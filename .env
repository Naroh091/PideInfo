# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=vigia_dev_secret_change_in_production

# Trusted proxies for reverse proxy (Caddy, Coolify, etc.)
# In production, set to the actual proxy IPs or REMOTE_ADDR for Coolify
TRUSTED_PROXIES=127.0.0.1
APP_SHARE_DIR=var/share
USER_NEEDS_MANUAL_ACTIVATION=false
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
DATABASE_URL="postgresql://postgres:pideinfo123@localhost:5433/postgres?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

###> custom-model ###
CUSTOM_MODEL=google/gemma-4-E4B-it
CUSTOM_MODEL_ENDPOINT=http://127.0.0.1:15000/v1
CUSTOM_MODEL_API_KEY=
CUSTOM_MODEL_MAX_TOKENS=4096
# Sampling temperature for ALL custom-model calls (overrides per-request temperatures).
CUSTOM_MODEL_TEMP=1

# Optional: directory where AgentTurnTraceCapture dumps the FULL conversation of every
# agentic chat turn (JSONL, one file per TASK+day) as training traces for distillation.
# Empty = disabled. WARNING: contains real citizens' files in plain text — restrict
# access, bound retention and decide explicitly whether it enters backups.
AGENT_TRACE_CAPTURE_DIR=

# Optional TEACHER model for high-quality trace collection. When TEACHER_MODEL and
# TEACHER_MODEL_ENDPOINT are both set, TEACHER_MODEL_SAMPLE % of agentic turns are
# served by the teacher INSTEAD of CUSTOM_MODEL — its output is what the user gets.
# The teacher MUST support tool calling and strict `response_format: json_schema`,
# or the agent breaks outright. Empty TEACHER_MODEL = disabled, everything goes to
# CUSTOM_MODEL. TEACHER_MODEL_TEMP defaults to empty too: some teacher backends
# (reasoning models) reject the `temperature` param outright, so it's safer unset
# by default — set it explicitly per-deployment only when the backend accepts it.
TEACHER_MODEL=
TEACHER_MODEL_ENDPOINT=
TEACHER_MODEL_API_KEY=
TEACHER_MODEL_MAX_TOKENS=16384
TEACHER_MODEL_TEMP=
# 0-100. Lets you throttle or cut the teacher off without a redeploy.
TEACHER_MODEL_SAMPLE=100

CUSTOM_EMBEDDING_MODEL=qwen3-embedding
CUSTOM_EMBEDDING_DIMENSION=0
# Optional: dedicated endpoint/key for embeddings. Leave empty to reuse CUSTOM_MODEL_ENDPOINT/API_KEY.
CUSTOM_EMBEDDING_ENDPOINT=
CUSTOM_EMBEDDING_API_KEY=
###< custom-model ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1
