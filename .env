# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=vigia_dev_secret_change_in_production

# Trusted proxies for reverse proxy (Caddy, Coolify, etc.)
# In production, set to the actual proxy IPs or REMOTE_ADDR for Coolify
TRUSTED_PROXIES=127.0.0.1
APP_SHARE_DIR=var/share
USER_NEEDS_MANUAL_ACTIVATION=false
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
DATABASE_URL="postgresql://postgres:pideinfo123@localhost:5433/postgres?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

###> custom-model ###
CUSTOM_MODEL=google/gemma-4-E4B-it
CUSTOM_MODEL_ENDPOINT=http://127.0.0.1:15000/v1
CUSTOM_MODEL_API_KEY=
CUSTOM_MODEL_MAX_TOKENS=4096
# Sampling temperature for ALL custom-model calls (overrides per-request temperatures).
CUSTOM_MODEL_TEMP=1

CUSTOM_EMBEDDING_MODEL=qwen3-embedding
CUSTOM_EMBEDDING_DIMENSION=0
# Optional: dedicated endpoint/key for embeddings. Leave empty to reuse CUSTOM_MODEL_ENDPOINT/API_KEY.
CUSTOM_EMBEDDING_ENDPOINT=
CUSTOM_EMBEDDING_API_KEY=
###< custom-model ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailer:1025
MAIL_FROM_ADDRESS=noreply@pideinfo.es
MAIL_FROM_NAME=PideInfo
###< symfony/mailer ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/mercure-bundle ###
# See https://symfony.com/doc/current/mercure.html#configuration
# The URL of the Mercure hub, used by the app to publish updates (internal Docker network)
MERCURE_URL=http://mercure/.well-known/mercure
# The public URL of the Mercure hub, used by the browser to connect
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure
# The secret used to sign the JWTs
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
###< symfony/mercure-bundle ###

###> aws/aws-s3 ###
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_REGION=eu-west-1
AWS_S3_PUBLIC_URL=https://${AWS_S3_BUCKET_NAME}.s3.${AWS_S3_REGION}.amazonaws.com
###< aws/aws-s3 ###

###> sentry/sentry-symfony ###
SENTRY_DSN=
###< sentry/sentry-symfony ###


###> symfony/amazon-mailer ###
# MAILER_DSN=ses://ACCESS_KEY:SECRET_KEY@default?region=eu-west-1
# MAILER_DSN=ses+smtp://ACCESS_KEY:SECRET_KEY@default?region=eu-west-1
###< symfony/amazon-mailer ###

###> redis/sessions ###
# Format: redis://[user:password@]host[:port]
REDIS_URL=redis://localhost:6379
