###< cloudflare turnstile ###

###> anonymous generation guardrails ###
# Global daily budget (turns/day across all IPs) for anonymous generation before
# the circuit breaker returns "temporarily unavailable" (see rate_limiter.yaml).
ANON_GEN_DAILY_BUDGET=2000
# Fail-open (true) when the moderation model is unreachable — allow the turn and
# rely on the deterministic guardrails; set false to fail closed (block).
ANON_MODERATION_FAIL_OPEN=true
###< anonymous generation guardrails ###

###> mesa de resoluciones ###
# Contraseñas de acceso a /mesa-resoluciones (herramienta interna para el CTBG),
# separadas por comas. Cualquiera de ellas abre la puerta; vacía = nadie entra.
MESA_PASSWORDS=
###< mesa de resoluciones ###

###> growthbook ###
# A/B testing for the public home hero (see src/Experiment/HomeHeroExperiment.php).
# Leave GROWTHBOOK_CLIENT_KEY empty to run the baked-in equal-weight inline
# experiment (works out of the box). Set the SDK client key — and, once the
# `home-hero` feature exists in the GrowthBook dashboard — to let GrowthBook
# manage weights/coverage/on-off. API host defaults to GrowthBook Cloud's CDN.
GROWTHBOOK_CLIENT_KEY=
GROWTHBOOK_API_HOST=https://cdn.growthbook.io
###< growthbook ###
