###> league/oauth2-server-bundle ###
# Keys are NOT committed; in production they must be mounted as secrets to var/oauth/
OAUTH_PRIVATE_KEY=%kernel.project_dir%/var/oauth/private.key
OAUTH_PUBLIC_KEY=%kernel.project_dir%/var/oauth/public.key
OAUTH_PASSPHRASE=
OAUTH_ENCRYPTION_KEY=
###< league/oauth2-server-bundle ###

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# Label used to fetch prompts (and to tag pushed versions). Defaults to 'production' when empty.
LANGFUSE_PROMPT_LABEL=
OTEL_SERVICE_NAME=pideinfo
OTEL_EXPORTER_OTLP_TIMEOUT=5000

###> friendsofsymfony/elastica-bundle ###
ELASTICSEARCH_URL=http://127.0.0.1:9200
# Search backend for the public resolution listing: "elastic" (with automatic
# fallback to Postgres) or "doctrine" (kill switch, never touches Elasticsearch).
RESOLUTION_SEARCH_BACKEND=elastic
# Same idea for the legislation index (`laws`).
LEGISLATION_SEARCH_BACKEND=elastic
# Hybrid retrieval for the AI agent (docs/search.md): fuse the dense pgvector
# ranking with a BM25 ranking from the `resolutions` index via RRF. Off until
# validated with app:retrieval:eval (docs/retrieval-eval.md).
RESOLUTION_HYBRID_RETRIEVAL=0
# Weight of the BM25 arm in the RRF fusion for LONG queries (dense arm = 1.0; short
# queries always fuse at 1.0). 0 = hybrid only for short queries — the only config
# measured strictly >= dense on every slice (docs/retrieval-eval.md). See docs/search.md.
RESOLUTION_HYBRID_LEXICAL_WEIGHT=0
###< friendsofsymfony/elastica-bundle ###

###> legalize-es ###
# Read-only checkout of https://github.com/legalize-dev/legalize-es (every Spanish law as
# markdown + frontmatter). Refreshed by `app:legalize:sync` (cron, 08:00). The volume must be
# readable by BOTH php-fpm and the workers: the agent reads untracked norms straight off disk.
# The app NEVER writes inside it — that is what makes `git reset --hard` safe.
LEGALIZE_PATH=/var/data/legalize
LEGALIZE_REPO_URL=https://github.com/legalize-dev/legalize-es.git
###< legalize-es ###

