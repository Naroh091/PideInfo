{# The "paper sheet": the draft as an editable document inside the chat.
   Renders in two contexts:
     - directly in the conversation when a draft already exists (prefill=true);
     - inside a <template> for assistant-chat to clone on the fly.
   Variables: flow ('request'|'complaint'), prefill (bool) and per-flow ones:
     request  → request, isRegDraft, batchId, isMultiOrganism, siblings
     complaint→ request, mode, isAlegation, currentDraft, currentBodyHtml #}
{% set prefill = prefill|default(false) %}

<div class="chat-turn-sheet">
    {% if flow == 'request' %}
        {% set shape = isRegDraft ? 'reg' : 'portal' %}
        <article class="paper-sheet"
                 data-controller="paper-sheet"
                 data-paper-sheet-shape-value="{{ shape }}"
                 data-paper-sheet-autosave-url-value="{{ autosaveUrl|default(path('app_solicitudes_realizar_autosave', {id: request.id})) }}">

            <div class="draft-meta-row">
                {% if isRegDraft %}
                    <span class="meta-pill meta-pill-reg">REG / RED SARA</span>
                {% else %}
                    <span class="meta-pill meta-pill-portal">Portal Transparencia</span>
                {% endif %}
                <span class="meta-pill">{{ request.publicBody.getLevelLabel() }}</span>
                {% if request.applicableLaw %}
                    <span class="meta-pill meta-pill-law">{{ request.applicableLaw.shortCode ?? request.applicableLaw.name }}</span>
                {% endif %}
                {% if isRegDraft %}
                    <span class="meta-pill meta-pill-unit" title="Unidad DIR3 de destino">
                        {{ request.regDestination.displayLabel }}
                    </span>
                {% endif %}
            </div>

            {# REG/RED SARA caps the asunto at 80 chars (silent truncation in
               portal); other channels use the AGE Portal limit of 255. #}
            {% set titleMaxLength = isRegDraft ? 80 : 255 %}
            <textarea class="draft-title-input"
                      placeholder="Asunto de la solicitud..."
                      maxlength="{{ titleMaxLength }}"
                      rows="1"
                      data-paper-sheet-target="title">{{ prefill ? request.title : '' }}</textarea>

            {% if isRegDraft %}
                <label class="draft-section-label">
                    <span>EXPONE</span><span class="draft-section-hint">Hechos y motivación · máx. 4.000 caracteres</span>
                </label>
                <textarea class="draft-body-input"
                          placeholder="Hechos, contexto y motivación de la solicitud. Describe la información que pides y por qué."
                          maxlength="4000"
                          data-paper-sheet-target="expone">{{ prefill ? request.expone : '' }}</textarea>

                <label class="draft-section-label">
                    <span>SOLICITA</span><span class="draft-section-hint">Petición concreta · máx. 4.000 caracteres</span>
                </label>
                <textarea class="draft-body-input"
                          placeholder="Petición concreta amparada en la Ley 19/2013 de Transparencia, Acceso a la Información Pública y Buen Gobierno."
                          maxlength="4000"
                          data-paper-sheet-target="solicita">{{ prefill ? request.solicita : '' }}</textarea>
            {% else %}
                <textarea class="draft-body-input"
                          placeholder="Describe con detalle qué información solicitas. Cuanto más concreto, más fácil será que la administración te responda."
                          maxlength="3000"
                          data-paper-sheet-target="body">{{ prefill ? request.description : '' }}</textarea>
            {% endif %}

            <div class="draft-sources" data-paper-sheet-target="sources"{{ (prefill and draftSources|default([])|length) ? '' : ' hidden' }}>
                <span class="draft-sources-label"><i data-lucide="link" class="w-3.5 h-3.5"></i> Fuentes utilizadas</span>
                <div class="draft-sources-pills" data-paper-sheet-target="sourcesPills">
                    {% if prefill %}{% for s in draftSources|default([]) %}
                        {% set internal = (s.type|default('')) == 'resolution' %}
                        {% set sicon = {'resolution': 'scale', 'criterion': 'book-open', 'judgment': 'gavel'}[s.type|default('')]|default('file-text') %}
                        {% if s.url|default('') %}
                            <a href="{{ s.url }}" class="draft-source{{ internal ? ' draft-source--interna' : '' }}" target="_blank" rel="noopener noreferrer"><i data-lucide="{{ sicon }}" class="w-3.5 h-3.5"></i> {{ s.label|default(s.reference) }}{% if not internal %} <i data-lucide="external-link" class="draft-source-ext"></i>{% endif %}</a>
                        {% else %}
                            <span class="draft-source"><i data-lucide="{{ sicon }}" class="w-3.5 h-3.5"></i> {{ s.label|default(s.reference) }}</span>
                        {% endif %}
                    {% endfor %}{% endif %}
                </div>
            </div>
            <footer class="paper-sheet-foot">
                <span data-paper-sheet-target="status" class="draft-status" style="text-align:left;"></span>
                <div class="draft-cta-group">
                    {% set requestPdfUrl = sheetPdfUrl|default(path('app_solicitudes_realizar_pdf', {id: request.id})) %}
                    <a href="{{ requestPdfUrl }}"
                       class="btn btn-secondary"
                       data-action="click->paper-sheet#downloadPdf"
                       data-paper-sheet-pdf-url-param="{{ requestPdfUrl }}">
                        <i data-lucide="file-down" class="w-4 h-4 mr-2"></i> Descargar PDF
                    </a>
                    {% if batchId %}
                        {# Submit goes through paper-sheet#dispatchSubmit so we
                           (a) confirm, (b) block while assistant-chat is mid-stream,
                           (c) force-flush any pending autosave before POSTing. #}
                        <form method="post"
                              action="{{ path('app_solicitudes_realizar_dispatch', {batchId: batchId}) }}"
                              data-action="submit->paper-sheet#dispatchSubmit">
                            {# Explicit preview confirmation (spec §5):
                               the server requires it (confirmReview) before creating tasks. #}
                            <label class="flex items-start gap-2 mt-3 text-sm text-slate-600 leading-relaxed">
                                <input type="checkbox" name="confirmReview" value="1" required class="mt-1">
                                <span>
                                    {% if isMultiOrganism %}
                                        He revisado los {{ siblings|length }} destinatarios y confirmo el envío
                                    {% else %}
                                        He revisado el destinatario y confirmo el envío
                                    {% endif %}
                                </span>
                            </label>
                            {% if isMultiOrganism and siblings|length > 5 %}
                                <p class="text-xs text-slate-500 leading-relaxed mt-2">
                                    Consejo: para lotes grandes, envía primero a un destinatario como piloto
                                    y comprueba que todo sale bien antes de lanzar el resto.
                                </p>
                            {% endif %}
                            <button type="submit" class="btn btn-primary">
                                <i data-lucide="send" class="w-4 h-4 mr-2"></i>
                                {% if isMultiOrganism %}
                                    Enviar a los {{ siblings|length }} organismos
                                {% else %}
                                    Enviar al organismo
                                {% endif %}
                            </button>
                        </form>
                    {% elseif sendUrl|default(null) %}
                        <a href="{{ sendUrl }}" class="btn btn-primary"
                           data-action="click->paper-sheet#goToSend"
                           data-paper-sheet-send-url-param="{{ sendUrl }}">
                            <i data-lucide="send" class="w-4 h-4 mr-2"></i> Enviar
                        </a>
                    {% endif %}
                </div>
            </footer>
        </article>
    {% elseif flow == 'consult' %}
        {# Free consult: HTML document (Trix, shape=complaint) with its own footer
           — type selector (DocumentType::consultSavable), Download PDF and
           Save to the record. No autosave, no "submit". The input id is
           rewritten to one unique per sheet in assistant-chat#_createSheet. #}
        <article class="paper-sheet paper-sheet--consult"
                 data-controller="paper-sheet"
                 data-paper-sheet-shape-value="complaint"
                 data-paper-sheet-pdf-url-value="{{ path('app_consult_pdf', {id: request.id}) }}"
                 data-paper-sheet-save-dossier-url-value="{{ path('app_consult_save', {id: request.id}) }}">

            <div class="draft-meta-row">
                <span class="meta-pill">{{ request.publicBody.getLevelLabel() }}</span>
                {% if request.applicableLaw %}
                    <span class="meta-pill meta-pill-law">{{ request.applicableLaw.shortCode ?? request.applicableLaw.name }}</span>
                {% endif %}
            </div>

            {# Filing title + plain-text editor (same format as the
               request). HTML is synthesized only on download/save
               (getHtml → _plainToHtml). #}
            <textarea class="draft-title-input"
                      placeholder="Título del escrito…"
                      maxlength="255"
                      rows="1"
                      data-paper-sheet-target="title"></textarea>
            <textarea class="draft-body-input"
                      data-paper-sheet-target="body"
                      placeholder="El documento que generes aparecerá aquí. Puedes editarlo antes de descargarlo o guardarlo."></textarea>

            <div class="draft-sources" data-paper-sheet-target="sources" hidden>
                <span class="draft-sources-label"><i data-lucide="link" class="w-3.5 h-3.5"></i> Fuentes utilizadas</span>
                <div class="draft-sources-pills" data-paper-sheet-target="sourcesPills"></div>
            </div>

            <footer class="paper-sheet-foot">
                <span data-paper-sheet-target="status" class="draft-status" style="text-align:left;"></span>
                <div class="draft-cta-group draft-cta-group--consult">
                    <label class="consult-doctype">
                        <span class="consult-doctype-label">Guardar como</span>
                        <select data-paper-sheet-target="docTypeSelect" class="consult-doctype-select">
                            <option value="complaint">Reclamación</option>
                            <option value="alegation_response">Respuesta a alegaciones</option>
                            <option value="subsanacion_response">Subsanación presentada</option>
                            <option value="other" selected>Otro</option>
                        </select>
                    </label>
                    <button type="button" class="btn btn-secondary" data-action="paper-sheet#downloadPdf">
                        <i data-lucide="file-down" class="w-4 h-4 mr-2"></i> Descargar PDF
                    </button>
                    <button type="button" class="btn btn-primary" data-action="paper-sheet#saveToDossier">
                        <i data-lucide="folder-plus" class="w-4 h-4 mr-2"></i> Guardar en el expediente
                    </button>
                </div>
            </footer>
        </article>
    {% else %}
        {# `is defined` and not `default()`: a saveUrl/presentUrl defined as
           null means "action unavailable" (anonymous flow) and default()
           would overwrite it with the authenticated route. #}
        {% set complaintSaveUrl = saveUrl is defined ? saveUrl : path('app_complaint_redactar_save', {id: request.id}) %}
        {% set complaintPdfUrl = sheetPdfUrl|default(path('app_complaint_download_pdf', {id: request.id})) %}
        {% set complaintPresentUrl = presentUrl is defined ? presentUrl : path('app_complaint_present_via_agent', {id: request.id}) %}
        {% set complaintSendUrl = sendUrl|default(null) %}
        <article class="paper-sheet"
                 data-controller="paper-sheet"
                 data-paper-sheet-shape-value="complaint"
                 data-paper-sheet-mode-value="{{ mode }}"
                 data-paper-sheet-draft-id-value="{{ currentDraft ? currentDraft.id : '' }}"
                 data-paper-sheet-save-url-value="{{ complaintSaveUrl ?? '' }}"
                 data-paper-sheet-pdf-url-value="{{ complaintPdfUrl }}"
                 {% if not isAlegation and complaintPresentUrl %}data-paper-sheet-present-url-value="{{ complaintPresentUrl }}"{% endif %}>

            <div class="draft-meta-row">
                <span class="meta-pill meta-pill-portal">
                    {% if isAlegation %}Consejo de Transparencia{% else %}Reclamación{% endif %}
                </span>
                <span class="meta-pill">{{ request.publicBody.getLevelLabel() }}</span>
                {% if request.applicableLaw %}
                    <span class="meta-pill meta-pill-law">{{ request.applicableLaw.shortCode ?? request.applicableLaw.name }}</span>
                {% endif %}
            </div>

            {# Plain-text editor (request style). The saved draft is HTML:
               it passes through the hidden htmlInput and paper-sheet#connect
               converts it to plain text for editing; on save/export the HTML
               is re-synthesized (getHtml → _plainToHtml). #}
            <input type="hidden" data-paper-sheet-target="htmlInput" value="{{ prefill ? currentBodyHtml : '' }}">
            <textarea class="draft-body-input"
                      data-paper-sheet-target="body"
                      placeholder="{% if isAlegation %}Escribe la respuesta a las alegaciones, o pídesela al asistente en el chat…{% else %}Escribe la reclamación, o pídesela al asistente en el chat…{% endif %}"></textarea>

            <div class="draft-sources" data-paper-sheet-target="sources"{{ (prefill and draftSources|default([])|length) ? '' : ' hidden' }}>
                <span class="draft-sources-label"><i data-lucide="link" class="w-3.5 h-3.5"></i> Fuentes utilizadas</span>
                <div class="draft-sources-pills" data-paper-sheet-target="sourcesPills">
                    {% if prefill %}{% for s in draftSources|default([]) %}
                        {% set internal = (s.type|default('')) == 'resolution' %}
                        {% set sicon = {'resolution': 'scale', 'criterion': 'book-open', 'judgment': 'gavel'}[s.type|default('')]|default('file-text') %}
                        {% if s.url|default('') %}
                            <a href="{{ s.url }}" class="draft-source{{ internal ? ' draft-source--interna' : '' }}" target="_blank" rel="noopener noreferrer"><i data-lucide="{{ sicon }}" class="w-3.5 h-3.5"></i> {{ s.label|default(s.reference) }}{% if not internal %} <i data-lucide="external-link" class="draft-source-ext"></i>{% endif %}</a>
                        {% else %}
                            <span class="draft-source"><i data-lucide="{{ sicon }}" class="w-3.5 h-3.5"></i> {{ s.label|default(s.reference) }}</span>
                        {% endif %}
                    {% endfor %}{% endif %}
                </div>
            </div>
            <footer class="paper-sheet-foot">
                <span data-paper-sheet-target="status" class="draft-status" style="text-align:left;"></span>
                <div class="draft-cta-group">
                    {% if complaintSaveUrl %}
                        <button type="button" class="btn btn-secondary"
                                data-action="paper-sheet#saveDraft">
                            <i data-lucide="save" class="w-4 h-4 mr-2"></i> Guardar borrador
                        </button>
                    {% endif %}
                    <button type="button" class="btn {{ (complaintPresentUrl or complaintSendUrl) ? 'btn-secondary' : 'btn-primary' }}"
                            data-action="paper-sheet#downloadPdf">
                        <i data-lucide="file-down" class="w-4 h-4 mr-2"></i> Descargar PDF
                    </button>
                    {% if complaintSendUrl %}
                        <button type="button" class="btn btn-primary"
                                data-action="paper-sheet#goToSend"
                                data-paper-sheet-send-url-param="{{ complaintSendUrl }}"
                                data-paper-sheet-send-save-url-param="{{ path('app_public_redactar_complaint_autosave', {id: request.id}) }}">
                            <i data-lucide="send" class="w-4 h-4 mr-2"></i> Enviar
                        </button>
                    {% endif %}
                    {% if not isAlegation and complaintPresentUrl %}
                        <button type="button" class="btn btn-secondary"
                                data-action="paper-sheet#presentViaAgent"
                                data-paper-sheet-agent-mode-param="supervised"
                                title="El agente abre la sede con el formulario rellenado y tú revisas + envías">
                            <i data-lucide="eye" class="w-4 h-4 mr-2"></i> Presentar (supervisado)
                        </button>
                        <button type="button" class="btn btn-primary"
                                data-action="paper-sheet#presentViaAgent"
                                data-paper-sheet-agent-mode-param="auto"
                                title="El agente rellena y envía sin intervención">
                            <i data-lucide="zap" class="w-4 h-4 mr-2"></i> Presentar (auto)
                        </button>
                    {% endif %}
                </div>
            </footer>
        </article>
    {% endif %}
</div>
