{# Turnos persistidos, renderizados en servidor al cargar la página.
   Variables: chatHistory (lista de turnos con role/content/kind/allowsHtml). #}
{% for turn in chatHistory|default([]) %}
    {% if turn.role|default('') == 'user' %}
        <div class="chat-turn chat-turn-user">
            <div class="chat-bubble-text">{{ turn.content|default('')|nl2br }}</div>
        </div>
    {% elseif turn.kind|default('') not in ['suggestions', 'system'] %}
        <div class="chat-turn chat-turn-assistant">
            {# `chat-md` iguala el render con el stream en vivo: white-space:normal
               (evita que el indentado del template se vea como líneas en blanco)
               + estilo de párrafos/listas. El contenido es HTML: se sanea en
               servidor para renderizarlo seguro al recargar. #}
            <div class="chat-bubble-text chat-md">{% if turn.allowsHtml|default(false) %}{{ turn.content|default('')|raw }}{% else %}{{ turn.content|default('')|sanitize_html }}{% endif %}</div>
        </div>
    {% endif %}
{% endfor %}
