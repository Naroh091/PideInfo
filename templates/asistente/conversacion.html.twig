{% extends (anonymous ?? false) ? 'layouts/public_page.html.twig' : 'layouts/app.html.twig' %}

{# Página de conversación unificada para redactar solicitudes y
   reclamaciones/alegaciones: el chat con el asistente ES la página, y el
   borrador vive dentro como hoja de papel editable (paper-sheet). Es la ÚNICA
   plantilla de redacción: la renderizan AccessRequestController::draft (auten-
   ticado) y AnonymousDraftController::draft (`anonymous: true`, /redactar); el
   editor clásico (canvas + widget flotante) fue retirado.

   Contrato de variables:
     flow == 'request'  → request, siblings, batchId, chatHistory, batch
                          (DraftBatchOverview::navigation(), null con un
                          solo destinatario)
     templateMode (bool) → plantilla común de un lote (DraftBatchController):
                          request = primera solicitud del lote (solo aloja el
                          registro de turnos), batch, placeholderCatalog,
                          placeholderValues; la hoja y el chat son los de la
                          plantilla, no los de esa solicitud.
     flow == 'complaint'→ request, mode, currentDraft, currentBodyHtml,
                          chatHistory, alegacionesDoc, existingDrafts
     anonymous (bool, opcional) → borrador sin dueño del flujo público
                          /redactar: layout público, endpoints espejo de
                          AnonymousDraftController, sin guardar/presentar,
                          CTA de registro. #}

{% set anonymous = anonymous|default(false) %}
{% set isRequest = flow == 'request' %}
{% set templateMode = templateMode|default(false) %}
{% set batch = batch|default(null) %}

{# Endpoints que consumen la hoja de papel y el informe: los autenticados por
   defecto, o los espejos públicos de AnonymousDraftController. Un valor null
   oculta la acción (paper-sheet no-opea con URL vacía). #}
{% if isRequest %}
    {% set autosaveUrl = anonymous ? path('app_public_redactar_autosave', {id: request.id}) : path('app_solicitudes_realizar_autosave', {id: request.id}) %}
    {% set sheetPdfUrl = anonymous ? path('app_public_redactar_pdf', {id: request.id}) : path('app_solicitudes_realizar_pdf', {id: request.id}) %}
    {% set similarUrl = anonymous ? path('app_public_redactar_similar', {id: request.id}) : path('app_solicitudes_realizar_similar', {id: request.id}) %}
    {% set probabilityUrl = anonymous ? path('app_public_redactar_probability', {id: request.id}) : path('app_solicitudes_realizar_probability', {id: request.id}) %}
    {% set sendUrl = anonymous ? path('app_public_redactar_send', {id: request.id}) : null %}
{% else %}
    {% set saveUrl = anonymous ? null : path('app_complaint_redactar_save', {id: request.id}) %}
    {% set sheetPdfUrl = anonymous ? path('app_public_redactar_complaint_pdf', {id: request.id}) : path('app_complaint_download_pdf', {id: request.id}) %}
    {% set presentUrl = anonymous ? null : path('app_complaint_present_via_agent', {id: request.id}) %}
    {% set analyzeUrl = anonymous ? path('app_public_redactar_complaint_analyze', {id: request.id}) : path('app_complaint_analyze', {id: request.id}) %}
    {% set sendUrl = anonymous ? path('app_public_redactar_complaint_send', {id: request.id}) : null %}
{% endif %}
{% if isRequest %}
    {% set batchId = batchId|default(null) %}
    {% set isMultiOrganism = (siblings|length) > 1 %}
    {% set isRegDraft = templateMode or request.regDestination is not null %}
    {% set isAlegation = false %}
    {% set isAmpliation = false %}
    {% if templateMode %}
        {% set hasDraft = not batch.template.isEmpty() %}
        {% set pageTitle = 'Plantilla común · PideInfo' %}
    {% else %}
        {% set hasDraft = request.title is not empty
            or request.description is not empty
            or request.expone is not empty
            or request.solicita is not empty %}
        {% set pageTitle = 'Redactar solicitud · PideInfo' %}
    {% endif %}
{% else %}
    {% set isAlegation = mode == 'alegation_response' %}
    {% set isAmpliation = mode == 'ampliation' %}
    {% set isMultiOrganism = false %}
    {% set isRegDraft = false %}
    {% set hasDraft = currentBodyHtml is not empty %}
    {% set pageTitle = (isAlegation ? 'Respuesta a alegaciones' : (isAmpliation ? 'Ampliación de reclamación' : 'Reclamación')) ~ ' - ' ~ request.title ~ ' - PideInfo' %}
{% endif %}

{% block title %}{{ pageTitle }}{% endblock %}

{# Turbo Drive intercambia el <body> sin recarga y Alpine (CDN, se inicializa una
   sola vez) no se reinicia en los renders de Turbo: al llegar aquí por navegación
   interna, el efecto x-show del modal `agentPresent` queda muerto y "Presentar
   (auto/supervisado)" no abre el popup aunque la tarea se encole. Forzamos carga
   completa al entrar. Ver docs/complaint-workflow.md → "Modal de progreso unificado". #}
{% block meta %}<meta name="turbo-visit-control" content="reload">{% endblock %}


{% block content %}
<div data-controller="assistant-chat{{ batch ? ' batch-versions' : '' }}"
     {% if templateMode %}
         data-assistant-chat-endpoint-url-value="{{ path('app_assistant_chat_batch_template', {id: request.id}) }}"
         data-assistant-chat-is-reg-value="true"
         data-assistant-chat-draft-noun-value="Plantilla"
     {% elseif isRequest %}
         data-assistant-chat-endpoint-url-value="{{ path('app_assistant_chat_request', {id: request.id}) }}"
         data-assistant-chat-is-reg-value="{{ isRegDraft ? 'true' : 'false' }}"
     {% else %}
         data-assistant-chat-endpoint-url-value="{{ path('app_assistant_chat_complaint', {id: request.id}) }}"
     {% endif %}
     data-assistant-chat-flow-value="{{ flow }}"
     data-assistant-chat-turn-url-value="{{ path('app_assistant_chat_turn', {flow: templateMode ? 'batch' : (isRequest ? 'request' : 'complaint'), id: request.id}) }}"
     data-assistant-chat-anonymous-value="{{ anonymous ? 'true' : 'false' }}"
     {% if anonymous %}data-assistant-chat-register-url-value="{{ path('app_register') }}"{% endif %}
     data-assistant-chat-has-draft-value="{{ hasDraft ? 'true' : 'false' }}"
     data-assistant-chat-created-at-value="{{ request.createdAt|date('c') }}"
     data-assistant-chat-updated-at-value="{{ templateMode and batch.template.updatedAt ? batch.template.updatedAt|date('c') : request.updatedAt|date('c') }}"
     data-action="paper-sheet:saved->assistant-chat#onDraftSaved{{ batch ? ' paper-sheet:saved->batch-versions#onTemplateSaved' : '' }}">

    {% if not anonymous and not isRequest %}
        {% include '_partials/agent_required_banner.html.twig' %}
    {% endif %}

    {# ── Breadcrumb + cabecera ─────────────────────────────── #}
    {% if not anonymous %}
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-3" style="font-family:'Inter',sans-serif;letter-spacing:.04em;">
        <a href="{{ path('app_solicitudes_index') }}" class="hover:text-slate-800 transition-colors">SOLICITUDES</a>
        <span class="text-slate-300">/</span>
        {% if isRequest %}
            <a href="{{ path('app_solicitudes_submit_form') }}" class="hover:text-slate-800 transition-colors">REALIZAR</a>
            {% if templateMode %}
                <span class="text-slate-300">/</span>
                <span class="text-slate-800 font-medium">PLANTILLA COMÚN</span>
            {% endif %}
        {% else %}
            <a href="{{ path('app_solicitudes_show', {id: request.id}) }}" class="hover:text-slate-800 transition-colors truncate max-w-[14rem]">
                {{ request.title|u.truncate(28) }}
            </a>
            <span class="text-slate-300">/</span>
            <span class="text-slate-800 font-medium">{{ isAlegation ? 'RESPUESTA A ALEGACIONES' : (isAmpliation ? 'AMPLIACIÓN DE RECLAMACIÓN' : 'RECLAMACIÓN') }}</span>
        {% endif %}
    </nav>
    {% endif %}

    <header class="draft-band">
        <div class="draft-band-row">
            <h1 class="draft-band-title">
                {% if templateMode %}
                    Redacta la plantilla común para <em>{{ batch.total }} organismos</em>
                {% elseif isRequest %}
                    Redacta tu solicitud para
                {% elseif isAlegation %}
                    Responde a las alegaciones de
                {% elseif isAmpliation %}
                    Amplía la reclamación frente a
                {% else %}
                    Reclama frente a
                {% endif %}
                {% if not templateMode %}<em>{{ request.publicBody.name }}</em>{% endif %}
            </h1>
            {% if anonymous %}
                <a href="{{ path('app_register') }}" class="ghost-link" title="Con una cuenta guardamos este borrador y te avisamos de los plazos">
                    <i data-lucide="user-plus" class="w-4 h-4"></i> Crea una cuenta para hacer seguimiento
                </a>
            {% elseif isRequest %}
                <a href="{{ path('app_solicitudes_index') }}" class="ghost-link">
                    <i data-lucide="save" class="w-4 h-4"></i> Guardar y salir
                </a>
            {% else %}
                <a href="{{ path('app_solicitudes_show', {id: request.id}) }}" class="ghost-link">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i> Volver al expediente
                </a>
            {% endif %}
        </div>
    </header>

    {% if isRequest and batch %}
        {% include 'asistente/_batch_nav.html.twig' %}
    {% elseif isRequest and isMultiOrganism %}
        <nav class="draft-tabs" aria-label="Otros borradores del envío">
            {% for sib in siblings %}
                <a href="{{ path('app_solicitudes_realizar_draft', {id: sib.id}) }}"
                   class="draft-tab{% if sib.id == request.id %} is-current{% endif %}">
                    {{ sib.publicBody.name|u.truncate(40, '…') }}
                    {% if sib.title is empty and sib.description is empty %}
                        <span class="draft-tab-state">vacío</span>
                    {% endif %}
                </a>
            {% endfor %}
        </nav>
    {% endif %}

    {% if not isRequest and (isAlegation or isAmpliation) and existingDrafts|default([])|length > 0 %}
        <nav class="draft-tabs" aria-label="{% if isAmpliation %}Borradores de ampliación de reclamación{% else %}Borradores de respuesta a alegaciones{% endif %}">
            {% for draft in existingDrafts %}
                <a href="{{ path('app_complaint_redactar', {id: request.id, mode: mode, draft: draft.id}) }}"
                   class="draft-tab{% if currentDraft and currentDraft.id == draft.id %} is-current{% endif %}">
                    <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
                    {{ draft.originalFilename|default('Borrador')|u.truncate(30) }}
                </a>
            {% endfor %}
            <a href="{{ path('app_complaint_redactar', {id: request.id, mode: mode}) }}"
               class="draft-tab">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i> Nuevo borrador
            </a>
        </nav>
    {% endif %}

    {# ── Conversación + sidebar de informe ─────────────────── #}
    <div class="conv-layout">
        <div class="conv-col">
            <div class="conv-history" data-assistant-chat-target="history">
                {% include 'asistente/_history.html.twig' %}

                {% if hasDraft and templateMode %}
                    {% include 'asistente/_template_sheet.html.twig' with {prefill: true} %}
                    {% include 'asistente/_versions_event.html.twig' %}
                {% elseif hasDraft %}
                    {% include 'asistente/_paper_sheet.html.twig' with {prefill: true, draftSources: request.getMetadataValue('cited_sources')} %}
                {% endif %}
            </div>

            {% include 'asistente/_composer.html.twig' %}
        </div>

        {% if templateMode %}
            {% include 'asistente/_template_sidebar.html.twig' %}
        {% else %}
            {% include 'asistente/_informe_sidebar.html.twig' %}
        {% endif %}
    </div>

    {# ── Inputs extra que viajan en cada turno (reclamación) ── #}
    {% if not isRequest %}
        <input type="hidden" name="mode" value="{{ mode }}" data-assistant-chat-target="extra">
        <input type="hidden" name="currentBodyHtml" value="" data-assistant-chat-target="extra">
    {% endif %}

    {# ── Plantillas que assistant-chat clona al vuelo ─────────── #}
    <template data-assistant-chat-target="introTemplate">
        {% include 'asistente/_intro_choice.html.twig' %}
    </template>
    <template data-assistant-chat-target="sheetTemplate">
        {% if templateMode %}
            {% include 'asistente/_template_sheet.html.twig' with {prefill: false} %}
        {% else %}
            {% include 'asistente/_paper_sheet.html.twig' with {prefill: false} %}
        {% endif %}
    </template>
</div>

{% if not anonymous %}
    {% include '_partials/_agent_present_modal.html.twig' %}
{% endif %}

{% endblock %}
