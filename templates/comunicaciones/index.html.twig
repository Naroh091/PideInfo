{% extends 'layouts/app.html.twig' %}

{% block title %}Comunicaciones por email - PideInfo{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* ── Comunicaciones index ── */
        .comms-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 2rem;
            padding-bottom: 1.25rem;
            border-bottom: 1px solid rgb(226 232 240);
        }
        .comms-title {
            font-family: 'DM Serif Display', Georgia, serif;
            font-weight: 400;
            font-size: clamp(1.75rem, 3.5vw, 2.4rem);
            line-height: 1.05;
            letter-spacing: -.015em;
            color: rgb(15 23 42);
        }
        .comms-sub {
            font-family: 'DM Sans', sans-serif;
            font-size: .92rem;
            color: rgb(100 116 139);
            margin-top: .35rem;
        }
        .comms-virtual-email {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            padding: .45rem .65rem;
            background: rgb(248 250 252);
            border: 1px solid rgb(226 232 240);
            border-radius: .55rem;
            font-family: 'JetBrains Mono', 'SF Mono', monospace;
            font-size: .78rem;
            color: rgb(15 23 42);
        }

        /* ── Email cards ── */
        .comm-card {
            background: white;
            border: 1px solid rgb(226 232 240);
            border-radius: 6px;
            overflow: hidden;
            margin-bottom: 1rem;
        }
        .comm-card-head {
            display: flex;
            gap: 1rem;
            padding: 1rem 1.25rem;
            background: #fafbfc;
            border-bottom: 1px solid rgb(241 245 249);
        }
        .comm-card-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            border-radius: 999px;
            background: var(--color-primary-50);
            color: var(--color-primary-600);
            flex-shrink: 0;
        }
        .comm-card-main { flex: 1; min-width: 0; }
        .comm-card-subject {
            font-family: 'DM Sans', sans-serif;
            font-weight: 600;
            font-size: .95rem;
            color: rgb(15 23 42);
        }
        .comm-card-meta {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: .35rem .65rem;
            margin-top: .3rem;
            font-family: 'DM Sans', sans-serif;
            font-size: .78rem;
            color: rgb(100 116 139);
        }
        .comm-card-meta .sep { color: rgb(203 213 225); }
        .comm-card-request {
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            margin-top: .5rem;
            font-family: 'DM Sans', sans-serif;
            font-size: .8rem;
            color: var(--color-primary-700);
            text-decoration: none;
        }
        .comm-card-request:hover { text-decoration: underline; }
        .comm-card-request.is-unlinked {
            color: rgb(180 130 30);
            cursor: default;
        }
        .comm-card-request.is-unlinked:hover { text-decoration: none; }

        /* ── Documents inside a card ── */
        .comm-doc {
            display: flex;
            align-items: flex-start;
            gap: .85rem;
            padding: .75rem 1.25rem;
            border-bottom: 1px solid rgb(241 245 249);
        }
        .comm-doc:last-child { border-bottom: none; }
        .comm-doc:hover { background: rgb(248 250 252); }
        .comm-doc:hover .comm-doc-actions { opacity: 1; }
        .comm-doc-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 30px;
            height: 30px;
            color: rgb(148 163 184);
            flex-shrink: 0;
        }
        .comm-doc-main { flex: 1; min-width: 0; }
        .comm-doc-name {
            font-family: 'DM Sans', sans-serif;
            font-weight: 500;
            font-size: .86rem;
            color: rgb(30 41 59);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .comm-doc-meta {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: .35rem .55rem;
            margin-top: .25rem;
            font-family: 'DM Sans', sans-serif;
            font-size: .76rem;
            color: rgb(100 116 139);
        }
        .comm-doc-summary {
            font-family: 'DM Sans', sans-serif;
            font-size: .82rem;
            color: rgb(71 85 105);
            margin-top: .35rem;
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .comm-doc-actions {
            display: flex;
            align-items: center;
            gap: .25rem;
            flex-shrink: 0;
            opacity: .55;
            transition: opacity .12s ease;
        }
        .comm-doc-actions a,
        .comm-doc-actions button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: .45rem;
            color: rgb(100 116 139);
            background: transparent;
            border: none;
            cursor: pointer;
            transition: background .12s ease, color .12s ease;
        }
        .comm-doc-actions a:hover,
        .comm-doc-actions button:hover {
            background: rgb(226 232 240);
            color: rgb(15 23 42);
        }
        .comm-doc-actions button.is-danger:hover {
            background: rgb(254 226 226);
            color: rgb(185 28 28);
        }

        /* ── Inline link-to-request form ── */
        .comm-link-form {
            display: flex;
            align-items: center;
            gap: .5rem;
            margin-top: .5rem;
        }
        .comm-link-form select {
            flex: 1;
            min-width: 0;
            max-width: 24rem;
            font-family: 'DM Sans', sans-serif;
            font-size: .8rem;
            color: rgb(30 41 59);
            padding: .35rem .5rem;
            background: white;
            border: 1px solid rgb(203 213 225);
            border-radius: .45rem;
        }
    </style>
{% endblock %}

{% block content %}
<header class="comms-header">
    <div class="min-w-0">
        <h1 class="comms-title">Comunicaciones por email</h1>
        <p class="comms-sub">
            {% if groups|length > 0 %}
                {{ groups|length }} email{{ groups|length != 1 ? 's' : '' }} recibido{{ groups|length != 1 ? 's' : '' }} en tu buzón virtual.
            {% else %}
                Las comunicaciones que lleguen a tu email virtual aparecerán aquí.
            {% endif %}
        </p>
    </div>
    {% if app.user.virtualEmail %}
        <span class="comms-virtual-email">
            <i data-lucide="mail" class="w-3.5 h-3.5 text-slate-400"></i>
            {{ app.user.virtualEmail }}
        </span>
    {% endif %}
</header>

{% if groups|length > 0 %}
    {% for group in groups %}
        <div class="comm-card">
            <div class="comm-card-head">
                <span class="comm-card-icon">
                    <i data-lucide="mail" class="w-[18px] h-[18px]"></i>
                </span>
                <div class="comm-card-main">
                    <p class="comm-card-subject">{{ group.subject }}</p>
                    <div class="comm-card-meta">
                        {% if group.from %}
                            <span>{{ group.from }}</span>
                            <span class="sep">·</span>
                        {% endif %}
                        <span>
                            {%- if group.date -%}
                                {{ group.date|date('d/m/Y H:i') }}
                            {%- else -%}
                                {{ group.createdAt|date('d/m/Y H:i') }}
                            {%- endif -%}
                        </span>
                        <span class="sep">·</span>
                        <span>{{ group.documents|length }} documento{{ group.documents|length != 1 ? 's' : '' }}</span>
                    </div>
                    {% if group.accessRequest %}
                        <a href="{{ path('app_solicitudes_show', {id: group.accessRequest.id}) }}" class="comm-card-request">
                            <i data-lucide="folder-open" class="w-3.5 h-3.5"></i>
                            {{ group.accessRequest.title }}
                        </a>
                    {% else %}
                        <span class="comm-card-request is-unlinked">
                            <i data-lucide="unlink" class="w-3.5 h-3.5"></i>
                            Sin solicitud vinculada
                        </span>
                    {% endif %}
                </div>
            </div>

            {% for doc in group.documents %}
                {% set iconName = doc.isPdf ? 'file-text' : (doc.isImage ? 'image' : 'file') %}
                <div class="comm-doc" data-document-id="{{ doc.id }}" x-data="{ linking: false }">
                    <span class="comm-doc-icon">
                        <i data-lucide="{{ iconName }}" class="w-[18px] h-[18px]"></i>
                    </span>
                    <div class="comm-doc-main">
                        <p class="comm-doc-name" title="{{ doc.displayFilename }}">{{ doc.displayFilename }}</p>
                        <div class="comm-doc-meta">
                            {% if doc.processed %}
                                <span class="badge badge-secondary">{{ doc.typeLabel }}</span>
                            {% else %}
                                <span class="badge badge-warning">Procesando...</span>
                            {% endif %}
                            {% if doc.accessRequest and doc.accessRequest is not same as(group.accessRequest) %}
                                <a href="{{ path('app_solicitudes_show', {id: doc.accessRequest.id}) }}"
                                   class="text-primary-700 hover:underline">{{ doc.accessRequest.title }}</a>
                            {% endif %}
                        </div>
                        {% if doc.summary %}
                            <p class="comm-doc-summary">{{ doc.summary }}</p>
                        {% endif %}
                        {% if doc.accessRequest is null %}
                            <div class="comm-link-form" x-show="linking" style="display: none;">
                                <select id="link-select-{{ doc.id }}">
                                    <option value="">Selecciona una solicitud…</option>
                                    {% for accessRequest in accessRequests %}
                                        <option value="{{ accessRequest.id }}">{{ accessRequest.title }}</option>
                                    {% endfor %}
                                </select>
                                <button type="button"
                                        class="btn btn-primary btn-sm"
                                        onclick="linkDocumentTo('{{ doc.id }}', document.getElementById('link-select-{{ doc.id }}').value, this)">
                                    Enlazar
                                </button>
                                <button type="button" class="btn btn-ghost btn-sm" @click="linking = false">
                                    Cancelar
                                </button>
                            </div>
                        {% endif %}
                    </div>
                    <div class="comm-doc-actions">
                        {% if doc.accessRequest is null %}
                            <button type="button" title="Vincular a una solicitud" @click="linking = !linking">
                                <i data-lucide="link" class="w-4 h-4"></i>
                            </button>
                        {% endif %}
                        <a href="{{ path('app_document_download', {id: doc.id}) }}?inline=1"
                           target="_blank"
                           title="Abrir en nueva pestaña">
                            <i data-lucide="external-link" class="w-4 h-4"></i>
                        </a>
                        <a href="{{ path('app_document_download', {id: doc.id}) }}"
                           title="Descargar">
                            <i data-lucide="download" class="w-4 h-4"></i>
                        </a>
                        <button type="button"
                                title="Reprocesar documento"
                                onclick="reprocessDocument('{{ doc.id }}', this)">
                            <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                        </button>
                        <form method="post"
                              action="{{ path('app_document_delete', {id: doc.id}) }}"
                              onsubmit="return confirm('¿Eliminar este documento? Esta acción no se puede deshacer.')"
                              class="inline-flex">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-document-' ~ doc.id) }}">
                            <input type="hidden" name="_redirect" value="comunicaciones">
                            <button type="submit" class="is-danger" title="Eliminar documento">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endfor %}
{% else %}
    <div class="empty-state py-16">
        <i data-lucide="inbox" class="empty-state-icon"></i>
        <h3 class="empty-state-title">No has recibido comunicaciones por email</h3>
        <p class="empty-state-description">
            {% if app.user.virtualEmail %}
                Usa tu email virtual <strong>{{ app.user.virtualEmail }}</strong> como dirección de contacto
                en los portales de transparencia y los Consejos: todo lo que llegue se procesará y aparecerá aquí.
            {% else %}
                Genera tu email virtual desde el panel principal y úsalo como dirección de contacto
                en los portales de transparencia: todo lo que llegue se procesará y aparecerá aquí.
            {% endif %}
        </p>
    </div>
{% endif %}

{% include '_partials/document_actions_js.html.twig' %}
{% endblock %}
