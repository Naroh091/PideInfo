{% extends 'layouts/app.html.twig' %}

{% block title %}{{ isEdit ? 'Editar recordatorio' : 'Nuevo recordatorio' }} - PideInfo{% endblock %}

{% block content %}
{# Breadcrumb #}
<nav class="flex items-center gap-2 text-xs text-slate-500 mb-3" style="font-family:'Inter',sans-serif;letter-spacing:.04em;">
    <a href="{{ path('app_solicitudes_index') }}" class="hover:text-slate-800 transition-colors">SOLICITUDES</a>
    <span class="text-slate-300">/</span>
    <a href="{{ path('app_solicitudes_show', {id: request.id}) }}" class="hover:text-slate-800 transition-colors truncate max-w-[14rem]">
        {{ request.title|u.truncate(30) }}
    </a>
    <span class="text-slate-300">/</span>
    <span class="text-slate-800 font-medium">{{ isEdit ? 'EDITAR RECORDATORIO' : 'NUEVO RECORDATORIO' }}</span>
</nav>

<div class="grid lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2">
        <div class="card">
            <div class="card-header">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary-100 flex items-center justify-center">
                        <i data-lucide="bell" class="w-5 h-5 text-primary-600"></i>
                    </div>
                    <div>
                        <h1 class="font-semibold text-slate-800">{{ isEdit ? 'Editar recordatorio' : 'Nuevo recordatorio' }}</h1>
                        <p class="text-sm text-slate-500">{{ isEdit ? 'Modifica los datos del recordatorio' : 'Programa un recordatorio personal para esta solicitud' }}</p>
                    </div>
                </div>
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'class': 'space-y-6', 'onsubmit': "if(typeof gtag==='function'){gtag('event','" ~ (isEdit ? 'edit_reminder' : 'create_reminder') ~ "')}"}}) }}
                    <div>
                        <label for="{{ form.deadlineAt.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1.5">
                            {{ form_label(form.deadlineAt) }}
                        </label>
                        {{ form_widget(form.deadlineAt, {'attr': {'class': 'input'}}) }}
                        {{ form_errors(form.deadlineAt) }}
                    </div>

                    <div>
                        <label for="{{ form.notifyTime.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1.5">
                            {{ form_label(form.notifyTime) }}
                        </label>
                        {{ form_widget(form.notifyTime, {'attr': {'class': 'input'}}) }}
                        <p class="text-xs text-slate-500 mt-1">{{ form_help(form.notifyTime) }}</p>
                        {{ form_errors(form.notifyTime) }}
                    </div>

                    <div>
                        <label for="{{ form.description.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1.5">
                            {{ form_label(form.description) }}
                        </label>
                        {{ form_widget(form.description, {'attr': {'class': 'input min-h-[100px]'}}) }}
                        {{ form_errors(form.description) }}
                    </div>

                    <div class="border-t border-slate-100 pt-6 flex flex-col sm:flex-row justify-between gap-4">
                        <a href="{{ path('app_solicitudes_show', {id: request.id}) }}" class="btn btn-secondary order-2 sm:order-1">
                            <i data-lucide="arrow-left" class="w-4 h-4 mr-2"></i>
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary order-1 sm:order-2">
                            <i data-lucide="check" class="w-4 h-4 mr-2"></i>
                            {{ isEdit ? 'Guardar cambios' : 'Crear recordatorio' }}
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <div class="lg:col-span-1">
        {# Info card #}
        <div class="card sticky top-24">
            <div class="card-header">
                <div class="flex items-center gap-2">
                    <i data-lucide="info" class="w-5 h-5 text-primary-500"></i>
                    <h2 class="font-semibold text-slate-800">Sobre los recordatorios</h2>
                </div>
            </div>
            <div class="card-body space-y-4 text-sm text-slate-600">
                <p>
                    Los recordatorios te permiten programar alertas personales para realizar seguimientos
                    informales antes de los plazos oficiales.
                </p>
                <div class="bg-blue-50 rounded-lg p-3 space-y-2">
                    <p class="font-medium text-blue-800">Recibirás dos notificaciones:</p>
                    <ul class="text-blue-700 text-xs space-y-1 ml-4 list-disc">
                        <li>El <strong>día anterior</strong> a la fecha programada</li>
                        <li>El <strong>mismo día</strong> de la fecha programada</li>
                    </ul>
                </div>
                <p>
                    Puedes elegir la hora de notificación. Si no especificas una hora, recibirás las alertas a las <strong>8:00 AM</strong>.
                </p>
                <div class="border-t border-slate-100 pt-4">
                    <h4 class="text-xs font-medium text-slate-500 mb-2">Solicitud</h4>
                    <p class="font-medium text-slate-800">{{ request.title }}</p>
                    <p class="text-slate-500">{{ request.publicBody.name }}</p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
