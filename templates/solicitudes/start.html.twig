{% extends 'layouts/app.html.twig' %}

{% block title %}Nueva solicitud - PideInfo{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .choice-card {
            display: flex;
            flex-direction: column;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 1.5rem;
            text-decoration: none;
            color: inherit;
            transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
            box-shadow: 0 1px 2px rgba(15,23,42,.04);
        }
        .choice-card:hover {
            border-color: #0284c7;
            box-shadow: 0 8px 24px -16px rgba(15,23,42,.18);
            transform: translateY(-1px);
        }
        .choice-card .choice-icon {
            width: 2.75rem; height: 2.75rem;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            margin-bottom: 1rem;
        }
        .choice-card.choice-register .choice-icon { background: #f1f5f9; color: #475569; }
        .choice-card.choice-submit   .choice-icon { background: #ecfeff; color: #0e7490; }

        /* When the register card is acting as a dropzone we tint the border
           and bg, and keep the link clickable for users who don't drag. */
        .choice-card.choice-register.dragover {
            border-color: #0284c7;
            background: rgba(186, 230, 253, .18);
            box-shadow: 0 8px 24px -16px rgba(2,132,199,.35);
        }
        .choice-register-dropzone-hint {
            margin-top: .55rem;
            font-size: .72rem;
            color: #64748b;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
        }
        .choice-register-dropzone-hint i { color: #0284c7; }
        .choice-card h3 {
            font-weight: 600;
            color: #0f172a;
            font-size: 1rem;
            margin-bottom: .35rem;
        }
        .choice-card p {
            font-size: .9rem;
            color: #475569;
            line-height: 1.45;
        }
        .choice-card .choice-cta {
            margin-top: auto;
            padding-top: 1rem;
            font-size: .85rem;
            font-weight: 600;
            color: #0284c7;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
        }
        .choice-card.choice-register .choice-cta { color: #475569; }
    </style>
{% endblock %}

{% block content %}
<nav class="flex items-center gap-2 text-xs text-slate-500 mb-3" style="font-family:'Inter',sans-serif;letter-spacing:.04em;">
    <a href="{{ path('app_solicitudes_index') }}" class="hover:text-slate-800 transition-colors">SOLICITUDES</a>
    <span class="text-slate-300">/</span>
    <span class="text-slate-800 font-medium">NUEVA SOLICITUD</span>
</nav>

<div class="max-w-4xl">
    <div class="mb-6">
        <h1 class="text-2xl font-semibold text-slate-800 mb-1">Nueva solicitud</h1>
        <p class="text-slate-500">Elige cómo quieres empezar.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
        <a href="{{ path('app_solicitudes_submit_form') }}" class="choice-card choice-submit">
            <div class="choice-icon"><i data-lucide="send" class="w-5 h-5"></i></div>
            <h3>Quiero redactarla con asistencia de IA y que PideInfo la envíe por mí</h3>
            <p>Redactas la solicitud y eliges a qué organismos enviarla. PideInfo se la entrega al Portal de Transparencia o al REG en tu nombre, usando tu certificado digital.</p>
            <span class="choice-cta">Realizar y enviar <i data-lucide="arrow-right" class="w-4 h-4"></i></span>
        </a>

        {# The register card doubles as a dropzone wired to the same
           file-uploader controller used on the home page. Click still
           navigates to /solicitudes/nueva/registrar; dropping a file kicks
           off the upload + orphan-link flow inline. #}
        <div data-controller="file-uploader"
             data-file-uploader-url-value="{{ path('app_document_upload') }}">
            <a href="{{ path('app_solicitudes_register') }}"
               class="choice-card choice-register"
               data-file-uploader-target="dropzone"
               data-action="dragover->file-uploader#dragOver dragenter->file-uploader#dragOver dragleave->file-uploader#dragLeave drop->file-uploader#drop">
                <div class="choice-icon"><i data-lucide="clipboard-list" class="w-5 h-5"></i></div>
                <h3>Ya la envié, sólo quiero registrarla</h3>
                <p>Anota una solicitud que ya presentaste por tu cuenta para hacerle seguimiento en PideInfo. Tú indicas el organismo, la fecha y, si la tienes, la referencia del expediente.</p>
                <span class="choice-register-dropzone-hint">
                    <i data-lucide="upload-cloud" class="w-3.5 h-3.5"></i>
                    O suelta aquí el acuse / PDF y la creamos por ti.
                </span>
                <span class="choice-cta">Registrar manualmente <i data-lucide="arrow-right" class="w-4 h-4"></i></span>
            </a>

            {# Live status / preview slots (rendered by file-uploader). #}
            <div data-file-uploader-target="status" class="mt-2"></div>
            <div data-file-uploader-target="preview" class="mt-2 space-y-1"></div>

            {# Same modals the home dropzone mounts so the post-upload flow
               (related-vs-separate, orphan link, keyword-match) keeps working. #}
            <div id="relatedDocsModal"
                 class="modal-backdrop hidden"
                 data-file-uploader-target="modal">
                <div class="modal-content max-w-md">
                    <div class="modal-header">
                        <h3 class="text-lg font-semibold text-slate-800">Documentos relacionados</h3>
                    </div>
                    <div class="modal-body">
                        <p class="text-slate-600 mb-4">Has subido varios documentos. Selecciona como quieres procesarlos:</p>
                        <div class="space-y-3">
                            <button type="button"
                                    class="w-full p-4 rounded-xl border-2 border-slate-200 hover:border-primary-500 hover:bg-primary-50 transition-all text-left group"
                                    data-action="click->file-uploader#processAsRelated">
                                <div class="flex items-start gap-3">
                                    <div class="w-10 h-10 rounded-lg bg-primary-100 flex items-center justify-center flex-shrink-0 group-hover:bg-primary-200 transition-colors">
                                        <i data-lucide="link" class="w-5 h-5 text-primary-600"></i>
                                    </div>
                                    <div>
                                        <p class="font-medium text-slate-800">Son documentos relacionados</p>
                                        <p class="text-sm text-slate-500 mt-1">Pertenecen a la misma solicitud</p>
                                    </div>
                                </div>
                            </button>
                            <button type="button"
                                    class="w-full p-4 rounded-xl border-2 border-slate-200 hover:border-slate-400 hover:bg-slate-50 transition-all text-left group"
                                    data-action="click->file-uploader#processAsSeparate">
                                <div class="flex items-start gap-3">
                                    <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center flex-shrink-0 group-hover:bg-slate-200 transition-colors">
                                        <i data-lucide="files" class="w-5 h-5 text-slate-600"></i>
                                    </div>
                                    <div>
                                        <p class="font-medium text-slate-800">Son documentos separados</p>
                                        <p class="text-sm text-slate-500 mt-1">Se analizarán de forma independiente</p>
                                    </div>
                                </div>
                            </button>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-action="click->file-uploader#closeModal">
                            Cancelar
                        </button>
                    </div>
                </div>
            </div>

            <div id="orphanLinkModal"
                 class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center"
                 data-file-uploader-target="orphanLinkModal">
                <div class="h-[80vh] w-[90vw] max-w-7xl mx-auto my-auto bg-white rounded-2xl shadow-2xl flex flex-col overflow-hidden">
                    <div class="flex items-center justify-between px-8 py-5 border-b border-slate-200">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center">
                                <i data-lucide="file-question" class="w-5 h-5 text-amber-600"></i>
                            </div>
                            <div>
                                <h2 class="text-lg font-semibold text-slate-800">Documento sin solicitud asociada</h2>
                                <p class="text-sm text-slate-500">
                                    <span id="orphanDocTitle"></span>
                                    <span id="orphanDocType" class="ml-2 text-xs badge badge-secondary"></span>
                                </p>
                            </div>
                        </div>
                        <button type="button"
                                class="btn btn-ghost btn-sm"
                                data-action="click->file-uploader#closeOrphanModal">
                            <i data-lucide="x" class="w-5 h-5"></i>
                        </button>
                    </div>
                    <div class="flex-1 flex overflow-hidden">
                        <div class="w-1/2 border-r border-slate-200 bg-slate-50">
                            <iframe id="orphanDocViewer" src="" class="w-full h-full border-0"></iframe>
                        </div>
                        <div class="w-1/2 flex flex-col overflow-hidden">
                            <div class="px-6 py-5 border-b border-slate-200">
                                <div class="relative flex items-center">
                                    <i data-lucide="search" class="w-4 h-4 absolute left-3 text-slate-400 pointer-events-none" style="z-index:1"></i>
                                    <input type="text"
                                           placeholder="Buscar solicitud..."
                                           id="orphanSearchInput"
                                           class="input input-icon-left w-full"
                                           data-action="input->file-uploader#searchOrphanRequests">
                                </div>
                            </div>
                            <div class="flex-1 overflow-y-auto px-6 py-5 space-y-8">
                                <div id="suggestedRequests"></div>
                                <div id="allRequests">
                                    <div class="text-center py-8">
                                        <div class="w-8 h-8 rounded-full bg-primary-100 flex items-center justify-center mx-auto mb-3">
                                            <i data-lucide="loader-2" class="w-4 h-4 text-primary-600 animate-spin"></i>
                                        </div>
                                        <p class="text-sm text-slate-500">Cargando solicitudes...</p>
                                    </div>
                                </div>
                            </div>
                            <div class="px-6 py-4 border-t border-slate-200 flex items-center justify-between gap-3 bg-slate-50">
                                <button type="button"
                                        class="btn btn-secondary"
                                        data-action="click->file-uploader#skipOrphanLink">
                                    Omitir
                                </button>
                                <button type="button"
                                        class="btn btn-primary"
                                        data-action="click->file-uploader#createRequestFromOrphan">
                                    <i data-lucide="plus" class="w-4 h-4 mr-2"></i>
                                    Añadir solicitud
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="keywordMatchModal"
                 class="modal-backdrop hidden"
                 data-file-uploader-target="keywordMatchModal">
                <div class="modal-content max-w-lg">
                    <div class="modal-header">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center">
                                <i data-lucide="alert-triangle" class="w-5 h-5 text-amber-600"></i>
                            </div>
                            <div>
                                <h3 class="text-lg font-semibold text-slate-800">Verificar asociaciones</h3>
                                <p class="text-sm text-slate-500">Documentos asociados automáticamente por palabras clave</p>
                            </div>
                        </div>
                    </div>
                    <div class="modal-body">
                        <p class="text-slate-600 mb-4">
                            Los siguientes documentos han sido asociados automáticamente a solicitudes existentes
                            basándose en palabras clave encontradas en el contenido. Por favor, verifica si las asociaciones son correctas.
                        </p>
                        <div id="keywordMatchList"
                             data-file-uploader-target="keywordMatchList"
                             class="space-y-3 max-h-80 overflow-y-auto">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-action="click->file-uploader#closeKeywordMatchModal">
                            Cerrar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Toast container for the file-uploader's live alerts. #}
    <div id="global-alerts-container" class="space-y-3 empty:hidden mt-4"></div>

    <p class="text-xs text-slate-400 mt-6">
        <i data-lucide="info" class="w-3.5 h-3.5 inline mr-1"></i>
        Para "Realizar y enviar" necesitas tener el agente local de PideInfo conectado, ya que es quien firma con tu certificado.
    </p>
</div>
{% endblock %}
