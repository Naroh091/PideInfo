{% extends 'layouts/app.html.twig' %}

{% block title %}Añadir solicitud - PideInfo{% endblock %}

{% block content %}
{# Breadcrumb #}
<nav class="flex items-center gap-2 text-sm mb-6">
    <a href="{{ path('app_solicitudes_index') }}" class="text-slate-500 hover:text-primary-600 transition-colors">
        Solicitudes
    </a>
    <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
    <span class="text-slate-800 font-medium">Añadir solicitud</span>
</nav>

<div class="grid lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2">
        <div class="card">
            <div class="card-header">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary-100 flex items-center justify-center">
                        <i data-lucide="file-plus" class="w-5 h-5 text-primary-600"></i>
                    </div>
                    <div>
                        <h1 class="font-semibold text-slate-800">Añadir solicitud de acceso a información</h1>
                        <p class="text-sm text-slate-500">Introduce los datos de tu solicitud</p>
                    </div>
                </div>
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                    <div>
                        <label for="{{ form.title.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1.5">
                            {{ form_label(form.title) }}
                        </label>
                        {{ form_widget(form.title, {'attr': {'class': 'input', 'placeholder': 'Ej: Solicitud de información sobre contratos de limpieza'}}) }}
                        {{ form_errors(form.title) }}
                    </div>

                    <div>
                        <label for="{{ form.description.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1.5">
                            {{ form_label(form.description) }}
                        </label>
                        {{ form_widget(form.description, {'attr': {'class': 'input min-h-[120px]', 'placeholder': 'Describe detalladamente la información que solicitas...'}}) }}
                        {{ form_errors(form.description) }}
                    </div>

                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label for="{{ form.publicBody.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1.5">
                                {{ form_label(form.publicBody) }}
                            </label>
                            {{ form_widget(form.publicBody) }}
                            {{ form_errors(form.publicBody) }}
                        </div>
                        <div>
                            <label for="{{ form.applicableLaw.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1.5">
                                {{ form_label(form.applicableLaw) }}
                            </label>
                            {{ form_widget(form.applicableLaw, {'attr': {'class': 'input'}}) }}
                            {{ form_errors(form.applicableLaw) }}
                        </div>
                    </div>

                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label for="{{ form.sentAt.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1.5">
                                {{ form_label(form.sentAt) }}
                            </label>
                            {{ form_widget(form.sentAt, {'attr': {'class': 'input'}}) }}
                            {{ form_errors(form.sentAt) }}
                        </div>
                        <div>
                            <label for="{{ form.externalId.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1.5">
                                {{ form_label(form.externalId) }}
                            </label>
                            {{ form_widget(form.externalId, {'attr': {'class': 'input', 'placeholder': 'Número de expediente (si lo tienes)'}}) }}
                            {% if form.externalId.vars.help %}
                                <p class="text-xs text-slate-400 mt-1">{{ form.externalId.vars.help }}</p>
                            {% endif %}
                            {{ form_errors(form.externalId) }}
                        </div>
                    </div>

                    <div class="border-t border-slate-100 pt-6 flex flex-col sm:flex-row justify-between gap-4">
                        <a href="{{ path('app_solicitudes_index') }}" class="btn btn-secondary order-2 sm:order-1">
                            <i data-lucide="arrow-left" class="w-4 h-4 mr-2"></i>
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary order-1 sm:order-2">
                            <i data-lucide="check" class="w-4 h-4 mr-2"></i>
                            Crear solicitud
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <div class="lg:col-span-1">
        <div class="card sticky top-24">
            <div class="card-header">
                <div class="flex items-center gap-2">
                    <i data-lucide="info" class="w-5 h-5 text-primary-500"></i>
                    <h2 class="font-semibold text-slate-800">Información</h2>
                </div>
            </div>
            <div class="card-body space-y-4">
                <div class="flex items-start gap-3">
                    <div class="w-8 h-8 rounded-lg bg-primary-100 flex items-center justify-center flex-shrink-0">
                        <i data-lucide="calendar" class="w-4 h-4 text-primary-600"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-slate-800">Cálculo automático</p>
                        <p class="text-xs text-slate-500">El sistema calculará el plazo de respuesta según la ley aplicable.</p>
                    </div>
                </div>

                <div class="flex items-start gap-3">
                    <div class="w-8 h-8 rounded-lg bg-primary-100 flex items-center justify-center flex-shrink-0">
                        <i data-lucide="upload" class="w-4 h-4 text-primary-600"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-slate-800">Documentos</p>
                        <p class="text-xs text-slate-500">Podrás subir documentos relacionados después de crear la solicitud.</p>
                    </div>
                </div>

                <div class="flex items-start gap-3">
                    <div class="w-8 h-8 rounded-lg bg-primary-100 flex items-center justify-center flex-shrink-0">
                        <i data-lucide="bell" class="w-4 h-4 text-primary-600"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-slate-800">Notificaciones</p>
                        <p class="text-xs text-slate-500">Recibirás alertas cuando se acerque el vencimiento del plazo.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
