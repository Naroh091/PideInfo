                            </a>
                        </div>
                    </article>
                {% endif %}
            </div>
        </section>
        {% include '_partials/_agent_present_modal.html.twig' %}

        {# ── Documentos ── #}
        {% set pendingDocs = 0 %}
        {% for doc in request.documents %}
            {% if not doc.processed %}{% set pendingDocs = pendingDocs + 1 %}{% endif %}
        {% endfor %}
