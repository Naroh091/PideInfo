                                {% if doc.aiMetadata.keyPoints is defined and doc.aiMetadata.keyPoints %}
                                    <p class="pieza-intro">Fundamentos principales de la resolución:</p>
                                    <ol class="exp-puntos exp-puntos--{{ resolutionTone }}">
                                        {% for point in doc.aiMetadata.keyPoints %}
