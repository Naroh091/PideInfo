{% extends 'layouts/app.html.twig' %}

{% block title %}{{ request.title }} - PideInfo{% endblock %}

{% block content %}
{# Breadcrumb #}
<nav class="flex items-center gap-2 text-sm mb-6">
    <a href="{{ path('app_solicitudes_index') }}" class="text-slate-500 hover:text-primary-600 transition-colors">
        Solicitudes
    </a>
    <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
    <span class="text-slate-800 font-medium truncate max-w-xs">{{ request.title|u.truncate(30) }}</span>
</nav>

{# Header #}
<div class="flex flex-col sm:flex-row justify-between items-start gap-4 mb-8">
    <div class="min-w-0">
        <h1 class="text-2xl font-bold text-slate-800">{{ request.title }}</h1>
        <div class="flex flex-wrap items-center gap-3 mt-2 text-sm text-slate-500">
            <span class="flex items-center gap-1">
                <i data-lucide="building" class="w-4 h-4"></i>
                {{ request.publicBody.name }}
            </span>
            {% if request.externalId %}
                <button type="button"
                        class="flex items-center gap-1 text-primary-600 hover:text-primary-800 cursor-pointer transition-colors"
                        onclick="navigator.clipboard.writeText('{{ request.externalId|e('js') }}'); this.querySelector('.copy-ok').classList.remove('hidden'); setTimeout(() => this.querySelector('.copy-ok').classList.add('hidden'), 1500)"
                        title="Copiar nº expediente">
                    <i data-lucide="hash" class="w-4 h-4"></i>
                    <span>{{ request.externalId }}</span>
                    <i data-lucide="check" class="w-3 h-3 text-emerald-500 copy-ok hidden"></i>
                </button>
            {% endif %}
            {% if request.complaint and request.complaint.externalId %}
                <button type="button"
                        class="flex items-center gap-1 text-amber-600 hover:text-amber-800 cursor-pointer transition-colors"
                        onclick="navigator.clipboard.writeText('{{ request.complaint.externalId|e('js') }}'); this.querySelector('.copy-ok').classList.remove('hidden'); setTimeout(() => this.querySelector('.copy-ok').classList.add('hidden'), 1500)"
                        title="Copiar nº expediente reclamación">
                    <i data-lucide="scale" class="w-4 h-4"></i>
                    <span>Recl: {{ request.complaint.externalId }}</span>
                    <i data-lucide="check" class="w-3 h-3 text-emerald-500 copy-ok hidden"></i>
                </button>
            {% endif %}
        </div>
    </div>
    <a href="{{ path('app_solicitudes_edit', {id: request.id}) }}" class="btn btn-secondary flex-shrink-0">
        <i data-lucide="pencil" class="w-4 h-4 mr-2"></i>
        Editar
    </a>
</div>

{# Redirection notice #}
{% if request.wasRedirected %}
    <div class="alert alert-info mb-6">
        <i data-lucide="arrow-right-circle" class="w-5 h-5 flex-shrink-0"></i>
        <div class="flex-1">
            <p class="font-medium">Solicitud trasladada</p>
            <p class="text-sm mt-1">
                Esta solicitud fue trasladada de <strong>{{ request.originalPublicBody.name }}</strong>
                a <strong>{{ request.publicBody.name }}</strong>
                {% if request.redirectedAt %}el {{ request.redirectedAt|date('d/m/Y') }}{% endif %}
                (art. 19.1 Ley 19/2013).
            </p>
        </div>
    </div>
{% endif %}

{# Third party allegations notice #}
{% if request.isDeadlineSuspended %}
    <div class="alert alert-warning mb-6">
        <i data-lucide="pause-circle" class="w-5 h-5 flex-shrink-0"></i>
        <div class="flex-1">
            <p class="font-medium">Plazo suspendido</p>
            <p class="text-sm mt-1">
                El plazo está suspendido por afectación a derechos de terceros.
                {% if request.thirdPartyAllegationsDeadlineAt %}
                    Plazo de alegaciones hasta el {{ request.thirdPartyAllegationsDeadlineAt|date('d/m/Y') }}.
                {% endif %}
                Quedan {{ request.suspendedDaysRemaining }} días hábiles cuando se reanude.
            </p>
        </div>
    </div>
{% endif %}

<div class="grid lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
        {# Main Info #}
        <div class="card">
            <div class="card-header">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary-100 flex items-center justify-center">
                        <i data-lucide="file-text" class="w-5 h-5 text-primary-600"></i>
                    </div>
                    <h2 class="font-semibold text-slate-800">Información de la solicitud</h2>
                </div>
            </div>
            <div class="card-body">
                <h3 class="text-sm font-medium text-slate-700 mb-2">Descripción</h3>
                <div class="text-slate-600 prose prose-sm prose-slate max-w-none">{{ request.description|markdown_to_html }}</div>

                <div class="border-t border-slate-100 mt-6 pt-6 grid sm:grid-cols-2 gap-6">
                    <div>
                        <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">Ley aplicable</h4>
                        <p class="text-slate-800">{{ request.applicableLaw.name }}</p>
                    </div>
                    <div>
                        <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">Fecha de envío</h4>
                        <p class="text-slate-800">{{ request.sentAt|date('d/m/Y') }}</p>
                    </div>
                </div>
            </div>
        </div>

        {# Alegation Points Card #}
        {% set alegacionesDoc = null %}
        {% for doc in request.documents %}
            {% if doc.type.value == 'alegaciones' and doc.aiMetadata.alegationPoints is defined and doc.aiMetadata.alegationPoints %}
                {% set alegacionesDoc = doc %}
            {% endif %}
        {% endfor %}
        {% if alegacionesDoc %}
            <div class="card border-l-4 border-red-400">
                <div class="card-header">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-red-100 flex items-center justify-center">
                            <i data-lucide="shield-alert" class="w-5 h-5 text-red-600"></i>
                        </div>
                        <h2 class="font-semibold text-slate-800">Alegaciones de la administración</h2>
                    </div>
                </div>
                <div class="card-body">
                    <p class="text-sm text-slate-500 mb-4">Argumentos principales presentados por la Administración en su defensa:</p>
                    <ol class="space-y-3">
                        {% for point in alegacionesDoc.aiMetadata.alegationPoints %}
                            <li class="flex items-start gap-3">
                                <span class="flex-shrink-0 w-6 h-6 rounded-full bg-red-100 text-red-700 text-xs font-bold flex items-center justify-center mt-0.5">{{ loop.index }}</span>
                                <span class="text-slate-700">{{ point }}</span>
                            </li>
                        {% endfor %}
                    </ol>
                </div>
            </div>
        {% endif %}

        {# Documents #}
        <div class="card"
             data-controller="file-uploader"
             data-file-uploader-url-value="{{ path('app_document_upload') }}"
             data-file-uploader-access-request-id-value="{{ request.id }}"
             data-file-uploader-documents-fragment-url-value="{{ path('app_solicitudes_documents_fragment', {id: request.id}) }}">
            <div class="card-header">
                <div class="flex items-center justify-between w-full">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-primary-100 flex items-center justify-center">
                            <i data-lucide="paperclip" class="w-5 h-5 text-primary-600"></i>
                        </div>
                        <h2 class="font-semibold text-slate-800">Documentos</h2>
                    </div>
                    {% if request.documents|length > 0 %}
                        <a href="{{ path('app_document_download_all', {id: request.id}) }}"
                           class="btn btn-secondary btn-sm">
                            <i data-lucide="archive" class="w-4 h-4 mr-1"></i>
                            Descargar todo
                        </a>
                    {% endif %}
                </div>
            </div>
            <div class="card-body">
                <div data-file-uploader-target="status"></div>

                {# Dropzone Area #}
                <div class="dropzone-area border-2 border-dashed border-slate-300 rounded-xl p-6 text-center mb-4 cursor-pointer transition-all hover:border-primary-400 hover:bg-primary-50/50"
                     data-file-uploader-target="dropzone"
                     data-action="dragover->file-uploader#dragOver dragleave->file-uploader#dragLeave drop->file-uploader#drop click->file-uploader#clickToUpload">
                    <div class="dropzone-content">
                        <div class="w-12 h-12 rounded-full bg-primary-100 flex items-center justify-center mx-auto mb-3">
                            <i data-lucide="cloud-upload" class="w-6 h-6 text-primary-600"></i>
                        </div>
                        <p class="text-slate-700 font-medium mb-1">Arrastra archivos aquí</p>
                        <p class="text-sm text-slate-500 mb-3">o haz clic para seleccionar</p>
                        <span class="btn btn-primary btn-sm">
                            <i data-lucide="folder-open" class="w-4 h-4 mr-2"></i>
                            Seleccionar archivos
                        </span>
                        <input type="file" class="hidden" multiple
                               accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.gif,.zip"
                               data-file-uploader-target="input"
                               data-action="change->file-uploader#selectFiles">
                        <p class="text-xs text-slate-400 mt-3">PDF, Word, imágenes o ZIP (máx. 50MB)</p>
                    </div>
                </div>

                {# Document List #}
                <div id="documents-list" data-documents-url="{{ path('app_solicitudes_documents_fragment', {id: request.id}) }}">
                    {% include 'solicitudes/_documents_list.html.twig' %}
                </div>

                <div data-file-uploader-target="preview" class="mt-4 space-y-2"></div>

                <div class="mt-3 text-right">
                    <button type="button"
                            class="text-xs text-slate-400 hover:text-primary-600 cursor-pointer transition-colors inline-flex items-center gap-1"
                            onclick="document.getElementById('importOrphanModal').classList.remove('hidden')">
                        <i data-lucide="link" class="w-3 h-3"></i>
                        Importar documento sin asignar
                    </button>
                </div>
            </div>
        </div>

        <style>
            .dropzone-area.dragover {
                border-color: rgb(var(--color-primary-500)) !important;
                background-color: rgb(var(--color-primary-50)) !important;
            }
            .dropzone-area.dragover .dropzone-content {
                opacity: 0.7;
            }
        </style>

        {# Timeline #}
        <div class="card">
            <div class="card-header">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary-100 flex items-center justify-center">
                        <i data-lucide="history" class="w-5 h-5 text-primary-600"></i>
                    </div>
                    <h2 class="font-semibold text-slate-800">Historial</h2>
                </div>
            </div>
            <div class="card-body">
                {% if request.statusHistory|length > 0 %}
                    <div class="space-y-4">
                        {% for history in request.statusHistory %}
                            {# --- Determine event title, icon, and color from context --- #}
                            {% set notes = history.notes|default('') %}
                            {% set notesLower = notes|lower %}
                            {% set sType = history.statusType %}
                            {% set to = history.toStatus %}
                            {% set from = history.fromStatus %}

                            {# Detect special events from notes content #}
                            {% set isCreation = from == '' %}
                            {% set isRedirection = 'trasladada' in notesLower %}
                            {% set isThirdParty = 'terceros' in notesLower %}
                            {% set isProcessingStart = 'inicio de tramitación' in notesLower and sType == 'status' %}
                            {% set isExtension = 'prórroga' in notesLower %}
                            {% set isSubsanacion = 'subsanación' in notesLower %}
                            {% set isAudiencia = 'audiencia' in notesLower %}
                            {% set isAmpliacion = 'ampliación' in notesLower %}

                            {# Default #}
                            {% set dotColor = 'bg-slate-400' %}
                            {% set icon = 'circle' %}
                            {% set title = notes %}
                            {% set titleColor = 'text-slate-800' %}

                            {% if isCreation %}
                                {% set dotColor = 'bg-primary-500' %}
                                {% set icon = 'file-plus' %}
                                {% set title = 'Solicitud creada' %}
                                {% set titleColor = 'text-primary-700' %}
                            {% elseif isRedirection %}
                                {% set dotColor = 'bg-blue-500' %}
                                {% set icon = 'arrow-right-circle' %}
                                {% set title = 'Solicitud trasladada' %}
                                {% set titleColor = 'text-blue-700' %}
                            {% elseif isThirdParty %}
                                {% set dotColor = 'bg-amber-500' %}
                                {% set icon = 'users' %}
                                {% set title = 'Afectación a derechos de terceros' %}
                                {% set titleColor = 'text-amber-700' %}
                            {% elseif isProcessingStart %}
                                {% set dotColor = 'bg-green-500' %}
                                {% set icon = 'play-circle' %}
                                {% set title = 'Inicio de tramitación' %}
                                {% set titleColor = 'text-green-700' %}
                            {% elseif isExtension %}
                                {% set dotColor = 'bg-orange-500' %}
                                {% set icon = 'clock' %}
                                {% set title = 'Prórroga del plazo' %}
                                {% set titleColor = 'text-orange-700' %}
                            {% elseif sType == 'complaint' %}
                                {# Complaint lifecycle events #}
                                {% if to == 'reclaimed' %}
                                    {% set dotColor = 'bg-amber-500' %}
                                    {% set icon = 'scale' %}
                                    {% if isSubsanacion %}
                                        {% set title = 'Subsanación' %}
                                    {% elseif isAudiencia %}
                                        {% set title = 'Trámite de audiencia' %}
                                    {% elseif isAmpliacion %}
                                        {% set title = 'Ampliación de reclamación' %}
                                    {% elseif 'alegaciones' in notesLower %}
                                        {% set title = 'Alegaciones de la Administración' %}
                                    {% elseif 'acuse de recibo' in notesLower %}
                                        {% set title = 'Acuse de recibo de reclamación' %}
                                    {% elseif 'inicio' in notesLower %}
                                        {% set title = 'Inicio de tramitación de reclamación' %}
                                    {% else %}
                                        {% set title = 'Reclamación presentada' %}
                                    {% endif %}
                                    {% set titleColor = 'text-amber-700' %}
                                {% elseif to == 'complaint_granted' %}
                                    {% set dotColor = 'bg-emerald-500' %}
                                    {% set icon = 'check-circle' %}
                                    {% set title = 'Reclamación estimada' %}
                                    {% set titleColor = 'text-emerald-700' %}
                                {% elseif to == 'complaint_denied' %}
                                    {% set dotColor = 'bg-red-500' %}
                                    {% set icon = 'x-circle' %}
                                    {% set title = 'Reclamación desestimada' %}
                                    {% set titleColor = 'text-red-700' %}
                                {% elseif to == 'complaint_archived' %}
                                    {% set dotColor = 'bg-slate-500' %}
                                    {% set icon = 'archive' %}
                                    {% set title = 'Reclamación archivada' %}
                                    {% set titleColor = 'text-slate-700' %}
                                {% else %}
                                    {% set dotColor = 'bg-amber-500' %}
                                    {% set icon = 'scale' %}
                                    {% set title = 'Reclamación' %}
                                    {% set titleColor = 'text-amber-700' %}
                                {% endif %}
                            {% elseif sType == 'courtStatus' %}
                                {% set dotColor = 'bg-purple-500' %}
                                {% set icon = 'gavel' %}
                                {% set titleColor = 'text-purple-700' %}
                                {% if to == 'in_court' %}
                                    {% set title = 'Recurso judicial interpuesto' %}
                                {% elseif to == 'court_granted' %}
                                    {% set dotColor = 'bg-emerald-500' %}
                                    {% set icon = 'check-circle' %}
                                    {% set title = 'Sentencia favorable' %}
                                    {% set titleColor = 'text-emerald-700' %}
                                {% elseif to == 'court_denied' %}
                                    {% set dotColor = 'bg-red-500' %}
                                    {% set icon = 'x-circle' %}
                                    {% set title = 'Sentencia desfavorable' %}
                                    {% set titleColor = 'text-red-700' %}
                                {% else %}
                                    {% set title = 'Vía judicial' %}
                                {% endif %}
                            {% elseif sType == 'status' %}
                                {# Primary status changes #}
                                {% if to == 'granted' %}
                                    {% set dotColor = 'bg-emerald-500' %}
                                    {% set icon = 'check-circle' %}
                                    {% set title = 'Solicitud concedida' %}
                                    {% set titleColor = 'text-emerald-700' %}
                                {% elseif to == 'denied' %}
                                    {% set dotColor = 'bg-red-500' %}
                                    {% set icon = 'x-circle' %}
                                    {% set title = 'Solicitud denegada' %}
                                    {% set titleColor = 'text-red-700' %}
                                {% elseif to == 'delayed' %}
                                    {% set dotColor = 'bg-amber-500' %}
                                    {% set icon = 'clock' %}
                                    {% set title = 'Silencio administrativo' %}
                                    {% set titleColor = 'text-amber-700' %}
                                {% elseif to == 'processing' %}
                                    {% set dotColor = 'bg-blue-500' %}
                                    {% set icon = 'loader' %}
                                    {% set title = 'Solicitud en trámite' %}
                                    {% set titleColor = 'text-blue-700' %}
                                {% elseif to == 'sent' %}
                                    {% set dotColor = 'bg-primary-500' %}
                                    {% set icon = 'send' %}
                                    {% set title = 'Solicitud enviada' %}
                                    {% set titleColor = 'text-primary-700' %}
                                {% else %}
                                    {% set dotColor = 'bg-slate-400' %}
                                    {% set icon = 'circle' %}
                                    {% set title = history.toStatusLabel %}
                                {% endif %}
                            {% endif %}

                            <div class="flex gap-4 pb-4 {{ not loop.last ? 'border-b border-slate-100' : '' }}">
                                <div class="w-8 h-8 rounded-full {{ dotColor }} flex items-center justify-center flex-shrink-0">
                                    <i data-lucide="{{ icon }}" class="w-4 h-4 text-white"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                                        <span class="font-medium {{ titleColor }}">{{ title }}</span>
                                        <span class="text-sm text-slate-500 flex-shrink-0">{{ history.createdAt|date('d/m/Y H:i') }}</span>
                                    </div>
                                    {% if notes and notes != title %}
                                        <p class="text-sm text-slate-600 mt-2">{{ notes }}</p>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-slate-500 text-center py-4">Sin cambios de estado registrados</p>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="lg:col-span-1 space-y-6">
        {# Status Card #}
        <div class="card">
            <div class="card-header">
                <h2 class="font-semibold text-slate-800">Estado actual</h2>
            </div>
            <div class="card-body space-y-4">
                {# Main Status #}
                <div>
                    <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Estado principal</h4>
                    <form action="{{ path('app_solicitudes_change_status', {id: request.id}) }}" method="post" class="status-change-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('change-status-' ~ request.id) }}">
                        <input type="hidden" name="statusType" value="status">
                        <select name="newStatus"
                                class="form-select text-sm w-full"
                                onchange="this.form.submit()">
                            <option value="pending" {{ request.status == 'pending' ? 'selected' : '' }}>Pendiente de recepción</option>
                            <option value="sent" {{ request.status == 'sent' ? 'selected' : '' }}>Enviada</option>
                            <option value="processing" {{ request.status == 'processing' ? 'selected' : '' }}>En trámite</option>
                            <option value="granted" {{ request.status == 'granted' ? 'selected' : '' }}>Concedida</option>
                            <option value="denied" {{ request.status == 'denied' ? 'selected' : '' }}>Denegada</option>
                            <option value="delayed" {{ request.status == 'delayed' ? 'selected' : '' }}>Silencio administrativo</option>
                        </select>
                    </form>
                </div>

                {% if request.isDeadlineSuspended %}
                    <div>
                        <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Plazo</h4>
                        <span class="badge badge-warning text-sm px-3 py-1">Plazo suspendido</span>
                        <p class="text-sm text-slate-600 mt-2">
                            El plazo está suspendido por afectación a derechos de terceros.
                            {% if request.thirdPartyAllegationsDeadlineAt %}
                                Plazo de alegaciones hasta el {{ request.thirdPartyAllegationsDeadlineAt|date('d/m/Y') }}.
                            {% endif %}
                            Quedan {{ request.suspendedDaysRemaining }} días hábiles cuando se reanude.
                        </p>
                    </div>
                {% endif %}

                {# Complaint Status #}
                <div>
                    <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Reclamación</h4>
                    <form action="{{ path('app_solicitudes_change_status', {id: request.id}) }}" method="post" class="status-change-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('change-status-' ~ request.id) }}">
                        <input type="hidden" name="statusType" value="complaint">
                        {% set cStatus = request.complaint ? request.complaint.status : 'none' %}
                        <select name="newStatus"
                                class="form-select text-sm w-full"
                                onchange="this.form.submit()">
                            <option value="none" {{ cStatus == 'none' ? 'selected' : '' }}>Sin reclamación</option>
                            <option value="reclaimed" {{ cStatus == 'reclaimed' ? 'selected' : '' }}>Reclamada</option>
                            <option value="complaint_granted" {{ cStatus == 'complaint_granted' ? 'selected' : '' }}>Reclamación estimada</option>
                            <option value="complaint_denied" {{ cStatus == 'complaint_denied' ? 'selected' : '' }}>Reclamación desestimada</option>
                            <option value="complaint_archived" {{ cStatus == 'complaint_archived' ? 'selected' : '' }}>Reclamación archivada</option>
                        </select>
                    </form>
                    {% if request.complaint and request.applicableLaw.complaintOrganism %}
                        <p class="text-sm text-slate-600 mt-2">
                            Ante: <a href="{{ request.applicableLaw.complaintOrganism.url }}" target="_blank" class="text-primary-600 hover:underline">
                                {{ request.applicableLaw.complaintOrganism.shortName ?? request.applicableLaw.complaintOrganism.name }}
                            </a>
                        </p>
                    {% endif %}
                </div>

                {# Court Status #}
                <div>
                    <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Vía judicial</h4>
                    <form action="{{ path('app_solicitudes_change_status', {id: request.id}) }}" method="post" class="status-change-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('change-status-' ~ request.id) }}">
                        <input type="hidden" name="statusType" value="courtStatus">
                        <select name="newStatus"
                                class="form-select text-sm w-full"
                                onchange="this.form.submit()">
                            <option value="none" {{ request.courtStatus == 'none' ? 'selected' : '' }}>Sin recurso judicial</option>
                            <option value="in_court" {{ request.courtStatus == 'in_court' ? 'selected' : '' }}>En vía judicial</option>
                            <option value="court_granted" {{ request.courtStatus == 'court_granted' ? 'selected' : '' }}>Sentencia favorable</option>
                            <option value="court_denied" {{ request.courtStatus == 'court_denied' ? 'selected' : '' }}>Sentencia desfavorable</option>
                        </select>
                    </form>
                </div>
            </div>
        </div>

        {# Deadlines Card #}
        <div class="card">
            <div class="card-header">
                <h2 class="font-semibold text-slate-800">Plazos</h2>
            </div>
            <div class="card-body space-y-4">
                <div>
                    <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Plazo de respuesta</h4>
                    {% if request.status in ['granted', 'denied'] %}
                        <div class="flex items-center gap-2">
                            <span class="font-semibold text-slate-400">{{ request.deadlineAt|date('d/m/Y') }}</span>
                            <span class="badge badge-success">Resuelta</span>
                        </div>
                    {% elseif request.isDeadlineSuspended %}
                        <div class="flex items-center gap-2">
                            <span class="badge badge-warning font-bold">PLAZO SUSPENDIDO</span>
                        </div>
                        <p class="text-sm text-slate-500 mt-2">
                            {% if request.thirdPartyAllegationsDeadlineAt %}
                                Alegaciones hasta {{ request.thirdPartyAllegationsDeadlineAt|date('d/m/Y') }}
                            {% endif %}
                        </p>
                    {% else %}
                        <div class="flex items-center gap-2">
                            <span class="font-semibold {{ request.isDeadlinePassed ? 'text-red-600' : 'text-slate-800' }}">
                                {{ request.deadlineAt|date('d/m/Y') }}
                            </span>
                            {% if request.isDeadlinePassed %}
                                <span class="badge badge-danger">Vencido</span>
                            {% else %}
                                <span class="text-sm text-slate-500">({{ request.daysUntilDeadline }} días)</span>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>

                {% if request.extensionCount > 0 %}
                    <div>
                        <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Prórroga</h4>
                        <span class="badge badge-info">{{ request.extensionCount }} aplicada(s)</span>
                    </div>
                {% endif %}

                {% if request.complaint and request.complaint.deadlineAt %}
                    <div>
                        <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Plazo resolución reclamación</h4>
                        {% set complaintPassed = date() > request.complaint.deadlineAt %}
                        <div class="flex items-center gap-2">
                            <span class="font-semibold {{ complaintPassed ? 'text-red-600' : 'text-slate-800' }}">
                                {{ request.complaint.deadlineAt|date('d/m/Y') }}
                            </span>
                            {% if complaintPassed %}
                                <span class="badge badge-danger">Vencido</span>
                            {% endif %}
                        </div>
                        {% if request.applicableLaw.complaintOrganism %}
                            <p class="text-xs text-slate-500 mt-1">
                                {{ request.applicableLaw.complaintOrganism.shortName ?? request.applicableLaw.complaintOrganism.name }} tiene 3 meses para resolver
                            </p>
                        {% endif %}
                    </div>
                {% endif %}

                {% if request.complaint and request.complaint.complianceDeadlineAt %}
                    <div>
                        <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Plazo de cumplimiento</h4>
                        <span class="font-semibold text-slate-800">{{ request.complaint.complianceDeadlineAt|date('d/m/Y') }}</span>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Virtual email hint #}
        {% if app.user.virtualEmail %}
        <div class="p-4 rounded-xl bg-violet-50 border border-violet-100" data-controller="clipboard">
            <div class="flex items-start gap-3">
                <i data-lucide="mail" class="w-5 h-5 text-violet-500 flex-shrink-0 mt-0.5"></i>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-violet-800">Email virtual</p>
                    <p class="text-xs text-violet-600 mt-1">Reenvía los correos de esta administración a:</p>
                    <div class="flex items-center gap-2 mt-2">
                        <code class="flex-1 text-xs bg-white/70 px-2 py-1.5 rounded text-violet-800 truncate"
                              data-clipboard-target="source">{{ app.user.virtualEmail }}</code>
                        <button type="button"
                                class="text-violet-600 hover:text-violet-800 p-1 flex-shrink-0"
                                data-action="click->clipboard#copy"
                                data-clipboard-target="button"
                                title="Copiar">
                            <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}

        {# Custom Deadlines Card #}
        <div class="card">
            <div class="card-header">
                <div class="flex items-center justify-between">
                    <h2 class="font-semibold text-slate-800">Recordatorios</h2>
                    <a href="{{ path('app_solicitudes_deadline_new', {id: request.id}) }}" class="btn btn-primary btn-sm">
                        <i data-lucide="plus" class="w-4 h-4 mr-1"></i>
                        Nuevo
                    </a>
                </div>
            </div>
            <div class="card-body">
                {% if request.customDeadlines|length > 0 %}
                    <div class="space-y-3">
                        {% for deadline in request.customDeadlines %}
                            <div class="p-3 rounded-lg bg-slate-50 {{ deadline.isPassed ? 'border-l-4 border-red-400' : '' }}">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="font-medium text-slate-800 text-sm">{{ deadline.deadlineAt|date('d/m/Y') }}</span>
                                            {% if deadline.notifyTime %}
                                                <span class="text-xs text-slate-500">{{ deadline.notifyTime|date('H:i') }}</span>
                                            {% endif %}
                                            {% if deadline.isPassed %}
                                                <span class="badge badge-danger text-xs">Vencido</span>
                                            {% elseif deadline.daysUntil <= 3 %}
                                                <span class="badge badge-warning text-xs">{{ deadline.daysUntil }} días</span>
                                            {% else %}
                                                <span class="badge badge-info text-xs">{{ deadline.daysUntil }} días</span>
                                            {% endif %}
                                        </div>
                                        <p class="text-sm text-slate-600 line-clamp-2">{{ deadline.description }}</p>
                                        <div class="flex items-center gap-2 mt-1">
                                            {% if deadline.notifiedDayBeforeAt %}
                                                <span class="text-xs text-green-600" title="Notificado día anterior: {{ deadline.notifiedDayBeforeAt|date('d/m/Y H:i') }}">
                                                    <i data-lucide="mail-check" class="w-3 h-3 inline"></i> día anterior
                                                </span>
                                            {% endif %}
                                            {% if deadline.notifiedAt %}
                                                <span class="text-xs text-green-600" title="Notificado mismo día: {{ deadline.notifiedAt|date('d/m/Y H:i') }}">
                                                    <i data-lucide="mail-check" class="w-3 h-3 inline"></i> mismo día
                                                </span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <a href="{{ path('app_solicitudes_deadline_edit', {id: request.id, deadlineId: deadline.id}) }}"
                                           class="btn btn-ghost btn-sm p-1"
                                           title="Editar">
                                            <i data-lucide="pencil" class="w-4 h-4"></i>
                                        </a>
                                        <form action="{{ path('app_solicitudes_deadline_delete', {id: request.id, deadlineId: deadline.id}) }}"
                                              method="post"
                                              class="inline"
                                              onsubmit="return confirm('¿Eliminar este recordatorio?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete-deadline-' ~ deadline.id) }}">
                                            <button type="submit" class="btn btn-ghost btn-sm p-1 text-red-600 hover:text-red-700" title="Eliminar">
                                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center py-4">
                        <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-3">
                            <i data-lucide="bell-off" class="w-6 h-6 text-slate-400"></i>
                        </div>
                        <p class="text-sm text-slate-500">Sin recordatorios programados</p>
                        <p class="text-xs text-slate-400 mt-1">Crea recordatorios para seguimientos informales</p>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Lists Card #}
        <div class="card" x-data="listsManager('{{ request.id }}')">
            <div class="card-header">
                <h2 class="font-semibold text-slate-800">Listas</h2>
            </div>
            <div class="card-body">
                <template x-if="loading">
                    <div class="text-center py-4">
                        <i data-lucide="loader-2" class="w-5 h-5 text-slate-400 animate-spin mx-auto"></i>
                    </div>
                </template>
                <template x-if="!loading">
                    <div>
                        {# Current list memberships #}
                        <template x-if="lists.filter(l => l.inList).length > 0">
                            <div class="space-y-2 mb-3">
                                <template x-for="list in lists.filter(l => l.inList)" :key="list.id">
                                    <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50">
                                        <a :href="'/listas/' + list.id" class="flex items-center gap-2 min-w-0 text-sm font-medium text-slate-800 hover:text-primary-600 transition-colors">
                                            <span class="w-3 h-3 rounded-full flex-shrink-0"
                                                  :style="'background-color: ' + (list.color || '#94a3b8')"></span>
                                            <span class="truncate" x-text="list.name"></span>
                                        </a>
                                        <template x-if="list.canEdit">
                                            <button @click="toggleList(list)"
                                                    class="text-slate-400 hover:text-red-600 p-1 transition-colors"
                                                    title="Quitar de la lista"
                                                    :disabled="toggling">
                                                <i data-lucide="x" class="w-3 h-3"></i>
                                            </button>
                                        </template>
                                    </div>
                                </template>
                            </div>
                        </template>

                        {# Add to list dropdown #}
                        <div class="relative">
                            <button @click="dropdownOpen = !dropdownOpen"
                                    class="btn btn-secondary btn-sm w-full">
                                <i data-lucide="plus" class="w-3 h-3 mr-1"></i>
                                Añadir a lista
                            </button>
                            <div x-show="dropdownOpen"
                                 @click.away="dropdownOpen = false"
                                 x-transition
                                 class="absolute left-0 right-0 mt-1 bg-white rounded-lg shadow-lg border border-slate-200 py-1 z-10 max-h-48 overflow-y-auto"
                                 style="display: none;">
                                <template x-for="list in lists.filter(l => !l.inList && l.canEdit)" :key="list.id">
                                    <button @click="toggleList(list)"
                                            class="w-full text-left px-3 py-2 text-sm text-slate-700 hover:bg-slate-50 flex items-center gap-2"
                                            :disabled="toggling">
                                        <span class="w-3 h-3 rounded-full flex-shrink-0"
                                              :style="'background-color: ' + (list.color || '#94a3b8')"></span>
                                        <span x-text="list.name" class="truncate"></span>
                                    </button>
                                </template>
                                <template x-if="lists.filter(l => !l.inList && l.canEdit).length === 0">
                                    <p class="px-3 py-2 text-xs text-slate-500">No hay más listas disponibles</p>
                                </template>
                                <div class="border-t border-slate-100 mt-1 pt-1">
                                    <a href="{{ path('app_listas_new') }}"
                                       class="block px-3 py-2 text-sm text-primary-600 hover:bg-primary-50 flex items-center gap-2">
                                        <i data-lucide="plus" class="w-3 h-3"></i>
                                        Crear nueva lista
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </template>
            </div>
        </div>

        {# Actions Card #}
        <div class="card">
            <div class="card-header">
                <h2 class="font-semibold text-slate-800">Acciones</h2>
            </div>
            <div class="card-body space-y-3">
                {% set canComplain = (request.status in ['denied', 'delayed']) or (request.isDeadlinePassed and request.status not in ['granted']) %}
                {% if canComplain and not request.complaint %}
                    <a href="{{ path('app_complaint_generate', {id: request.id, mode: 'complaint'}) }}" class="btn btn-accent w-full">
                        <i data-lucide="alert-triangle" class="w-4 h-4 mr-2"></i>
                        Generar reclamación
                    </a>
                    {% if request.applicableLaw.complaintOrganism %}
                        <p class="text-xs text-slate-500 text-center mt-1">
                            Ante {{ request.applicableLaw.complaintOrganism.shortName ?? request.applicableLaw.complaintOrganism.name }}
                        </p>
                    {% endif %}
                {% endif %}

                {% if request.complaint and request.complaint.status == 'reclaimed' %}
                    <a href="{{ path('app_complaint_generate', {id: request.id, mode: 'alegation_response'}) }}" class="btn btn-primary w-full">
                        <i data-lucide="shield-alert" class="w-4 h-4 mr-2"></i>
                        Generar respuesta a alegaciones
                    </a>
                {% endif %}

                <a href="#" class="btn btn-secondary w-full">
                    <i data-lucide="download" class="w-4 h-4 mr-2"></i>
                    Exportar historial
                </a>

                <hr class="my-4 border-slate-200">

                <form action="{{ path('app_solicitudes_delete', {id: request.id}) }}"
                      method="post"
                      onsubmit="return confirm('¿Estás seguro de que quieres eliminar esta solicitud? Esta acción no se puede deshacer.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-request-' ~ request.id) }}">
                    <button type="submit" class="btn btn-danger w-full">
                        <i data-lucide="trash-2" class="w-4 h-4 mr-2"></i>
                        Eliminar solicitud
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

{# Modal for importing orphan documents #}
<div id="importOrphanModal" class="modal-backdrop hidden">
    <div class="modal-content max-w-2xl">
        <div class="modal-header">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-primary-100 flex items-center justify-center">
                    <i data-lucide="link" class="w-5 h-5 text-primary-600"></i>
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-slate-800">Importar documento sin asignar</h3>
                    <p class="text-sm text-slate-500">Selecciona un documento para enlazarlo a esta solicitud</p>
                </div>
            </div>
        </div>
        <div class="modal-body">
            <div id="orphanDocList" class="space-y-3 max-h-96 overflow-y-auto">
                <div class="text-center py-8">
                    <div class="w-8 h-8 rounded-full bg-primary-100 flex items-center justify-center mx-auto mb-3">
                        <i data-lucide="loader-2" class="w-4 h-4 text-primary-600 animate-spin"></i>
                    </div>
                    <p class="text-sm text-slate-500">Cargando documentos...</p>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('importOrphanModal').classList.add('hidden')">
                Cerrar
            </button>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('importOrphanModal');
    const docList = document.getElementById('orphanDocList');
    const accessRequestId = '{{ request.id }}';

    const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
            if (mutation.attributeName === 'class' && !modal.classList.contains('hidden')) {
                loadOrphanDocs();
            }
        });
    });
    observer.observe(modal, { attributes: true });

    async function loadOrphanDocs() {
        try {
            const resp = await fetch('/documentos/orphaned', {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            if (resp.ok) {
                const data = await resp.json();
                renderOrphanDocs(data.documents);
            }
        } catch (e) {
            docList.innerHTML = '<p class="text-sm text-red-600 text-center py-4">Error al cargar documentos</p>';
        }
    }

    function renderOrphanDocs(docs) {
        if (!docs || docs.length === 0) {
            docList.innerHTML = `
                <div class="text-center py-8">
                    <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-3">
                        <i data-lucide="check-circle" class="w-6 h-6 text-slate-400"></i>
                    </div>
                    <p class="text-sm text-slate-500">No hay documentos sin asignar</p>
                </div>
            `;
            if (window.lucide) window.lucide.createIcons();
            return;
        }

        docList.innerHTML = docs.map(function(doc) {
            return '<div class="p-4 rounded-xl border border-slate-200 hover:border-primary-400 hover:bg-primary-50/50 transition-all">'
                + '<div class="flex items-start gap-3">'
                + '<div class="w-10 h-10 rounded-lg ' + (doc.isPdf ? 'bg-red-100' : 'bg-slate-200') + ' flex items-center justify-center flex-shrink-0">'
                + '<i data-lucide="' + (doc.isPdf ? 'file-text' : 'file') + '" class="w-5 h-5 ' + (doc.isPdf ? 'text-red-600' : 'text-slate-600') + '"></i>'
                + '</div>'
                + '<div class="flex-1 min-w-0">'
                + '<p class="font-medium text-slate-800 truncate">' + doc.name + '</p>'
                + '<div class="flex flex-wrap items-center gap-2 mt-1 text-xs text-slate-500">'
                + '<span>' + doc.typeLabel + '</span>'
                + '<span>' + doc.createdAt + '</span>'
                + (doc.publicBodyName ? '<span class="text-primary-600">' + doc.publicBodyName + '</span>' : '')
                + '</div>'
                + (doc.summary ? '<p class="text-sm text-slate-600 mt-2 line-clamp-2">' + doc.summary + '</p>' : '')
                + '<div class="flex items-center gap-2 mt-3">'
                + '<button type="button" class="btn btn-primary btn-sm" onclick="linkOrphanDoc(\'' + doc.id + '\', this)">'
                + '<i data-lucide="link" class="w-3 h-3 mr-1"></i> Enlazar</button>'
                + (doc.isPdf ? '<a href="' + doc.downloadUrl + '" target="_blank" class="btn btn-ghost btn-sm">'
                + '<i data-lucide="eye" class="w-3 h-3 mr-1"></i> Ver</a>' : '')
                + '</div></div></div></div>';
        }).join('');

        if (window.lucide) window.lucide.createIcons();
    }

    window.reprocessDocument = async function(docId, btn) {
        if (!confirm('¿Reprocesar este documento? Se volverá a analizar con IA.')) return;

        const icon = btn.querySelector('i');
        btn.disabled = true;
        if (icon) icon.classList.add('animate-spin');

        try {
            const resp = await fetch('/documentos/procesar', {
                method: 'POST',
                body: JSON.stringify({ documentIds: [docId] }),
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            if (resp.ok) {
                const badge = btn.closest('[data-document-id]').querySelector('.badge');
                if (badge) {
                    badge.className = 'badge badge-warning';
                    badge.textContent = 'Procesando...';
                }
            } else {
                const err = await resp.json();
                alert(err.error || 'Error al reprocesar documento');
            }
        } catch (e) {
            alert('Error de conexión');
        } finally {
            btn.disabled = false;
            if (icon) icon.classList.remove('animate-spin');
        }
    };

    window.linkOrphanDoc = async function(docId, btn) {
        btn.disabled = true;
        btn.textContent = 'Enlazando...';

        try {
            const resp = await fetch('/documentos/' + docId + '/link', {
                method: 'POST',
                body: JSON.stringify({ accessRequestId: accessRequestId }),
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            if (resp.ok) {
                window.location.reload();
            } else {
                const err = await resp.json();
                alert(err.error || 'Error al enlazar documento');
                btn.disabled = false;
                btn.textContent = 'Enlazar';
            }
        } catch (e) {
            alert('Error de conexión');
            btn.disabled = false;
            btn.textContent = 'Enlazar';
        }
    };
});

// Lists manager Alpine.js component
function listsManager(requestId) {
    return {
        lists: [],
        loading: true,
        dropdownOpen: false,
        toggling: false,

        init() {
            this.loadLists();
        },

        async loadLists() {
            try {
                const resp = await fetch('/listas/para-solicitud/' + requestId, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (resp.ok) {
                    const data = await resp.json();
                    this.lists = data.lists;
                }
            } catch (e) {
                console.error('Error loading lists:', e);
            } finally {
                this.loading = false;
                this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
            }
        },

        async toggleList(list) {
            this.toggling = true;
            const url = list.inList
                ? '/listas/' + list.id + '/solicitudes/quitar'
                : '/listas/' + list.id + '/solicitudes/agregar';

            try {
                const resp = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({
                        requestId: requestId,
                        _token: list.csrfToken
                    })
                });

                if (resp.ok) {
                    list.inList = !list.inList;
                    this.dropdownOpen = false;
                    this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
                } else {
                    const data = await resp.json();
                    alert(data.error || 'Error');
                }
            } catch (e) {
                alert('Error de conexión');
            } finally {
                this.toggling = false;
            }
        }
    };
}
</script>
{% endblock %}
