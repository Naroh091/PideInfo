{% extends 'layouts/app.html.twig' %}

{% import '_macros/agent_task.html.twig' as agent_task %}

{% block title %}{{ request.title }} - PideInfo{% endblock %}

{# Forzar carga completa: Turbo Drive + Alpine dejan muerto el efecto x-show del
   modal `agentPresent` (Presentar con el agente) al llegar por navegación interna.
   Ver docs/complaint-workflow.md → "Modal de progreso unificado". #}
{% block meta %}<meta name="turbo-visit-control" content="reload">{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* ─────────────────────────────────────────────────────────────
           PAGE-SCOPED — «El expediente» (diseño v2, design/redesign/
           expediente-v2.html): hero carpeta con papel, cards paso,
           actuaciones cronológicas y ficha registral lateral.
           Paleta del kit: tinta slate, acción sky, rotulador ámbar.
           ───────────────────────────────────────────────────────────── */

        /* ── Hero: la carpeta del expediente ── */
        .hcarta { position: relative; margin-top: 2rem; --papel-carpeta: #fffefb; }
        .hcarta-tab {
            position: absolute; top: -1.72rem; left: 1.4rem; z-index: 2;
            display: inline-flex; align-items: center; gap: .55rem;
            background: var(--papel-carpeta);
            border: 1px solid rgb(226 232 240);
            border-bottom: 0;
            border-radius: .65rem .65rem 0 0;
            padding: .45rem .85rem .5rem;
            font-family: 'JetBrains Mono', monospace;
            font-size: .72rem;
            font-weight: 600;
            font-variant-numeric: tabular-nums;
            box-shadow: 0 -8px 18px -14px rgba(15, 23, 42, .25);
        }
        .hcarta-tab::after {
            /* tapa el borde superior de la carta bajo la pestaña: papel continuo */
            content: "";
            position: absolute; left: 0; right: 0; bottom: -2px; height: 3px;
            background: var(--papel-carpeta);
        }
        .hcarta-ref {
            display: inline-flex; align-items: center; gap: .35rem;
            font: inherit;
            color: var(--color-primary-700, #0369a1);
            background: none; border: 0; padding: 0;
            cursor: pointer;
            transition: color .12s ease;
        }
        .hcarta-ref:hover { color: var(--color-primary-800, #075985); }
        .hcarta-ref--recl { color: #b45309; }
        .hcarta-ref--recl:hover { color: #92400e; }
        .hcarta-tab-sep { color: #cbd5e1; }
        .hcarta-cuerpo {
            position: relative;
            isolation: isolate;
            overflow: hidden;
            background: var(--papel-carpeta);
            border: 1px solid rgb(226 232 240);
            border-radius: 0 1rem 1rem 1rem;
            box-shadow:
                0 14px 40px -30px rgba(15, 23, 42, .25),
                inset 0 0 22px rgba(146, 106, 26, .018);
            padding: 1.35rem 1.6rem 1.1rem;
        }
        /* Sin nº de registro no hay pestaña: la esquina vuelve a redondearse */
        .hcarta--sin-tab .hcarta-cuerpo { border-radius: 1rem; }
        .hcarta-cuerpo::before {
            /* grano del papel: turbulencia SVG desaturada a ~5% de alfa */
            content: "";
            position: absolute; inset: 0; z-index: -1;
            background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='180'%20height='180'%3E%3Cfilter%20id='g'%3E%3CfeTurbulence%20type='fractalNoise'%20baseFrequency='.85'%20numOctaves='2'%20stitchTiles='stitch'/%3E%3CfeColorMatrix%20type='saturate'%20values='0'/%3E%3CfeComponentTransfer%3E%3CfeFuncA%20type='linear'%20slope='.055'/%3E%3C/feComponentTransfer%3E%3C/filter%3E%3Crect%20width='100%25'%20height='100%25'%20filter='url(%23g)'/%3E%3C/svg%3E");
            pointer-events: none;
        }
        .hcarta-cuerpo::after {
            /* luz rasante: el papel no es perfectamente plano */
            content: "";
            position: absolute; inset: 0; z-index: -1;
            background: radial-gradient(120% 90% at 8% 0%, rgba(255, 255, 255, .85) 0%, transparent 55%),
                        radial-gradient(90% 70% at 100% 100%, rgba(146, 106, 26, .022) 0%, transparent 60%);
            pointer-events: none;
        }
        .hcarta-titulo {
            font-family: 'DM Serif Display', Georgia, serif;
            font-weight: 400;
            line-height: 1.12;
            letter-spacing: -.018em;
            color: rgb(15 23 42);
            font-size: clamp(1.6rem, 3.2vw, 2.35rem);
            margin: 0;
        }

        /* Franja de metadatos: celdas separadas por filete */
        .exp-meta {
            display: flex; flex-wrap: wrap;
            margin-top: 1rem;
            border-top: 1px solid rgba(146, 106, 26, .14);
            padding-top: .7rem;
            gap: .35rem 0;
        }
        .exp-meta-celda {
            display: flex; flex-direction: column; gap: .25rem;
            padding: 0 1.1rem;
            border-right: 1px solid rgba(146, 106, 26, .14);
            min-width: 0;
        }
        .exp-meta-celda:first-child { padding-left: 0; }
        .exp-meta-celda:last-child { border-right: 0; }
        .exp-meta-clave {
            font-family: 'DM Sans', sans-serif;
            font-size: .68rem; font-weight: 500;
            color: rgb(148 163 184);
        }
        .exp-meta-valor {
            font-family: 'DM Sans', sans-serif;
            font-size: .85rem; font-weight: 500;
            color: rgb(71 85 105);
            display: inline-flex; align-items: center; gap: .4rem;
            min-width: 0;
        }
        .exp-meta-valor .trunca {
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
            max-width: 17rem;
        }
        .exp-meta-valor.es-mono { font-family: 'JetBrains Mono', monospace; font-size: .8rem; font-variant-numeric: tabular-nums; }

        /* ── Badges editables (desplegable inline de Estado/Resolución/Reclamación) ── */
        .badge-edit { position: relative; display: inline-flex; }
        .badge-edit-trigger {
            display: inline-flex; align-items: center; gap: .3rem;
            background: transparent; border: 0; padding: 0; margin: 0;
            cursor: pointer; border-radius: 999px;
        }
        .badge-edit-trigger:focus-visible { outline: 2px solid rgb(14 165 233); outline-offset: 2px; }
        .badge-edit-caret { color: rgb(148 163 184); transition: transform .15s ease; flex-shrink: 0; }
        .badge-edit-trigger:hover .badge-edit-caret { color: rgb(71 85 105); }
        /* El menú se teletransporta al <body>: posición fija calculada en JS. */
        .badge-edit-backdrop { position: fixed; inset: 0; z-index: 55; background: transparent; }
        .badge-edit-menu {
            position: fixed; z-index: 56;
            background: white;
            border: 1px solid rgb(226 232 240);
            border-radius: .6rem;
            box-shadow: 0 12px 32px -16px rgba(15, 23, 42, .3);
            padding: .3rem;
            min-width: 210px; max-height: 20rem; overflow-y: auto;
        }
        .badge-edit-form { margin: 0; }
        .badge-edit-item {
            display: flex; align-items: center; justify-content: space-between; gap: .5rem;
            width: 100%; text-align: left;
            background: transparent; border: 0; cursor: pointer;
            padding: .3rem .4rem; border-radius: .4rem;
            transition: background-color .12s ease;
        }
        .badge-edit-item:hover { background: rgb(248 250 252); }
        .badge-edit-item.is-active { background: rgb(240 249 255); }
        .badge-edit-check { width: .85rem; height: .85rem; color: rgb(2 132 199); flex-shrink: 0; }

        /* ── Tooltip (i) del label «Estado» ── */
        .estado-info { position: relative; display: inline-flex; vertical-align: middle; margin-left: .15rem; }
        .estado-info-btn {
            display: inline-flex; background: transparent; border: 0; padding: 0; margin: 0;
            color: rgb(148 163 184); cursor: help; line-height: 0;
        }
        .estado-info-btn:hover { color: rgb(71 85 105); }
        .estado-info-btn:focus-visible { outline: 2px solid rgb(14 165 233); outline-offset: 2px; border-radius: 999px; }
        /* Teletransportado al <body>: posición fija calculada en JS. */
        .estado-info-tip {
            position: fixed;
            width: 15rem;
            background: rgb(15 23 42); color: white;
            font-family: 'DM Sans', sans-serif; font-size: .72rem; font-weight: 400; line-height: 1.35;
            padding: .5rem .6rem; border-radius: .5rem;
            box-shadow: 0 12px 32px -16px rgba(15, 23, 42, .5);
            z-index: 60;
        }

        /* Aviso «Vista admin / Compartida por» */
        .exp-viendo-como {
            display: inline-flex; align-items: center; gap: .5rem;
            font-family: 'Inter', sans-serif;
            font-size: .82rem; font-weight: 500;
            padding: .35rem .75rem;
            border-radius: 999px;
            margin-top: .75rem;
        }
        .exp-viendo-como.is-admin { background: var(--color-accent-50); color: var(--color-accent-800); border: 1px solid var(--color-accent-200); }
        .exp-viendo-como.is-org { background: var(--color-primary-50); color: var(--color-primary-800); border: 1px solid var(--color-primary-200); }

        /* Editar (píldora discreta junto a las migas) */
        .exp-editar {
            display: inline-flex; align-items: center; gap: .4rem;
            font-family: 'Inter', sans-serif;
            font-size: .82rem; font-weight: 500;
            color: rgb(71 85 105);
            background: white;
            border: 1px solid rgb(226 232 240);
            border-radius: 999px;
            padding: .35rem .85rem;
            transition: all .15s ease;
        }
        .exp-editar:hover {
            border-color: var(--color-primary-400);
            color: var(--color-primary-700);
            box-shadow: 0 0 0 3px rgba(2, 132, 199, .08);
        }

        /* ── La card del paso: una hoja más; la urgencia vive en la
             cabecera (rótulo serif itálica + filete + plazo en mono) ── */
        .paso3 {
            background: #fff;
            border: 1px solid rgb(226 232 240);
            border-radius: 1rem;
            box-shadow: 0 14px 40px -30px rgba(15, 23, 42, .25);
            padding: 1.05rem 1.4rem 1.2rem;
            margin-bottom: 1.25rem;
        }
        .paso3-cab { display: flex; align-items: baseline; gap: .75rem; flex-wrap: wrap; }
        .paso3-nombre {
            font-family: 'DM Serif Display', Georgia, serif;
            font-style: italic; font-weight: 400;
            font-size: .95rem; line-height: 1.2;
            color: #b45309;
        }
        .paso3-filete {
            flex: 1; min-width: 3rem; height: 1px;
            background: linear-gradient(90deg, var(--color-accent-200, #fde68a), transparent);
            position: relative; top: -.3rem;
        }
        .paso3-plazo {
            font-family: 'JetBrains Mono', monospace;
            font-size: .76rem; font-weight: 500;
            color: rgb(100 116 139);
            font-variant-numeric: tabular-nums;
        }
        .paso3-plazo b { color: rgb(15 23 42); font-weight: 600; }
        .paso3-plazo .rojo { color: #b91c1c; font-weight: 600; }
        .paso3-frase {
            font-family: 'DM Sans', sans-serif;
            font-size: .95rem; font-weight: 600; line-height: 1.5;
            color: rgb(15 23 42);
            margin: .65rem 0 0;
            max-width: 46rem;
        }
        .paso3-texto {
            font-family: 'DM Sans', sans-serif;
            font-size: .83rem; line-height: 1.55;
            color: rgb(100 116 139);
            margin: .35rem 0 0;
            max-width: 48rem;
        }
        .paso3-texto strong { color: rgb(51 65 85); font-weight: 600; }
        .paso3-texto p + p { margin-top: .5rem; }
        .paso3-acciones { display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; margin-top: .95rem; }
        .paso3-lista { margin-top: .5rem; }
        .paso3-lista li {
            display: flex; align-items: flex-start; gap: .55rem;
            padding: .35rem 0;
            font-size: .85rem; color: rgb(51 65 85);
            border-bottom: 1px dashed rgb(241 245 249);
        }
        .paso3-lista li:last-child { border-bottom: 0; }
        .paso3-pill {
            display: inline-flex; align-items: center; gap: .45rem;
            font-family: 'Inter', sans-serif;
            font-size: .72rem;
            color: rgb(71 85 105);
            background: rgb(248 250 252);
            border: 1px solid rgb(226 232 240);
            border-radius: 999px;
            padding: .3rem .75rem;
            margin-top: .75rem;
        }
        .paso3-pill strong { color: rgb(30 41 59); font-weight: 600; }
        /* Tonos: el rótulo y el filete cambian de tinta; la hoja no */
        .paso3--rojo .paso3-nombre { color: #b91c1c; }
        .paso3--rojo .paso3-filete { background: linear-gradient(90deg, #fecaca, transparent); }
        .paso3--verde .paso3-nombre { color: #047857; }
        .paso3--verde .paso3-filete { background: linear-gradient(90deg, #a7f3d0, transparent); }
        .paso3--cielo .paso3-nombre { color: var(--color-primary-700); }
        .paso3--cielo .paso3-filete { background: linear-gradient(90deg, var(--color-primary-200), transparent); }

        /* ── Rótulos de sección: serif + filete ── */
        .exp-seccion {
            display: flex; align-items: baseline; gap: .75rem;
            margin: 0 0 .8rem .1rem;
        }
        .exp-seccion-nombre {
            font-family: 'DM Serif Display', Georgia, serif;
            font-size: 1.02rem; font-weight: 400; line-height: 1.2;
            color: rgb(15 23 42);
        }
        .exp-seccion-filete {
            flex: 1; height: 1px;
            background: linear-gradient(90deg, rgb(226 232 240), transparent);
            position: relative; top: -.3rem;
        }
        .exp-seccion-nota {
            font-family: 'DM Sans', sans-serif;
            font-size: .75rem; color: rgb(148 163 184);
        }
        .exp-seccion-nota .pendiente-dot {
            display: inline-block;
            width: .45rem; height: .45rem; border-radius: 999px;
            background: var(--color-accent-500);
            box-shadow: 0 0 0 3px rgba(245, 158, 11, .18);
            animation: expPulso 1.2s ease-in-out infinite;
            margin-right: .25rem;
            vertical-align: 1px;
        }
        @keyframes expPulso { 0%, 100% { opacity: 1; } 50% { opacity: .55; } }

        /* ── La hoja: superficie común ── */
        .exp-hoja {
            background: #fff;
            border: 1px solid rgb(226 232 240);
            border-radius: 1rem;
            box-shadow: 0 14px 40px -30px rgba(15, 23, 42, .25);
        }
        .exp-hoja-cuerpo { padding: 1.25rem 1.4rem; }

        /* Piezas del expediente (actuaciones) */
        .pieza-cab {
            display: flex; align-items: center; gap: .7rem;
            padding: .85rem 1.25rem .1rem;
        }
        .pieza-cab .panel-icono { width: 2rem; height: 2rem; border-radius: .5rem; flex-shrink: 0; }
        .pieza-titulo {
            font-family: 'DM Sans', sans-serif;
            font-size: .92rem; font-weight: 600; line-height: 1.3;
            color: rgb(15 23 42);
            margin: 0;
        }
        .pieza-fecha {
            font-family: 'JetBrains Mono', monospace;
            font-size: .7rem; line-height: 1.4;
            color: rgb(148 163 184);
            font-variant-numeric: tabular-nums;
            margin: .1rem 0 0;
        }
        .pieza-cuerpo { padding: .8rem 1.25rem 1.1rem; }
        .pieza-intro {
            font-family: 'DM Sans', sans-serif;
            font-size: .8rem; color: rgb(100 116 139);
            margin: 0 0 .7rem;
        }
        .pieza-acciones {
            display: flex; gap: .5rem; flex-wrap: wrap; align-items: center;
            margin-top: .9rem; padding-top: .85rem;
            border-top: 1px solid rgb(241 245 249);
        }
        .pieza-doc {
            display: flex; align-items: center; gap: .4rem;
            font-family: 'JetBrains Mono', monospace;
            font-size: .72rem; font-weight: 500;
            color: rgb(148 163 184); text-decoration: none;
            margin-top: .9rem; padding-top: .75rem;
            border-top: 1px solid rgb(241 245 249);
            width: 100%;
            min-width: 0;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            transition: color .12s ease;
        }
        .pieza-doc i, .pieza-doc svg { flex-shrink: 0; }
        .pieza-doc:hover { color: var(--color-primary-700); }
        .pieza--pendiente { border-style: dashed; }
        .pieza-nota-roja {
            margin-top: .75rem;
            padding: .65rem .8rem;
            background: rgb(254 242 242);
            border-radius: .5rem;
            font-size: .83rem;
        }
        .pieza-nota-roja b { color: rgb(153 27 27); font-weight: 600; display: block; margin-bottom: .15rem; }
        .pieza-nota-roja span { color: rgb(185 28 28); }

        /* El texto de la solicitud, citado */
        .exp-cita {
            border-left: 2px solid var(--color-primary-200, #bae6fd);
            padding-left: 1.1rem;
        }
        .exp-cita .prose { font-size: .9rem; line-height: 1.65; color: rgb(51 65 85); }

        /* Puntos clave numerados (el escrito real va enumerado) */
        .exp-puntos { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .55rem; }
        .exp-puntos li {
            display: flex; gap: .65rem; align-items: flex-start;
            font-family: 'DM Sans', sans-serif;
            font-size: .85rem; line-height: 1.5;
            color: rgb(51 65 85);
        }
        .exp-puntos .n {
            font-family: 'JetBrains Mono', monospace;
            font-size: .68rem; font-weight: 600; line-height: 1;
            color: rgb(100 116 139);
            background: rgb(248 250 252);
            border: 1px solid rgb(226 232 240);
            border-radius: .35rem;
            padding: .22rem .38rem;
            margin-top: .1rem;
            flex-shrink: 0;
        }
        .exp-puntos--exito .n { background: #ecfdf5; border-color: #a7f3d0; color: #047857; }
        .exp-puntos--fallo .n { background: #fef2f2; border-color: #fecaca; color: #b91c1c; }
        .exp-puntos--ambar .n { background: var(--color-accent-50); border-color: var(--color-accent-200); color: #b45309; }
        .exp-puntos--curso .n { background: var(--color-primary-50); border-color: var(--color-primary-200); color: var(--color-primary-700); }

        /* ── Documentos ── */
        .exp-drop {
            display: flex; align-items: center; gap: .8rem;
            border: 1px dashed #cbd5e1;
            border-radius: .65rem;
            padding: .65rem .9rem;
            color: rgb(100 116 139);
            font-family: 'DM Sans', sans-serif;
            font-size: .8rem; font-weight: 500;
            cursor: pointer;
            transition: border-color .12s, background .12s;
            margin-bottom: .75rem;
        }
        .exp-drop:hover, .exp-drop.dragover {
            border-color: var(--color-primary-400);
            background: var(--color-primary-50);
            color: var(--color-primary-700);
        }
        .exp-drop .sub { font-size: .72rem; font-weight: 400; color: rgb(148 163 184); display: block; }

        .exp-doc-fila {
            display: grid; grid-template-columns: 1rem minmax(0, 1fr) auto; gap: .7rem;
            align-items: flex-start;
            padding: .6rem .25rem .65rem;
            border-bottom: 1px solid rgb(241 245 249);
        }
        .exp-doc-fila:last-child { border-bottom: 0; }
        .exp-doc-icono { display: inline-flex; margin-top: .15rem; color: rgb(148 163 184); }
        .exp-doc-nombre {
            font-family: 'DM Sans', sans-serif;
            font-size: .83rem; font-weight: 500; line-height: 1.3;
            color: rgb(71 85 105);
            margin: 0;
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        }
        .exp-doc-meta {
            font-family: 'JetBrains Mono', monospace;
            font-size: .7rem; line-height: 1.4;
            color: rgb(148 163 184);
            margin: .1rem 0 0;
            display: flex; align-items: center; gap: .45rem; flex-wrap: wrap;
        }
        .exp-doc-fila.tramite .exp-doc-nombre { color: rgb(100 116 139); font-weight: 400; }
        .exp-doc-fila.tramite .exp-doc-icono { opacity: .55; }
        .exp-doc-fila.tramite .exp-doc-resumen { color: rgb(148 163 184); }
        .exp-doc-resumen {
            font-family: 'DM Sans', sans-serif;
            font-size: .78rem; line-height: 1.5;
            color: rgb(100 116 139);
            margin: .35rem 0 0;
            padding-left: .6rem;
            border-left: 2px solid rgb(226 232 240);
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .exp-doc-acciones { display: inline-flex; gap: .1rem; opacity: .45; transition: opacity .12s ease; margin-top: -.1rem; }
        .exp-doc-fila:hover .exp-doc-acciones { opacity: 1; }
        .exp-doc-acciones a, .exp-doc-acciones button {
            display: inline-flex; align-items: center; justify-content: center;
            width: 1.8rem; height: 1.8rem;
            border-radius: .4rem;
            color: rgb(148 163 184);
            background: none; border: 0; cursor: pointer;
            transition: background .12s ease, color .12s ease;
        }
        .exp-doc-acciones a:hover, .exp-doc-acciones button:hover { background: rgb(241 245 249); color: var(--color-primary-700); }
        .exp-doc-tag {
            display: inline-flex; align-items: center; gap: .3rem;
            font-family: 'DM Sans', sans-serif;
            font-size: .62rem; font-weight: 500; line-height: 1;
            padding: .14rem .45rem;
            border-radius: 999px;
            vertical-align: 1px;
        }
        .exp-doc-tag--borrador { background: var(--color-accent-50); color: #b45309; border: 1px solid var(--color-accent-200); }
        .exp-doc-tag--previo { background: rgb(248 250 252); color: rgb(100 116 139); border: 1px solid rgb(226 232 240); }
        .exp-doc-tag--proceso { background: var(--color-accent-50); color: #b45309; }
        .exp-doc-tag--proceso .punto {
            width: .35rem; height: .35rem; border-radius: 999px;
            background: var(--color-accent-500);
            animation: expPulso 1.2s ease-in-out infinite;
        }
        .exp-doc-grupo { display: flex; align-items: baseline; gap: .6rem; margin: 1rem 0 .2rem; }
        .exp-doc-grupo b {
            font-family: 'DM Serif Display', Georgia, serif;
            font-style: italic; font-weight: 400;
            font-size: .9rem; line-height: 1.2;
            color: #b45309;
        }
        .exp-doc-grupo .filete {
            flex: 1; height: 1px;
            background: linear-gradient(90deg, var(--color-accent-200), transparent);
            position: relative; top: -.3rem;
        }
        .exp-doc-vacia {
            padding: 1.5rem 1rem;
            text-align: center;
            color: rgb(148 163 184);
            font-size: .9rem;
        }
        .exp-doc-vacia em {
            font-family: 'DM Serif Display', Georgia, serif;
            font-style: italic;
            color: rgb(100 116 139);
            font-size: 1rem;
            display: block;
            margin-bottom: .25rem;
        }
        .exp-doc-pie {
            display: flex; align-items: center; justify-content: space-between; gap: 1rem;
            margin-top: .85rem; padding-top: .7rem;
            border-top: 1px solid rgb(241 245 249);
        }
        .exp-doc-pie-enlace {
            display: inline-flex; align-items: center; gap: .35rem;
            font-family: 'DM Sans', sans-serif;
            font-size: .78rem; color: rgb(100 116 139);
            background: none; border: 0; padding: 0; cursor: pointer;
            transition: color .12s ease;
        }
        .exp-doc-pie-enlace:hover { color: var(--color-primary-700); }

        /* ── La ficha registral (lateral) ── */
        .ficha-bloque { padding: 1.05rem 1.25rem; border-top: 1px solid rgb(241 245 249); }
        .ficha-bloque--primero { border-top: 0; }
        .ficha-rotulo {
            font-family: 'DM Serif Display', Georgia, serif;
            font-style: italic; font-weight: 400;
            font-size: .92rem; line-height: 1.2;
            color: rgb(15 23 42);
            margin: 0 0 .65rem;
        }
        .ficha-fila { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .15rem .75rem; padding: .28rem 0; }
        .ficha-clave { font-family: 'DM Sans', sans-serif; font-size: .76rem; color: rgb(100 116 139); white-space: nowrap; }
        .ficha-valor {
            font-family: 'JetBrains Mono', monospace;
            font-size: .78rem; font-weight: 500; line-height: 1.4;
            color: rgb(71 85 105);
            font-variant-numeric: tabular-nums;
            text-align: right;
            display: inline-flex; align-items: center; gap: .4rem;
            min-width: 0; max-width: 100%;
            word-break: break-all;   /* nº de expediente kilométricos: saltan a su propia línea */
            margin-left: auto;
        }
        .ficha-valor.es-ui { font-family: 'DM Sans', sans-serif; }
        .ficha-valor.rojo { color: #b91c1c; font-weight: 600; }
        .ficha-valor.ambar { color: #b45309; }
        .ficha-barra { height: .3rem; border-radius: 999px; background: rgb(241 245 249); margin: .3rem 0 .1rem; overflow: hidden; }
        .ficha-barra i { display: block; height: 100%; border-radius: 999px; background: var(--color-accent-500); }
        .ficha-barra i.es-cielo { background: var(--color-primary-300); }
        .ficha-tag {
            display: inline-flex; align-items: center;
            font-family: 'DM Sans', sans-serif;
            font-size: .68rem; font-weight: 500; line-height: 1.4;
            padding: .05rem .5rem;
            border-radius: 999px;
        }
        .ficha-tag.is-resolved { background: rgb(236 253 245); color: rgb(5 150 105); }
        .ficha-tag.is-passed { background: rgb(254 242 242); color: rgb(185 28 28); }
        .ficha-tag.is-suspended { background: var(--color-accent-50); color: var(--color-accent-700); font-style: italic; }
        .ficha-nota {
            font-family: 'DM Sans', sans-serif;
            font-size: .74rem; line-height: 1.5;
            color: rgb(148 163 184);
            margin: .3rem 0 0;
        }
        .ficha-enlace {
            display: flex; align-items: center; gap: .5rem;
            font-family: 'DM Sans', sans-serif;
            font-size: .83rem; font-weight: 500;
            color: rgb(71 85 105);
            background: none; border: 0; cursor: pointer;
            text-decoration: none;
            padding: .3rem 0;
            text-align: left;
            transition: color .12s ease;
        }
        .ficha-enlace i, .ficha-enlace svg { color: rgb(148 163 184); transition: color .12s ease; }
        .ficha-enlace:hover { color: var(--color-primary-700); }
        .ficha-enlace:hover i, .ficha-enlace:hover svg { color: var(--color-primary-600); }
        .ficha-enlace.peligro { color: rgb(127 29 29); opacity: .68; }
        .ficha-enlace.peligro i, .ficha-enlace.peligro svg { color: rgb(185 28 28); }
        .ficha-enlace.peligro:hover { color: rgb(185 28 28); opacity: 1; }
        .ficha-mail {
            font-family: 'JetBrains Mono', monospace;
            font-size: .72rem;
            color: rgb(71 85 105);
            background: none; border: 0; padding: 0;
            text-align: left;
            display: inline-flex; align-items: center; gap: .35rem;
            cursor: pointer;
            transition: color .12s ease;
            word-break: break-all;
        }
        .ficha-mail:hover { color: var(--color-primary-700); }
        .ficha-mail i { opacity: .55; flex-shrink: 0; }
        .ficha-accion-form { margin: 0; padding: 0; }

        /* ── Cronología compacta ── */
        .crono-fila {
            display: grid; grid-template-columns: 5.2rem .9rem minmax(0, 1fr) auto; gap: .5rem;
            align-items: flex-start;
            padding: .42rem 0;
            border-bottom: 1px solid rgb(241 245 249);
        }
        .crono-fila:last-child { border-bottom: 0; }
        .crono-fecha {
            font-family: 'JetBrains Mono', monospace;
            font-size: .7rem; font-weight: 500; line-height: 1.65;
            color: rgb(148 163 184);
            font-variant-numeric: tabular-nums;
        }
        .crono-punto { width: .5rem; height: .5rem; border-radius: 999px; justify-self: center; margin-top: .32rem; }
        .crono-texto {
            font-family: 'DM Sans', sans-serif;
            font-size: .8rem; line-height: 1.45;
            color: rgb(71 85 105);
        }
        .crono-texto.es-fuerte { font-weight: 600; color: rgb(15 23 42); }
        .crono-notas {
            font-family: 'DM Sans', sans-serif;
            font-size: .72rem; line-height: 1.45;
            color: rgb(148 163 184);
            margin: .15rem 0 0;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .crono-borrar { opacity: 0; transition: opacity .12s ease; align-self: center; }
        .crono-fila:hover .crono-borrar { opacity: 1; }

        /* Listas — toggle pills + formulario de alta (heredado del diseño previo) */
        .lists-toggle-stack { display: flex; flex-direction: column; gap: .3rem; margin-bottom: .75rem; }
        .list-pill {
            display: flex; align-items: center; gap: .5rem;
            padding: .35rem .55rem;
            border-radius: .45rem;
            border: 1px solid rgb(226 232 240);
            background: #ffffff;
            font-family: 'DM Sans', sans-serif;
            font-size: .85rem;
            color: rgb(71 85 105);
            cursor: pointer;
            text-align: left;
            transition: border-color .15s ease, background .15s ease, color .15s ease;
        }
        .list-pill:hover:not(:disabled) { border-color: rgb(186 230 253); color: rgb(15 23 42); }
        .list-pill.is-in {
            border-color: var(--color-primary-200, rgb(186 230 253));
            background: var(--color-primary-50, rgb(240 249 255));
            color: var(--color-primary-700, rgb(3 105 161));
            font-weight: 500;
        }
        .list-pill.is-readonly { cursor: default; opacity: .75; }
        .list-pill-check {
            display: inline-flex; align-items: center; justify-content: center;
            width: 1.1rem; height: 1.1rem; flex-shrink: 0;
            border-radius: 999px;
            background: rgb(241 245 249);
            color: rgb(148 163 184);
        }
        .list-pill.is-in .list-pill-check { background: var(--color-primary-600, rgb(2 132 199)); color: #ffffff; }
        .list-pill-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .list-pill-meta { font-family: 'Inter', sans-serif; font-size: .7rem; color: rgb(148 163 184); font-weight: 500; }
        .list-pill.is-in .list-pill-meta { color: var(--color-primary-700, rgb(3 105 161)); }
        .lists-empty { font-family: 'DM Sans', sans-serif; font-size: .82rem; color: rgb(148 163 184); line-height: 1.5; margin-bottom: .65rem; }
        .list-create-row { display: flex; gap: .35rem; align-items: stretch; margin-top: .25rem; }
        .list-create-input {
            flex: 1; min-width: 0;
            font-family: 'DM Sans', sans-serif;
            font-size: .82rem;
            padding: .35rem .55rem;
            border: 1px solid rgb(226 232 240);
            border-radius: .4rem;
            background: #ffffff; color: rgb(15 23 42);
            outline: none;
        }
        .list-create-input:focus { border-color: var(--color-primary-300, rgb(125 211 252)); box-shadow: 0 0 0 2px rgba(2, 132, 199, .12); }
        .list-create-btn {
            display: inline-flex; align-items: center; gap: .3rem;
            padding: .35rem .6rem;
            border-radius: .4rem;
            border: 1px solid rgb(15 23 42);
            background: rgb(15 23 42);
            color: #ffffff;
            font-family: 'Inter', sans-serif;
            font-size: .72rem; font-weight: 500;
            cursor: pointer;
            white-space: nowrap;
        }
        .list-create-btn:hover:not(:disabled) { background: #000; border-color: #000; }
        .list-create-btn:disabled { background: rgb(203 213 225); border-color: rgb(203 213 225); cursor: not-allowed; }
        .list-error { font-family: 'DM Sans', sans-serif; font-size: .78rem; color: rgb(185 28 28); margin-top: .45rem; }

        /* Referencias alternativas (desplegable de la pestaña) */
        .hcarta-altrefs {
            position: absolute; top: 100%; left: 0; margin-top: .35rem;
            background: white;
            border: 1px solid rgb(226 232 240);
            border-radius: .5rem;
            box-shadow: 0 12px 32px -16px rgba(15, 23, 42, .25);
            padding: .25rem 0;
            z-index: 30;
            min-width: 220px;
        }

        /* ── Entrada ── */
        @keyframes expRise {
            from { opacity: 0; transform: translateY(6px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .rise { animation: expRise .55s ease-out both; }
        .rise-1 { animation-delay: 0s; }
        .rise-2 { animation-delay: .08s; }
        .rise-3 { animation-delay: .16s; }
        .rise-4 { animation-delay: .24s; }
        .rise-5 { animation-delay: .32s; }
        @media (prefers-reduced-motion: reduce) {
            .rise { animation: none; }
            .expPulso, .exp-seccion-nota .pendiente-dot, .exp-doc-tag--proceso .punto { animation: none; }
        }
    </style>
{% endblock %}

{% block content %}
{% import '_macros/status_picker.html.twig' as picker %}
{% set canEditStatus = is_granted('edit', request) %}
{# Scope Alpine compartido por los tres badges editables: abre el menú
   teletransportado calculando su posición fija desde el propio trigger. #}
{% set pickerData = '{ open: false, mx: 0, my: 0, openMenu() { const r = $refs.trigger.getBoundingClientRect(); this.mx = Math.min(r.left, window.innerWidth - 232); this.my = r.bottom + 6; this.open = true; } }' %}
{# ── Migas + editar ── #}
<div class="flex items-center justify-between gap-3 mb-1 rise rise-1">
    <nav class="flex items-center gap-2 text-xs text-slate-500 min-w-0" style="font-family:'Inter',sans-serif;letter-spacing:.04em;">
        <a href="{{ path('app_solicitudes_index') }}" class="hover:text-slate-800 transition-colors">SOLICITUDES</a>
        <span class="text-slate-300">/</span>
        <span class="text-slate-800 font-medium truncate max-w-[24rem]">{{ request.title|u.truncate(50) }}</span>
    </nav>
    <a href="{{ path('app_solicitudes_edit', {id: request.id}) }}" class="exp-editar flex-shrink-0">
        <i data-lucide="pencil" class="w-3 h-3"></i>
        Editar
    </a>
</div>

{#
   Estado efectivo: con una reclamación activa (no archivada) manda la vía de
   reclamación — AccessRequest::getEffectiveStatusLabel(). Los colores de badge
   siguen el mismo criterio que el listado.
#}
{% set statusBadge = {
    'sent': 'status-sent',
    'processing': 'status-processing',
    'granted': 'status-granted',
    'granted_completed': 'status-granted-completed',
    'denied': 'status-denied',
    'delayed': 'status-delayed',
    'pending': 'status-pending',
    'partially_granted': 'badge-warning',
    'inadmitted': 'badge-danger'
} %}
{% set complaintBadge = {
    'reclaimed': 'badge-warning',
    'complaint_granted': 'badge-success',
    'complaint_denied': 'badge-danger',
    'complaint_archived': 'badge-secondary'
} %}
{% set resultBadge = {
    'granted': 'badge-success',
    'partially_granted': 'badge-warning',
    'denied': 'badge-danger',
    'inadmitted': 'badge-danger',
    'silence': 'badge-secondary',
    'upheld': 'badge-success',
    'partially_upheld': 'badge-warning',
    'dismissed': 'badge-danger',
    'archived': 'badge-secondary'
} %}

{# ── Hero: la carpeta del expediente ── #}
{% set hasTab = request.externalId or (request.complaint and request.complaint.externalId) %}
<header class="hcarta {{ not hasTab ? 'hcarta--sin-tab' }} rise rise-2 mb-6">
    {% if hasTab %}
        <span class="hcarta-tab" x-data="{ showAltRefs: false }">
            {% if request.externalId %}
                <button type="button" class="hcarta-ref"
                        onclick="navigator.clipboard.writeText('{{ request.externalId|e('js') }}'); this.querySelector('.copy-ok').classList.remove('hidden'); setTimeout(() => this.querySelector('.copy-ok').classList.add('hidden'), 1500)"
                        title="Copiar nº expediente">
                    <i data-lucide="hash" class="w-3 h-3"></i>
                    {{ request.externalId }}
                    <i data-lucide="check" class="w-3 h-3 text-emerald-500 copy-ok hidden"></i>
                </button>
                {% if request.alternativeReferences|length > 0 %}
                    <button type="button"
                            @click="showAltRefs = !showAltRefs"
                            class="text-slate-400 hover:text-slate-600 transition-colors"
                            title="Ver referencias alternativas">
                        <i data-lucide="chevron-down" class="w-3.5 h-3.5 transition-transform" :class="showAltRefs && 'rotate-180'"></i>
                    </button>
                    <div x-show="showAltRefs"
                         x-transition
                         @click.away="showAltRefs = false"
                         class="hcarta-altrefs"
                         style="display: none;">
                        <p class="px-3 py-1.5 text-xs text-slate-400 font-medium" style="font-family:'DM Sans',sans-serif;">Referencias alternativas</p>
                        {% for ref in request.alternativeReferences %}
                            <button type="button"
                                    class="w-full flex items-center gap-2 px-3 py-2 text-sm text-slate-700 hover:bg-slate-50 transition-colors font-mono"
                                    onclick="navigator.clipboard.writeText('{{ ref|e('js') }}'); this.querySelector('.copy-ok').classList.remove('hidden'); setTimeout(() => this.querySelector('.copy-ok').classList.add('hidden'), 1500)"
                                    title="Copiar referencia">
                                <i data-lucide="hash" class="w-3.5 h-3.5 text-slate-400"></i>
                                <span class="text-xs">{{ ref }}</span>
                                <i data-lucide="check" class="w-3 h-3 text-emerald-500 copy-ok hidden ml-auto"></i>
                            </button>
                        {% endfor %}
                    </div>
                {% endif %}
            {% endif %}
            {% if request.externalId and request.complaint and request.complaint.externalId %}
                <span class="hcarta-tab-sep">·</span>
            {% endif %}
            {% if request.complaint and request.complaint.externalId %}
                <button type="button" class="hcarta-ref hcarta-ref--recl"
                        onclick="navigator.clipboard.writeText('{{ request.complaint.externalId|e('js') }}'); this.querySelector('.copy-ok').classList.remove('hidden'); setTimeout(() => this.querySelector('.copy-ok').classList.add('hidden'), 1500)"
                        title="Copiar nº expediente reclamación">
                    <i data-lucide="scale" class="w-3 h-3"></i>
                    Recl: {{ request.complaint.externalId }}
                    <i data-lucide="check" class="w-3 h-3 text-emerald-500 copy-ok hidden"></i>
                </button>
            {% endif %}
        </span>
    {% endif %}
    <div class="hcarta-cuerpo">
        <h1 class="hcarta-titulo">{{ request.title }}</h1>

        {% if is_granted('ROLE_ADMIN') and request.user != app.user %}
            <div class="exp-viendo-como is-admin">
                <i data-lucide="shield-alert" class="w-3.5 h-3.5"></i>
                Vista admin · <strong>{{ request.user ? request.user.fullName : 'Borrador anónimo' }}</strong>
                {% if request.user %}<span class="opacity-60">· {{ request.user.email }}</span>{% endif %}
            </div>
        {% elseif request.user != app.user %}
            <div class="exp-viendo-como is-org">
                <i data-lucide="building-2" class="w-3.5 h-3.5"></i>
                Compartida por <strong>{{ request.user ? request.user.fullName : 'Borrador anónimo' }}</strong>
            </div>
        {% endif %}

        <div class="exp-meta">
            <div class="exp-meta-celda">
                <span class="exp-meta-clave">Administración</span>
                {% set displayedAdmin = request.regDestination ? request.regDestination.displayLabel : request.publicBody.name %}
                {% set adminTitle = request.regDestination
                    ? request.regDestination.displayLabel ~ ' · ' ~ request.publicBody.name
                    : request.publicBody.name %}
                <span class="exp-meta-valor">
                    <i data-lucide="building" class="w-3.5 h-3.5 text-slate-400 flex-shrink-0"></i>
                    <span class="trunca" title="{{ adminTitle }}">{{ displayedAdmin }}</span>
                </span>
            </div>
            <div class="exp-meta-celda">
                <span class="exp-meta-clave">Presentada</span>
                <span class="exp-meta-valor es-mono">{{ request.sentAt|date('d/m/Y') }}</span>
            </div>
            <div class="exp-meta-celda">
                <span class="exp-meta-clave">
                    Estado
                    <span class="estado-info"
                          x-data="{ tip: false, tx: 0, ty: 0, show() { const r = $refs.ibtn.getBoundingClientRect(); this.tx = Math.min(r.left, window.innerWidth - 256); this.ty = r.bottom + 6; this.tip = true; } }"
                          @mouseenter="show()" @mouseleave="tip = false">
                        <button type="button" class="estado-info-btn" x-ref="ibtn"
                                @focus="show()" @blur="tip = false"
                                aria-label="Qué significa este estado">
                            <i data-lucide="info" class="w-3.5 h-3.5"></i>
                        </button>
                        <template x-teleport="body">
                            <span x-show="tip" x-cloak style="display: none;" class="estado-info-tip" role="tooltip"
                                  :style="'left:' + tx + 'px; top:' + ty + 'px;'">
                                Estado interno de trámite de la solicitud, que puede no coincidir con los trámites de la administración.
                            </span>
                        </template>
                    </span>
                </span>
                {# Trigger editable: el status CRUDO de la solicitud (su propio eje,
                   coherente con el desplegable). Vista de solo lectura: el estado
                   EFECTIVO, donde una reclamación activa manda sobre el badge. #}
                {% set estadoBadgeRaw %}<span class="badge {{ statusBadge[request.status]|default('badge-secondary') }}">{{ request.statusLabel }}</span>{% endset %}
                <span class="exp-meta-valor">
                    {% if canEditStatus %}
                        <span class="badge-edit" x-data="{{ pickerData }}" @keydown.escape.window="open = false">
                            <button type="button" class="badge-edit-trigger" x-ref="trigger"
                                    @click="open ? (open = false) : openMenu()"
                                    :aria-expanded="open" aria-haspopup="true">
                                {{ estadoBadgeRaw }}
                                <i data-lucide="chevron-down" class="badge-edit-caret w-3 h-3" :class="open && 'rotate-180'"></i>
                            </button>
                            {{ picker.status_menu(request.id, 'status', statusPicker.status) }}
                        </span>
                    {% elseif request.hasActiveComplaint %}
                        <span class="badge {{ complaintBadge[request.complaint.status]|default('badge-info') }}">{{ request.effectiveStatusLabel }}</span>
                    {% else %}
                        {{ estadoBadgeRaw }}
                    {% endif %}
                    {% if request.isDeadlineSuspended %}
                        <span class="badge badge-warning">Plazo suspendido</span>
                    {% endif %}
                </span>
            </div>
            {% if canEditStatus or request.resolutionResult %}
                <div class="exp-meta-celda">
                    <span class="exp-meta-clave">Resolución</span>
                    {% set resolucionBadge %}
                        <span class="badge {{ resultBadge[request.resolutionResult]|default('badge-secondary') }}">{{ request.resolutionResultLabel|default('Sin resolución') }}</span>
                    {% endset %}
                    <span class="exp-meta-valor">
                        {% if canEditStatus %}
                            <span class="badge-edit" x-data="{{ pickerData }}" @keydown.escape.window="open = false">
                                <button type="button" class="badge-edit-trigger" x-ref="trigger"
                                        @click="open ? (open = false) : openMenu()"
                                        :aria-expanded="open" aria-haspopup="true">
                                    {{ resolucionBadge }}
                                    <i data-lucide="chevron-down" class="badge-edit-caret w-3 h-3" :class="open && 'rotate-180'"></i>
                                </button>
                                {{ picker.status_menu(request.id, 'resolution', statusPicker.resolution) }}
                            </span>
                        {% else %}
                            {{ resolucionBadge }}
                        {% endif %}
                    </span>
                </div>
            {% endif %}
            {% if request.complaint and (canEditStatus or request.complaint.complaintResult) %}
                <div class="exp-meta-celda">
                    <span class="exp-meta-clave">Reclamación</span>
                    {% set reclamacionBadge %}
                        {% set reclLabel = request.complaint.complaintResultLabel|default(request.complaint.statusLabel) %}
                        {% set reclClass = resultBadge[request.complaint.complaintResult]|default(complaintBadge[request.complaint.status])|default('badge-secondary') %}
                        <span class="badge {{ reclClass }}">{{ reclLabel }}</span>
                    {% endset %}
                    <span class="exp-meta-valor">
                        {% if canEditStatus %}
                            <span class="badge-edit" x-data="{{ pickerData }}" @keydown.escape.window="open = false">
                                <button type="button" class="badge-edit-trigger" x-ref="trigger"
                                        @click="open ? (open = false) : openMenu()"
                                        :aria-expanded="open" aria-haspopup="true">
                                    {{ reclamacionBadge }}
                                    <i data-lucide="chevron-down" class="badge-edit-caret w-3 h-3" :class="open && 'rotate-180'"></i>
                                </button>
                                {{ picker.status_menu(request.id, 'complaint', statusPicker.complaint) }}
                            </span>
                        {% else %}
                            {{ reclamacionBadge }}
                        {% endif %}
                    </span>
                </div>
            {% endif %}
        </div>
    </div>
</header>

{# ── Los pasos: qué toca hacer ahora ── #}
<div class="rise rise-3">
    {{ component('RequestStatusBanner', {request: request}) }}
</div>

{# Trámite de audiencia activo: plazo abierto para presentar alegaciones.
   Se oculta al vencer; el histórico queda en la cronología y en Plazos. #}
{% if request.complaint and request.complaint.activeHearingProcess %}
    {% set hearing = request.complaint.activeHearingProcess %}
    {% set hearingOrganism = request.applicableLaw.complaintOrganism
        ? (request.applicableLaw.complaintOrganism.shortName ?? request.applicableLaw.complaintOrganism.name)
        : 'el organismo de transparencia' %}
    <div class="rise rise-3">
        <section class="paso3">
            <div class="paso3-cab">
                <span class="paso3-nombre">Trámite de audiencia</span>
                <span class="paso3-filete"></span>
                <span class="paso3-plazo">
                    hasta el <b>{{ hearing.endDate|date('d/m/Y') }}</b>
                    · <span class="{{ hearing.daysUntilEnd <= 5 ? 'rojo' }}">queda{{ hearing.daysUntilEnd != 1 ? 'n' : '' }} {{ hearing.daysUntilEnd }} día{{ hearing.daysUntilEnd != 1 ? 's' : '' }}</span>
                </span>
            </div>
            <p class="paso3-frase">Responde a lo alegado antes de que {{ hearingOrganism }} resuelva la reclamación.</p>
            <p class="paso3-texto">
                Se ha abierto un trámite de audiencia de {{ hearing.hearingDays }} {{ hearing.hearingDaysTypeLabel }}
                (desde el {{ hearing.startDate|date('d/m/Y') }}) para que puedas alegar lo que estimes oportuno
                antes de que se resuelva la reclamación.
            </p>
            <div class="paso3-acciones">
                {% if request.complaint.status == 'reclaimed' %}
                    <a href="{{ path('app_complaint_redactar', {id: request.id, mode: 'alegation_response'}) }}" class="btn btn-accent btn-sm">
                        <i data-lucide="message-square-reply" class="w-3.5 h-3.5 mr-1.5"></i>
                        Redactar alegaciones
                    </a>
                {% endif %}
                {% if hearing.triggerDocument %}
                    <a href="{{ path('app_document_download', {id: hearing.triggerDocument.id}) }}" class="btn btn-secondary btn-sm" data-turbo="false">
                        <i data-lucide="file-text" class="w-3.5 h-3.5 mr-1.5"></i>
                        Ver notificación
                    </a>
                {% endif %}
                <form method="post" action="{{ path('app_complaint_hearing_close', {id: request.id}) }}" class="ficha-accion-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('close-hearing-' ~ request.complaint.id) }}">
                    <button type="submit" class="btn btn-ghost btn-sm">
                        <i data-lucide="check-circle" class="w-4 h-4 mr-1.5"></i>
                        Ya he presentado las alegaciones
                    </button>
                </form>
            </div>
        </section>
    </div>
{% endif %}

{# Visibilidad de los intentos de envío vía agente. Si la solicitud sigue
   pendiente y hubo tareas fallidas o inciertas, lo avisamos junto a la
   invitación de envío y ofrecemos un modal con el detalle de cada intento. #}
{% if request.status == 'pending' and agentTasks|default([])|length > 0 %}
    {% set problemTasks = agentTasks|filter(t => t.status in ['failed', 'uncertain']) %}
    {% if problemTasks|length > 0 %}
        {% set hasUncertain = agentTasks|filter(t => t.status == 'uncertain')|length > 0 %}
        <div class="rise rise-3" x-data="{ tasksModal: false }">
            <section class="paso3">
                <div class="paso3-cab">
                    <span class="paso3-nombre">{{ hasUncertain ? 'Envío sin confirmar' : 'Intentos de envío con errores' }}</span>
                    <span class="paso3-filete"></span>
                    <span class="paso3-plazo">{{ problemTasks|length }} intento{{ problemTasks|length != 1 ? 's' : '' }}</span>
                </div>
                <p class="paso3-frase">
                    {% if hasUncertain %}
                        Un envío anterior quedó sin confirmar: puede que la solicitud ya esté presentada en el portal.
                    {% else %}
                        Hubo {{ problemTasks|length }} intento{{ problemTasks|length != 1 ? 's' : '' }} de envío con errores.
                    {% endif %}
                </p>
                <p class="paso3-texto">
                    {% if hasUncertain %}
                        Antes de volver a enviarla, comprueba en la sede electrónica del organismo si la solicitud ya consta presentada — así evitas presentarla por duplicado.
                    {% else %}
                        Puedes revisar qué falló en cada intento y volver a enviar la solicitud.
                    {% endif %}
                </p>
                <div class="paso3-acciones">
                    <button type="button" @click="tasksModal = true" class="btn btn-secondary btn-sm">
                        <i data-lucide="list" class="w-3.5 h-3.5 mr-1.5"></i>
                        Ver detalle de los intentos
                    </button>
                </div>
            </section>

            {# Modal — listado de intentos de envío del agente. x-teleport lo
               saca al <body>: si no, el transform del contenedor .rise atrapa
               el overlay fixed y no cubre el viewport ni queda bien apilado. #}
            <template x-teleport="body">
            <div x-show="tasksModal" x-cloak class="modal-backdrop" style="display: none;"
                 @keydown.escape.window="tasksModal = false">
                <div class="modal-content max-w-2xl w-full mx-4" @click.away="tasksModal = false">
                    <div class="modal-header flex items-center justify-between">
                        <h3 class="text-lg font-semibold text-slate-900">Intentos de envío</h3>
                        <button type="button" @click="tasksModal = false"
                                class="text-slate-400 hover:text-slate-600 transition-colors">
                            <i data-lucide="x" class="w-5 h-5"></i>
                        </button>
                    </div>
                    <div class="modal-body space-y-3 max-h-96 overflow-y-auto">
                        {% for task in agentTasks %}
                            <div class="border border-slate-200 rounded-lg p-3">
                                <div class="flex items-center justify-between gap-3 mb-1">
                                    <span class="text-sm font-medium text-slate-800">{{ task.typeLabel }}</span>
                                    {{ agent_task.status_badge(task) }}
                                </div>
                                <p class="text-xs text-slate-400 mb-1.5" style="font-family: 'JetBrains Mono', monospace;">
                                    {{ task.createdAt|date('d/m/Y H:i') }}
                                </p>
                                {% if task.status in ['failed', 'uncertain'] %}
                                    <p class="text-sm text-slate-600">{{ task.errorMessage|agent_error }}</p>
                                    {% if task.errorMessage %}
                                        <details class="mt-1.5">
                                            <summary class="text-xs text-slate-400 cursor-pointer hover:text-slate-600">Detalle técnico</summary>
                                            <code class="block mt-1 p-2 bg-slate-50 border border-slate-200 rounded text-xs text-slate-600 break-all whitespace-pre-wrap">{{ task.errorMessage }}</code>
                                        </details>
                                    {% endif %}
                                {% elseif task.status == 'done' %}
                                    <p class="text-sm text-slate-600">Envío completado correctamente.</p>
                                {% else %}
                                    <p class="text-sm text-slate-600">Envío en curso.</p>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                    <div class="modal-footer">
                        <button type="button" @click="tasksModal = false" class="btn btn-primary btn-sm">Cerrar</button>
                    </div>
                </div>
            </div>
            </template>
        </div>
    {% endif %}
{% endif %}

{# Organism name helper #}
{% set organismName = request.applicableLaw.complaintOrganism
    ? (request.applicableLaw.complaintOrganism.shortName ?? request.applicableLaw.complaintOrganism.name)
    : 'organismo competente' %}

{# Collect all summary blocks and sort by document date #}
{% set summaryBlocks = [] %}
{% for doc in request.documents %}
    {% set hasContent = (doc.aiMetadata.summary is defined and doc.aiMetadata.summary) or (doc.aiMetadata.keyPoints is defined and doc.aiMetadata.keyPoints) %}
    {% if doc.type.value == 'response' and hasContent %}
        {% set summaryBlocks = summaryBlocks|merge([doc]) %}
    {% elseif doc.type.value == 'complaint' and (hasContent or (doc.aiMetadata.citedResolutions is defined and doc.aiMetadata.citedResolutions|length > 0)) %}
        {% set summaryBlocks = summaryBlocks|merge([doc]) %}
    {% elseif doc.type.value == 'alegaciones' and doc.aiMetadata.alegationPoints is defined and doc.aiMetadata.alegationPoints %}
        {% set summaryBlocks = summaryBlocks|merge([doc]) %}
    {% elseif doc.type.value == 'alegation_response' and (hasContent or (doc.aiMetadata.citedResolutions is defined and doc.aiMetadata.citedResolutions|length > 0)) %}
        {% set summaryBlocks = summaryBlocks|merge([doc]) %}
    {% elseif doc.type.value == 'complaint_resolution' and hasContent %}
        {% set summaryBlocks = summaryBlocks|merge([doc]) %}
    {% endif %}
{% endfor %}

{% set summaryBlocks = summaryBlocks|sort((a, b) => (a.documentDate ?? a.createdAt) <=> (b.documentDate ?? b.createdAt)) %}

{# Dedupe: when the AI has extracted identical body text from two
   documents (same summary + keypoints), only keep the first chronological
   occurrence. Avoids visually-noisy "two reclamaciones with the same
   content" cases when there's a duplicate scan/upload of the same piece. #}
{% set seenBodies = [] %}
{% set dedupedBlocks = [] %}
{% for doc in summaryBlocks %}
    {% set bodyParts = [doc.aiMetadata.summary|default('')|trim] %}
    {% if doc.aiMetadata.keyPoints is defined and doc.aiMetadata.keyPoints %}
        {% for point in doc.aiMetadata.keyPoints %}
            {% set bodyParts = bodyParts|merge([point|trim]) %}
        {% endfor %}
    {% endif %}
    {% set bodyKey = bodyParts|join('|') %}
    {% if bodyKey == '|' or bodyKey == '' or bodyKey not in seenBodies %}
        {% if bodyKey != '' and bodyKey != '|' %}
            {% set seenBodies = seenBodies|merge([bodyKey]) %}
        {% endif %}
        {% set dedupedBlocks = dedupedBlocks|merge([doc]) %}
    {% endif %}
{% endfor %}
{% set summaryBlocks = dedupedBlocks %}

{% set complaintCount = 0 %}
{% set pendingHearingPiece = request.complaint
    and request.complaint.activeHearingProcess
    and request.complaint.status == 'reclaimed' %}
{% set piezaCount = summaryBlocks|length + 1 + (pendingHearingPiece ? 1 : 0) %}

<div class="grid lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2 space-y-8 rise rise-4">
        {# ── Actuaciones: el expediente en orden cronológico ── #}
        <section>
            <div class="exp-seccion">
                <span class="exp-seccion-nombre">Actuaciones</span>
                <span class="exp-seccion-filete"></span>
                <span class="exp-seccion-nota">{{ piezaCount }} pieza{{ piezaCount != 1 ? 's' : '' }} en el expediente</span>
            </div>

            <div class="space-y-4">
                {# Actuación inicial: la solicitud #}
                <article class="exp-hoja">
                    <div class="pieza-cab">
                        <span class="panel-icono panel-icono--curso"><i data-lucide="send"></i></span>
                        <div class="min-w-0 flex-1">
                            <h2 class="pieza-titulo">La solicitud</h2>
                            <p class="pieza-fecha">
                                {% if request.status == 'pending' %}
                                    {{ request.createdAt|date('d/m/Y') }} · pendiente de envío
                                {% else %}
                                    {{ request.sentAt|date('d/m/Y') }}{% if request.externalId %} · {{ request.externalId }}{% endif %}
                                {% endif %}
                            </p>
                        </div>
                        {% if request.status == 'pending' %}
                            <span class="badge badge-secondary">Pendiente de envío</span>
                        {% else %}
                            <span class="badge status-sent">Presentada</span>
                        {% endif %}
                    </div>
                    <div class="pieza-cuerpo">
                        <div class="exp-cita">
                            <div class="prose prose-sm prose-slate max-w-none">{{ request.description|markdown_to_html }}</div>
                        </div>
                    </div>
                </article>

                {% for doc in summaryBlocks %}
                    {% set docDate = doc.documentDate ?? doc.createdAt %}

                    {% if doc.type.value == 'response' %}
                        {% set responseStatus = doc.aiMetadata.status is defined ? doc.aiMetadata.status : null %}
                        {% set responseTone = responseStatus == 'concedida' ? 'exito' : (responseStatus == 'denegada' ? 'fallo' : 'curso') %}
                        <article class="exp-hoja">
                            <div class="pieza-cab">
                                <span class="panel-icono panel-icono--{{ responseTone }}">
                                    <i data-lucide="{{ responseStatus == 'concedida' ? 'file-check' : (responseStatus == 'denegada' ? 'file-x-2' : 'file-text') }}"></i>
                                </span>
                                <div class="min-w-0 flex-1">
                                    <h2 class="pieza-titulo">Respuesta de la administración</h2>
                                    <p class="pieza-fecha">{{ docDate|date('d/m/Y') }}</p>
                                </div>
                                {% if responseStatus == 'concedida' %}
                                    <span class="badge badge-success">Concedida</span>
                                {% elseif responseStatus == 'denegada' %}
                                    <span class="badge badge-danger">Denegada</span>
                                {% endif %}
                            </div>
                            <div class="pieza-cuerpo">
                                {% if doc.aiMetadata.keyPoints is defined and doc.aiMetadata.keyPoints %}
                                    <p class="pieza-intro">Puntos clave de la respuesta:</p>
                                    <ol class="exp-puntos exp-puntos--{{ responseTone }}">
                                        {% for point in doc.aiMetadata.keyPoints %}
                                            <li><span class="n">{{ loop.index }}</span> {{ point }}</li>
                                        {% endfor %}
                                    </ol>
                                {% elseif doc.aiMetadata.summary is defined and doc.aiMetadata.summary %}
                                    <p class="text-sm text-slate-600">{{ doc.aiMetadata.summary }}</p>
                                {% endif %}
                                {% if doc.aiMetadata.denialReason is defined and doc.aiMetadata.denialReason %}
                                    <div class="pieza-nota-roja">
                                        <b>Motivo de denegación</b>
                                        <span>{{ doc.aiMetadata.denialReason }}</span>
                                    </div>
                                {% endif %}
                                <a href="{{ path('app_document_download', {id: doc.id}) }}" class="pieza-doc">
                                    <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
                                    {{ doc.originalFilename }}
                                </a>
                            </div>
                        </article>

                    {% elseif doc.type.value == 'complaint' %}
                        {% set complaintCount = complaintCount + 1 %}
                        {% set complaintFiled = request.complaint is not null and request.complaint.filedAt is not null %}
                        {% set editRoute = (doc.aiMetadata.origin|default('ai')) == 'external' ? 'app_complaint_draft' : 'app_complaint_assistant' %}
                        {% if complaintFiled %}
                            {# Reclamación ya presentada: el borrador deja de ser la pieza activa, se muestra como referencia secundaria. #}
                            <div class="rounded-lg border border-slate-200 bg-slate-50/60 px-4 py-3 flex items-center gap-3">
                                <i data-lucide="pen-line" class="w-4 h-4 text-slate-400 flex-shrink-0"></i>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-slate-600 truncate">
                                        {% if complaintCount == 1 %}
                                            Borrador de la reclamación
                                        {% else %}
                                            Borrador de la ampliación
                                        {% endif %}
                                        <span class="ml-1 text-xs text-slate-400 font-normal">· {{ docDate|date('d/m/Y') }}</span>
                                    </p>
                                </div>
                                <a href="{{ path('app_complaint_pdf', {id: request.id}) }}"
                                   class="text-xs text-slate-500 hover:text-slate-800 inline-flex items-center gap-1"
                                   title="Descargar PDF del borrador">
                                    <i data-lucide="file-down" class="w-3.5 h-3.5"></i>
                                    PDF
                                </a>
                                <a href="{{ path(editRoute, {id: request.id}) }}"
                                   class="text-xs text-slate-500 hover:text-slate-800 inline-flex items-center gap-1"
                                   title="Ver el borrador">
                                    <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                                    Ver
                                </a>
                            </div>
                        {% else %}
                        <article class="exp-hoja">
                            <div class="pieza-cab">
                                <span class="panel-icono panel-icono--aviso"><i data-lucide="scale"></i></span>
                                <div class="min-w-0 flex-1">
                                    <h2 class="pieza-titulo">
                                        {% if complaintCount == 1 %}
                                            Reclamación ante el {{ organismName }}
                                        {% else %}
                                            Ampliación de la reclamación ante el {{ organismName }}
                                        {% endif %}
                                    </h2>
                                    <p class="pieza-fecha">{{ docDate|date('d/m/Y') }}</p>
                                </div>
                                <span class="badge badge-warning">Borrador</span>
                            </div>
                            <div class="pieza-cuerpo">
                                {% if doc.aiMetadata.keyPoints is defined and doc.aiMetadata.keyPoints %}
                                    <p class="pieza-intro">Argumentos principales de la reclamación:</p>
                                    <ol class="exp-puntos exp-puntos--ambar">
                                        {% for point in doc.aiMetadata.keyPoints %}
                                            <li><span class="n">{{ loop.index }}</span> {{ point }}</li>
                                        {% endfor %}
                                    </ol>
                                {% elseif doc.aiMetadata.summary is defined and doc.aiMetadata.summary %}
                                    <p class="text-sm text-slate-600">{{ doc.aiMetadata.summary }}</p>
                                {% endif %}
                                {% if doc.aiMetadata.citedResolutions is defined and doc.aiMetadata.citedResolutions|length > 0 %}
                                    <div class="mt-3">
                                        <p class="text-sm font-medium text-slate-700 mb-2">Resoluciones citadas:</p>
                                        <ul class="space-y-2">
                                            {% for res in doc.aiMetadata.citedResolutions %}
                                                <li class="text-sm text-slate-600 flex items-start gap-2">
                                                    <i data-lucide="bookmark" class="w-4 h-4 text-amber-500 flex-shrink-0 mt-0.5"></i>
                                                    <span>
                                                        <strong>{{ res.reference }}</strong>
                                                        {% if res.date %}<span class="text-slate-400 ml-1">({{ res.date }})</span>{% endif %}
                                                        {% if res.excerpt %}<br><span class="text-slate-500">{{ res.excerpt }}</span>{% endif %}
                                                    </span>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                {% endif %}
                                {# Use the body-level-aware getter so AGE requests get the state CTBG form, not the autonomic one. #}
                                {% set complaintFormUrl = request.applicableLaw.complaintOrganism ? request.applicableLaw.complaintOrganism.complaintFormUrlFor(request) : null %}
                                <div class="pieza-acciones"
                                     x-data="{
                                        openAgentModal: false,
                                        agentMode: 'supervised',
                                        async presentNow() {
                                            const store = this.$store.agentPresent;
                                            if (store.busy) return;
                                            this.openAgentModal = false;
                                            store.open('reclamación');
                                            try {
                                                const res = await fetch('{{ path('app_complaint_present_via_agent', {id: request.id}) }}', {
                                                    method: 'POST',
                                                    headers: { 'Content-Type': 'application/json' },
                                                    body: JSON.stringify({ mode: this.agentMode }),
                                                });
                                                const data = await res.json();
                                                if (!res.ok) { store.fail(data.error || 'No se pudo encolar la tarea.'); return; }
                                                store.track([{ id: data.taskId, statusUrl: data.statusUrl, schemeUrl: data.schemeUrl }], { entityLabel: 'reclamación' });
                                            } catch (e) { store.fail('Error de red.'); }
                                        }
                                     }">

                                    {% if complaintFormUrl %}
                                        <button type="button"
                                                class="btn btn-accent btn-sm"
                                                @click="openAgentModal = true">
                                            <i data-lucide="bot" class="w-4 h-4 mr-1.5"></i>
                                            Presentar con el agente
                                        </button>
                                        <button type="button"
                                                class="btn btn-secondary btn-sm"
                                                onclick="window.open({{ complaintFormUrl|json_encode|raw }}, '_blank', 'noopener,noreferrer'); document.getElementById('complaint-pdf-download-{{ doc.id }}').click();">
                                            <i data-lucide="upload-cloud" class="w-4 h-4 mr-1.5"></i>
                                            Iniciar manual
                                        </button>
                                        <a id="complaint-pdf-download-{{ doc.id }}"
                                           href="{{ path('app_complaint_pdf', {id: request.id}) }}"
                                           class="hidden"
                                           download></a>
                                    {% endif %}
                                    <a href="{{ path('app_complaint_pdf', {id: request.id}) }}" class="btn btn-secondary btn-sm">
                                        <i data-lucide="file-down" class="w-4 h-4 mr-1.5"></i>
                                        PDF
                                    </a>
                                    <a href="{{ path('app_complaint_word', {id: request.id}) }}" class="btn btn-secondary btn-sm">
                                        <i data-lucide="file-down" class="w-4 h-4 mr-1.5"></i>
                                        Word
                                    </a>
                                    <a href="{{ path(editRoute, {id: request.id}) }}" class="text-xs text-slate-500 hover:text-slate-800 inline-flex items-center gap-1">
                                        <i data-lucide="pen-line" class="w-3.5 h-3.5"></i>
                                        Editar
                                    </a>
                                    {# Modo modal — Alpine controlled. x-teleport al <body>: los
                                       ancestros animados (.rise, fill both) son containing block
                                       de position:fixed y atraparían el overlay. #}
                                    <template x-teleport="body">
                                    <div x-show="openAgentModal" x-cloak
                                         class="fixed inset-0 z-50 flex items-center justify-center bg-black/40"
                                         style="display: none;"
                                         @keydown.escape.window="openAgentModal = false">
                                        <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6" @click.outside="openAgentModal = false">
                                            <h3 class="font-semibold text-slate-800 mb-2">Presentar con el agente</h3>
                                            <p class="text-sm text-slate-600 mb-4">Elige cómo quieres que el agente proceda en la sede del Consejo:</p>

                                            <label class="flex items-start gap-3 p-3 rounded-lg border border-slate-200 mb-2 cursor-pointer hover:border-primary-400">
                                                <input type="radio" name="agent-mode" value="supervised" x-model="agentMode" class="mt-1">
                                                <span>
                                                    <span class="block font-medium text-slate-800">Supervisado</span>
                                                    <span class="block text-xs text-slate-500">El agente rellena el formulario; tú revisas y pulsas «Enviar».</span>
                                                </span>
                                            </label>

                                            <label class="flex items-start gap-3 p-3 rounded-lg border border-slate-200 mb-4 cursor-pointer hover:border-primary-400">
                                                <input type="radio" name="agent-mode" value="auto" x-model="agentMode" class="mt-1">
                                                <span>
                                                    <span class="block font-medium text-slate-800">Automático</span>
                                                    <span class="block text-xs text-slate-500">El agente envía la reclamación por ti, sin intervención adicional.</span>
                                                </span>
                                            </label>

                                            <div class="flex justify-end gap-2">
                                                <button type="button" class="btn btn-ghost btn-sm" @click="openAgentModal = false">Cancelar</button>
                                                <button type="button" class="btn btn-accent btn-sm"
                                                        @click="presentNow()">
                                                    Lanzar agente
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    </template>
                                </div>
                                <a href="{{ path('app_document_download', {id: doc.id}) }}" class="pieza-doc">
                                    <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
                                    {{ doc.originalFilename }}
                                </a>
                            </div>
                        </article>
                        {% endif %}

                    {% elseif doc.type.value == 'alegaciones' %}
                        <article class="exp-hoja">
                            <div class="pieza-cab">
                                <span class="panel-icono panel-icono--fallo"><i data-lucide="shield-alert"></i></span>
                                <div class="min-w-0 flex-1">
                                    <h2 class="pieza-titulo">Alegaciones de la administración</h2>
                                    <p class="pieza-fecha">{{ docDate|date('d/m/Y') }}</p>
                                </div>
                            </div>
                            <div class="pieza-cuerpo">
                                <p class="pieza-intro">Argumentos principales presentados por la Administración en su defensa:</p>
                                <ol class="exp-puntos exp-puntos--fallo">
                                    {% for point in doc.aiMetadata.alegationPoints %}
                                        <li><span class="n">{{ loop.index }}</span> {{ point }}</li>
                                    {% endfor %}
                                </ol>
                                <a href="{{ path('app_document_download', {id: doc.id}) }}" class="pieza-doc">
                                    <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
                                    {{ doc.originalFilename }}
                                </a>
                            </div>
                        </article>

                    {% elseif doc.type.value == 'alegation_response' %}
                        <article class="exp-hoja">
                            <div class="pieza-cab">
                                <span class="panel-icono panel-icono--curso"><i data-lucide="reply"></i></span>
                                <div class="min-w-0 flex-1">
                                    <h2 class="pieza-titulo">Respuesta a las alegaciones</h2>
                                    <p class="pieza-fecha">{{ docDate|date('d/m/Y') }}</p>
                                </div>
                            </div>
                            <div class="pieza-cuerpo">
                                {% if doc.aiMetadata.keyPoints is defined and doc.aiMetadata.keyPoints %}
                                    <p class="pieza-intro">Contraargumentos principales:</p>
                                    <ol class="exp-puntos exp-puntos--curso">
                                        {% for point in doc.aiMetadata.keyPoints %}
                                            <li><span class="n">{{ loop.index }}</span> {{ point }}</li>
                                        {% endfor %}
                                    </ol>
                                {% elseif doc.aiMetadata.summary is defined and doc.aiMetadata.summary %}
                                    <p class="text-sm text-slate-600">{{ doc.aiMetadata.summary }}</p>
                                {% endif %}
                                {% if doc.aiMetadata.citedResolutions is defined and doc.aiMetadata.citedResolutions|length > 0 %}
                                    <div class="mt-3">
                                        <p class="text-sm font-medium text-slate-700 mb-2">Resoluciones citadas:</p>
                                        <ul class="space-y-2">
                                            {% for res in doc.aiMetadata.citedResolutions %}
                                                <li class="text-sm text-slate-600 flex items-start gap-2">
                                                    <i data-lucide="bookmark" class="w-4 h-4 text-blue-500 flex-shrink-0 mt-0.5"></i>
                                                    <span>
                                                        <strong>{{ res.reference }}</strong>
                                                        {% if res.date %}<span class="text-slate-400 ml-1">({{ res.date }})</span>{% endif %}
                                                        {% if res.excerpt %}<br><span class="text-slate-500">{{ res.excerpt }}</span>{% endif %}
                                                    </span>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                {% endif %}
                                <a href="{{ path('app_document_download', {id: doc.id}) }}" class="pieza-doc">
                                    <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
                                    {{ doc.originalFilename }}
                                </a>
                            </div>
                        </article>

                    {% elseif doc.type.value == 'complaint_resolution' %}
                        {% set resolutionStatus = doc.aiMetadata.status is defined ? doc.aiMetadata.status : null %}
                        {% set resolutionTone = resolutionStatus == 'concedida' ? 'exito' : (resolutionStatus == 'denegada' ? 'fallo' : 'curso') %}
                        <article class="exp-hoja">
