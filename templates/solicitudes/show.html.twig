{% extends 'layouts/app.html.twig' %}

{% block title %}{{ request.title }} - PideInfo{% endblock %}

{% block content %}
{# Breadcrumb #}
<nav class="flex items-center gap-2 text-sm mb-6">
    <a href="{{ path('app_solicitudes_index') }}" class="text-slate-500 hover:text-primary-600 transition-colors">
        Solicitudes
    </a>
    <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
    <span class="text-slate-800 font-medium truncate max-w-xs">{{ request.title|u.truncate(30) }}</span>
</nav>

{# Header #}
<div class="flex flex-col sm:flex-row justify-between items-start gap-4 mb-8">
    <div class="min-w-0">
        <h1 class="text-2xl font-bold text-slate-800">{{ request.title }}</h1>
        <div class="flex flex-wrap items-center gap-3 mt-2 text-sm text-slate-500">
            <span class="flex items-center gap-1">
                <i data-lucide="building" class="w-4 h-4"></i>
                {{ request.publicBody.name }}
            </span>
            {% if request.externalId %}
                <span class="flex items-center gap-1 text-primary-600">
                    <i data-lucide="hash" class="w-4 h-4"></i>
                    {{ request.externalId }}
                </span>
            {% endif %}
        </div>
    </div>
    <a href="{{ path('app_solicitudes_edit', {id: request.id}) }}" class="btn btn-secondary flex-shrink-0">
        <i data-lucide="pencil" class="w-4 h-4 mr-2"></i>
        Editar
    </a>
</div>

{# Redirection notice #}
{% if request.wasRedirected %}
    <div class="alert alert-info mb-6">
        <i data-lucide="arrow-right-circle" class="w-5 h-5 flex-shrink-0"></i>
        <div class="flex-1">
            <p class="font-medium">Solicitud trasladada</p>
            <p class="text-sm mt-1">
                Esta solicitud fue trasladada de <strong>{{ request.originalPublicBody.name }}</strong>
                a <strong>{{ request.publicBody.name }}</strong>
                {% if request.redirectedAt %}el {{ request.redirectedAt|date('d/m/Y') }}{% endif %}
                (art. 19.1 Ley 19/2013).
            </p>
        </div>
    </div>
{% endif %}

{# Third party allegations notice #}
{% if request.isDeadlineSuspended %}
    <div class="alert alert-warning mb-6">
        <i data-lucide="pause-circle" class="w-5 h-5 flex-shrink-0"></i>
        <div class="flex-1">
            <p class="font-medium">Plazo suspendido</p>
            <p class="text-sm mt-1">
                El plazo está suspendido por afectación a derechos de terceros.
                {% if request.thirdPartyAllegationsDeadlineAt %}
                    Plazo de alegaciones hasta el {{ request.thirdPartyAllegationsDeadlineAt|date('d/m/Y') }}.
                {% endif %}
                Quedan {{ request.suspendedDaysRemaining }} días hábiles cuando se reanude.
            </p>
        </div>
    </div>
{% endif %}

<div class="grid lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
        {# Main Info #}
        <div class="card">
            <div class="card-header">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary-100 flex items-center justify-center">
                        <i data-lucide="file-text" class="w-5 h-5 text-primary-600"></i>
                    </div>
                    <h2 class="font-semibold text-slate-800">Información de la solicitud</h2>
                </div>
            </div>
            <div class="card-body">
                <h3 class="text-sm font-medium text-slate-700 mb-2">Descripción</h3>
                <p class="text-slate-600 whitespace-pre-line">{{ request.description }}</p>

                <div class="border-t border-slate-100 mt-6 pt-6 grid sm:grid-cols-2 gap-6">
                    <div>
                        <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">Ley aplicable</h4>
                        <p class="text-slate-800">{{ request.applicableLaw.name }}</p>
                    </div>
                    <div>
                        <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">Fecha de envío</h4>
                        <p class="text-slate-800">{{ request.sentAt|date('d/m/Y') }}</p>
                    </div>
                </div>
            </div>
        </div>

        {# Documents #}
        <div class="card"
             data-controller="file-uploader"
             data-file-uploader-url-value="{{ path('app_document_upload') }}"
             data-file-uploader-access-request-id-value="{{ request.id }}">
            <div class="card-header">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-primary-100 flex items-center justify-center">
                            <i data-lucide="paperclip" class="w-5 h-5 text-primary-600"></i>
                        </div>
                        <h2 class="font-semibold text-slate-800">Documentos</h2>
                    </div>
                    <label class="btn btn-primary btn-sm cursor-pointer">
                        <i data-lucide="upload" class="w-4 h-4 mr-2"></i>
                        Subir
                        <input type="file" class="hidden" multiple
                               accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.gif"
                               data-file-uploader-target="input"
                               data-action="change->file-uploader#selectFiles">
                    </label>
                </div>
            </div>
            <div class="card-body">
                <div data-file-uploader-target="status"></div>

                {% if request.documents|length > 0 %}
                    <div class="space-y-3">
                        {% for doc in request.documents %}
                            <div class="flex items-center justify-between p-4 rounded-xl bg-slate-50 hover:bg-slate-100 transition-colors" data-document-id="{{ doc.id }}">
                                <div class="flex items-center gap-3 min-w-0">
                                    <div class="w-10 h-10 rounded-lg {{ doc.isPdf ? 'bg-red-100' : (doc.isImage ? 'bg-blue-100' : 'bg-slate-200') }} flex items-center justify-center flex-shrink-0">
                                        <i data-lucide="{{ doc.isPdf ? 'file-text' : (doc.isImage ? 'image' : 'file') }}"
                                           class="w-5 h-5 {{ doc.isPdf ? 'text-red-600' : (doc.isImage ? 'text-blue-600' : 'text-slate-600') }}"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <p class="font-medium text-slate-800 truncate">{{ doc.originalFilename }}</p>
                                        <p class="text-sm text-slate-500">{{ doc.typeLabel }} - {{ doc.fileSizeFormatted }}</p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="badge {{ doc.processed ? 'badge-success' : 'badge-warning' }}">
                                        {{ doc.processed ? 'Procesado' : 'Pendiente' }}
                                    </span>
                                    <a href="{{ path('app_document_download', {id: doc.id}) }}"
                                       class="btn btn-ghost btn-sm"
                                       title="Descargar">
                                        <i data-lucide="download" class="w-4 h-4"></i>
                                    </a>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="empty-state py-8">
                        <div class="empty-state-icon">
                            <i data-lucide="file" class="w-full h-full"></i>
                        </div>
                        <p class="empty-state-title">Sin documentos</p>
                        <p class="empty-state-description">No hay documentos adjuntos a esta solicitud</p>
                    </div>
                {% endif %}

                <div data-file-uploader-target="preview" class="mt-4 space-y-2"></div>
            </div>
        </div>

        {# Timeline #}
        <div class="card">
            <div class="card-header">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary-100 flex items-center justify-center">
                        <i data-lucide="history" class="w-5 h-5 text-primary-600"></i>
                    </div>
                    <h2 class="font-semibold text-slate-800">Historial</h2>
                </div>
            </div>
            <div class="card-body">
                {% if request.statusHistory|length > 0 %}
                    <div class="space-y-4">
                        {% for history in request.statusHistory %}
                            {# Determine icon and color based on event type #}
                            {% set isRedirection = 'trasladada' in (history.notes|default('')|lower) %}
                            {% set isThirdParty = 'terceros' in (history.notes|default('')|lower) %}
                            {% set isProcessingStart = 'inicio de tramitación' in (history.notes|default('')|lower) %}
                            {% set isExtension = history.reason|default('') == 'extension' %}

                            {% set dotColor = 'bg-primary-500' %}
                            {% set icon = 'circle' %}
                            {% if isRedirection %}
                                {% set dotColor = 'bg-blue-500' %}
                                {% set icon = 'arrow-right-circle' %}
                            {% elseif isThirdParty %}
                                {% set dotColor = 'bg-amber-500' %}
                                {% set icon = 'users' %}
                            {% elseif isProcessingStart %}
                                {% set dotColor = 'bg-green-500' %}
                                {% set icon = 'play-circle' %}
                            {% elseif isExtension %}
                                {% set dotColor = 'bg-orange-500' %}
                                {% set icon = 'clock' %}
                            {% elseif history.toStatus == 'granted' %}
                                {% set dotColor = 'bg-emerald-500' %}
                                {% set icon = 'check-circle' %}
                            {% elseif history.toStatus == 'denied' %}
                                {% set dotColor = 'bg-red-500' %}
                                {% set icon = 'x-circle' %}
                            {% endif %}

                            {# Use entity method to get translated status label #}
                            {% set statusLabel = history.toStatusLabel %}

                            {# Map status to badge classes #}
                            {% set statusBadgeClass = {
                                'sent': 'status-sent',
                                'processing': 'status-processing',
                                'granted': 'status-granted',
                                'denied': 'status-denied',
                                'delayed': 'status-delayed',
                                'pending': 'status-pending'
                            } %}
                            {% set badgeClass = statusBadgeClass[history.toStatus]|default('badge-secondary') %}

                            <div class="flex gap-4 pb-4 {{ not loop.last ? 'border-b border-slate-100' : '' }}">
                                <div class="w-8 h-8 rounded-full {{ dotColor }} flex items-center justify-center flex-shrink-0">
                                    <i data-lucide="{{ icon }}" class="w-4 h-4 text-white"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                                        <div>
                                            {% if isRedirection %}
                                                <span class="font-medium text-blue-700">Solicitud trasladada</span>
                                            {% elseif isThirdParty %}
                                                <span class="font-medium text-amber-700">Afectación a terceros</span>
                                            {% elseif isProcessingStart %}
                                                <span class="font-medium text-green-700">Inicio de tramitación</span>
                                            {% else %}
                                                <span class="font-medium text-slate-800">{{ history.statusTypeLabel }}</span>
                                                <span class="text-slate-400 mx-2">→</span>
                                                <span class="badge {{ badgeClass }}">{{ statusLabel }}</span>
                                            {% endif %}
                                        </div>
                                        <span class="text-sm text-slate-500 flex-shrink-0">{{ history.createdAt|date('d/m/Y H:i') }}</span>
                                    </div>
                                    {% if history.notes %}
                                        <p class="text-sm text-slate-600 mt-2">{{ history.notes }}</p>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-slate-500 text-center py-4">Sin cambios de estado registrados</p>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="lg:col-span-1 space-y-6">
        {# Status Card #}
        <div class="card">
            <div class="card-header">
                <h2 class="font-semibold text-slate-800">Estado actual</h2>
            </div>
            <div class="card-body space-y-4">
                <div>
                    <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Estado principal</h4>
                    {% set statusClass = {
                        'sent': 'status-sent',
                        'processing': 'status-processing',
                        'granted': 'status-granted',
                        'denied': 'status-denied',
                        'delayed': 'status-delayed',
                        'pending': 'status-pending'
                    } %}
                    <span class="badge {{ statusClass[request.status]|default('badge-secondary') }} text-sm px-3 py-1">
                        {{ request.statusLabel }}
                    </span>
                </div>

                {% if request.isDeadlineSuspended %}
                    <div>
                        <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Plazo</h4>
                        <span class="badge badge-warning text-sm px-3 py-1">Plazo suspendido</span>
                        <p class="text-sm text-slate-600 mt-2">
                            El plazo está suspendido por afectación a derechos de terceros.
                            {% if request.thirdPartyAllegationsDeadlineAt %}
                                Plazo de alegaciones hasta el {{ request.thirdPartyAllegationsDeadlineAt|date('d/m/Y') }}.
                            {% endif %}
                            Quedan {{ request.suspendedDaysRemaining }} días hábiles cuando se reanude.
                        </p>
                    </div>
                {% endif %}

                {% if request.complaintStatus != 'none' %}
                    <div>
                        <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Reclamación</h4>
                        <span class="badge badge-info text-sm px-3 py-1">{{ request.complaintStatusLabel }}</span>
                        {% if request.applicableLaw.complaintOrganism %}
                            <p class="text-sm text-slate-600 mt-2">
                                Ante: <a href="{{ request.applicableLaw.complaintOrganism.url }}" target="_blank" class="text-primary-600 hover:underline">
                                    {{ request.applicableLaw.complaintOrganism.shortName ?? request.applicableLaw.complaintOrganism.name }}
                                </a>
                            </p>
                        {% endif %}
                    </div>
                {% endif %}

                {% if request.courtStatus != 'none' %}
                    <div>
                        <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Vía judicial</h4>
                        <span class="badge badge-secondary text-sm px-3 py-1">{{ request.courtStatusLabel }}</span>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Deadlines Card #}
        <div class="card">
            <div class="card-header">
                <h2 class="font-semibold text-slate-800">Plazos</h2>
            </div>
            <div class="card-body space-y-4">
                <div>
                    <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Plazo de respuesta</h4>
                    {% if request.isDeadlineSuspended %}
                        <div class="flex items-center gap-2">
                            <span class="badge badge-warning font-bold">PLAZO SUSPENDIDO</span>
                        </div>
                        <p class="text-sm text-slate-500 mt-2">
                            {% if request.thirdPartyAllegationsDeadlineAt %}
                                Alegaciones hasta {{ request.thirdPartyAllegationsDeadlineAt|date('d/m/Y') }}
                            {% endif %}
                        </p>
                    {% else %}
                        <div class="flex items-center gap-2">
                            <span class="font-semibold {{ request.isDeadlinePassed ? 'text-red-600' : 'text-slate-800' }}">
                                {{ request.deadlineAt|date('d/m/Y') }}
                            </span>
                            {% if request.isDeadlinePassed %}
                                <span class="badge badge-danger">Vencido</span>
                            {% else %}
                                <span class="text-sm text-slate-500">({{ request.daysUntilDeadline }} días)</span>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>

                {% if request.extensionCount > 0 %}
                    <div>
                        <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Prórroga</h4>
                        <span class="badge badge-info">{{ request.extensionCount }} aplicada(s)</span>
                    </div>
                {% endif %}

                {% if request.complaintDeadlineAt %}
                    <div>
                        <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Plazo resolución reclamación</h4>
                        {% set complaintPassed = date() > request.complaintDeadlineAt %}
                        <div class="flex items-center gap-2">
                            <span class="font-semibold {{ complaintPassed ? 'text-red-600' : 'text-slate-800' }}">
                                {{ request.complaintDeadlineAt|date('d/m/Y') }}
                            </span>
                            {% if complaintPassed %}
                                <span class="badge badge-danger">Vencido</span>
                            {% endif %}
                        </div>
                        {% if request.applicableLaw.complaintOrganism %}
                            <p class="text-xs text-slate-500 mt-1">
                                {{ request.applicableLaw.complaintOrganism.shortName ?? request.applicableLaw.complaintOrganism.name }} tiene 3 meses para resolver
                            </p>
                        {% endif %}
                    </div>
                {% endif %}

                {% if request.complianceDeadlineAt %}
                    <div>
                        <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Plazo de cumplimiento</h4>
                        <span class="font-semibold text-slate-800">{{ request.complianceDeadlineAt|date('d/m/Y') }}</span>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Custom Deadlines Card #}
        <div class="card">
            <div class="card-header">
                <div class="flex items-center justify-between">
                    <h2 class="font-semibold text-slate-800">Recordatorios</h2>
                    <a href="{{ path('app_solicitudes_deadline_new', {id: request.id}) }}" class="btn btn-primary btn-sm">
                        <i data-lucide="plus" class="w-4 h-4 mr-1"></i>
                        Nuevo
                    </a>
                </div>
            </div>
            <div class="card-body">
                {% if request.customDeadlines|length > 0 %}
                    <div class="space-y-3">
                        {% for deadline in request.customDeadlines %}
                            <div class="p-3 rounded-lg bg-slate-50 {{ deadline.isPassed ? 'border-l-4 border-red-400' : '' }}">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="font-medium text-slate-800 text-sm">{{ deadline.deadlineAt|date('d/m/Y') }}</span>
                                            {% if deadline.notifyTime %}
                                                <span class="text-xs text-slate-500">{{ deadline.notifyTime|date('H:i') }}</span>
                                            {% endif %}
                                            {% if deadline.isPassed %}
                                                <span class="badge badge-danger text-xs">Vencido</span>
                                            {% elseif deadline.daysUntil <= 3 %}
                                                <span class="badge badge-warning text-xs">{{ deadline.daysUntil }} días</span>
                                            {% else %}
                                                <span class="badge badge-info text-xs">{{ deadline.daysUntil }} días</span>
                                            {% endif %}
                                        </div>
                                        <p class="text-sm text-slate-600 line-clamp-2">{{ deadline.description }}</p>
                                        <div class="flex items-center gap-2 mt-1">
                                            {% if deadline.notifiedDayBeforeAt %}
                                                <span class="text-xs text-green-600" title="Notificado día anterior: {{ deadline.notifiedDayBeforeAt|date('d/m/Y H:i') }}">
                                                    <i data-lucide="mail-check" class="w-3 h-3 inline"></i> día anterior
                                                </span>
                                            {% endif %}
                                            {% if deadline.notifiedAt %}
                                                <span class="text-xs text-green-600" title="Notificado mismo día: {{ deadline.notifiedAt|date('d/m/Y H:i') }}">
                                                    <i data-lucide="mail-check" class="w-3 h-3 inline"></i> mismo día
                                                </span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <a href="{{ path('app_solicitudes_deadline_edit', {id: request.id, deadlineId: deadline.id}) }}"
                                           class="btn btn-ghost btn-sm p-1"
                                           title="Editar">
                                            <i data-lucide="pencil" class="w-4 h-4"></i>
                                        </a>
                                        <form action="{{ path('app_solicitudes_deadline_delete', {id: request.id, deadlineId: deadline.id}) }}"
                                              method="post"
                                              class="inline"
                                              onsubmit="return confirm('¿Eliminar este recordatorio?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete-deadline-' ~ deadline.id) }}">
                                            <button type="submit" class="btn btn-ghost btn-sm p-1 text-red-600 hover:text-red-700" title="Eliminar">
                                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center py-4">
                        <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-3">
                            <i data-lucide="bell-off" class="w-6 h-6 text-slate-400"></i>
                        </div>
                        <p class="text-sm text-slate-500">Sin recordatorios programados</p>
                        <p class="text-xs text-slate-400 mt-1">Crea recordatorios para seguimientos informales</p>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Actions Card #}
        <div class="card">
            <div class="card-header">
                <h2 class="font-semibold text-slate-800">Acciones</h2>
            </div>
            <div class="card-body space-y-3">
                {% set canComplain = (request.status in ['denied', 'delayed']) or (request.isDeadlinePassed and request.status not in ['granted']) %}
                {% if canComplain and request.complaintStatus == 'none' %}
                    <a href="{{ path('app_complaint_generate', {id: request.id}) }}" class="btn btn-accent w-full">
                        <i data-lucide="alert-triangle" class="w-4 h-4 mr-2"></i>
                        Generar reclamación
                    </a>
                    {% if request.applicableLaw.complaintOrganism %}
                        <p class="text-xs text-slate-500 text-center mt-1">
                            Ante {{ request.applicableLaw.complaintOrganism.shortName ?? request.applicableLaw.complaintOrganism.name }}
                        </p>
                    {% endif %}
                {% endif %}

                <a href="#" class="btn btn-secondary w-full">
                    <i data-lucide="download" class="w-4 h-4 mr-2"></i>
                    Exportar historial
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
