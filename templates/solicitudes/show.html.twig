                                {% elseif doc.aiMetadata.summary is defined and doc.aiMetadata.summary %}
                                    <p class="text-sm text-slate-600">{{ doc.aiMetadata.summary }}</p>
                                {% endif %}
                                <a href="{{ path('app_document_download', {id: doc.id}) }}" class="pieza-doc">
                                    <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
                                    {{ doc.originalFilename }}
                                </a>
                            </div>
                        </article>
                    {% endif %}
                {% endfor %}

                {# Pieza pendiente: tus alegaciones al trámite de audiencia #}
                {% if pendingHearingPiece %}
                    {% set hearing = request.complaint.activeHearingProcess %}
                    <article class="exp-hoja pieza--pendiente">
                        <div class="pieza-cab" style="padding-bottom: .85rem;">
