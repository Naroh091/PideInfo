{% extends 'layouts/app.html.twig' %}

{% block title %}Solicitudes - PideInfo{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <meta name="turbo-visit-control" content="reload">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.3/css/dataTables.dataTables.min.css">
    <style>
        /* ─────────────────────────────────────────────────────────────
           PAGE-SCOPED STYLES — investigative casebook
           Respect the existing palette: primary (sky), accent (amber),
           slate as neutrals. No new colors.
           ───────────────────────────────────────────────────────────── */

        .casebook-eyebrow {
            font-family: 'DM Sans', sans-serif;
            font-size: .85rem;
            font-weight: 600;
            color: var(--color-primary-600, #0284c7);
        }

        .casebook-title {
            font-family: 'DM Serif Display', Georgia, serif;
            font-weight: 400;
            line-height: 1.05;
            letter-spacing: -0.015em;
            color: rgb(15 23 42);
        }

        .micro-label {
            font-family: 'DM Sans', sans-serif;
            font-size: .78rem;
            font-weight: 600;
            color: rgb(100 116 139);
        }

        /* ── The metric ribbon ── */
        /* Responsive grid: 3 cols on small, 5 on md, 9 on large.
           Chips share width equally; never overflow horizontally. */
        /* ── Índice de estados: línea tipográfica con trazo de
           rotulador bajo la pestaña activa (maqueta solicitudes-a v2) ── */
        .sol-indice {
            display: flex;
            flex-wrap: wrap;
            gap: 0 1.4rem;
            margin-top: 1.25rem;
            border-bottom: 1px solid rgb(203 213 225);
        }
        .sol-tab {
            position: relative;
            display: inline-flex;
            align-items: baseline;
            gap: .4rem;
            padding: .5rem 0 .65rem;
            text-decoration: none;
            font-family: 'DM Sans', sans-serif;
            font-size: .85rem;
            font-weight: 500;
            color: rgb(71 85 105);
        }
        .sol-tab b {
            font-family: 'JetBrains Mono', monospace;
            font-size: .78rem;
            font-weight: 600;
            color: rgb(100 116 139);
            font-variant-numeric: tabular-nums;
        }
        .sol-tab:hover { color: rgb(15 23 42); }
        .sol-tab.is-active { color: rgb(15 23 42); font-weight: 600; }
        .sol-tab.is-active::after {
            content: '';
            position: absolute;
            left: -2%; right: -2%; bottom: -2px;
            height: .32rem;
            background: var(--color-accent-200);
            border-radius: .12rem .3rem .25rem .15rem;
            transform: rotate(-.5deg);
        }
        .sol-tab.is-zero { opacity: .45; }
        .sol-tab-dot {
            width: .45rem; height: .45rem;
            border-radius: 999px;
            align-self: center;
            flex-shrink: 0;
        }

        /* ── Toolbar ── */
        .toolbar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: .5rem;
            margin-top: 1rem;
        }
        .toolbar-search {
            position: relative;
            flex: 1 1 18rem;
            min-width: 14rem;
        }
        .toolbar-search input {
            width: 100%;
            height: 2.5rem;
            padding: 0 2.25rem 0 2.5rem;
            border-radius: .65rem;
            border: 1px solid rgb(226 232 240);
            background: white;
            font-size: .9rem;
            color: rgb(15 23 42);
            transition: border-color .15s ease, box-shadow .15s ease;
        }
        .toolbar-search input:focus {
            outline: none;
            border-color: rgb(14 165 233);
            box-shadow: 0 0 0 3px rgba(14,165,233,.10);
        }
        .toolbar-search-icon {
            position: absolute;
            left: .8rem; top: 50%;
            transform: translateY(-50%);
            color: rgb(148 163 184);
            pointer-events: none;
        }
        .toolbar-search-loading {
            position: absolute;
            right: .8rem; top: 50%;
            transform: translateY(-50%);
            color: rgb(148 163 184);
        }

        .toolbar-divider {
            width: 1px; height: 1.5rem;
            background: rgb(226 232 240);
            margin: 0 .25rem;
        }

        /* ── Active filter chips bar ── */
        .filter-chips {
            display: flex; flex-wrap: wrap;
            gap: .4rem;
            padding-top: .8rem;
        }
        .filter-chip {
            display: inline-flex; align-items: center;
            gap: .4rem;
            padding: .3rem .6rem .3rem .7rem;
            background: rgb(240 249 255);
            border: 1px solid rgb(186 230 253);
            border-radius: 999px;
            font-family: 'Inter', sans-serif;
            font-size: .72rem;
            font-weight: 500;
            color: rgb(7 89 133);
            text-decoration: none;
            transition: background .15s ease, border-color .15s ease;
        }
        .filter-chip:hover {
            background: rgb(224 242 254);
            border-color: rgb(125 211 252);
        }
        .filter-chip-key {
            font-weight: 600;
            font-size: .75rem;
            color: rgb(2 132 199);
        }
        .filter-chip-x {
            display: inline-flex; align-items: center; justify-content: center;
            width: 1rem; height: 1rem;
            border-radius: 999px;
            background: rgba(2,132,199,.14);
            color: rgb(2 132 199);
        }
        .filter-clear-all {
            display: inline-flex; align-items: center;
            gap: .3rem;
            padding: .3rem .65rem;
            border-radius: 999px;
            font-family: 'Inter', sans-serif;
            font-size: .7rem;
            font-weight: 600;
            color: rgb(100 116 139);
            border: 1px dashed rgb(203 213 225);
            text-decoration: none;
            transition: color .15s ease, border-color .15s ease;
        }
        .filter-clear-all:hover {
            color: rgb(220 38 38);
            border-color: rgb(252 165 165);
            border-style: solid;
        }

        /* ── Table card ── */
        .table-card {
            background: white;
            border: 1px solid rgb(226 232 240);
            border-radius: 1rem;
            padding: .25rem 1rem 1rem;
            min-width: 0;
            margin-top: 1.5rem;
            box-shadow: 0 14px 40px -30px rgba(15, 23, 42, .25);
        }

        /* ── List selector (toolbar) ── */
        .toolbar-lists {
            position: relative;
            flex: 0 0 auto;
        }
        .toolbar-lists-button {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            height: 2.5rem;
            padding: 0 .85rem;
            border-radius: .65rem;
            border: 1px solid rgb(226 232 240);
            background: white;
            font-family: 'DM Sans', sans-serif;
            font-size: .85rem;
            color: rgb(51 65 85);
            cursor: pointer;
            transition: border-color .15s ease, background .15s ease;
        }
        .toolbar-lists-button:hover {
            border-color: rgb(186 230 253);
            background: rgb(248 250 252);
        }
        .toolbar-lists-button.is-active {
            border-color: rgb(125 211 252);
            background: rgb(240 249 255);
            color: rgb(7 89 133);
        }
        .toolbar-lists-button .chev {
            color: rgb(148 163 184);
            transition: transform .15s ease;
        }
        .toolbar-lists.is-open .toolbar-lists-button .chev {
            transform: rotate(180deg);
        }
        .toolbar-lists-menu {
            position: absolute;
            top: calc(100% + .35rem);
            left: 0;
            min-width: 16rem;
            max-height: 22rem;
            overflow-y: auto;
            padding: .35rem;
            background: white;
            border: 1px solid rgb(226 232 240);
            border-radius: .75rem;
            box-shadow: 0 12px 32px -8px rgba(15,23,42,.12);
            z-index: 30;
            display: none;
        }
        .toolbar-lists.is-open .toolbar-lists-menu { display: block; }
        .list-item {
            display: flex;
            align-items: center;
            gap: .65rem;
            padding: .5rem .65rem;
            border-radius: .5rem;
            font-family: 'DM Sans', sans-serif;
            font-size: .85rem;
            color: rgb(51 65 85);
            text-decoration: none;
            transition: background .12s ease, color .12s ease;
        }
        .list-item:hover {
            background: rgb(248 250 252);
            color: rgb(15 23 42);
        }
        .list-item.is-active {
            background: rgb(240 249 255);
            color: rgb(7 89 133);
            font-weight: 600;
        }
        .list-item-dot {
            width: .55rem; height: .55rem;
            border-radius: 999px;
            background: rgb(148 163 184);
            box-shadow: 0 0 0 1px rgba(0,0,0,.04);
            flex-shrink: 0;
        }
        .list-item-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .list-item-count {
            font-family: 'Inter', sans-serif;
            font-size: .68rem;
            font-weight: 600;
            color: rgb(148 163 184);
            font-feature-settings: "tnum";
        }
        .list-item.is-active .list-item-count { color: rgb(7 89 133); }
        .toolbar-lists-divider {
            height: 1px;
            background: rgb(241 245 249);
            margin: .35rem .25rem;
        }
        .list-item-add {
            display: flex; align-items: center; gap: .55rem;
            padding: .5rem .65rem;
            border-radius: .5rem;
            font-family: 'DM Sans', sans-serif;
            font-size: .82rem;
            color: rgb(2 132 199);
            text-decoration: none;
            transition: background .12s ease;
        }
        .list-item-add:hover { background: rgb(240 249 255); }

        /* ─────────────────────────────────────────────────────────────
           DataTables 2.x — refined overrides keyed to the new design
           ───────────────────────────────────────────────────────────── */
        .dt-container {
            font-family: 'DM Sans', sans-serif;
            font-size: .875rem;
            color: rgb(51 65 85);
        }
        .dt-container .dt-search,
        .dt-container .dt-length,
        div.dt-length { display: none !important; }

        .dt-container .dt-layout-row:last-child {
            display: flex; flex-wrap: wrap;
            justify-content: space-between; align-items: center;
            gap: .75rem;
            margin: 0;
            padding: 1.25rem .25rem .25rem;
        }
        .dt-container .dt-layout-cell { padding: 0; }

        .dt-container .dt-info {
            color: rgb(148 163 184);
            font-size: .72rem;
            font-family: 'Inter', sans-serif;
            letter-spacing: .04em;
        }

        .dt-container .dt-paging {
            display: flex; align-items: center; gap: .15rem;
        }
        .dt-container .dt-paging .dt-paging-button {
            display: inline-flex; align-items: center; justify-content: center;
            min-width: 2.1rem; height: 2.1rem;
            padding: 0 .55rem;
            border-radius: .55rem;
            font-size: .8rem;
            font-weight: 500;
            font-family: 'Inter', sans-serif;
            color: rgb(100 116 139);
            background: transparent;
            border: 1px solid transparent;
            cursor: pointer;
            transition: all .15s cubic-bezier(.4,0,.2,1);
        }
        .dt-container .dt-paging .dt-paging-button:hover:not(.disabled):not(.current) {
            background: rgb(241 245 249);
            color: rgb(15 23 42);
        }
        .dt-container .dt-paging .dt-paging-button.current {
            background: rgb(15 23 42);
            color: white;
            border-color: transparent;
        }
        .dt-container .dt-paging .dt-paging-button.disabled {
            color: rgb(203 213 225);
            cursor: default; pointer-events: none;
        }

        .dt-container table.dataTable {
            width: 100% !important;
            border-collapse: separate;
            border-spacing: 0 .15rem;
        }

        /* Headers — newsroom labels */
        .dt-container table.dataTable thead th {
            padding: .85rem 1rem .55rem;
            text-align: left;
            font-family: 'DM Sans', sans-serif;
            font-weight: 600;
            font-size: .78rem;
            color: rgb(100 116 139);
            background: transparent;
            border: none;
            white-space: nowrap;
            position: relative;
            border-bottom: 1px solid rgb(241 245 249);
        }
        .dt-container table.dataTable thead th.dt-orderable-asc,
        .dt-container table.dataTable thead th.dt-orderable-desc { cursor: pointer; }
        .dt-container table.dataTable thead th.dt-orderable-asc:hover,
        .dt-container table.dataTable thead th.dt-orderable-desc:hover { color: rgb(51 65 85); }
        .dt-container table.dataTable thead th.dt-ordering-asc,
        .dt-container table.dataTable thead th.dt-ordering-desc { color: rgb(2 132 199); }
        .dt-container table.dataTable thead th .dt-column-order { display: none; }

        /* Celdas del libro de registro (asiento / mono / semáforo) */
        .sol-asiento b {
            display: block;
            font-family: 'JetBrains Mono', monospace;
            font-size: .72rem;
            font-weight: 600;
            color: rgb(15 23 42);
            max-width: 9.5rem;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .sol-asiento span {
            font-family: 'JetBrains Mono', monospace;
            font-size: .68rem;
            color: rgb(148 163 184);
        }
        .sol-mono {
            font-family: 'JetBrains Mono', monospace;
            font-size: .72rem;
            font-weight: 500;
            color: rgb(71 85 105);
            font-variant-numeric: tabular-nums;
        }
        .sol-dias { font-size: .72rem; font-weight: 500; }
        .sol-dias--ok    { color: rgb(100 116 139); }
        .sol-dias--aviso { color: rgb(180 83 9); }
        .sol-dias--rojo  { color: rgb(185 28 28); }
        .sol-dias--exito { color: rgb(4 120 87); }

        /* Rows — list-style, no chunky cards */
        .dt-container table.dataTable tbody td {
            padding: .9rem 1rem;
            border: none;
            vertical-align: middle;
            background: white;
            transition: background .12s ease;
            border-bottom: 1px solid rgb(241 245 249);
        }
        .dt-container table.dataTable tbody tr:last-child td { border-bottom: 0; }
        .dt-container table.dataTable tbody tr { cursor: pointer; }
        .dt-container table.dataTable tbody tr:hover td {
            background: rgb(248 250 252);
        }
        .dt-container table.dataTable tbody tr:active td { background: rgb(240 249 255); }
        .dt-container table.dataTable tbody td:first-child {
            border-left: 3px solid transparent;
            padding-left: calc(1rem - 3px);
            transition: border-color .12s ease, background .12s ease;
        }
        .dt-container table.dataTable tbody tr:hover td:first-child {
            border-left-color: rgb(2 132 199);
        }

        /* Empty state */
        .dt-container .dt-empty,
        .dt-container .dataTables_empty {
            text-align: center;
            padding: 4rem 1rem;
            color: rgb(148 163 184);
            font-size: .9rem;
            font-family: 'DM Sans', sans-serif;
        }

        .dt-container .dt-processing {
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            padding: .75rem 1.25rem;
            background: white;
            border-radius: .65rem;
            box-shadow: 0 8px 24px rgba(0,0,0,.08);
            z-index: 10;
            font-family: 'Inter', sans-serif;
            font-weight: 500;
            font-size: .8rem;
            color: rgb(71 85 105);
            letter-spacing: .04em;
        }

        @media (max-width: 640px) {
            .dt-container .dt-layout-row:last-child {
                flex-direction: column;
                align-items: center;
                gap: .5rem;
            }
        }

        /* Nuke default DT chrome */
        table.dataTable thead th,
        table.dataTable thead td,
        table.dataTable.no-footer { border-bottom: none !important; }
        table.dataTable.stripe tbody tr.odd,
        table.dataTable.stripe tbody tr.even,
        table.dataTable.display tbody tr.odd,
        table.dataTable.display tbody tr.even { background: transparent !important; }
        table.dataTable.hover tbody tr:hover,
        table.dataTable.display tbody tr:hover { background: transparent !important; }
        table.dataTable.order-column tbody tr>.sorting_1,
        table.dataTable.order-column tbody tr>.sorting_2,
        table.dataTable.order-column tbody tr>.sorting_3,
        table.dataTable.display tbody tr>.sorting_1,
        table.dataTable.display tbody tr>.sorting_2,
        table.dataTable.display tbody tr>.sorting_3,
        table.dataTable.display tbody tr.odd>.sorting_1,
        table.dataTable.display tbody tr.even>.sorting_1 { background: transparent !important; }
    </style>
{% endblock %}

{% block content %}

{# ─────────────────── PAGE HEADER ─────────────────── #}
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div class="min-w-0">
        <h1 class="casebook-title text-3xl sm:text-[2.4rem]">Mis <span class="rotulador">solicitudes</span></h1>
        <p class="text-slate-500 mt-1 text-sm">
            {% if totalCount == 0 %}
                Aún no has registrado ninguna solicitud. Empieza por aquí.
            {% else %}
                Busca, filtra y sigue el estado y los plazos de cada expediente{% if currentList %},
                    ahora filtrando por <span class="font-medium text-slate-700">{{ currentList.name }}</span>{% endif %}.
                <a href="{{ path('app_stats') }}" class="text-primary-600 hover:text-primary-700 hover:underline font-medium">Ver estadísticas →</a>
            {% endif %}
        </p>
    </div>
    <a href="{{ path('app_solicitudes_new') }}" class="btn btn-primary panel-cta">
        <i data-lucide="pen-line" class="w-4 h-4"></i>
        Nueva solicitud
    </a>
</div>

{% if totalCount > 0 %}
    <div class="panel-franja">
        <span class="panel-dato"><b>{{ totalCount }}</b><span>expediente{{ totalCount == 1 ? '' : 's' }}</span></span>
        <span class="panel-dato"><b>{{ activeCount }}</b><span>en curso</span></span>
        {% if upcomingCount > 0 %}
            <span class="panel-dato panel-dato--aviso"><b>{{ upcomingCount }}</b><span>con plazo esta semana</span></span>
        {% endif %}
    </div>
{% endif %}

{# ─────────────────── ÍNDICE DE ESTADOS ───────────────────
   Recuentos EFECTIVOS (una solicitud reclamada cuenta y filtra como
   «Reclamada», no en su estado crudo). El activo, subrayado a rotulador. #}
{% set metricBase = {} %}
{% if search %}{% set metricBase = metricBase|merge({q: search}) %}{% endif %}
{% if listId %}{% set metricBase = metricBase|merge({list: listId}) %}{% endif %}

{% set metrics = [
    {key: '',                  label: 'Todas',       count: totalCount},
    {key: 'sent',              label: 'Enviadas',    count: effectiveCounts.sent|default(0)},
    {key: 'processing',        label: 'En trámite',  count: effectiveCounts.processing|default(0)},
    {key: 'pending',           label: 'Pendientes',  count: effectiveCounts.pending|default(0)},
    {key: 'granted',           label: 'Concedidas',  count: effectiveCounts.granted|default(0)},
    {key: 'granted_completed', label: 'Completadas', count: effectiveCounts.granted_completed|default(0)},
    {key: 'partially_granted', label: 'Parciales',   count: effectiveCounts.partially_granted|default(0)},
    {key: 'denied',            label: 'Denegadas',   count: effectiveCounts.denied|default(0)},
    {key: 'inadmitted',        label: 'Inadmitidas', count: effectiveCounts.inadmitted|default(0)},
    {key: 'delayed',           label: 'Silencio',    count: effectiveCounts.delayed|default(0)},
    {key: 'reclaimed',         label: 'Reclamadas',  count: reclamadasCount},
] %}

<nav class="sol-indice" aria-label="Filtrar por estado">
    {% for m in metrics %}
        {% set isActive = (status|default('') == m.key) %}
        {% set href = path('app_solicitudes_index', metricBase|merge(m.key ? {status: m.key} : {})) %}
        <a href="{{ href }}" class="sol-tab {{ isActive ? 'is-active' : '' }} {{ m.count == 0 ? 'is-zero' : '' }}">
            {% if bucketColors[m.key]|default(null) %}<span class="sol-tab-dot" style="background: {{ bucketColors[m.key] }}"></span>{% endif %}
            {{ m.label }} <b>{{ m.count }}</b>
        </a>
    {% endfor %}
</nav>

{# ─────────────────── TOOLBAR ─────────────────── #}
<form id="filter-form" method="get" class="toolbar">
    {# preserve current filters in hidden inputs so search submits cleanly #}
    {% if status %}<input type="hidden" name="status" value="{{ status }}">{% endif %}
    {% if listId %}<input type="hidden" name="list" value="{{ listId }}">{% endif %}

    <label class="toolbar-search">
        <i data-lucide="search" class="w-4 h-4 toolbar-search-icon"></i>
        <input type="text" id="search-input" name="q" value="{{ search }}"
               placeholder="Buscar por título, organismo, descripción o nº de registro…"
               autocomplete="off">
        <span id="search-loading" class="hidden toolbar-search-loading">
            <i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i>
        </span>
    </label>

    <div class="toolbar-lists" id="lists-menu">
        <button type="button" class="toolbar-lists-button {{ currentList ? 'is-active' : '' }}" id="lists-menu-button"
                aria-haspopup="true" aria-expanded="false">
            <i data-lucide="bookmark" class="w-3.5 h-3.5"></i>
            <span>{{ currentList ? currentList.name : 'Todas las listas' }}</span>
            <i data-lucide="chevron-down" class="w-3.5 h-3.5 chev"></i>
        </button>
        <div class="toolbar-lists-menu" role="menu">
            {% set urlAll = {} %}
            {% if status %}{% set urlAll = urlAll|merge({status: status}) %}{% endif %}
            {% if search %}{% set urlAll = urlAll|merge({q: search}) %}{% endif %}
            <a href="{{ path('app_solicitudes_index', urlAll) }}" class="list-item {{ not listId ? 'is-active' : '' }}">
                <span class="list-item-dot" style="background: rgb(15 23 42);"></span>
                <span class="list-item-name">Todas las solicitudes</span>
                <span class="list-item-count">{{ totalCount }}</span>
            </a>

            {% if lists|length > 0 %}
                {% for list in lists %}
                    {% set urlForList = {list: list.id} %}
                    {% if status %}{% set urlForList = urlForList|merge({status: status}) %}{% endif %}
                    {% if search %}{% set urlForList = urlForList|merge({q: search}) %}{% endif %}
                    {% set isActive = listId is same as(list.id ~ '') %}
                    <a href="{{ path('app_solicitudes_index', urlForList) }}"
                       class="list-item {{ isActive ? 'is-active' : '' }}"
                       title="{{ list.description|default(list.name) }}">
                        <span class="list-item-dot" {% if list.color %}style="background: {{ list.color }};"{% endif %}></span>
                        <span class="list-item-name">{{ list.name }}</span>
                        <span class="list-item-count">{{ list.items|length }}</span>
                    </a>
                {% endfor %}
            {% endif %}

            <div class="toolbar-lists-divider"></div>
            <a href="{{ path('app_listas_new') }}" class="list-item-add">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                Nueva lista
            </a>
            {% if lists|length > 0 %}
                <a href="{{ path('app_listas_index') }}" class="list-item-add">
                    <i data-lucide="settings-2" class="w-3.5 h-3.5"></i>
                    Gestionar listas
                </a>
            {% endif %}
        </div>
    </div>
</form>

{# ─────────────────── ACTIVE FILTER CHIPS ─────────────────── #}
{% if status or search or listId %}
    {% set baseRemove = {} %}
    {% if search and not (search) %}{% endif %}{# noop #}

    <div class="filter-chips">
        {% if status %}
            {% set urlNoStatus = {} %}
            {% if search %}{% set urlNoStatus = urlNoStatus|merge({q: search}) %}{% endif %}
            {% if listId %}{% set urlNoStatus = urlNoStatus|merge({list: listId}) %}{% endif %}
            <a href="{{ path('app_solicitudes_index', urlNoStatus) }}" class="filter-chip" title="Quitar este filtro">
                <span class="filter-chip-key">Estado</span>
                <span>
                    {% set statusLabels = {
                        'sent':'Enviadas','processing':'En trámite','granted':'Concedidas','granted_completed':'Completadas',
                        'partially_granted':'Parciales','inadmitted':'Inadmitidas',
                        'denied':'Denegadas','delayed':'Silencio','pending':'Pendientes','reclaimed':'Reclamadas'
                    } %}
                    {{ statusLabels[status]|default(status) }}
                </span>
                <span class="filter-chip-x"><i data-lucide="x" class="w-2.5 h-2.5"></i></span>
            </a>
        {% endif %}
        {% if listId and currentList %}
            {% set urlNoList = {} %}
            {% if search %}{% set urlNoList = urlNoList|merge({q: search}) %}{% endif %}
            {% if status %}{% set urlNoList = urlNoList|merge({status: status}) %}{% endif %}
            <a href="{{ path('app_solicitudes_index', urlNoList) }}" class="filter-chip" title="Quitar lista">
                <span class="filter-chip-key">Lista</span>
                <span>{{ currentList.name }}</span>
                <span class="filter-chip-x"><i data-lucide="x" class="w-2.5 h-2.5"></i></span>
            </a>
        {% endif %}
        {% if search %}
            {% set urlNoSearch = {} %}
            {% if status %}{% set urlNoSearch = urlNoSearch|merge({status: status}) %}{% endif %}
            {% if listId %}{% set urlNoSearch = urlNoSearch|merge({list: listId}) %}{% endif %}
            <a href="{{ path('app_solicitudes_index', urlNoSearch) }}" class="filter-chip" title="Quitar búsqueda">
                <span class="filter-chip-key">Buscar</span>
                <span>«{{ search|u.truncate(40) }}»</span>
                <span class="filter-chip-x"><i data-lucide="x" class="w-2.5 h-2.5"></i></span>
            </a>
        {% endif %}
        <a href="{{ path('app_solicitudes_index') }}" class="filter-clear-all">
            <i data-lucide="x" class="w-3 h-3"></i>
            Limpiar filtros
        </a>
    </div>
{% endif %}

{# ─────────────────── MAIN TABLE (full width) ─────────────────── #}
<section class="table-card">
    <div data-turbo="false">
        <div id="solicitudes-table">
            <div class="text-center py-16 text-slate-400">
                <i data-lucide="loader-2" class="w-6 h-6 mx-auto mb-3 animate-spin"></i>
                <p class="text-sm">Cargando solicitudes…</p>
            </div>
        </div>
    </div>
</section>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.3/js/dataTables.min.js"></script>
    <script src="{{ asset('bundles/datatables/js/datatables.js') }}"></script>
    <script>
        $(function() {
            var spanishLanguage = {
                "processing": "Cargando…",
                "lengthMenu": "Mostrar _MENU_",
                "zeroRecords": "Ninguna solicitud coincide con los filtros aplicados",
                "emptyTable": "No hay solicitudes disponibles",
                "info": "_START_–_END_ de _TOTAL_",
                "infoEmpty": "Sin solicitudes",
                "infoFiltered": "(de _MAX_)",
                "search": "",
                "searchPlaceholder": "Buscar…",
                "paginate": {
                    "first": "«",
                    "last": "»",
                    "next": "›",
                    "previous": "‹"
                }
            };

            var settings = {{ datatable_settings(datatable)|raw }};

            $('#solicitudes-table').initDataTables(settings, {
                "language": spanishLanguage,
                "order": [],
                "pageLength": 50,
                "lengthMenu": [10, 25, 50, 100],
                "drawCallback": function() {
                    if (typeof lucide !== 'undefined') {
                        lucide.createIcons();
                    }

                    $(this).find('tbody tr').each(function() {
                        var href = $(this).find('[data-href]').first().data('href');
                        if (href) $(this).attr('data-href', href);
                    });

                    $(this).find('tbody tr[data-href]').off('click.nav').on('click.nav', function(e) {
                        if (window.getSelection().toString()) return;
                        window.location.href = $(this).data('href');
                    });
                }
            });

            // Lists dropdown toggle
            var listsMenu = document.getElementById('lists-menu');
            var listsButton = document.getElementById('lists-menu-button');
            if (listsMenu && listsButton) {
                listsButton.addEventListener('click', function(e) {
                    e.stopPropagation();
                    var isOpen = listsMenu.classList.toggle('is-open');
                    listsButton.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                });
                document.addEventListener('click', function(e) {
                    if (!listsMenu.contains(e.target)) {
                        listsMenu.classList.remove('is-open');
                        listsButton.setAttribute('aria-expanded', 'false');
                    }
                });
                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') {
                        listsMenu.classList.remove('is-open');
                        listsButton.setAttribute('aria-expanded', 'false');
                    }
                });
            }

            // Debounced search
            var searchTimeout = null;
            var searchInput = document.getElementById('search-input');
            var searchLoading = document.getElementById('search-loading');
            var filterForm = document.getElementById('filter-form');

            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    clearTimeout(searchTimeout);
                    searchLoading.classList.remove('hidden');

                    searchTimeout = setTimeout(function() {
                        sessionStorage.setItem('pideinfo_search_focus', '1');
                        filterForm.submit();
                    }, 400);
                });

                searchLoading.classList.add('hidden');

                if (sessionStorage.getItem('pideinfo_search_focus') && searchInput.value) {
                    sessionStorage.removeItem('pideinfo_search_focus');
                    searchInput.focus();
                    searchInput.setSelectionRange(searchInput.value.length, searchInput.value.length);
                }

                if (typeof lucide !== 'undefined') {
                    lucide.createIcons();
                }
            }
        });
    </script>
{% endblock %}
