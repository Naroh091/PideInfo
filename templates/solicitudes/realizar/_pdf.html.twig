<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Solicitud — {{ accessRequest.publicBody.name }}</title>
    <style>
        {% include 'pdf/_styles.css.twig' %}

        .doc-addressee-block { margin: 0 0 1.6em 0; }
    </style>
</head>
<body>
    <div class="doc-heading">Solicitud de acceso a información pública</div>
    {% if accessRequest.applicableLaw %}
        <div class="doc-subheading">al amparo de la {{ accessRequest.applicableLaw.name }}{% if accessRequest.applicableLaw.shortCode %} ({{ accessRequest.applicableLaw.shortCode }}){% endif %}</div>
    {% endif %}

    <div class="doc-addressee-block">
        {% if generic_destination|default(false) %}
            {# Borrador anónimo sin destinatario elegido: se deja la línea en
               blanco para rellenar a mano al presentarla. #}
            <div class="doc-addressee">A/A: ______________________________________________</div>
        {% else %}
            <div class="doc-addressee">A/A: {{ accessRequest.publicBody.name }}</div>
        {% endif %}
        {% if accessRequest.title is not empty %}
            <div class="doc-addressee">ASUNTO: {{ accessRequest.title }}</div>
        {% endif %}
    </div>

    <div class="content">
        {% for paragraph in body_paragraphs %}
            <p>{{ paragraph|nl2br }}</p>
        {% endfor %}
    </div>

    {% include 'pdf/_footer.html.twig' %}
</body>
</html>
