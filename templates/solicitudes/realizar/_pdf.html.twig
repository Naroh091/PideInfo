<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Solicitud — {{ accessRequest.publicBody.name }}</title>
    <style>
        @page { margin: 0; }
        html { margin: 0; padding: 0; }
        body {
            margin: 0;
            padding: 2.6cm 2.4cm 2.8cm 2.4cm;
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 11pt;
            line-height: 1.4;
            color: #1e293b;
        }

        .meta-block {
            margin: 0 0 1.4em 0;
            padding-bottom: .8em;
            border-bottom: 1px solid #cbd5e1;
        }
        .meta-row {
            display: block;
            font-size: 9.5pt;
            margin-bottom: 0.18em;
            line-height: 1.35;
        }
        .meta-key {
            color: #475569;
            display: inline-block;
            min-width: 4.2cm;
        }
        .meta-value {
            color: #0f172a;
            font-weight: 600;
        }

        .doc-title {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 15pt;
            font-weight: 700;
            color: #0f172a;
            line-height: 1.25;
            margin: 0 0 1em 0;
        }

        .body-content {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 11pt;
            line-height: 1.45;
            color: #1e293b;
            text-align: justify;
        }
        .body-content p {
            margin: 0 0 0.7em 0;
            orphans: 3;
            widows: 3;
        }

        .footer {
            position: fixed;
            left: 2.4cm;
            right: 2.4cm;
            bottom: 1cm;
            height: .8cm;
            padding-top: .2cm;
            border-top: 1px solid #e2e8f0;
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 7.5pt;
            color: #94a3b8;
            text-align: center;
            line-height: 1.3;
        }
    </style>
</head>
<body>
    <div class="meta-block">
        <div class="meta-row">
            <span class="meta-key">Destinatario</span>
            <span class="meta-value">{{ accessRequest.publicBody.name }}</span>
        </div>
        {% if accessRequest.applicableLaw %}
            <div class="meta-row">
                <span class="meta-key">Ley aplicable</span>
                <span class="meta-value">{{ accessRequest.applicableLaw.name }}{% if accessRequest.applicableLaw.shortCode %} ({{ accessRequest.applicableLaw.shortCode }}){% endif %}</span>
            </div>
        {% endif %}
        <div class="meta-row">
            <span class="meta-key">Fecha</span>
            <span class="meta-value">{{ 'now'|date('d/m/Y') }}</span>
        </div>
        {% if user_name %}
            <div class="meta-row">
                <span class="meta-key">Solicitante</span>
                <span class="meta-value">{{ user_name }}</span>
            </div>
        {% endif %}
    </div>

    {% if accessRequest.title is not empty %}
        <h1 class="doc-title">{{ accessRequest.title }}</h1>
    {% endif %}

    <div class="body-content">
        {% for paragraph in body_paragraphs %}
            <p>{{ paragraph|nl2br }}</p>
        {% endfor %}
    </div>

    <div class="footer">
        Generado con Pideinfo.es
    </div>
</body>
</html>
