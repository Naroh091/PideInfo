{% extends 'layouts/app.html.twig' %}

{% block title %}Redactar solicitud · PideInfo{% endblock %}

{% set batchId = batchId|default(null) %}
{% set isMultiOrganism = (siblings|length) > 1 %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {# Source Serif 4 used for the body of the request — DM Serif Display is a
       display face and gets fatiguing at body sizes; Source Serif keeps the
       editorial feel while staying readable for long text. #}
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet">
    <style>
        /* ───────────────────────────────────────────────────────────
           Realizar / paso 2: redactar
           Reuses the .brief / .panel / .verdict / .gauge vocabulary
           from templates/complaint/interactive.html.twig so the two
           flows feel like the same product.
           ─────────────────────────────────────────────────────────── */
        :root {
            --realizar-ink: #0f172a;
            --realizar-ink-soft: #334155;
            --realizar-ink-mute: #64748b;
            --realizar-rule: #e2e8f0;
        }

        /* ── Header band ── */
        .draft-band { margin: 0 0 1.25rem; }
        .draft-eyebrow {
            font-family: 'Inter', sans-serif;
            font-size: .7rem; font-weight: 700;
            letter-spacing: .08em; text-transform: uppercase;
            color: var(--color-primary-700, #0369a1);
            display: inline-flex; align-items: center; gap: .5rem;
            margin-bottom: .35rem;
        }
        .draft-eyebrow .dot { width: 4px; height: 4px; border-radius: 50%; background: var(--color-accent-500); }
        .draft-band-row {
            display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
        }
        .draft-band-title {
            font-family: 'DM Serif Display', Georgia, serif;
            font-weight: 400;
            line-height: 1.06;
            letter-spacing: -.018em;
            color: rgb(15 23 42);
            font-size: clamp(1.6rem, 3vw, 2.1rem);
            margin: .25rem 0;
        }
        .draft-band-title em { font-style: italic; color: var(--color-primary-600); }
        .draft-status {
            font-family: 'Inter', sans-serif;
            font-size: .72rem; letter-spacing: .03em; color: rgb(148 163 184);
            min-width: 8.5rem; text-align: right;
        }
        .canvas-status-saved { color: rgb(5 150 105); }

        /* Sibling switcher */
        .draft-tabs { display: flex; gap: .35rem; flex-wrap: wrap; margin: 0 0 1.25rem; }
        .draft-tab {
            font-family: 'Inter', sans-serif;
            font-size: .78rem; font-weight: 500;
            padding: .35rem .7rem;
            border-radius: 999px;
            border: 1px solid var(--realizar-rule);
            background: #ffffff;
            color: var(--realizar-ink-soft);
            text-decoration: none;
            display: inline-flex; align-items: center; gap: .35rem;
        }
        .draft-tab:hover { border-color: rgb(186 230 253); color: var(--realizar-ink); }
        .draft-tab.is-current {
            background: var(--color-primary-50); color: var(--color-primary-700);
            border-color: var(--color-primary-200);
        }
        .draft-tab .draft-tab-state { font-size: .62rem; opacity: .7; text-transform: uppercase; letter-spacing: .04em; }

        /* ── 2/3 + 1/3 layout ── */
        .draft-grid {
            display: grid;
            grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
            gap: 1.5rem;
            align-items: start;
        }
        @media (max-width: 1023px) { .draft-grid { grid-template-columns: 1fr; gap: 1rem; } }

        /* ── Canvas card ── */
        .draft-card {
            position: relative;
            background: linear-gradient(180deg, #ffffff 0%, #fafbfd 100%);
            border: 1px solid var(--realizar-rule);
            border-radius: .85rem;
            padding: 1.85rem 2rem 2.1rem;
            box-shadow: 0 1px 2px rgba(15, 23, 42, .03);
        }
        .draft-meta-row {
            display: flex; gap: .4rem; flex-wrap: wrap; align-items: center;
            margin-bottom: 1.25rem;
        }
        .meta-pill {
            font-family: 'Inter', sans-serif;
            font-size: .68rem; letter-spacing: .04em; font-weight: 600;
            padding: .15rem .5rem; border-radius: 999px;
            background: rgb(248 250 252); color: var(--realizar-ink-soft);
            border: 1px solid var(--realizar-rule);
            text-transform: uppercase;
        }
        .meta-pill-portal {
            background: var(--color-primary-50); color: var(--color-primary-700);
            border-color: var(--color-primary-200);
        }
        .meta-pill-law {
            background: var(--color-accent-50); color: var(--color-accent-700);
            border-color: var(--color-accent-200);
        }
        .meta-pill-reg {
            background: rgb(241 245 249); color: rgb(51 65 85);
            border-color: rgb(203 213 225);
        }
        .meta-pill-unit {
            background: #fff; color: rgb(71 85 105);
            border-color: rgb(203 213 225);
            text-transform: none; letter-spacing: 0;
            max-width: 24rem;
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
            display: inline-block;
        }

        .draft-section-label {
            display: flex; justify-content: space-between; align-items: baseline;
            font-family: 'Inter', sans-serif;
            font-size: .72rem; letter-spacing: .08em; text-transform: uppercase;
            font-weight: 700;
            color: var(--color-primary-700, #0369a1);
            margin-top: 1.6rem; margin-bottom: .35rem;
        }
        .draft-section-hint {
            font-weight: 500; letter-spacing: .04em;
            color: rgb(148 163 184); text-transform: none;
            font-size: .68rem;
        }
        .draft-section-label + .draft-body-input {
            margin-top: 0;
            min-height: min(34vh, 22rem);
        }

        /* Title — textarea so it wraps over multiple lines instead of truncating. */
        .draft-title-input {
            display: block;
            width: 100%;
            font-family: 'DM Serif Display', Georgia, serif;
            font-size: clamp(1.4rem, 2.6vw, 1.75rem);
            font-weight: 400;
            line-height: 1.18;
            color: var(--realizar-ink);
            border: none; outline: none;
            padding: .15rem 0 .55rem;
            border-bottom: 1px solid transparent;
            background: transparent;
            letter-spacing: -.01em;
            resize: none;
            overflow: hidden;
            min-height: 2.4rem;
            field-sizing: content; /* progressive enhancement, harmless where unsupported */
        }
        .draft-title-input:focus { border-bottom-color: rgb(186 230 253); }
        .draft-title-input::placeholder { color: rgb(203 213 225); font-style: italic; }

        .draft-body-input {
            position: relative;
            width: 100%;
            min-height: min(60vh, 38rem);
            margin-top: 1.4rem;
            font-family: 'Source Serif 4', 'DM Serif Display', Georgia, 'Times New Roman', serif;
            font-size: 1.05rem;
            line-height: 1.75;
            color: rgb(15 23 42);
            border: none; outline: none; resize: vertical;
            background: transparent;
            padding: 0;
            text-align: justify;
            hyphens: auto;
            transition: background-color .35s ease;
        }
        .draft-body-input::placeholder { color: rgb(203 213 225); font-style: italic; }
        .draft-title-input.canvas-typing,
        .draft-body-input.canvas-typing {
            background-color: rgba(2, 132, 199, .04);
            caret-color: var(--color-primary-500);
        }

        .draft-counters {
            display: flex; justify-content: space-between; align-items: center;
            margin-top: 1.1rem; padding-top: 1rem;
            border-top: 1px dashed var(--realizar-rule);
            font-family: 'Inter', sans-serif;
            font-size: .72rem; color: rgb(148 163 184); letter-spacing: .04em;
        }
        .draft-cta-row {
            margin-top: 1.5rem;
            display: flex; justify-content: space-between; gap: .75rem; align-items: center;
            flex-wrap: wrap;
        }
        .draft-cta-group {
            display: flex; gap: .5rem; align-items: center; flex-wrap: wrap;
        }
        .draft-cta-row .btn { min-width: 10rem; justify-content: center; }

        /* ── Sidebar (brief vocabulary from complaint flow) ── */
        .brief {
            display: flex; flex-direction: column; gap: 1.25rem;
            position: sticky; top: 5.25rem;
        }
        @media (max-width: 1023px) { .brief { position: static; } }

        .panel {
            background: #ffffff;
            border: 1px solid var(--realizar-rule);
            border-radius: 6px;
            padding: 1.25rem 1.25rem 1.4rem;
        }
        .panel-label {
            display: flex; align-items: center; gap: .5rem;
            font-family: 'DM Sans', sans-serif;
            font-size: .85rem; font-weight: 600;
            color: var(--realizar-ink-mute);
            margin-bottom: .9rem;
        }
        .panel-label::after { content: ""; flex: 1; height: 1px; background: var(--realizar-rule); }

        /* Verdict (huge serif percentage) */
        .verdict {
            display: flex; align-items: baseline; gap: .5rem;
            font-family: 'DM Serif Display', Georgia, serif;
            color: var(--realizar-ink);
            line-height: 1; margin-top: .25rem;
        }
        .verdict-num {
            font-size: 4.25rem;
            font-weight: 400;
            letter-spacing: -.04em;
            font-feature-settings: "tnum";
        }
        .verdict-frac {
            font-family: 'DM Sans', sans-serif;
            font-size: .82rem; color: var(--realizar-ink-mute); font-weight: 500;
            transform: translateY(-.2rem);
        }
        .verdict-label {
            margin-top: .35rem;
            font-family: 'DM Sans', sans-serif;
            font-size: .85rem; color: var(--realizar-ink-soft);
        }
        .verdict-zone {
            display: inline-block;
            padding: 1px 6px;
            border-radius: 3px;
            font-weight: 600; font-size: .8rem;
            margin-left: .25rem;
        }
        .zone-low      { background: #fee2e2; color: #b91c1c; }
        .zone-mid-low  { background: #fef3c7; color: #b45309; }
        .zone-mid      { background: #fef9c3; color: #854d0e; }
        .zone-mid-high { background: #d1fae5; color: #065f46; }
        .zone-high     { background: #dcfce7; color: #166534; }

        /* Gauge */
        .gauge { margin-top: 1rem; height: 1.05rem; position: relative; }
        .gauge-track {
            position: absolute; top: 50%; left: 0; right: 0;
            transform: translateY(-50%);
            height: 6px; border-radius: 3px;
            background: linear-gradient(90deg, #fecaca 0%, #fed7aa 30%, #fde68a 50%, #bbf7d0 75%, #86efac 100%);
            opacity: .55;
        }
        .gauge-ticks {
            position: absolute; top: 0; left: 0; right: 0; height: 100%;
            display: flex; justify-content: space-between; pointer-events: none;
        }
        .gauge-ticks span { width: 1px; height: 50%; background: rgba(15,23,42,.18); align-self: center; }
        .gauge-marker {
            position: absolute; top: 0; bottom: 0; width: 2px;
            background: var(--realizar-ink);
            transition: left .9s cubic-bezier(.25,.8,.25,1);
        }
        .gauge-marker::before {
            content: "";
            position: absolute; top: -3px; left: 50%; transform: translateX(-50%);
            width: 8px; height: 8px;
            background: var(--realizar-ink);
            border-radius: 999px;
            border: 2px solid white;
        }
        .gauge-scale {
            display: flex; justify-content: space-between; margin-top: .5rem;
            font-family: 'Inter', sans-serif; font-size: .62rem;
            color: var(--realizar-ink-mute); letter-spacing: .08em;
        }

        .brief-section { margin-top: 1.4rem; padding-top: 1.2rem; border-top: 1px solid #f1f5f9; }
        .brief-section-title {
            display: flex; align-items: center; gap: .45rem;
            font-family: 'DM Sans', sans-serif;
            font-size: .85rem; font-weight: 600;
            margin-bottom: .55rem;
        }
        .brief-section-title.is-pos { color: #047857; }
        .brief-section-title.is-neg { color: #b91c1c; }
        .brief-section-title .mark {
            display: inline-flex; align-items: center; justify-content: center;
            width: 1rem; height: 1rem; border-radius: 999px;
            font-size: .65rem;
        }
        .is-pos .mark { background: #dcfce7; color: #047857; }
        .is-neg .mark { background: #fee2e2; color: #b91c1c; }

        .brief-html {
            font-family: 'DM Sans', sans-serif;
            font-size: .87rem;
            line-height: 1.55;
            color: var(--realizar-ink-soft);
        }
        .brief-html b { color: var(--realizar-ink); font-weight: 600; }
        .brief-html i { color: var(--realizar-ink); font-style: italic; }
        .brief-html ul { margin: 0; padding-left: 1.05rem; }
        .brief-html li { margin-bottom: .25rem; }
        .brief-summary {
            font-family: 'DM Serif Display', Georgia, serif;
            font-style: italic;
            font-size: 1rem; line-height: 1.5;
            color: var(--realizar-ink);
        }
        .brief-summary b { font-style: normal; font-weight: 700; }

        .brief-skel-num {
            display: inline-block;
            width: 5rem; height: 4rem;
            border-radius: 4px;
            background: linear-gradient(90deg, #f1f5f9 0%, #e2e8f0 50%, #f1f5f9 100%);
            background-size: 200% 100%;
            animation: brief-shimmer 1.4s infinite;
        }
        .brief-skel-bar {
            margin-top: 1rem;
            height: 8px; border-radius: 4px;
            background: linear-gradient(90deg, #f1f5f9 0%, #e2e8f0 50%, #f1f5f9 100%);
            background-size: 200% 100%;
            animation: brief-shimmer 1.4s infinite;
        }
        .brief-skel-line {
            height: .7rem; border-radius: 3px; margin-top: .55rem;
            background: linear-gradient(90deg, #f1f5f9 0%, #e2e8f0 50%, #f1f5f9 100%);
            background-size: 200% 100%;
            animation: brief-shimmer 1.4s infinite;
        }
        @keyframes brief-shimmer {
            0%   { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }
        .ghost-link {
            display: inline-flex; align-items: center; gap: .35rem;
            font-family: 'DM Sans', sans-serif;
            font-size: .82rem;
            color: var(--realizar-ink-mute);
            background: transparent; border: none; cursor: pointer; padding: 0;
            transition: color .15s ease;
        }
        .ghost-link:hover { color: var(--realizar-ink); }

        /* RAG resolution cards (smaller, brief-style) */
        .rag-list { display: flex; flex-direction: column; gap: .6rem; }
        .rag-card {
            background: #ffffff;
            border: 1px solid var(--realizar-rule);
            border-radius: .55rem;
            padding: .65rem .75rem;
        }
        .rag-card-head {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: .35rem;
        }
        .rag-status {
            display: inline-flex; align-items: center;
            font-family: 'Inter', sans-serif;
            font-size: .62rem; font-weight: 600;
            letter-spacing: .04em; text-transform: uppercase;
            padding: .12rem .45rem; border-radius: 999px;
            border: 1px solid; white-space: nowrap;
        }
        .rag-status.is-emerald { color: rgb(5 150 105); background: rgb(236 253 245); border-color: rgb(167 243 208); }
        .rag-status.is-amber   { color: var(--color-accent-700); background: var(--color-accent-50); border-color: var(--color-accent-200); }
        .rag-status.is-red     { color: rgb(185 28 28); background: rgb(254 242 242); border-color: rgb(254 202 202); }
        .rag-status.is-slate   { color: var(--realizar-ink-soft); background: rgb(248 250 252); border-color: var(--realizar-rule); }
        .rag-card-score {
            font-family: 'Inter', sans-serif;
            font-size: .62rem; color: rgb(148 163 184);
            text-transform: uppercase; letter-spacing: .04em;
        }
        .rag-card-ref {
            font-family: 'DM Serif Display', Georgia, serif;
            font-size: .92rem; color: var(--realizar-ink);
            margin: 0 0 .15rem;
        }
        .rag-card-body {
            font-family: 'DM Sans', sans-serif;
            font-size: .76rem; color: var(--realizar-ink-soft);
            margin-bottom: .3rem;
        }
        .rag-card-summary {
            font-family: 'DM Sans', sans-serif;
            font-size: .8rem; color: rgb(30 41 59); line-height: 1.5;
        }
        .rag-card-foot {
            font-family: 'Inter', sans-serif;
            font-size: .66rem; color: rgb(148 163 184);
            margin-top: .35rem; letter-spacing: .04em;
        }
        .rag-empty {
            display: flex; gap: .5rem; align-items: flex-start;
            font-family: 'DM Sans', sans-serif;
            font-size: .82rem; color: var(--realizar-ink-mute); line-height: 1.5;
        }
        .rag-empty i { color: rgb(148 163 184); margin-top: .12rem; flex-shrink: 0; }
        .rag-error i { color: var(--color-accent-600); }

        /* Pedagogy */
        .pedagogy-card {
            background: var(--color-primary-50);
            border: 1px solid var(--color-primary-100);
            border-radius: 6px;
            padding: .7rem .85rem;
            font-family: 'DM Sans', sans-serif;
            font-size: .8rem; color: var(--realizar-ink); line-height: 1.5;
        }
        .pedagogy-card b { font-weight: 600; }
        .pedagogy-card .pedagogy-icon { color: var(--color-primary-600); margin-right: .4rem; }

        /* Multi-organism notice (replaces verdict when batch > 1) */
        .verdict-multi {
            display: flex; gap: .65rem; align-items: flex-start;
            font-family: 'DM Sans', sans-serif;
            font-size: .85rem; color: var(--realizar-ink-soft);
            line-height: 1.5;
        }
        .verdict-multi i { color: var(--color-primary-600); margin-top: .1rem; flex-shrink: 0; }

        /* ───────────────────────────────────────────────────────────
           Floating chat widget (bottom-right)
           ─────────────────────────────────────────────────────────── */
        .chatbot-fab {
            position: fixed;
            right: 1.5rem; bottom: 1.5rem;
            z-index: 30;
            width: 3.4rem; height: 3.4rem;
            border-radius: 999px;
            background: var(--realizar-ink);
            color: #ffffff;
            border: none; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            box-shadow: 0 10px 30px -8px rgba(15, 23, 42, .35);
            transition: transform .15s ease, box-shadow .15s ease;
        }
        .chatbot-fab:hover { transform: translateY(-1px); box-shadow: 0 14px 36px -8px rgba(15, 23, 42, .45); }
        .chatbot-fab.is-open { transform: scale(.85); opacity: 0; pointer-events: none; }
        .chatbot-fab .chatbot-fab-dot {
            position: absolute; top: .55rem; right: .55rem;
            width: .55rem; height: .55rem; border-radius: 999px;
            background: var(--color-accent-500);
            box-shadow: 0 0 0 2px var(--realizar-ink);
        }

        .chatbot-panel {
            position: fixed;
            right: 1.5rem; bottom: 1.5rem;
            z-index: 31;
            width: min(380px, calc(100vw - 2rem));
            height: min(560px, calc(100vh - 5rem));
            background: #ffffff;
            border: 1px solid var(--realizar-rule);
            border-radius: 14px;
            box-shadow: 0 24px 60px -16px rgba(15, 23, 42, .35);
            display: flex; flex-direction: column;
            overflow: hidden;
            transform: translateY(20px) scale(.96);
            opacity: 0; pointer-events: none;
            transition: transform .18s ease, opacity .18s ease;
        }
        .chatbot-panel.is-open { transform: translateY(0) scale(1); opacity: 1; pointer-events: auto; }

        .chatbot-head {
            display: flex; align-items: center; justify-content: space-between;
            padding: .85rem 1rem;
            background: var(--realizar-ink);
            color: #ffffff;
        }
        .chatbot-head-title {
            display: flex; align-items: center; gap: .55rem;
            font-family: 'DM Sans', sans-serif;
            font-size: .9rem; font-weight: 600;
        }
        .chatbot-head-title small {
            display: block;
            font-family: 'Inter', sans-serif;
            font-size: .65rem; font-weight: 500;
            opacity: .7; letter-spacing: .04em; text-transform: uppercase;
            margin-top: .15rem;
        }
        .chatbot-close {
            background: transparent; border: none; cursor: pointer;
            color: rgba(255, 255, 255, .8);
            display: inline-flex; align-items: center; justify-content: center;
            width: 1.85rem; height: 1.85rem; border-radius: 999px;
        }
        .chatbot-close:hover { background: rgba(255, 255, 255, .1); color: #ffffff; }

        .chatbot-history {
            flex: 1;
            overflow-y: auto;
            padding: 1rem;
            display: flex; flex-direction: column; gap: .5rem;
            background: rgb(248 250 252);
        }
        .chat-empty {
            display: flex; gap: .5rem; align-items: flex-start;
            font-family: 'DM Sans', sans-serif;
            font-size: .82rem; color: var(--realizar-ink-mute);
            padding: .2rem 0;
            line-height: 1.5;
        }
        .chat-empty i { color: var(--color-primary-600); flex-shrink: 0; margin-top: .12rem; }
        .chat-empty b { color: var(--realizar-ink); font-weight: 600; }

        .chat-turn {
            font-family: 'DM Sans', sans-serif;
            font-size: .85rem; line-height: 1.5;
            padding: .55rem .75rem;
            border-radius: .6rem;
            max-width: 90%;
            word-wrap: break-word;
        }
        .chat-turn-user {
            align-self: flex-end;
            background: var(--color-primary-600);
            color: #ffffff;
        }
        .chat-turn-assistant {
            align-self: flex-start;
            background: #ffffff;
            color: var(--realizar-ink);
            border: 1px solid var(--realizar-rule);
        }
        .chat-turn-error {
            align-self: flex-start;
            background: rgb(254 242 242);
            color: rgb(185 28 28);
            border: 1px solid rgb(254 202 202);
        }

        .chat-suggest-grid { display: grid; grid-template-columns: 1fr; gap: .5rem; }
        .chat-suggest-card {
            background: #ffffff;
            border: 1px solid var(--realizar-rule);
            border-radius: .5rem;
            padding: .55rem .7rem;
            display: flex; flex-direction: column; gap: .35rem;
        }
        .chat-suggest-head { display: flex; justify-content: space-between; align-items: center; gap: .5rem; }
        .chat-suggest-head strong {
            font-family: 'DM Sans', sans-serif;
            font-size: .82rem; color: var(--realizar-ink); font-weight: 600;
        }
        .chat-suggest-source {
            font-family: 'Inter', sans-serif;
            font-size: .58rem; color: rgb(148 163 184);
            text-transform: uppercase; letter-spacing: .04em;
        }
        .chat-suggest-body {
            font-family: 'DM Sans', sans-serif;
            font-size: .8rem; color: var(--realizar-ink-soft); line-height: 1.5;
        }
        .chat-suggest-insert {
            font-family: 'Inter', sans-serif;
            font-size: .7rem; color: var(--color-primary-700);
            display: inline-flex; align-items: center; gap: .25rem;
            background: transparent; border: none; cursor: pointer;
            padding: 0; align-self: flex-start;
        }
        .chat-suggest-insert:hover { color: var(--color-primary-600); }
        .chat-suggest-insert:disabled { color: rgb(5 150 105); cursor: default; }

        .chatbot-toolbar {
            display: flex; gap: .35rem; flex-wrap: wrap;
            padding: .5rem .75rem;
            background: #ffffff;
            border-top: 1px solid var(--realizar-rule);
        }
        .composer-quick {
            font-family: 'Inter', sans-serif;
            font-size: .68rem; font-weight: 500;
            padding: .3rem .55rem;
            border-radius: .4rem;
            border: 1px solid var(--realizar-rule);
            background: #ffffff;
            color: var(--realizar-ink-soft);
            cursor: pointer;
            display: inline-flex; align-items: center; gap: .25rem;
        }
        .composer-quick:hover { border-color: var(--color-primary-300); color: var(--color-primary-700); }
        .composer-quick:disabled { opacity: .5; cursor: not-allowed; }
        .composer-quick.is-primary {
            background: var(--color-primary-600);
            color: #ffffff; border-color: var(--color-primary-600);
        }
        .composer-quick.is-primary:hover { background: var(--color-primary-700); }

        .chatbot-input-row {
            display: flex; gap: .35rem; align-items: stretch;
            padding: .65rem .75rem .85rem;
            background: #ffffff;
            border-top: 1px solid var(--realizar-rule);
        }
        .composer-input {
            flex: 1;
            font-family: 'DM Sans', sans-serif;
            font-size: .85rem;
            border: 1px solid rgb(203 213 225);
            border-radius: .45rem;
            padding: .45rem .65rem;
            background: #ffffff;
            outline: none;
        }
        .composer-input:focus {
            border-color: var(--color-primary-300);
            box-shadow: 0 0 0 3px rgba(2, 132, 199, .08);
        }
        .composer-send {
            display: inline-flex; align-items: center; justify-content: center; gap: .3rem;
            padding: 0 .75rem;
            font-family: 'Inter', sans-serif;
            font-size: .76rem; font-weight: 600;
            border-radius: .45rem;
            background: var(--realizar-ink);
            color: #ffffff;
            border: none; cursor: pointer;
        }
        .composer-send:hover { background: rgb(30 41 59); }
        .composer-send:disabled { opacity: .55; cursor: not-allowed; }
        .composer-status {
            font-family: 'Inter', sans-serif;
            font-size: .65rem; color: rgb(148 163 184);
            align-self: center; margin-right: .15rem;
        }
    </style>
{% endblock %}

{% block content %}
<div data-controller="realizar-canvas realizar-sidebar-rag"
     data-realizar-canvas-autosave-url-value="{{ path('app_solicitudes_realizar_autosave', {id: request.id}) }}"
     data-realizar-sidebar-rag-similar-url-value="{{ path('app_solicitudes_realizar_similar', {id: request.id}) }}"
     data-realizar-sidebar-rag-probability-url-value="{{ path('app_solicitudes_realizar_probability', {id: request.id}) }}"
     data-realizar-sidebar-rag-multi-organism-value="{{ isMultiOrganism ? 'true' : 'false' }}"
     data-action="realizar-canvas:settled->realizar-sidebar-rag#onSettled realizar-chat:canvas-replaced->realizar-sidebar-rag#onCanvasReplaced">

    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-3"
         style="font-family:'Inter',sans-serif;letter-spacing:.04em;">
        <a href="{{ path('app_solicitudes_index') }}" class="hover:text-slate-800 transition-colors">SOLICITUDES</a>
        <span class="text-slate-300">/</span>
        <a href="{{ path('app_solicitudes_submit_form') }}" class="hover:text-slate-800 transition-colors">REALIZAR</a>
    </nav>

    <header class="draft-band">
        <div class="draft-band-row">
            <h1 class="draft-band-title">
                Redacta tu solicitud para
                <em>{{ request.publicBody.name|u.truncate(60, '…') }}</em>
            </h1>
            <span data-realizar-canvas-target="status" class="draft-status"></span>
        </div>
    </header>

    {% if isMultiOrganism %}
        <nav class="draft-tabs" aria-label="Otros borradores del envío">
            {% for sib in siblings %}
                <a href="{{ path('app_solicitudes_realizar_draft', {id: sib.id}) }}"
                   class="draft-tab{% if sib.id == request.id %} is-current{% endif %}">
                    {{ sib.publicBody.name|u.truncate(40, '…') }}
                    {% if sib.title is empty and sib.description is empty %}
                        <span class="draft-tab-state">vacío</span>
                    {% endif %}
                </a>
            {% endfor %}
        </nav>
    {% endif %}

    <div class="draft-grid">
        {# ── Canvas (2/3) ── #}
        <article class="draft-card">
            {% set isRegDraft = request.regDestination is not null %}

            <div class="draft-meta-row">
                {% if isRegDraft %}
                    <span class="meta-pill meta-pill-reg">REG / RED SARA</span>
                {% else %}
                    <span class="meta-pill meta-pill-portal">Portal Transparencia</span>
                {% endif %}
                <span class="meta-pill">{{ request.publicBody.getLevelLabel() }}</span>
                {% if request.applicableLaw %}
                    <span class="meta-pill meta-pill-law">{{ request.applicableLaw.shortCode ?? request.applicableLaw.name }}</span>
                {% endif %}
                {% if isRegDraft %}
                    <span class="meta-pill meta-pill-unit" title="Unidad DIR3 de destino">
                        {{ request.regDestination.displayLabel }}
                    </span>
                {% endif %}
            </div>

            <textarea class="draft-title-input"
                      placeholder="Asunto de la solicitud..."
                      maxlength="255"
                      rows="1"
                      data-realizar-canvas-target="title"
                      id="draft-title-input">{{ request.title }}</textarea>

            {% if isRegDraft %}
                <label for="draft-expone-input" class="draft-section-label">
                    <span>EXPONE</span><span class="draft-section-hint">Hechos y motivación · máx. 4.000 caracteres</span>
                </label>
                <textarea class="draft-body-input"
                          placeholder="Hechos, contexto y motivación de la solicitud. Describe la información que pides y por qué."
                          maxlength="4000"
                          data-realizar-canvas-target="expone"
                          id="draft-expone-input">{{ request.expone }}</textarea>

                <label for="draft-solicita-input" class="draft-section-label">
                    <span>SOLICITA</span><span class="draft-section-hint">Petición concreta · máx. 4.000 caracteres</span>
                </label>
                <textarea class="draft-body-input"
                          placeholder="Petición concreta amparada en la Ley 19/2013 de Transparencia, Acceso a la Información Pública y Buen Gobierno."
                          maxlength="4000"
                          data-realizar-canvas-target="solicita"
                          id="draft-solicita-input">{{ request.solicita }}</textarea>

                <div class="draft-counters">
                    <span>EXPONE · máx. 4.000 caracteres</span>
                    <span>SOLICITA · máx. 4.000 caracteres</span>
                </div>
            {% else %}
                <textarea class="draft-body-input"
                          placeholder="Describe con detalle qué información solicitas. Cuanto más concreto, más fácil será que la administración te responda."
                          maxlength="3000"
                          data-realizar-canvas-target="body"
                          id="draft-body-input">{{ request.description }}</textarea>

                <div class="draft-counters">
                    <span>Asunto · máx. 255 caracteres</span>
                    <span>Información · máx. 3.000 caracteres</span>
                </div>
            {% endif %}

            <div class="draft-cta-row">
                <div class="draft-cta-group">
                    <a href="{{ path('app_solicitudes_index') }}" class="btn btn-secondary">
                        <i data-lucide="save" class="w-4 h-4 mr-2"></i> Guardar y salir
                    </a>
                    <a href="{{ path('app_solicitudes_realizar_pdf', {id: request.id}) }}"
                       class="btn btn-secondary"
                       data-action="click->realizar-canvas#downloadPdf"
                       data-realizar-canvas-pdf-url-param="{{ path('app_solicitudes_realizar_pdf', {id: request.id}) }}">
                        <i data-lucide="file-down" class="w-4 h-4 mr-2"></i> Descargar PDF
                    </a>
                </div>
                {% if batchId %}
                    <form method="post"
                          action="{{ path('app_solicitudes_realizar_dispatch', {batchId: batchId}) }}"
                          onsubmit="return confirm('¿Enviar la solicitud al organismo? El agente local empezará a procesarla y no podrás editarla más.');">
                        <button type="submit" class="btn btn-primary">
                            <i data-lucide="send" class="w-4 h-4 mr-2"></i>
                            {% if isMultiOrganism %}
                                Enviar a los {{ siblings|length }} organismos
                            {% else %}
                                Enviar al organismo
                            {% endif %}
                        </button>
                    </form>
                {% endif %}
            </div>
        </article>

        {# ── Sidebar (1/3, brief vocabulary) ── #}
        <aside class="brief">
            <section class="panel">
                <div class="panel-label">
                    <i data-lucide="gavel" class="w-3.5 h-3.5"></i>
                    Informe preliminar
                </div>
                <div data-realizar-sidebar-rag-target="probability">
                    <div>
                        <div class="brief-skel-num"></div>
                        <div class="brief-skel-bar"></div>
                        <div class="brief-skel-line" style="width:90%"></div>
                        <div class="brief-skel-line" style="width:75%"></div>
                    </div>
                </div>
                <div class="brief-html mt-2 text-xs" data-realizar-sidebar-rag-target="probabilityStatus" style="color: var(--realizar-ink-mute); font-size: .68rem;"></div>
            </section>

            <section class="panel">
                <div class="panel-label">
                    <i data-lucide="library" class="w-3.5 h-3.5"></i>
                    Resoluciones similares
                </div>
                <div class="rag-list" data-realizar-sidebar-rag-target="similar"></div>
                <div class="brief-html mt-2 text-xs" data-realizar-sidebar-rag-target="similarStatus" style="color: var(--realizar-ink-mute); font-size: .68rem;"></div>
            </section>

            <section class="pedagogy-card">
                <i data-lucide="info" class="w-4 h-4 inline pedagogy-icon"></i>
                <b>Importante:</b> el corpus de resoluciones sólo cubre solicitudes que escalaron a reclamación ante el Consejo de Transparencia. Una probabilidad baja no significa que la solicitud sea mala — significa que en casos parecidos la denegación fue confirmada en reclamación.
            </section>
        </aside>
    </div>
</div>

{# ── Floating chatbot (bottom-right) ── #}
<div data-controller="realizar-chat"
     data-realizar-chat-chat-url-value="{{ path('app_solicitudes_realizar_chat', {id: request.id}) }}"
     data-realizar-chat-title-selector-value="#draft-title-input"
     data-realizar-chat-body-selector-value="#draft-body-input">

    <button type="button"
            class="chatbot-fab"
            data-realizar-chat-target="fab"
            data-action="realizar-chat#open"
            aria-label="Abrir asistente">
        <i data-lucide="sparkles" class="w-5 h-5"></i>
        <span class="chatbot-fab-dot"></span>
    </button>

    <div class="chatbot-panel"
         data-realizar-chat-target="panel"
         role="dialog"
         aria-label="Asistente de redacción">
        <header class="chatbot-head">
            <div class="chatbot-head-title">
                <i data-lucide="sparkles" class="w-4 h-4"></i>
                <div>
                    Asistente de redacción
                    <small>Ayuda a redactar tu solicitud</small>
                </div>
            </div>
            <button type="button"
                    class="chatbot-close"
                    data-action="realizar-chat#close"
                    aria-label="Cerrar asistente">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </header>

        <div class="chatbot-history" data-realizar-chat-target="history">
            {% for turn in chatHistory|default([]) %}
                {% if turn.role == 'user' %}
                    <div class="chat-turn chat-turn-user">{{ turn.content|nl2br }}</div>
                {% elseif turn.role == 'assistant' and turn.kind == 'suggestions' %}
                    <div class="chat-turn chat-turn-assistant">
                        <div class="chat-suggest-grid">
                            {% for s in turn.items|default([]) %}
                                <div class="chat-suggest-card">
                                    <div class="chat-suggest-head">
                                        <strong>{{ s.title|default('') }}</strong>
                                        {% if s.source %}<span class="chat-suggest-source">{{ s.source }}</span>{% endif %}
                                    </div>
                                    <p class="chat-suggest-body">{{ s.body|default('') }}</p>
                                    <button type="button"
                                            class="chat-suggest-insert"
                                            data-action="realizar-chat#insertSuggestion"
                                            data-suggestion-text="{{ s.body|default('')|e('html_attr') }}">
                                        <i data-lucide="plus" class="w-3 h-3"></i> Añadir al borrador
                                    </button>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% elseif turn.role == 'assistant' %}
                    {% set rawHtml = turn.content|default('') %}
                    {% if turn.allowsHtml|default(false) %}
                        <div class="chat-turn chat-turn-assistant">{{ rawHtml|raw }}</div>
                    {% else %}
                        <div class="chat-turn chat-turn-assistant">{{ rawHtml|nl2br }}</div>
                    {% endif %}
                {% endif %}
            {% endfor %}
        </div>

        <div class="chatbot-toolbar">
            <button type="button"
                    class="composer-quick is-primary"
                    data-realizar-chat-target="generateBtn"
                    data-action="realizar-chat#generateFirst">
                <i data-lucide="sparkles" class="w-3 h-3"></i> Generar
            </button>
            <button type="button"
                    class="composer-quick"
                    data-realizar-chat-target="rewriteBtn"
                    data-action="realizar-chat#rewrite">
                <i data-lucide="refresh-cw" class="w-3 h-3"></i> Reescribir
            </button>
            <button type="button"
                    class="composer-quick"
                    data-realizar-chat-target="suggestBtn"
                    data-action="realizar-chat#suggest">
                <i data-lucide="lightbulb" class="w-3 h-3"></i> Sugerir
            </button>
        </div>

        <form class="chatbot-input-row" data-action="submit->realizar-chat#sendMessage">
            <input type="text"
                   class="composer-input"
                   placeholder="Pregúntame qué pedir, cómo formularlo…"
                   data-realizar-chat-target="input">
            <span class="composer-status" data-realizar-chat-target="status"></span>
            <button type="submit" class="composer-send" aria-label="Enviar">
                <i data-lucide="send" class="w-3 h-3"></i>
            </button>
        </form>
    </div>
</div>
{% endblock %}
