{% extends 'layouts/app.html.twig' %}

{% block title %}Redactar solicitud · PideInfo{% endblock %}

{% set batchId = batchId|default(null) %}
{% set isMultiOrganism = (siblings|length) > 1 %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {# Source Serif 4 used for the body of the request — DM Serif Display is a
       display face and gets fatiguing at body sizes; Source Serif keeps the
       editorial feel while staying readable for long text. #}
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet">
{% endblock %}

{% block content %}
<div id="draft-canvas"
     data-controller="realizar-canvas realizar-sidebar-rag"
     data-realizar-canvas-autosave-url-value="{{ path('app_solicitudes_realizar_autosave', {id: request.id}) }}"
     data-realizar-sidebar-rag-similar-url-value="{{ path('app_solicitudes_realizar_similar', {id: request.id}) }}"
     data-realizar-sidebar-rag-probability-url-value="{{ path('app_solicitudes_realizar_probability', {id: request.id}) }}"
     data-realizar-sidebar-rag-multi-organism-value="{{ isMultiOrganism ? 'true' : 'false' }}"
     data-action="realizar-canvas:settled->realizar-sidebar-rag#onSettled">

    {% include '_partials/agent_required_banner.html.twig' %}

    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-3"
         style="font-family:'Inter',sans-serif;letter-spacing:.04em;">
        <a href="{{ path('app_solicitudes_index') }}" class="hover:text-slate-800 transition-colors">SOLICITUDES</a>
        <span class="text-slate-300">/</span>
        <a href="{{ path('app_solicitudes_submit_form') }}" class="hover:text-slate-800 transition-colors">REALIZAR</a>
    </nav>

    <header class="draft-band">
        <div class="draft-band-row">
            <h1 class="draft-band-title">
                Redacta tu solicitud para
                <em>{{ request.publicBody.name|u.truncate(60, '…') }}</em>
            </h1>
            <span data-realizar-canvas-target="status" class="draft-status"></span>
        </div>
    </header>

    {% if isMultiOrganism %}
        <nav class="draft-tabs" aria-label="Otros borradores del envío">
            {% for sib in siblings %}
                <a href="{{ path('app_solicitudes_realizar_draft', {id: sib.id}) }}"
                   class="draft-tab{% if sib.id == request.id %} is-current{% endif %}">
                    {{ sib.publicBody.name|u.truncate(40, '…') }}
                    {% if sib.title is empty and sib.description is empty %}
                        <span class="draft-tab-state">vacío</span>
                    {% endif %}
                </a>
            {% endfor %}
        </nav>
    {% endif %}

    <div class="draft-grid">
        {# ── Canvas (2/3) ── #}
        <article class="draft-card">
            {% set isRegDraft = request.regDestination is not null %}

            <div class="draft-meta-row">
                {% if isRegDraft %}
                    <span class="meta-pill meta-pill-reg">REG / RED SARA</span>
                {% else %}
                    <span class="meta-pill meta-pill-portal">Portal Transparencia</span>
                {% endif %}
                <span class="meta-pill">{{ request.publicBody.getLevelLabel() }}</span>
                {% if request.applicableLaw %}
                    <span class="meta-pill meta-pill-law">{{ request.applicableLaw.shortCode ?? request.applicableLaw.name }}</span>
                {% endif %}
                {% if isRegDraft %}
                    <span class="meta-pill meta-pill-unit" title="Unidad DIR3 de destino">
                        {{ request.regDestination.displayLabel }}
                    </span>
                {% endif %}
            </div>

            {# REG/RED SARA caps the asunto at 80 chars (silent truncation in
               portal); other channels use the AGE Portal limit of 255. #}
            {% set titleMaxLength = isRegDraft ? 80 : 255 %}
            <textarea class="draft-title-input"
                      placeholder="Asunto de la solicitud..."
                      maxlength="{{ titleMaxLength }}"
                      rows="1"
                      data-realizar-canvas-target="title"
                      id="draft-title-input">{{ request.title }}</textarea>

            {% if isRegDraft %}
                <label for="draft-expone-input" class="draft-section-label">
                    <span>EXPONE</span><span class="draft-section-hint">Hechos y motivación · máx. 4.000 caracteres</span>
                </label>
                <textarea class="draft-body-input"
                          placeholder="Hechos, contexto y motivación de la solicitud. Describe la información que pides y por qué."
                          maxlength="4000"
                          data-realizar-canvas-target="expone"
                          id="draft-expone-input">{{ request.expone }}</textarea>

                <label for="draft-solicita-input" class="draft-section-label">
                    <span>SOLICITA</span><span class="draft-section-hint">Petición concreta · máx. 4.000 caracteres</span>
                </label>
                <textarea class="draft-body-input"
                          placeholder="Petición concreta amparada en la Ley 19/2013 de Transparencia, Acceso a la Información Pública y Buen Gobierno."
                          maxlength="4000"
                          data-realizar-canvas-target="solicita"
                          id="draft-solicita-input">{{ request.solicita }}</textarea>

                <div class="draft-counters">
                    <span>Asunto · máx. 80 caracteres</span>
                    <span>EXPONE · máx. 4.000 caracteres</span>
                    <span>SOLICITA · máx. 4.000 caracteres</span>
                </div>
            {% else %}
                <textarea class="draft-body-input"
                          placeholder="Describe con detalle qué información solicitas. Cuanto más concreto, más fácil será que la administración te responda."
                          maxlength="3000"
                          data-realizar-canvas-target="body"
                          id="draft-body-input">{{ request.description }}</textarea>

                <div class="draft-counters">
                    <span>Asunto · máx. 255 caracteres</span>
                    <span>Información · máx. 3.000 caracteres</span>
                </div>
            {% endif %}

            <div class="draft-cta-row">
                <div class="draft-cta-group">
                    <a href="{{ path('app_solicitudes_index') }}" class="btn btn-secondary">
                        <i data-lucide="save" class="w-4 h-4 mr-2"></i> Guardar y salir
                    </a>
                    <a href="{{ path('app_solicitudes_realizar_pdf', {id: request.id}) }}"
                       class="btn btn-secondary"
                       data-action="click->realizar-canvas#downloadPdf"
                       data-realizar-canvas-pdf-url-param="{{ path('app_solicitudes_realizar_pdf', {id: request.id}) }}">
                        <i data-lucide="file-down" class="w-4 h-4 mr-2"></i> Descargar PDF
                    </a>
                </div>
                {% if batchId %}
                    {# Submit goes through realizar-canvas#dispatchSubmit so we
                       (a) confirm, (b) block while assistant-chat is mid-stream,
                       (c) force-flush any pending autosave before POSTing.
                       Avoids the prod race that surfaces as reg_body_required
                       / reg_destination_required blockers on rows that look
                       complete in psql a few seconds later. #}
                    <form method="post"
                          action="{{ path('app_solicitudes_realizar_dispatch', {batchId: batchId}) }}"
                          data-action="submit->realizar-canvas#dispatchSubmit">
                        <button type="submit" class="btn btn-primary">
                            <i data-lucide="send" class="w-4 h-4 mr-2"></i>
                            {% if isMultiOrganism %}
                                Enviar a los {{ siblings|length }} organismos
                            {% else %}
                                Enviar al organismo
                            {% endif %}
                        </button>
                    </form>
                {% endif %}
            </div>
        </article>

        {# ── Sidebar (1/3, brief vocabulary) ── #}
        <aside class="brief">
            <section class="panel">
                <div class="panel-label">
                    <i data-lucide="gavel" class="w-3.5 h-3.5"></i>
                    Informe preliminar
                </div>
                <div data-realizar-sidebar-rag-target="probability">
                    <div>
                        <div class="brief-skel-num"></div>
                        <div class="brief-skel-bar"></div>
                        <div class="brief-skel-line" style="width:90%"></div>
                        <div class="brief-skel-line" style="width:75%"></div>
                    </div>
                </div>
                <div class="brief-html mt-2 text-xs" data-realizar-sidebar-rag-target="probabilityStatus" style="color: #64748b; font-size: .68rem;"></div>
            </section>

            <section class="panel">
                <div class="panel-label">
                    <i data-lucide="library" class="w-3.5 h-3.5"></i>
                    Resoluciones similares
                </div>
                <div class="rag-list" data-realizar-sidebar-rag-target="similar"></div>
                <div class="brief-html mt-2 text-xs" data-realizar-sidebar-rag-target="similarStatus" style="color: #64748b; font-size: .68rem;"></div>
            </section>

            <section class="pedagogy-card">
                <i data-lucide="info" class="w-4 h-4 inline pedagogy-icon"></i>
                <b>Importante:</b> el corpus de resoluciones sólo cubre solicitudes que escalaron a reclamación ante el Consejo de Transparencia. Una probabilidad baja no significa que la solicitud sea mala — significa que en casos parecidos la denegación fue confirmada en reclamación.
            </section>
        </aside>
    </div>
</div>

{# ── Floating chatbot (bottom-right) — unified assistant-chat controller ── #}
<div data-controller="assistant-chat"
     data-assistant-chat-endpoint-url-value="{{ path('app_assistant_chat_request', {id: request.id}) }}"
     data-assistant-chat-is-reg-value="{{ isRegDraft ? 'true' : 'false' }}"
     data-assistant-chat-canvas-outlet-selector-value="#draft-canvas">

    <button type="button"
            class="chatbot-fab"
            data-assistant-chat-target="fab"
            data-action="assistant-chat#open"
            aria-label="Abrir asistente">
        <i data-lucide="sparkles" class="w-5 h-5"></i>
        <span class="chatbot-fab-dot"></span>
    </button>

    <div class="chatbot-panel"
         data-assistant-chat-target="panel"
         role="dialog"
         aria-label="Asistente de redacción">
        <header class="chatbot-head">
            <div class="chatbot-head-title">
                <i data-lucide="sparkles" class="w-4 h-4"></i>
                <div>
                    Asistente de redacción
                    <small>Pídeme lo que necesites o adjunta archivos</small>
                </div>
            </div>
            <button type="button"
                    class="chatbot-close"
                    data-action="assistant-chat#close"
                    aria-label="Cerrar asistente">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </header>

        <div class="chatbot-history" data-assistant-chat-target="history">
            {% for turn in chatHistory|default([]) %}
                {% if turn.role == 'user' %}
                    <div class="chat-turn chat-turn-user">
                        <div class="chat-bubble-text">{{ turn.content|nl2br }}</div>
                    </div>
                {% elseif turn.role == 'assistant' %}
                    {% set rawHtml = turn.content|default('') %}
                    <div class="chat-turn chat-turn-assistant">
                        <div class="chat-bubble-text">
                            {% if turn.allowsHtml|default(false) %}{{ rawHtml|raw }}{% else %}{{ rawHtml|nl2br }}{% endif %}
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>

        <div data-assistant-chat-target="attachChips" class="composer-chips"></div>

        <form class="chatbot-input-row" data-action="submit->assistant-chat#sendMessage">
            <label class="composer-attach" title="Adjuntar archivo (no se guarda)">
                <input type="file"
                       class="hidden"
                       multiple
                       accept=".pdf,.csv,.txt,.md,.png,.jpg,.jpeg"
                       data-assistant-chat-target="attachInput"
                       data-action="change->assistant-chat#onAttach">
                <i data-lucide="paperclip" class="w-3.5 h-3.5"></i>
            </label>
            <textarea rows="1"
                      class="composer-input composer-input-multiline"
                      placeholder="Escribe un mensaje, pega texto o adjunta archivos…"
                      data-assistant-chat-target="input"
                      data-action="keydown->assistant-chat#onKeydown input->assistant-chat#onInput"></textarea>
            <button type="submit"
                    class="composer-send"
                    data-assistant-chat-target="sendButton"
                    aria-label="Enviar">
                <i data-lucide="send" class="w-3 h-3"></i>
            </button>
        </form>
        <p class="composer-disclaimer">Los archivos se usan solo en esta conversación y no se guardan.</p>
    </div>
</div>
{% include '_partials/_agent_present_modal.html.twig' %}
{% endblock %}
