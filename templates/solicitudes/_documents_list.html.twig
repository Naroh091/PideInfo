{% if request.documents|length > 0 %}
    {% set requestDocs = [] %}
    {% set complaintDocs = [] %}
    {% for doc in request.documents %}
        {% if doc.type and doc.type.isComplaintRelated() %}
            {% set complaintDocs = complaintDocs|merge([doc]) %}
        {% else %}
            {% set requestDocs = requestDocs|merge([doc]) %}
        {% endif %}
    {% endfor %}

    {% macro document_item(doc) %}
        {% set isZip = doc.mimeType in ['application/zip', 'application/x-zip-compressed'] %}
        {% set iconName = isZip ? 'archive' : (doc.isPdf ? 'file-text' : (doc.isImage ? 'image' : 'file')) %}
        <div class="docs-row" data-document-id="{{ doc.id }}">
            <span class="docs-icon">
                <i data-lucide="{{ iconName }}" class="w-[18px] h-[18px]"></i>
            </span>
            <div class="docs-main">
                <p class="docs-name" title="{{ doc.displayFilename }}">{{ doc.displayFilename }}</p>
                {% if doc.documentDate or not doc.processed %}
                    <div class="docs-meta">
                        {% if doc.documentDate %}
                            <span>{{ doc.documentDate|date('d/m/Y') }}</span>
                        {% endif %}
                        {% if not doc.processed %}
                            {% if doc.documentDate %}<span class="sep">·</span>{% endif %}
                            <span class="docs-status is-pending">Procesando</span>
                        {% endif %}
                    </div>
                {% endif %}
                {% if doc.summary %}
                    <p class="docs-summary">{{ doc.summary }}</p>
                {% endif %}
            </div>
            <div class="docs-actions">
                <a href="{{ path('app_document_download', {id: doc.id}) }}?inline=1"
                   target="_blank"
                   title="Abrir en nueva pestaña">
                    <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                </a>
                <a href="{{ path('app_document_download', {id: doc.id}) }}"
                   title="Descargar">
                    <i data-lucide="download" class="w-3.5 h-3.5"></i>
                </a>
                {% if not isZip %}
                    <button type="button"
                            title="Reprocesar documento"
                            onclick="reprocessDocument('{{ doc.id }}', this)">
                        <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
                    </button>
                {% endif %}
            </div>
        </div>
    {% endmacro %}

    {% if requestDocs|length > 0 %}
        <div class="docs-list">
            {% for doc in requestDocs %}
                {{ _self.document_item(doc) }}
            {% endfor %}
        </div>
    {% endif %}

    {% if complaintDocs|length > 0 %}
        <div class="docs-group-label">
            <span class="docs-group-label-name">Documentos de reclamación</span>
            <span class="docs-group-label-rule"></span>
        </div>
        <div class="docs-list">
            {% for doc in complaintDocs %}
                {{ _self.document_item(doc) }}
            {% endfor %}
        </div>
    {% endif %}
{% else %}
    <div class="docs-empty">
        <em>Sin documentos en el expediente</em>
        Sube el primero arrastrándolo arriba o pulsando «Seleccionar».
    </div>
{% endif %}
