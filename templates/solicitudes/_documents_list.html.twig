{% if request.documents|length > 0 %}
    {% set requestDocs = [] %}
    {% set complaintDocs = [] %}
    {% set courtDocs = [] %}
    {% for doc in request.documents %}
        {% if doc.type and doc.type.isCourtRelated() %}
            {% set courtDocs = courtDocs|merge([doc]) %}
        {% elseif doc.type and doc.type.isComplaintRelated() %}
            {% set complaintDocs = complaintDocs|merge([doc]) %}
        {% else %}
            {% set requestDocs = requestDocs|merge([doc]) %}
        {% endif %}
    {% endfor %}

    {% macro document_item(doc, request) %}
        {% set isZip = doc.mimeType in ['application/zip', 'application/x-zip-compressed'] %}
        {% set isDraft = doc.type and doc.type.value == 'complaint' and doc.mimeType == 'text/html' %}
        {% set draftFiled = isDraft and request.complaint is not null and request.complaint.filedAt is not null %}
        {% set iconName = isDraft ? 'pen-line' : (isZip ? 'archive' : (doc.isPdf ? 'file-text' : (doc.isImage ? 'image' : 'file'))) %}
        {% set draftOrigin = doc.aiMetadata.origin|default('ai') %}
        {% set draftEditRoute = draftOrigin == 'external' ? 'app_complaint_draft' : 'app_complaint_assistant' %}
        {% set displayName = isDraft ? 'Borrador de la reclamación' : doc.displayFilename %}
        {% set isProcedural = doc.type and doc.type.isProcedural() %}
        <div class="exp-doc-fila{% if draftFiled %} opacity-75{% endif %}{% if isProcedural %} tramite{% endif %}"
             data-document-id="{{ doc.id }}"
             data-doc-type="{{ doc.type.value }}"
             data-doc-name="{{ doc.customName ?? '' }}"
             data-doc-derived="{{ displayName }}">
            <span class="exp-doc-icono">
                <i data-lucide="{{ iconName }}" class="w-4 h-4"></i>
            </span>
            <div class="min-w-0">
                <p class="exp-doc-nombre" title="{{ displayName }}">
                    {{ displayName }}
                    {% if isDraft %}
                        {% if draftFiled %}
                            <span class="exp-doc-tag exp-doc-tag--previo">Borrador previo</span>
                        {% else %}
                            <span class="exp-doc-tag exp-doc-tag--borrador">Borrador</span>
                        {% endif %}
                    {% endif %}
                </p>
                {% if doc.documentDate or not doc.processed %}
                    <p class="exp-doc-meta">
                        {% if doc.documentDate %}
                            <span>{{ doc.documentDate|date('d/m/Y') }}</span>
                        {% endif %}
                        {% if not doc.processed %}
                            <span class="exp-doc-tag exp-doc-tag--proceso"><span class="punto"></span> Procesando</span>
                        {% endif %}
                    </p>
                {% endif %}
                {% if isDraft and not draftFiled %}
                    <p class="exp-doc-resumen" style="border: 0; padding-left: 0;">Última edición: {{ doc.createdAt|date('d/m/Y H:i') }}.</p>
                {% elseif doc.summary %}
                    <p class="exp-doc-resumen">{{ doc.summary }}</p>
                {% endif %}
            </div>
            <div class="exp-doc-acciones">
                {% if isDraft %}
                    <a href="{{ path(draftEditRoute, {id: request.id}) }}"
                       title="Continuar editando el borrador">
                        <i data-lucide="pen-line" class="w-3.5 h-3.5"></i>
                    </a>
                {% else %}
                    <a href="{{ path('app_document_download', {id: doc.id}) }}?inline=1"
                       target="_blank"
                       title="Abrir en nueva pestaña">
                        <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                    </a>
                    <a href="{{ path('app_document_download', {id: doc.id}) }}"
                       title="Descargar">
                        <i data-lucide="download" class="w-3.5 h-3.5"></i>
                    </a>
                    <button type="button"
                            title="Renombrar o reclasificar"
                            onclick="editDocument(this)">
                        <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                    </button>
                    {% if not isZip %}
                        <button type="button"
                                title="Reprocesar documento"
                                onclick="reprocessDocument('{{ doc.id }}', this)">
                            <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
                        </button>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    {% endmacro %}

    {% if requestDocs|length > 0 %}
        <div>
            {% for doc in requestDocs %}
                {{ _self.document_item(doc, request) }}
            {% endfor %}
        </div>
    {% endif %}

    {% if complaintDocs|length > 0 %}
        <div class="exp-doc-grupo">
            <b>Documentos de reclamación</b>
            <span class="filete"></span>
        </div>
        <div>
            {% for doc in complaintDocs %}
                {{ _self.document_item(doc, request) }}
            {% endfor %}
        </div>
    {% endif %}

    {% if courtDocs|length > 0 %}
        <div class="exp-doc-grupo">
            <b>Fase judicial</b>
            <span class="filete"></span>
        </div>
        <div>
            {% for doc in courtDocs %}
                {{ _self.document_item(doc, request) }}
            {% endfor %}
        </div>
    {% endif %}
{% else %}
    <div class="exp-doc-vacia">
        <em>Sin documentos en el expediente</em>
        Sube el primero arrastrándolo arriba o haciendo clic en la zona de subida.
    </div>
{% endif %}
