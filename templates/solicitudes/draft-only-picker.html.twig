{% extends 'layouts/app.html.twig' %}

{% block title %}Solo redactar · Nueva solicitud · PideInfo{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% include '_partials/organism_picker_styles.html.twig' %}
{% endblock %}

{% block content %}

<nav class="flex items-center gap-2 text-xs text-slate-500 mb-3"
     style="font-family:'Inter',sans-serif;letter-spacing:.04em;">
    <a href="{{ path('app_solicitudes_index') }}" class="hover:text-slate-800 transition-colors">SOLICITUDES</a>
    <span class="text-slate-300">/</span>
    <a href="{{ path('app_solicitudes_new') }}" class="hover:text-slate-800 transition-colors">NUEVA</a>
    <span class="text-slate-300">/</span>
    <span class="text-slate-800 font-medium">SOLO REDACTAR</span>
</nav>

<header class="picker-band">
    <h1 class="picker-title">¿A qué organismo va dirigida tu <em>solicitud</em>?</h1>
    <p class="picker-sub">
        Elige el organismo y, si es del REG, la unidad de destino. Después redactarás tu
        solicitud con ayuda de la IA y la guardaremos como borrador. No se enviará
        automáticamente: podrás enviarla más adelante cuando tú quieras.
    </p>
</header>

{% include '_partials/organism_picker.html.twig' with {'reg_levels': reg_levels, 'draft_only': true} %}
{% endblock %}
