{% extends 'layouts/app.html.twig' %}

{% block title %}Editar solicitud - PideInfo{% endblock %}

{% block content %}
{# Breadcrumb #}
<nav class="flex items-center gap-2 text-sm mb-6">
    <a href="{{ path('app_solicitudes_index') }}" class="text-slate-500 hover:text-primary-600 transition-colors">
        Solicitudes
    </a>
    <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
    <a href="{{ path('app_solicitudes_show', {id: request.id}) }}" class="text-slate-500 hover:text-primary-600 transition-colors truncate max-w-[150px]">
        {{ request.title|u.truncate(30) }}
    </a>
    <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
    <span class="text-slate-800 font-medium">Editar</span>
</nav>

<div class="grid lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2">
        <div class="card">
            <div class="card-header">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary-100 flex items-center justify-center">
                        <i data-lucide="edit" class="w-5 h-5 text-primary-600"></i>
                    </div>
                    <div>
                        <h1 class="font-semibold text-slate-800">Editar solicitud</h1>
                        <p class="text-sm text-slate-500">Modifica los datos de tu solicitud</p>
                    </div>
                </div>
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'class': 'space-y-6', 'onsubmit': "if(typeof gtag==='function'){gtag('event','edit_request')}"}}) }}
                    <div>
                        <label for="{{ form.title.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1.5">
                            {{ form_label(form.title) }}
                        </label>
                        {{ form_widget(form.title, {'attr': {'class': 'input'}}) }}
                        {{ form_errors(form.title) }}
                    </div>

                    <div>
                        <label for="{{ form.description.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1.5">
                            {{ form_label(form.description) }}
                        </label>
                        {{ form_widget(form.description, {'attr': {'class': 'input min-h-[120px]'}}) }}
                        {{ form_errors(form.description) }}
                    </div>

                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label for="{{ form.publicBody.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1.5">
                                {{ form_label(form.publicBody) }}
                            </label>
                            {{ form_widget(form.publicBody) }}
                            {{ form_errors(form.publicBody) }}
                        </div>
                        <div>
                            <label for="{{ form.applicableLaw.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1.5">
                                {{ form_label(form.applicableLaw) }}
                            </label>
                            {{ form_widget(form.applicableLaw, {'attr': {'class': 'input'}}) }}
                            {{ form_errors(form.applicableLaw) }}
                        </div>
                    </div>

                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label for="{{ form.sentAt.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1.5">
                                {{ form_label(form.sentAt) }}
                            </label>
                            {{ form_widget(form.sentAt, {'attr': {'class': 'input'}}) }}
                            {{ form_errors(form.sentAt) }}
                        </div>
                        <div>
                            <label for="{{ form.externalId.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1.5">
                                {{ form_label(form.externalId) }}
                            </label>
                            {{ form_widget(form.externalId, {'attr': {'class': 'input'}}) }}
                            <p class="text-xs text-slate-500 mt-1">{{ form_help(form.externalId) }}</p>
                            {{ form_errors(form.externalId) }}
                        </div>
                    </div>

                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label for="{{ form.status.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1.5">
                                {{ form_label(form.status) }}
                            </label>
                            {{ form_widget(form.status, {'attr': {'class': 'input'}}) }}
                            {{ form_errors(form.status) }}
                        </div>
                        <div>
                            <label for="{{ form.deadlineAt.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1.5">
                                {{ form_label(form.deadlineAt) }}
                            </label>
                            {{ form_widget(form.deadlineAt, {'attr': {'class': 'input'}}) }}
                            {{ form_errors(form.deadlineAt) }}
                        </div>
                    </div>

                    <div class="border-t border-slate-100 pt-6 flex flex-col sm:flex-row justify-between gap-4">
                        <a href="{{ path('app_solicitudes_show', {id: request.id}) }}" class="btn btn-secondary order-2 sm:order-1">
                            <i data-lucide="arrow-left" class="w-4 h-4 mr-2"></i>
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary order-1 sm:order-2">
                            <i data-lucide="check" class="w-4 h-4 mr-2"></i>
                            Guardar cambios
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <div class="lg:col-span-1">
        {# Status summary #}
        <div class="card sticky top-24">
            <div class="card-header">
                <div class="flex items-center gap-2">
                    <i data-lucide="info" class="w-5 h-5 text-primary-500"></i>
                    <h2 class="font-semibold text-slate-800">Resumen</h2>
                </div>
            </div>
            <div class="card-body space-y-4">
                <div>
                    <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">Estado actual</h4>
                    {% set statusClass = {
                        'sent': 'status-sent',
                        'processing': 'status-processing',
                        'granted': 'status-granted',
                        'granted_completed': 'status-granted-completed',
                        'denied': 'status-denied',
                        'delayed': 'status-delayed',
                        'pending': 'status-pending'
                    } %}
                    <span class="badge {{ statusClass[request.status]|default('badge-secondary') }}">
                        {{ request.statusLabel }}
                    </span>
                    <p class="text-xs text-slate-500 mt-1">Puedes cambiar el estado en el formulario</p>
                </div>

                <div>
                    <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">Plazo actual</h4>
                    {% if request.status in ['granted', 'granted_completed', 'denied'] %}
                        <p class="text-sm text-slate-500">
                            {{ request.deadlineAt|date('d/m/Y') }}
                            <span class="badge badge-success ml-1">Resuelta</span>
                        </p>
                    {% else %}
                        <p class="text-sm {{ request.isDeadlinePassed ? 'text-red-600' : 'text-slate-800' }}">
                            {{ request.deadlineAt|date('d/m/Y') }}
                            {% if not request.isDeadlinePassed %}
                                <span class="text-slate-500">({{ request.daysUntilDeadline }} días)</span>
                            {% endif %}
                        </p>
                    {% endif %}
                    <p class="text-xs text-slate-500 mt-1">Puedes modificar el plazo en el formulario</p>
                </div>

                <div>
                    <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">Documentos</h4>
                    <p class="text-sm text-slate-800">{{ request.documents|length }} adjunto(s)</p>
                </div>

                <div class="border-t border-slate-100 pt-4">
                    <a href="{{ path('app_solicitudes_show', {id: request.id}) }}" class="btn btn-ghost w-full text-sm">
                        <i data-lucide="eye" class="w-4 h-4 mr-2"></i>
                        Ver detalle completo
                    </a>
                </div>
            </div>
        </div>

        {# Lists Card #}
        <div class="card" style="overflow: visible" x-data="listsManager('{{ request.id }}')">
            <div class="card-header">
                <div class="flex items-center gap-2">
                    <i data-lucide="list" class="w-5 h-5 text-primary-500"></i>
                    <h2 class="font-semibold text-slate-800">Listas</h2>
                </div>
            </div>
            <div class="card-body">
                <template x-if="loading">
                    <div class="text-center py-4">
                        <i data-lucide="loader-2" class="w-5 h-5 text-slate-400 animate-spin mx-auto"></i>
                    </div>
                </template>
                <template x-if="!loading">
                    <div>
                        <template x-if="lists.filter(l => l.inList).length > 0">
                            <div class="space-y-2 mb-3">
                                <template x-for="list in lists.filter(l => l.inList)" :key="list.id">
                                    <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50">
                                        <a :href="'/listas/' + list.id" class="flex items-center gap-2 min-w-0 text-sm font-medium text-slate-800 hover:text-primary-600 transition-colors">
                                            <span class="w-3 h-3 rounded-full flex-shrink-0"
                                                  :style="'background-color: ' + (list.color || '#94a3b8')"></span>
                                            <span class="truncate" x-text="list.name"></span>
                                        </a>
                                        <template x-if="list.canEdit">
                                            <button @click="toggleList(list)"
                                                    class="text-slate-400 hover:text-red-600 p-1 transition-colors"
                                                    title="Quitar de la lista"
                                                    :disabled="toggling">
                                                <i data-lucide="x" class="w-3 h-3"></i>
                                            </button>
                                        </template>
                                    </div>
                                </template>
                            </div>
                        </template>

                        <div class="relative">
                            <button @click="dropdownOpen = !dropdownOpen"
                                    class="btn btn-secondary btn-sm w-full">
                                <i data-lucide="plus" class="w-3 h-3 mr-1"></i>
                                Añadir a lista
                            </button>
                            <div x-show="dropdownOpen"
                                 @click.away="dropdownOpen = false"
                                 x-transition
                                 class="absolute left-0 right-0 mt-1 bg-white rounded-lg shadow-lg border border-slate-200 py-1 z-10 max-h-48 overflow-y-auto"
                                 style="display: none;">
                                <template x-for="list in lists.filter(l => !l.inList && l.canEdit)" :key="list.id">
                                    <button @click="toggleList(list)"
                                            class="w-full text-left px-3 py-2 text-sm text-slate-700 hover:bg-slate-50 flex items-center gap-2"
                                            :disabled="toggling">
                                        <span class="w-3 h-3 rounded-full flex-shrink-0"
                                              :style="'background-color: ' + (list.color || '#94a3b8')"></span>
                                        <span x-text="list.name" class="truncate"></span>
                                    </button>
                                </template>
                                <template x-if="lists.filter(l => !l.inList && l.canEdit).length === 0">
                                    <p class="px-3 py-2 text-xs text-slate-500">No hay más listas disponibles</p>
                                </template>
                                <div class="border-t border-slate-100 mt-1 pt-1">
                                    <a href="{{ path('app_listas_new') }}"
                                       class="block px-3 py-2 text-sm text-primary-600 hover:bg-primary-50 flex items-center gap-2">
                                        <i data-lucide="plus" class="w-3 h-3"></i>
                                        Crear nueva lista
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </template>
            </div>
        </div>
    </div>
</div>

<script>
function listsManager(requestId) {
    return {
        lists: [],
        loading: true,
        dropdownOpen: false,
        toggling: false,

        init() {
            this.loadLists();
        },

        async loadLists() {
            try {
                const resp = await fetch('/listas/para-solicitud/' + requestId, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (resp.ok) {
                    const data = await resp.json();
                    this.lists = data.lists;
                }
            } catch (e) {
                console.error('Error loading lists:', e);
            } finally {
                this.loading = false;
                this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
            }
        },

        async toggleList(list) {
            this.toggling = true;
            const url = list.inList
                ? '/listas/' + list.id + '/solicitudes/quitar'
                : '/listas/' + list.id + '/solicitudes/agregar';

            try {
                const resp = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({
                        requestId: requestId,
                        _token: list.csrfToken
                    })
                });

                if (resp.ok) {
                    list.inList = !list.inList;
                    this.dropdownOpen = false;
                    this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
                } else {
                    const data = await resp.json();
                    alert(data.error || 'Error');
                }
            } catch (e) {
                alert('Error de conexión');
            } finally {
                this.toggling = false;
            }
        }
    };
}
</script>
{% endblock %}
