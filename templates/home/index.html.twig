{% extends 'base.html.twig' %}

{% block title %}PideInfo - Gestiona tu derecho de acceso a la información pública{% endblock %}

{% block og %}
    <meta property="og:title" content="PideInfo - Gestiona tu derecho de acceso a la información pública">
    <meta property="og:description" content="PideInfo te ayuda a gestionar tus solicitudes de acceso a información pública, controlar los plazos legales y reclamar cuando la Administración no responde.">
    <meta property="og:image" content="{{ url('og_image_home') }}">
    <meta property="og:url" content="{{ url('app_home') }}">
    <meta property="og:site_name" content="PideInfo">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="PideInfo - Gestiona tu derecho de acceso a la información pública">
    <meta name="twitter:description" content="PideInfo te ayuda a gestionar tus solicitudes de acceso a información pública, controlar los plazos legales y reclamar cuando la Administración no responde.">
    <meta name="twitter:image" content="{{ url('og_image_home') }}">
{% endblock %}

{% block body_class %}min-h-screen flex flex-col{% endblock %}

{% block body %}
{% include '_partials/public_nav.html.twig' with { active_page: 'home' } %}

{# Hero #}
<section class="hero-section py-16 sm:py-24 relative overflow-hidden">
    <div class="hero-bg"></div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
            <div class="flex-1 text-center lg:text-left">
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium mb-6">
                    <i data-lucide="sparkles" class="w-4 h-4"></i>
                    Beta abierta — registro gratuito
                </div>

                <h1 class="repo-title text-4xl sm:text-5xl lg:text-6xl text-slate-800" style="line-height: 1.1">
                    Ejerce tu derecho de acceso
                    <span class="repo-title-accent">a la información pública</span>
                </h1>

                <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-xl mx-auto lg:mx-0">
                    PideInfo te ayuda a gestionar tus solicitudes de acceso a información pública, controlar los plazos legales y reclamar cuando la Administración no responde o deniega tu derecho.
                </p>

                <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                    <a href="{{ path('app_register') }}" class="btn btn-primary px-8 py-3 text-base">
                        <i data-lucide="user-plus" class="w-5 h-5 mr-2"></i>
                        Crear mi cuenta gratis
                    </a>
                    <a href="#como-funciona" class="btn btn-ghost px-8 py-3 text-base">
                        <i data-lucide="arrow-down" class="w-5 h-5 mr-2"></i>
                        Cómo funciona
                    </a>
                </div>
            </div>

            <div class="lg:w-5/12 flex-shrink-0" style="animation: fade-slide-up 0.6s ease-out both; animation-delay: 0.2s">
                <img src="{{ asset('images/hero.png') }}" alt="Ciudadano accediendo a información pública"
                     class="w-full h-auto" loading="eager">
            </div>
        </div>
    </div>
</section>

{# Reivindicación #}
<section class="py-20 bg-white border-y border-slate-200/50 relative">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14">
            <h2 class="repo-title text-3xl sm:text-4xl text-slate-800">El derecho de acceso en España:<br>una carrera de obstáculos</h2>
        </div>

        <div class="grid sm:grid-cols-3 gap-10 mb-14">
            <div class="text-center group">
                <div class="mb-5">
                    <img src="{{ asset('images/2a_silencio.png') }}" alt="Silencio administrativo"
                         class="w-36 h-36 mx-auto object-contain transition-transform duration-300 group-hover:scale-105" loading="lazy">
                </div>
                <h3 class="font-semibold text-slate-800 mb-2" style="font-family: 'DM Sans', sans-serif">Silencio administrativo</h3>
                <p class="text-sm text-slate-500 leading-relaxed">Muchas administraciones simplemente no responden, esperando que te canses. El silencio equivale a denegación, pero dificulta saber cuándo reclamar.</p>
            </div>
            <div class="text-center group">
                <div class="mb-5">
                    <img src="{{ asset('images/2b_denegado.png') }}" alt="Denegaciones injustificadas"
                         class="w-36 h-36 mx-auto object-contain transition-transform duration-300 group-hover:scale-105" loading="lazy">
                </div>
                <h3 class="font-semibold text-slate-800 mb-2" style="font-family: 'DM Sans', sans-serif">Denegaciones injustificadas</h3>
                <p class="text-sm text-slate-500 leading-relaxed">La Ley 19/2013 reconoce límites, pero con frecuencia se aplican de forma extensiva para evitar la transparencia. Reclamar requiere argumentación jurídica sólida.</p>
            </div>
            <div class="text-center group">
                <div class="mb-5">
                    <img src="{{ asset('images/2c_plazos.png') }}" alt="Plazos y burocracia"
                         class="w-36 h-36 mx-auto object-contain transition-transform duration-300 group-hover:scale-105" loading="lazy">
                </div>
                <h3 class="font-semibold text-slate-800 mb-2" style="font-family: 'DM Sans', sans-serif">Plazos y burocracia</h3>
                <p class="text-sm text-slate-500 leading-relaxed">Un mes para responder, 30 días para reclamar, 3 meses para resolver la reclamación. Perder un plazo es perder tu derecho.</p>
            </div>
        </div>

        <blockquote class="home-quote">
            <p class="text-lg leading-relaxed">
                «Todas las personas tienen derecho a acceder a la información pública.»
            </p>
            <footer class="mt-3 text-sm text-slate-500 not-italic">
                — Artículo 12, Ley 19/2013, de transparencia, acceso a la información pública y buen gobierno
            </footer>
        </blockquote>
    </div>
</section>

{# Cómo funciona #}
<section id="como-funciona" class="py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14">
            <h2 class="repo-title text-3xl sm:text-4xl text-slate-800">PideInfo automatiza el trabajo pesado</h2>
            <p class="mt-3 text-slate-500 text-lg">Para que tú te centres en pedir información, no en gestionar papeles</p>
        </div>

        <div class="flex flex-col lg:flex-row gap-12 items-center">
            <div class="flex-1 space-y-6">
                {% set steps = [
                    { title: 'Registra tus solicitudes', desc: 'Crea solicitudes a mano o sube directamente los PDFs: el sistema los analiza con inteligencia artificial, extrae los datos y calcula los plazos automáticamente.' },
                    { title: 'Recibe documentos automáticamente', desc: 'Configura tu correo para reenviar los emails de las administraciones a tu buzón virtual. Los adjuntos se clasifican y enlazan solos a la solicitud correcta.' },
                    { title: 'Controla plazos y actúa a tiempo', desc: 'El sistema te avisa cuando se acercan plazos de respuesta, de reclamación o de cumplimiento. Nunca más pierdas tu derecho por dejar pasar una fecha.' },
                    { title: 'Reclama con fundamento jurídico', desc: 'Cuando te deniegan o no responden, PideInfo genera reclamaciones con IA basándose en resoluciones favorables y criterios del Consejo de Transparencia.' },
                ] %}
                {% for step in steps %}
                <div class="home-step group">
                    <div class="home-step-num">{{ loop.index }}</div>
                    <div class="flex-1">
                        <h3 class="font-semibold text-slate-800 text-lg" style="font-family: 'DM Sans', sans-serif">{{ step.title }}</h3>
                        <p class="text-slate-500 mt-1 leading-relaxed">{{ step.desc }}</p>
                    </div>
                </div>
                {% endfor %}
            </div>

            <div class="lg:w-80 flex-shrink-0" style="animation: fade-slide-up 0.6s ease-out both; animation-delay: 0.1s">
                <img src="{{ asset('images/3_como_funciona.png') }}" alt="Flujo de procesamiento de PideInfo"
                     class="w-full h-auto" loading="lazy">
            </div>
        </div>
    </div>
</section>

{# Conectividad con portales — el certificado nunca sale del ordenador #}
<section class="home-portals-section py-20 border-y border-slate-200/50 relative overflow-hidden">
    <div class="home-portals-bg"></div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="flex flex-col lg:flex-row-reverse items-center gap-12 lg:gap-16">
            <div class="flex-1 text-center lg:text-left">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-medium mb-5">
                    <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
                    Privacidad por diseño
                </span>
                <h2 class="repo-title text-3xl sm:text-4xl text-slate-800">
                    Tu certificado digital
                    <span class="repo-title-accent">no sale de tu ordenador</span>
                </h2>
                <p class="mt-4 text-slate-600 leading-relaxed max-w-lg">
                    Conectamos directamente con los portales del Estado para sincronizar tus expedientes y notificaciones. El certificado FNMT nunca se sube ni se delega: el agente local de PideInfo lo usa <em>en tu equipo</em> y nos envía sólo los datos que ya son tuyos.
                </p>

                <ul class="mt-6 space-y-2.5 max-w-lg mx-auto lg:mx-0">
                    {% set perks = [
                        { icon: 'lock-keyhole', text: 'Autenticación Cl@ve / FNMT realizada localmente, sin proxy.' },
                        { icon: 'refresh-cw',    text: 'Sincronización periódica de expedientes, notificaciones y documentos.' },
                        { icon: 'eye-off',       text: 'PideInfo nunca ve tu clave privada ni tu navegador autenticado.' },
                    ] %}
                    {% for perk in perks %}
                    <li class="flex items-start gap-3 text-sm text-slate-600">
                        <span class="flex-shrink-0 w-6 h-6 rounded-md bg-emerald-100 text-emerald-700 flex items-center justify-center mt-0.5">
                            <i data-lucide="{{ perk.icon }}" class="w-3.5 h-3.5"></i>
                        </span>
                        <span>{{ perk.text }}</span>
                    </li>
                    {% endfor %}
                </ul>
            </div>

            <div class="lg:w-5/12 flex-shrink-0 w-full">
                <div class="home-portals-card">
                    {# Local machine + certificate #}
                    <div class="home-portals-machine">
                        <div class="home-portals-machine-screen">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center text-white shadow-sm">
                                    <i data-lucide="badge-check" class="w-4 h-4"></i>
                                </div>
                                <div class="min-w-0">
                                    <p class="text-[11px] uppercase tracking-wider text-slate-500 font-medium">Tu equipo</p>
                                    <p class="text-sm font-semibold text-slate-800 truncate">Certificado FNMT · seguro</p>
                                </div>
                                <span class="ml-auto inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-[10px] font-medium">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                    Local
                                </span>
                            </div>
                            <div class="mt-3 flex items-center gap-2 text-[11px] text-slate-500">
                                <i data-lucide="terminal" class="w-3 h-3"></i>
                                <code class="font-mono">pideinfo-agent · sync</code>
                            </div>
                        </div>
                        <div class="home-portals-machine-base"></div>
                    </div>

                    <div class="home-portals-flow">
                        <span class="home-portals-flow-line"></span>
                        <span class="home-portals-flow-pill">Sólo tus datos · cifrado</span>
                        <span class="home-portals-flow-line"></span>
                    </div>

                    {# Portal grid #}
                    <div class="grid grid-cols-2 gap-2.5">
                        {% set portals = [
                            { name: 'Portal de Transparencia', code: 'AGE',     icon: 'building-2',     hue: 'sky' },
                            { name: 'CTBG sede electrónica',   code: 'CTBG',    icon: 'scale',          hue: 'indigo' },
                            { name: 'DEHú',                    code: 'DEHú',    icon: 'mail-check',     hue: 'violet' },
                            { name: 'Registro Electrónico',    code: 'REC',     icon: 'file-stack',     hue: 'amber' },
                        ] %}
                        {% for portal in portals %}
                        <div class="home-portal-card group">
                            <div class="flex items-center gap-2.5">
                                <span class="home-portal-icon home-portal-icon--{{ portal.hue }}">
                                    <i data-lucide="{{ portal.icon }}" class="w-3.5 h-3.5"></i>
                                </span>
                                <div class="min-w-0">
                                    <p class="text-xs font-semibold text-slate-800 truncate">{{ portal.name }}</p>
                                    <p class="text-[10px] uppercase tracking-wider text-slate-400">{{ portal.code }}</p>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{# MCP — IA conectada a tus solicitudes #}
<section class="home-mcp-section py-20 relative overflow-hidden">
    <div class="home-mcp-bg"></div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
            <div class="flex-1 text-center lg:text-left">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-900 text-primary-200 text-xs font-medium mb-5">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary-300"></span>
                    Nuevo · servidor MCP
                </span>
                <h2 class="repo-title text-3xl sm:text-4xl text-slate-800">
                    Tu asistente IA
                    <span class="repo-title-accent">conoce tus solicitudes</span>
                </h2>
                <p class="mt-4 text-slate-600 leading-relaxed max-w-lg">
                    PideInfo expone un servidor <strong>Model Context Protocol</strong> (MCP) para que Claude, ChatGPT, Cursor o cualquier asistente compatible pueda buscar, crear y gestionar tus solicitudes <em>en tu nombre</em> — con autorización OAuth y permisos revocables en cualquier momento.
                </p>

                <div class="mt-6 flex flex-wrap items-center gap-2">
                    <span class="text-xs uppercase tracking-wider text-slate-500 font-medium mr-1">Compatibles:</span>
                    {% for client in ['Claude.ai', 'ChatGPT', 'Cursor', 'OpenClaw', 'Hermes', 'MCP Inspector'] %}
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-white border border-slate-200 text-slate-700 text-xs font-medium shadow-sm">{{ client }}</span>
                    {% endfor %}
                </div>

                <div class="mt-7 flex flex-wrap gap-3 justify-center lg:justify-start">
                    {% if app.user %}
                    <button type="button"
                            @click="$dispatch('open-mcp-info-modal')"
                            class="btn btn-primary px-6 py-3 text-base">
                        <i data-lucide="cpu" class="w-5 h-5 mr-2"></i>
                        Conectar mi asistente
                    </button>
                    {% else %}
                    <a href="{{ path('app_register') }}" class="btn btn-primary px-6 py-3 text-base">
                        <i data-lucide="cpu" class="w-5 h-5 mr-2"></i>
                        Conectar mi asistente
                    </a>
                    {% endif %}
                </div>
            </div>

            <div class="lg:w-5/12 flex-shrink-0 w-full">
                <div class="home-mcp-transcript" aria-hidden="true">
                    <div class="home-mcp-transcript-head">
                        <span class="home-mcp-dot home-mcp-dot--red"></span>
                        <span class="home-mcp-dot home-mcp-dot--amber"></span>
                        <span class="home-mcp-dot home-mcp-dot--green"></span>
                        <span class="ml-2 text-[10px] uppercase tracking-wider text-slate-400 font-medium">Sesión MCP</span>
                    </div>

                    <div class="home-mcp-transcript-body">
                        <div class="home-mcp-msg home-mcp-msg--user">
                            <span class="home-mcp-msg-label">Tú</span>
                            <p>¿Qué solicitudes tengo en plazo crítico esta semana?</p>
                        </div>

                        <div class="home-mcp-tools">
                            <div class="home-mcp-tool">
                                <span class="home-mcp-tool-arrow">→</span>
                                <code>list_upcoming_deadlines</code>
                                <span class="home-mcp-tool-arg">daysAhead: 7</span>
                                <span class="home-mcp-tool-ok"><i data-lucide="check" class="w-3 h-3"></i> 3 solicitudes</span>
                            </div>
                            <div class="home-mcp-tool">
                                <span class="home-mcp-tool-arrow">→</span>
                                <code>get_request_detail</code>
                                <span class="home-mcp-tool-arg">uuid: 019d…7819</span>
                                <span class="home-mcp-tool-ok"><i data-lucide="check" class="w-3 h-3"></i> Vence en 2 días</span>
                            </div>
                            <div class="home-mcp-tool">
                                <span class="home-mcp-tool-arrow">→</span>
                                <code>get_status_history</code>
                                <span class="home-mcp-tool-arg">uuid: 019d…7819</span>
                                <span class="home-mcp-tool-ok"><i data-lucide="check" class="w-3 h-3"></i> 4 cambios</span>
                            </div>
                        </div>

                        <div class="home-mcp-msg home-mcp-msg--assistant">
                            <span class="home-mcp-msg-label">Asistente</span>
                            <p>Tienes 3 solicitudes que vencen esta semana. La del Ministerio de Hacienda ya fue prorrogada un mes por el organismo el 8 de abril; las otras dos siguen en trámite ordinario.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{# Repositorio de resoluciones #}
<section class="home-repo-section py-20 border-y border-slate-200/50 relative overflow-hidden">
    <div class="home-repo-bg"></div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="flex flex-col lg:flex-row items-center gap-12">
            <div class="flex-1 text-center lg:text-left">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/80 border border-primary-200 text-primary-700 text-xs font-medium mb-5">
                    <i data-lucide="globe" class="w-3.5 h-3.5"></i>
                    Acceso libre — sin registro
                </span>
                <h2 class="repo-title text-3xl sm:text-4xl text-slate-800">
                    Repositorio <span class="repo-title-accent">unificado</span><br>
                    de resoluciones de transparencia
                </h2>
                <p class="mt-4 text-slate-500 leading-relaxed max-w-lg">
                    Más de {{ globalStats.total|number_format(0, ',', '.') }} resoluciones de {{ globalStats.organismCount }} consejos de transparencia españoles, indexadas, analizadas con IA y con búsqueda avanzada. Un recurso público para ciudadanos, investigadores y profesionales.
                </p>
                <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 justify-center lg:justify-start">
                    <div class="flex items-center gap-2 text-sm">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
                        <span class="text-slate-600"><strong class="text-slate-800">{{ globalStats.successRate }}%</strong> tasa de estimación</span>
                    </div>
                    <div class="flex items-center gap-2 text-sm">
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
                        <span class="text-slate-600"><strong class="text-slate-800">{{ globalStats.meanDaysToResolve }}</strong> días de media</span>
                    </div>
                </div>
                <div class="mt-7">
                    <a href="{{ path('app_resoluciones_index') }}" class="btn btn-primary px-8 py-3 text-base">
                        <i data-lucide="scale" class="w-5 h-5 mr-2"></i>
                        Explorar resoluciones
                    </a>
                </div>
            </div>
            <div class="lg:w-5/12 flex-shrink-0">
                <div class="home-repo-preview">
                    <div class="home-repo-bar">
                        <div class="home-repo-bar-seg" style="width: 55%; background: #34d399"></div>
                        <div class="home-repo-bar-seg" style="width: 30%; background: #f87171"></div>
                        <div class="home-repo-bar-seg" style="width: 15%; background: #cbd5e1"></div>
                    </div>
                    <div class="space-y-2.5 mt-5">
                        {% for i in 1..4 %}
                        <div class="flex items-center gap-3 p-3 bg-white rounded-lg border border-slate-100">
                            <span class="w-1.5 h-8 rounded-full bg-{{ ['emerald', 'red', 'emerald', 'amber'][i-1] }}-{{ [400, 400, 400, 400][i-1] }} flex-shrink-0"></span>
                            <div class="flex-1 min-w-0">
                                <div class="h-2.5 bg-slate-200 rounded-full w-{{ ['3/4', '2/3', '4/5', '1/2'][i-1] }}"></div>
                                <div class="h-2 bg-slate-100 rounded-full w-1/3 mt-1.5"></div>
                            </div>
                            <div class="h-2 bg-slate-100 rounded-full w-12"></div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{# En desarrollo #}
<section class="py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid sm:grid-cols-2 gap-8">
            <div class="dash-section p-8 text-center">
                <img src="{{ asset('images/5a_notificaciones.png') }}" alt="Notificaciones automáticas"
                     class="w-28 h-28 mx-auto mb-5 object-contain" loading="lazy">
                <h3 class="font-semibold text-slate-800 mb-3" style="font-family: 'DM Sans', sans-serif">En lo que estamos trabajando</h3>
                <p class="text-sm text-slate-500 leading-relaxed">
                    Gestión automática de <strong class="text-slate-700">comunicaciones y notificaciones electrónicas</strong> de las administraciones, para que las actualizaciones que te lleguen se carguen automáticamente — sin entrar, autenticarte y subir documentos a mano.
                </p>
            </div>

            <div class="dash-section p-8 text-center">
                <img src="{{ asset('images/5b_sostenibilidad.png') }}" alt="Modelo de sostenibilidad"
                     class="w-28 h-28 mx-auto mb-5 object-contain" loading="lazy">
                <h3 class="font-semibold text-slate-800 mb-3" style="font-family: 'DM Sans', sans-serif">Modelo de sostenibilidad</h3>
                <p class="text-sm text-slate-500 leading-relaxed">
                    Durante la beta el uso es <strong class="text-slate-700">completamente gratuito</strong>. Habrá un plan gratuito que cubrirá las necesidades de la mayoría. Quienes lo usen profesionalmente podrán acceder a un plan ajustado al coste real — sin márgenes artificiales.
                </p>
            </div>
        </div>
    </div>
</section>

{# Qué es #}
<section class="py-12 pb-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-slate-500 leading-relaxed italic">
