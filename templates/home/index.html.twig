    { canal: 'REG / RED SARA', ley: 'Llei 19/2014 · Catalunya', leyLarga: 'Llei 19/2014, de 29 de desembre, de transparència, accés a la informació pública i bon govern', aa: 'Ajuntament de Barcelona',
      asunto: 'Inspecciones sanitarias en bares y restaurantes',
      solicita: 'La relación de inspecciones higiénico-sanitarias realizadas a bares y restaurantes en 2025, con el resultado de cada una y las medidas adoptadas ante los incumplimientos.',
      hero: { eyebrow: 'Salud pública · Inspecciones de establecimientos', pre: '¿Qué bares de mi ciudad ', mark: 'han suspendido la inspección sanitaria', post: '?',
              sub: 'Los resultados de las inspecciones son información pública. PideInfo te ayuda a pedirlos y a reclamar si te los niegan.' } },
    { canal: 'REG / RED SARA', ley: 'Ley 10/2019 · C. de Madrid', leyLarga: 'Ley 10/2019, de 10 de abril, de Transparencia de la Comunidad de Madrid', aa: 'Metro de Madrid, S.A.',
