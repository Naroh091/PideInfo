<script>
    // ── La hoja que se escribe sola, en tándem con el hero ───
    // El catálogo caso↔pregunta viene del bloque Twig del hero (única
    // fuente). Cada caso se teclea, respira y da paso al siguiente del
    // barajado; al cambiar de caso, el titular funde a SU pregunta.
    // Con reduced-motion: el caso del SSR, quieto y sin rotación.
    (function () {
        // Cada administración con su ley de transparencia (las mismas que
        // resuelve ApplicableLawResolver): estatal 19/2013 para la AGE y sus
        // entes; la autonómica correspondiente para CCAA y entidades locales.
        const EXPONE_ESTATAL = {{ exponeEstatal|json_encode|raw }};
        const expone = (ley) => `Que, en ejercicio del derecho de acceso a la información pública reconocido por la ${ley},`;

        const CASOS = {{ casos|json_encode|raw }}.map(c => ({
            ...c,
            expone: c.leyLarga ? expone(c.leyLarga) : EXPONE_ESTATAL,
        }));
        const campos = {
            canal: document.querySelector('[data-campo="canal"]'),
            ley: document.querySelector('[data-campo="ley"]'),
            aa: document.querySelector('[data-campo="aa"]'),
            asunto: document.querySelector('[data-campo="asunto"]'),
            expone: document.querySelector('[data-campo="expone"]'),
            solicita: document.querySelector('[data-campo="solicita"]'),
        };
        if (!campos.aa) return;

        // Barajado Fisher–Yates: cada visita ve un orden distinto.
        const orden = CASOS.map((_, i) => i);
        for (let i = orden.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [orden[i], orden[j]] = [orden[j], orden[i]];
        }

        // El caso que el servidor ya pintó (hero + hoja) abre la rotación:
        // así el primer tecleo no cambia el titular que el visitante está
        // leyendo. El resto sigue el barajado.
        const inicial = parseInt(document.querySelector('.home-hoja-marco')?.dataset.casoInicial ?? '-1', 10);
        if (inicial >= 0 && inicial < CASOS.length) {
            orden.splice(orden.indexOf(inicial), 1);
            orden.unshift(inicial);
        }

        // Rotación del hero en tándem: al pasar a un caso nuevo, el titular
        // funde a SU pregunta y el rotulador vuelve a barrer.
        const heroRota = document.querySelector('[data-hero-rota]');
        const heroCampos = {};
        heroRota?.querySelectorAll('[data-hero-campo]').forEach(el => { heroCampos[el.dataset.heroCampo] = el; });

        function fundirHero(caso) {
            if (!heroRota || !heroCampos.mark) return;
            heroRota.classList.add('is-cambiando');
            setTimeout(() => {
                heroCampos.eyebrow.textContent = caso.hero.eyebrow;
                heroCampos.pre.textContent = caso.hero.pre;
                heroCampos.mark.textContent = caso.hero.mark;
                heroCampos.post.textContent = caso.hero.post;
                heroCampos.sub.textContent = caso.hero.sub;
                heroCampos.mark.classList.remove('rotulador--barrido');
                void heroCampos.mark.offsetWidth; // reinicia la animación del barrido
                heroCampos.mark.classList.add('rotulador--barrido');
                heroRota.classList.remove('is-cambiando');
            }, 300); // en sintonía con la transición de .home-hero-rota
        }

        function pintar(caso) {
            campos.canal.textContent = caso.canal;
            campos.ley.textContent = caso.ley;
            campos.aa.textContent = caso.aa;
            campos.asunto.textContent = caso.asunto;
            campos.expone.textContent = caso.expone;
            campos.solicita.textContent = caso.solicita;
        }

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            pintar(CASOS[orden[0]]); // el caso del SSR, quieto y sin rotar
            return;
        }

        const caret = document.querySelector('.home-hoja-caret');
        const SECUENCIA = ['aa', 'asunto', 'expone', 'solicita'];

        function teclearCaso(idx) {
            const caso = CASOS[orden[idx % orden.length]];
            if (idx > 0) fundirHero(caso); // el 0 ya lo pintó el servidor
            campos.canal.textContent = caso.canal;
            campos.ley.textContent = caso.ley;
            SECUENCIA.forEach(k => { campos[k].textContent = ''; });

            function teclearCampo(c) {
                if (c >= SECUENCIA.length) {
                    setTimeout(() => teclearCaso(idx + 1), 4200); // respira antes del siguiente
                    return;
                }
                const span = campos[SECUENCIA[c]];
                const texto = caso[SECUENCIA[c]];
                let pos = 0;
                if (caret) span.after(caret); // el caret acompaña a la línea que se escribe

                (function paso() {
                    if (pos <= texto.length) {
                        span.textContent = texto.slice(0, pos);
                        pos++;
                        setTimeout(paso, 14 + Math.random() * 22);
                    } else {
                        setTimeout(() => teclearCampo(c + 1), 300);
                    }
                })();
            }
            teclearCampo(0);
        }

        // Arranca tras el barrido del rotulador, para no competir con él.
        SECUENCIA.forEach(k => { campos[k].textContent = ''; });
        setTimeout(() => teclearCaso(0), 1300);
    })();

    // ── Reveals discretos ────────────────────────────────────
    (function () {
        const nodos = document.querySelectorAll('.home-revela');
        if (!('IntersectionObserver' in window)) {
            nodos.forEach(n => n.classList.add('visible'));
            return;
        }
        const io = new IntersectionObserver((entries) => {
            entries.forEach(e => {
                if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
            });
        }, { threshold: 0.15 });
        nodos.forEach(n => io.observe(n));
    })();
</script>

{% endblock %}
