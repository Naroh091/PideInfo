{% extends 'base.html.twig' %}

{% block title %}PideInfo — Ejerce tu derecho de acceso a la información pública{% endblock %}

{% block og %}
    <meta property="og:title" content="PideInfo — Ejerce tu derecho de acceso a la información pública">
    <meta property="og:description" content="De la solicitud a la reclamación: redacta con resoluciones reales, presenta en más de 31.000 registros oficiales, vigila los plazos y reclama con fundamento jurídico.">
    <meta property="og:image" content="{{ url('og_image_home') }}">
    <meta property="og:url" content="{{ url('app_home') }}">
    <meta property="og:site_name" content="PideInfo">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="PideInfo — Ejerce tu derecho de acceso a la información pública">
    <meta name="twitter:description" content="De la solicitud a la reclamación: redacta con resoluciones reales, presenta en más de 31.000 registros oficiales, vigila los plazos y reclama con fundamento jurídico.">
    <meta name="twitter:image" content="{{ url('og_image_home') }}">
{% endblock %}


{% block body_class %}bg-white min-h-screen flex flex-col{% endblock %}

{% block body %}
{% include '_partials/public_nav.html.twig' with { active_page: 'home' } %}

{# ── Hero: el derecho, subrayado ─────────────────────────── #}
<header class="home-hero">
    <div class="max-w-6xl mx-auto px-5 sm:px-8">
        <div class="home-hero-grid">
            <div>
                <p class="home-hero-eyebrow"><span>{{ heroVariant.eyebrow }}</span></p>

                <h1 class="home-hero-cita">«{{ heroVariant.titlePre }}<span class="rotulador rotulador--barrido">{{ heroVariant.titleMark }}</span>{{ heroVariant.titlePost }}»</h1>

                <p class="home-hero-sub">{{ heroVariant.subtitle }}</p>

                <div class="mt-9 flex flex-wrap items-center gap-3.5">
                    <a href="{{ path('app_public_redactar') }}" class="btn-editorial btn-editorial--primario">
                        <i data-lucide="pen-line"></i>
                        Redactar mi primera solicitud
                    </a>
                    <a href="{{ path('app_register') }}" class="btn-editorial btn-editorial--secundario">
                        <i data-lucide="user-plus"></i>
                        Crear cuenta
                    </a>
                </div>
                <p class="home-hero-nota"><i data-lucide="check"></i> Sin registro — al terminar descargas el PDF listo para presentar, o lo envías desde nuestra plataforma.</p>
            </div>

            <div class="home-hoja-marco" aria-hidden="true">
                <div class="home-hoja">
                    <div class="home-hoja-meta">
                        <span class="home-hoja-pill home-hoja-pill--canal" data-campo="canal">Portal Transparencia</span>
                        <span class="home-hoja-pill" data-campo="ley">Ley 19/2013</span>
                    </div>
                    <p class="home-hoja-titulo">Solicitud de acceso a información pública</p>
                    <p class="home-hoja-linea"><b>A/A:</b> <span data-campo="aa">Ministerio de Transportes y Movilidad Sostenible</span></p>
                    <p class="home-hoja-linea"><b>ASUNTO:</b> <span data-campo="asunto">Contratos de conservación de carreteras 2023–2024</span></p>
                    <p class="home-hoja-linea"><b>EXPONE:</b> <span data-campo="expone">Que, al amparo del artículo 17 de la Ley 19/2013, de 9 de diciembre, de transparencia, acceso a la información pública y buen gobierno,</span></p>
                    <p class="home-hoja-linea"><b>SOLICITA:</b> <span data-campo="solicita">La relación de contratos de conservación y explotación de carreteras adjudicados en 2023 y 2024, con importe, adjudicatario y criterios de adjudicación.</span><span class="home-hoja-caret"></span></p>
                    <div class="home-hoja-firma">
                        <span>borrador · aún sin presentar</span>
                        <span>pideinfo.es</span>
                    </div>
                </div>
                <div class="home-hoja-sello">
                    <i data-lucide="library"></i>
                    <span>Apoyada en <b>{{ globalStats.total|number_format(0, ',', '.') }} resoluciones</b> reales</span>
                </div>
            </div>
        </div>
    </div>
</header>

{# ── Banda tinta: el repositorio que respalda cada argumento ── #}
<section class="home-repo-oscuro">
    <div class="max-w-6xl mx-auto px-5 sm:px-8">
        <div class="home-repo-oscuro-grid">
            <div class="home-revela">
                <h2 class="home-seccion-titulo">Si rechazan darte lo que pides, te ayudamos con <span class="home-acento">resoluciones y sentencias</span></h2>
                <p class="home-repo-oscuro-sub">Unificamos las resoluciones de los {{ globalStats.organismCount }} consejos de transparencia — y las <b>sentencias judiciales</b> que las confirman o anulan — en un repositorio único y buscable. Es un <b>corpus único en España</b> con el que el asistente redacta, y es público: sin registro.</p>
                <div class="home-repo-cta">
                    <a href="{{ path('app_resoluciones_index') }}" class="btn-editorial btn-editorial--primario btn-editorial--tinta">
                        <i data-lucide="library"></i>
                        Explorar el repositorio
                    </a>
                </div>
            </div>
            <div class="home-revela">
                <div class="home-repo-preview" aria-hidden="true">
                    <div class="home-repo-barra">
                        <span class="home-repo-seg--fav" style="width:{{ globalStats.favorablePct }}%"></span>
                        <span class="home-repo-seg--parcial" style="width:{{ globalStats.partialPct }}%"></span>
                        <span class="home-repo-seg--desfav" style="width:{{ globalStats.unfavorablePct }}%"></span>
                    </div>
                    <div class="home-repo-leyenda">
                        <span><i class="home-repo-seg--fav"></i>Estimadas {{ globalStats.favorablePct }}%</span>
                        <span><i class="home-repo-seg--parcial"></i>Parciales {{ globalStats.partialPct }}%</span>
                        <span><i class="home-repo-seg--desfav"></i>Desestimadas {{ globalStats.unfavorablePct }}%</span>
                    </div>
                    <div class="home-repo-fila">
                        <span class="ref">R/0155/2021</span>
                        <span class="titulo-fila">Contratos de emergencia — Ministerio de Hacienda</span>
                        <span class="home-pildora home-pildora--estimada">Estimada</span>
                    </div>
                    <div class="home-repo-fila">
                        <span class="ref">RT 0389/2024</span>
                        <span class="titulo-fila">Retribuciones de altos cargos — Generalitat</span>
                        <span class="home-pildora home-pildora--parcial">Parcial</span>
                    </div>
                    <div class="home-repo-fila">
                        <span class="ref">CTBG 118/2025</span>
                        <span class="titulo-fila">Agendas de reuniones — Ministerio del Interior</span>
                        <span class="home-pildora home-pildora--desestimada">Desestimada</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="home-franja">
            <span class="home-franja-dato"><b>{{ globalStats.total|number_format(0, ',', '.') }}</b>resoluciones</span>
            <span class="home-franja-dato"><b>{{ globalStats.judgmentCount|number_format(0, ',', '.') }}</b>sentencias judiciales</span>
            <span class="home-franja-dato"><b>{{ globalStats.distinctPublicBodies|number_format(0, ',', '.') }}</b>administraciones reclamadas</span>
            <span class="home-franja-dato"><b>{{ globalStats.successRate }}&nbsp;%</b>de reclamaciones estimadas</span>
        </div>
    </div>
</section>

{# ── El problema: carrera de obstáculos ──────────────────── #}
<section class="home-seccion">
    <div class="max-w-6xl mx-auto px-5 sm:px-8">
        <div class="home-obstaculos-grid">
            <div class="home-obstaculos-titular home-revela">
                <h2 class="home-seccion-titulo">La ley te da el derecho.<br>La práctica te lo <span class="home-acento">complica</span>.</h2>
                <p class="home-seccion-sub">Tres formas habituales de perder un expediente — y las tres se ganan reaccionando a tiempo y con fundamento.</p>
            </div>
            <div class="home-obstaculos-cards">
                {% set obstaculos = [
                    { img: '2a_silencio.png', title: 'Silencio administrativo', desc: 'La Administración puede sencillamente no contestar. El silencio es desestimatorio — y si no reaccionas a tiempo, el expediente muere solo.' },
                    { img: '2b_denegado.png', title: 'Denegaciones injustificadas', desc: 'Los límites de la ley se invocan de forma expansiva. La mayoría de denegaciones se caen cuando alguien las reclama con fundamento.' },
                    { img: '2c_plazos.png', title: 'Plazos y burocracia', desc: 'Un mes de plazo, prórrogas, subsanaciones, alegaciones de terceros… cada trámite tiene su reloj, y todos corren en tu contra.' },
                ] %}
                {% for obstaculo in obstaculos %}
                <div class="home-obstaculo home-revela">
                    <img src="{{ asset('images/' ~ obstaculo.img) }}" alt="" loading="lazy">
                    <div>
                        <h3>{{ obstaculo.title }}</h3>
                        <p>{{ obstaculo.desc }}</p>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

{# ── Cómo funciona: el expediente completo ───────────────── #}
<section class="home-seccion home-seccion--alterna" id="como-funciona">
    <div class="max-w-6xl mx-auto px-5 sm:px-8">
        <div class="home-seccion-cabecera home-revela">
            <h2 class="home-seccion-titulo">Tú pides. PideInfo hace <span class="home-acento">el resto</span>.</h2>
            <p class="home-seccion-sub">Redacción, envío, seguimiento y reclamación: el expediente completo en un solo sitio.</p>
        </div>
        <div class="home-features">
            <div class="home-feature home-revela">
                <div class="home-feature-cab">
                    <span class="home-feature-num">1</span>
                    <span class="home-feature-icono"><i data-lucide="pen-line"></i></span>
                </div>
                <h3>Redacción con precedentes</h3>
                <p>El asistente escribe contigo citando la <b>ley aplicable</b> y <b>resoluciones que ya ganaron</b> casos como el tuyo — nada de plantillas genéricas.</p>
                <span class="home-feature-prueba"><i data-lucide="check"></i> {{ globalStats.total|number_format(0, ',', '.') }} resoluciones y {{ globalStats.judgmentCount|number_format(0, ',', '.') }} sentencias detrás de cada borrador</span>
            </div>
            <div class="home-feature home-revela">
                <div class="home-feature-cab">
                    <span class="home-feature-num">2</span>
                    <span class="home-feature-icono"><i data-lucide="send"></i></span>
                </div>
                <h3>Envío sin sedes imposibles</h3>
                <p>Presenta en el <b>Portal de Transparencia</b> o en <b>más de 31.000 registros oficiales</b> sin pelearte con formularios: PideInfo <b>rellena y presenta por ti</b>.</p>
                <span class="home-feature-prueba"><i data-lucide="check"></i> Portal AGE + REG / RED SARA, con acuse en el expediente</span>
            </div>
            <div class="home-feature home-revela">
                <div class="home-feature-cab">
                    <span class="home-feature-num">3</span>
                    <span class="home-feature-icono"><i data-lucide="alarm-clock"></i></span>
                </div>
                <h3>Ningún plazo se te escapa</h3>
                <p>Cada solicitud lleva su reloj legal: <b>prórrogas, subsanaciones y silencio</b> detectados al día. Las respuestas <b>entran solas al expediente</b> y se clasifican automáticamente.</p>
                <span class="home-feature-prueba"><i data-lucide="check"></i> Te avisamos antes de que venza — no después</span>
            </div>
            <div class="home-feature home-revela">
                <div class="home-feature-cab">
                    <span class="home-feature-num">4</span>
                    <span class="home-feature-icono"><i data-lucide="gavel"></i></span>
                </div>
                <h3>Reclamar deja de dar pereza</h3>
                <p>Si deniegan o callan, la reclamación al Consejo de Transparencia sale con <b>los argumentos que ya funcionaron</b> — lista para presentar desde aquí.</p>
                <span class="home-feature-prueba"><i data-lucide="check"></i> Con análisis de probabilidad de éxito antes de presentar</span>
            </div>
        </div>
    </div>
</section>

{# ── Privacidad del certificado ──────────────────────────── #}
<section class="home-seccion home-privacidad">
    <div class="max-w-6xl mx-auto px-5 sm:px-8">
        <div class="home-privacidad-grid">
            <div class="home-revela">
                <span class="home-badge home-badge--emerald"><i data-lucide="shield-check"></i> Privacidad por diseño</span>
                <h2 class="home-seccion-titulo">Centraliza todos los procesos <span class="home-acento">de forma segura</span></h2>
                <p class="home-seccion-sub"><strong>Olvídate de tener que registrarte y manejar decenas de sedes electrónicas.</strong> Pideinfo se conecta con los portales del Estado para sincronizar tus expedientes y notificaciones mediante certificado digital. Tu certificado nunca se sube ni se delega: el agente local de PideInfo lo usa <em>en tu equipo</em> y nos envía solo los datos que ya son tuyos.</p>
                <ul class="home-perks">
                    {% set perks = [
                        { icon: 'lock-keyhole', text: 'Autenticación Cl@ve / FNMT realizada localmente, sin proxy.' },
                        { icon: 'refresh-cw',   text: 'Sincronización periódica de expedientes, notificaciones y documentos.' },
                        { icon: 'eye-off',      text: 'PideInfo nunca ve tu clave privada ni tu navegador autenticado.' },
                    ] %}
                    {% for perk in perks %}
                    <li class="home-perk"><span class="home-perk-icono"><i data-lucide="{{ perk.icon }}"></i></span> {{ perk.text }}</li>
                    {% endfor %}
                </ul>
            </div>
            <div class="home-revela">
                <div class="home-maquina">
                    <div class="home-maquina-pantalla">
                        <div class="home-maquina-cab">
                            <span class="home-maquina-logo"><i data-lucide="badge-check"></i></span>
                            <div class="home-maquina-cab-txt">
                                <p class="mini">Tu equipo</p>
                                <p class="nombre">Certificado FNMT · seguro</p>
                            </div>
                            <span class="home-maquina-local"><span class="home-maquina-punto"></span> Local</span>
                        </div>
                        <div class="home-maquina-cmd"><i data-lucide="terminal"></i> <code>pideinfo-agent · sync</code></div>
                    </div>
                    <div class="home-maquina-base"></div>
                    <div class="home-flujo">
                        <span class="home-flujo-linea"></span>
                        <span class="home-flujo-pill">Solo tus datos · cifrado</span>
                        <span class="home-flujo-linea"></span>
                    </div>
                    <div class="home-portales">
                        {% set portals = [
                            { name: 'Portal de Transparencia', code: 'AGE',  icon: 'building-2', hue: 'sky' },
                            { name: 'CTBG sede electrónica',   code: 'CTBG', icon: 'scale',      hue: 'indigo' },
                            { name: 'DEHú',                    code: 'DEHú', icon: 'mail-check', hue: 'violet' },
                            { name: 'Registro Electrónico',    code: 'REC',  icon: 'file-stack', hue: 'amber' },
                        ] %}
                        {% for portal in portals %}
                        <div class="home-portal">
                            <span class="home-portal-icono home-portal-icono--{{ portal.hue }}"><i data-lucide="{{ portal.icon }}"></i></span>
                            <div><p class="nombre">{{ portal.name }}</p><p class="codigo">{{ portal.code }}</p></div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{# ── MCP, en tinta ───────────────────────────────────────── #}
<section class="home-mcp">
    <div class="max-w-6xl mx-auto px-5 sm:px-8">
        <div class="home-mcp-grid">
            <div class="home-revela">
                <span class="home-badge home-badge--tinta"><span class="home-maquina-punto" style="background:#7dd3fc"></span> Nuevo · servidor MCP</span>
                <h2 class="home-seccion-titulo">Tu asistente IA <span class="home-acento">conoce tus solicitudes</span></h2>
                <p class="home-mcp-sub">PideInfo expone un servidor <strong>Model Context Protocol</strong> para que Claude, ChatGPT, Cursor o cualquier asistente compatible pueda buscar, crear y gestionar tus solicitudes <em>en tu nombre</em> — con autorización OAuth y permisos revocables en cualquier momento.</p>
                <div class="home-mcp-clientes">
                    <span class="home-mcp-clientes-label">Compatibles:</span>
                    {% for client in ['Claude.ai', 'ChatGPT', 'Cursor', 'OpenClaw', 'Hermes', 'MCP Inspector'] %}
                    <span class="home-chip">{{ client }}</span>
                    {% endfor %}
                </div>
                <div class="home-mcp-cta">
                    <a href="{{ path('app_register') }}" class="btn-editorial btn-editorial--primario btn-editorial--tinta">
                        <i data-lucide="cpu"></i>
                        Conectar mi asistente
                    </a>
                </div>
            </div>
            <div class="home-revela">
                <div class="home-terminal" aria-hidden="true">
                    <div class="home-terminal-cab">
                        <span class="home-terminal-punto home-terminal-punto--rojo"></span>
                        <span class="home-terminal-punto home-terminal-punto--ambar"></span>
                        <span class="home-terminal-punto home-terminal-punto--verde"></span>
                        <span>Sesión MCP</span>
                    </div>
                    <div class="home-terminal-cuerpo">
                        <div class="home-msg home-msg--user">
                            <span class="home-msg-label">Tú</span>
                            <p>¿Qué solicitudes tengo en plazo crítico esta semana?</p>
                        </div>
                        <div class="home-tools">
                            <div class="home-tool"><span class="home-tool-flecha">→</span> <code>list_upcoming_deadlines</code> <span class="home-tool-arg">daysAhead: 7</span> <span class="home-tool-ok"><i data-lucide="check"></i> 3 solicitudes</span></div>
                            <div class="home-tool"><span class="home-tool-flecha">→</span> <code>get_request_detail</code> <span class="home-tool-arg">uuid: 019d…7819</span> <span class="home-tool-ok"><i data-lucide="check"></i> Vence en 2 días</span></div>
                            <div class="home-tool"><span class="home-tool-flecha">→</span> <code>get_status_history</code> <span class="home-tool-arg">uuid: 019d…7819</span> <span class="home-tool-ok"><i data-lucide="check"></i> 4 cambios</span></div>
                        </div>
                        <div class="home-msg home-msg--assistant">
                            <span class="home-msg-label">Asistente</span>
                            <p>Tienes 3 solicitudes que vencen esta semana. La del Ministerio de Hacienda ya fue prorrogada un mes por el organismo el 8 de abril; las otras dos siguen en trámite ordinario.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{# ── Cierre ──────────────────────────────────────────────── #}
<section class="home-cierre">
    <div class="max-w-6xl mx-auto px-5 sm:px-8">
        <p>PideInfo nace para que ejercer el derecho de acceso a la información pública deje de ser cosa de especialistas. Gratuito durante la beta abierta.</p>
    </div>
</section>

{% include '_partials/public_footer.html.twig' %}

<script>
    // ── La hoja que se escribe sola: 10 solicitudes reales ───
    // Estatales, autonómicas y locales, con alguna sonrisa dentro.
    // Se muestran en orden aleatorio; cada una se teclea, respira y
    // da paso a la siguiente. Con reduced-motion: una al azar, quieta.
    (function () {
        // Cada administración con su ley de transparencia (las mismas que
        // resuelve ApplicableLawResolver): estatal 19/2013 para la AGE y sus
        // entes; la autonómica correspondiente para CCAA y entidades locales.
        const EXPONE_ESTATAL = 'Que, al amparo del artículo 17 de la Ley 19/2013, de 9 de diciembre, de transparencia, acceso a la información pública y buen gobierno,';
        const expone = (ley) => `Que, en ejercicio del derecho de acceso a la información pública reconocido por la ${ley},`;

        const CASOS = [
            { canal: 'Portal Transparencia', ley: 'Ley 19/2013', aa: 'Ministerio de Transportes y Movilidad Sostenible',
              asunto: 'Contratos de conservación de carreteras 2023–2024',
              expone: EXPONE_ESTATAL,
              solicita: 'La relación de contratos de conservación y explotación de carreteras adjudicados en 2023 y 2024, con importe, adjudicatario y criterios de adjudicación.' },
            { canal: 'REG / RED SARA', ley: 'Ley 10/2019 · C. de Madrid', aa: 'Ayuntamiento de Madrid',
              asunto: 'Coste del alumbrado navideño 2025',
              expone: expone('Ley 10/2019, de 10 de abril, de Transparencia de la Comunidad de Madrid'),
              solicita: 'El coste total del alumbrado navideño de 2025, desglosado por distrito y por contrato, incluyendo montaje, consumo eléctrico y desmontaje.' },
            { canal: 'Portal Transparencia', ley: 'Ley 19/2013', aa: 'Dirección General de Tráfico',
              asunto: 'Los radares que más multan',
              expone: EXPONE_ESTATAL,
              solicita: 'La relación de los diez radares fijos con mayor número de denuncias en 2025, con su ubicación exacta y el importe total recaudado por cada uno.' },
            { canal: 'REG / RED SARA', ley: 'Llei 19/2014 · Catalunya', aa: 'Generalitat de Catalunya — Departament de la Presidència',
              asunto: 'Agendas de reuniones con grupos de interés',
              expone: expone('Llei 19/2014, de 29 de desembre, de transparència, accés a la informació pública i bon govern'),
              solicita: 'Las agendas de reuniones de los altos cargos del Departament con grupos de interés durante 2025, con fecha, asistentes y asunto tratado.' },
            { canal: 'REG / RED SARA', ley: 'Ley 3/2015 · Castilla y León', aa: 'Ayuntamiento de Ponferrada',
              asunto: 'Cachés de las orquestas de las fiestas',
              expone: expone('Ley 3/2015, de 4 de marzo, de Transparencia y Participación Ciudadana de Castilla y León'),
              solicita: 'El coste de las orquestas y grupos musicales contratados para las fiestas patronales de 2019 a 2025, con el caché de cada actuación.' },
            { canal: 'Portal Transparencia', ley: 'Ley 19/2013', aa: 'Ministerio de Defensa',
              asunto: 'Expedientes sobre fenómenos aéreos no identificados',
              expone: EXPONE_ESTATAL,
              solicita: 'Copia de los expedientes desclasificados del Ejército del Aire sobre avistamientos de fenómenos aéreos no identificados y su criterio de clasificación.' },
            { canal: 'REG / RED SARA', ley: 'Ley 1/2014 · Andalucía', aa: 'Servicio Andaluz de Salud',
              asunto: 'Listas de espera quirúrgicas por hospital',
              expone: expone('Ley 1/2014, de 24 de junio, de Transparencia Pública de Andalucía'),
              solicita: 'Las listas de espera quirúrgicas a 31 de diciembre de 2025, desglosadas por hospital, especialidad y tiempo medio de espera.' },
            { canal: 'REG / RED SARA', ley: 'Ley 19/2013', aa: 'Renfe Viajeros, S.M.E., S.A.',
              asunto: 'Puntualidad real de Cercanías',
              expone: EXPONE_ESTATAL,
              solicita: 'La puntualidad media por línea de Cercanías en 2025, los criterios para computar un tren como puntual y el importe total devuelto por retrasos.' },
            { canal: 'Portal Transparencia', ley: 'Ley 19/2013', aa: 'Ministerio de la Presidencia, Justicia y Relaciones con las Cortes',
              asunto: 'Viajes oficiales del presidente del Gobierno',
              expone: EXPONE_ESTATAL,
              solicita: 'La relación de viajes oficiales del presidente del Gobierno en 2024 y 2025, con destino, motivo, medio de transporte y coste por desplazamiento.' },
            { canal: 'REG / RED SARA', ley: 'Ley 8/2015 · Aragón', aa: 'Ayuntamiento de Zaragoza',
              asunto: 'Lo que cuestan las Fiestas del Pilar',
              expone: expone('Ley 8/2015, de 25 de marzo, de Transparencia de la Actividad Pública y Participación Ciudadana de Aragón'),
              solicita: 'El coste total de las Fiestas del Pilar de 2025, desglosado por conciertos, seguridad, limpieza y fuegos artificiales, y los ingresos por patrocinios.' },
        ];

        const campos = {
            canal: document.querySelector('[data-campo="canal"]'),
            ley: document.querySelector('[data-campo="ley"]'),
            aa: document.querySelector('[data-campo="aa"]'),
            asunto: document.querySelector('[data-campo="asunto"]'),
            expone: document.querySelector('[data-campo="expone"]'),
            solicita: document.querySelector('[data-campo="solicita"]'),
        };
        if (!campos.aa) return;

        // Barajado Fisher–Yates: cada visita ve un orden distinto.
        const orden = CASOS.map((_, i) => i);
        for (let i = orden.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [orden[i], orden[j]] = [orden[j], orden[i]];
        }

        function pintar(caso) {
            campos.canal.textContent = caso.canal;
            campos.ley.textContent = caso.ley;
            campos.aa.textContent = caso.aa;
            campos.asunto.textContent = caso.asunto;
            campos.expone.textContent = caso.expone;
            campos.solicita.textContent = caso.solicita;
        }

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            pintar(CASOS[orden[0]]); // una al azar, sin teclear
            return;
        }

        const caret = document.querySelector('.home-hoja-caret');
        const SECUENCIA = ['aa', 'asunto', 'expone', 'solicita'];

        function teclearCaso(idx) {
            const caso = CASOS[orden[idx % orden.length]];
            campos.canal.textContent = caso.canal;
            campos.ley.textContent = caso.ley;
            SECUENCIA.forEach(k => { campos[k].textContent = ''; });

            function teclearCampo(c) {
                if (c >= SECUENCIA.length) {
                    setTimeout(() => teclearCaso(idx + 1), 4200); // respira antes del siguiente
                    return;
                }
                const span = campos[SECUENCIA[c]];
                const texto = caso[SECUENCIA[c]];
                let pos = 0;
                if (caret) span.after(caret); // el caret acompaña a la línea que se escribe

                (function paso() {
                    if (pos <= texto.length) {
                        span.textContent = texto.slice(0, pos);
                        pos++;
                        setTimeout(paso, 14 + Math.random() * 22);
                    } else {
                        setTimeout(() => teclearCampo(c + 1), 300);
                    }
                })();
            }
            teclearCampo(0);
        }

        // Arranca tras el barrido del rotulador, para no competir con él.
        SECUENCIA.forEach(k => { campos[k].textContent = ''; });
        setTimeout(() => teclearCaso(0), 1300);
    })();

    // ── Reveals discretos ────────────────────────────────────
    (function () {
        const nodos = document.querySelectorAll('.home-revela');
        if (!('IntersectionObserver' in window)) {
            nodos.forEach(n => n.classList.add('visible'));
            return;
        }
        const io = new IntersectionObserver((entries) => {
            entries.forEach(e => {
                if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
            });
        }, { threshold: 0.15 });
        nodos.forEach(n => io.observe(n));
    })();
</script>

