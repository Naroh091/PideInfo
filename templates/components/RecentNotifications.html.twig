{% import 'components/_notification_macros.html.twig' as macros %}

<div {{ attributes.defaults({class: 'recent-notifications', 'data-action': 'notification_created@window->live#$render documents:processed@window->live#$render'}) }}>
    {% set notifications = this.notifications %}

    <section class="dash-section" style="animation: fade-slide-up 0.5s ease-out both; animation-delay: 0.05s"
             data-controller="accordion" data-accordion-key-value="notifications">
        <button type="button" class="dash-section-header cursor-pointer w-full" data-action="click->accordion#toggle">
            <h2 class="dash-section-title">
                <i data-lucide="activity" class="w-4 h-4 text-primary-500"></i>
                Actividad
                {% if notifications|length > 0 %}
                    <span class="dash-count">{{ notifications|length }}</span>
                {% endif %}
            </h2>
            <div class="flex items-center gap-3">
                <a href="{{ path('app_notificaciones_index') }}" class="text-xs text-slate-400 hover:text-primary-600 transition-colors" data-action="click->accordion#stopProp">
                    Ver todo <i data-lucide="arrow-right" class="w-3 h-3 inline"></i>
                </a>
                <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 transition-transform duration-200" data-accordion-target="icon"></i>
            </div>
        </button>

        <div data-accordion-target="body">
        {% if notifications|length > 0 %}
            <div class="dash-timeline">
                {% for notification in notifications %}
                    <a href="{{ path('app_notificaciones_read', {id: notification.id}) }}"
                       class="dash-timeline-item group {{ not notification.read ? 'dash-timeline-unread' : '' }}">
                        <div class="dash-timeline-dot {{ notification.alertLevel == 'warning' ? 'dash-dot-warn' : '' }}">
                            <i data-lucide="{{ notification.icon }}" class="w-3.5 h-3.5"></i>
                        </div>
                        <div class="flex-1 min-w-0 py-3">
                            {% if notification.accessRequest %}
                                <p class="text-xs font-medium text-primary-600 truncate mb-0.5">{{ notification.accessRequest.title }}</p>
                            {% endif %}
                            <p class="text-sm text-slate-700 leading-relaxed {{ not notification.read ? 'font-medium' : '' }}">
                                {{ notification.message }}
                            </p>
                            {{ macros.status_transition(notification) }}
                            <div class="flex items-center gap-2 mt-1">
                                <span class="text-xs text-slate-400">{{ notification.createdAt|date('d/m H:i') }}</span>
                                <span class="text-xs px-1.5 py-0.5 rounded bg-slate-50 text-slate-400">{{ notification.typeLabel }}</span>
                            </div>
                        </div>
                        {% if not notification.read %}
                            <span class="w-2 h-2 rounded-full bg-primary-500 flex-shrink-0"></span>
                        {% endif %}
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <div class="py-8 text-center">
                <p class="text-sm text-slate-400">Sin actividad reciente</p>
            </div>
        {% endif %}
        </div>
    </section>
</div>
