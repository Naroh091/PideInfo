{% macro status_label(status) %}
    {%- apply spaceless -%}
    {%- if status == 'none' -%}Sin reclamación
    {%- elseif status == 'sent' -%}Enviada
    {%- elseif status == 'processing' -%}En trámite
    {%- elseif status == 'granted' -%}Concedida
    {%- elseif status == 'granted_completed' -%}Completada
    {%- elseif status == 'denied' -%}Denegada
    {%- elseif status == 'delayed' -%}Silencio
    {%- elseif status == 'pending' -%}Pendiente
    {%- elseif status == 'reclaimed' -%}Reclamada
    {%- elseif status == 'complaint_granted' -%}Estimada
    {%- elseif status == 'complaint_denied' -%}Desestimada
    {%- elseif status == 'complaint_archived' -%}Archivada
    {%- elseif status == 'in_court' -%}En tribunal
    {%- elseif status == 'court_granted' -%}Favorable
    {%- elseif status == 'court_denied' -%}Desfavorable
    {%- else -%}{{ status }}
    {%- endif -%}
    {%- endapply -%}
{% endmacro %}

{% macro status_badge_class(status) %}
    {%- apply spaceless -%}
    {%- if status == 'sent' -%}status-sent
    {%- elseif status == 'processing' -%}status-processing
    {%- elseif status in ['granted', 'complaint_granted', 'court_granted'] -%}status-granted
    {%- elseif status == 'granted_completed' -%}status-granted-completed
    {%- elseif status in ['denied', 'complaint_denied', 'court_denied'] -%}status-denied
    {%- elseif status == 'delayed' -%}status-delayed
    {%- elseif status == 'pending' -%}status-pending
    {%- elseif status in ['reclaimed', 'in_court'] -%}status-processing
    {%- else -%}badge-secondary
    {%- endif -%}
    {%- endapply -%}
{% endmacro %}

{% macro status_transition(notification) %}
    {% if notification.type in ['status_changed', 'complaint_filed'] and notification.fromStatus and notification.toStatus %}
        <span class="inline-flex items-center gap-1">
            <span class="badge {{ _self.status_badge_class(notification.fromStatus) }} text-xs">{{ _self.status_label(notification.fromStatus) }}</span>
            <i data-lucide="arrow-right" class="w-3 h-3 text-slate-400 flex-shrink-0"></i>
            <span class="badge {{ _self.status_badge_class(notification.toStatus) }} text-xs">{{ _self.status_label(notification.toStatus) }}</span>
        </span>
    {% endif %}
{% endmacro %}
