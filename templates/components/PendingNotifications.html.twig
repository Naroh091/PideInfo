<div {{ attributes.defaults({class: 'pending-notifications', 'data-action': 'documents:processed@window->live#$render'}) }}>
    {% set items = this.requestsWithNotifications %}

    {% if items|length > 0 %}
    <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-6 animate-fade-in">
        <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center flex-shrink-0">
                <i data-lucide="bell-ring" class="w-5 h-5 text-amber-600"></i>
            </div>
            <div class="flex-1">
                <h3 class="font-semibold text-amber-800 text-base">
                    {{ this.totalCount }} notificación{{ this.totalCount != 1 ? 'es' : '' }} pendiente{{ this.totalCount != 1 ? 's' : '' }} en el portal
                </h3>
                <p class="text-sm text-amber-700 mt-1">
                    El agente ha detectado notificaciones sin aceptar en el Portal de Transparencia.
                </p>

                <div class="mt-4 space-y-3">
                    {% for item in items %}
                        <a href="{{ path('app_solicitudes_show', {id: item.request.id}) }}"
                           class="block p-3 bg-white/70 rounded-lg border border-amber-100 hover:border-amber-300 transition-colors group">
                            <div class="flex items-center justify-between gap-3">
                                <div class="min-w-0">
                                    <p class="font-medium text-slate-800 group-hover:text-primary-600 transition-colors truncate">
                                        {{ item.request.title }}
                                    </p>
                                    <p class="text-xs text-slate-500 mt-0.5">{{ item.request.publicBody.name }}</p>
                                </div>
                                <span class="badge badge-warning flex-shrink-0">
                                    {{ item.notifications|length }} pendiente{{ item.notifications|length != 1 ? 's' : '' }}
                                </span>
                            </div>
                            <ul class="mt-2 space-y-1">
                                {% for n in item.notifications %}
                                    <li class="flex items-start gap-2 text-xs text-amber-800">
                                        <i data-lucide="{{ n.esComunicacion is defined and n.esComunicacion ? 'message-square' : 'file-text' }}" class="w-3.5 h-3.5 flex-shrink-0 mt-0.5 text-amber-500"></i>
                                        <span>
                                            <strong>{{ n.tipo }}</strong>
                                            {% if n.concepto is defined and n.concepto %} — {{ n.concepto }}{% endif %}
                                            {% if n.fechaEmision is defined %}
                                                <span class="text-amber-600 ml-1">({{ n.fechaEmision|date('d/m/Y') }})</span>
                                            {% endif %}
                                            {% if n.fechaCaducidad is defined and n.fechaCaducidad %}
                                                <span class="text-red-600 ml-1">· caduca {{ n.fechaCaducidad|date('d/m/Y') }}</span>
                                            {% endif %}
                                        </span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </a>
                    {% endfor %}
                </div>

                {% set firstNotification = items[0].notifications[0] %}
                {% if firstNotification.reportedAt is defined %}
                    <p class="text-xs text-amber-500 mt-3">
                        Última actualización: {{ firstNotification.reportedAt|date('d/m/Y H:i') }}
                    </p>
                {% endif %}
            </div>
        </div>
    </div>
    {% endif %}
</div>
