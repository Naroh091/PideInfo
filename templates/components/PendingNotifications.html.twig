<div {{ attributes.defaults({class: 'pending-notifications', 'data-action': 'documents:processed@window->live#$render'}) }}>
    {% set portalItems = this.portalItems %}
    {% set consejoItems = this.consejoItems %}
    {% set dehuItems = this.dehuItems %}

    {% if portalItems|length > 0 %}
    <div class="alert-banner alert-banner-amber mb-6 animate-fade-in">
        <div class="alert-banner-stripe"></div>
        <div class="flex items-start gap-4 p-5">
            <div class="alert-banner-icon bg-amber-100 text-amber-600">
                <i data-lucide="bell-ring" class="w-5 h-5"></i>
            </div>
            <div class="flex-1 min-w-0">
                <h3 class="font-semibold text-slate-800">
                    {{ this.portalCount }} notificación{{ this.portalCount != 1 ? 'es' : '' }} pendiente{{ this.portalCount != 1 ? 's' : '' }} en el Portal de Transparencia
                </h3>
                <p class="text-sm text-slate-500 mt-1">
                    El agente ha detectado notificaciones sin aceptar en el Portal.
                </p>

                <div class="mt-4 space-y-2">
                    {% for item in portalItems %}
                        <a href="{{ path('app_solicitudes_show', {id: item.request.id}) }}"
                           class="block p-3 bg-white rounded-lg border border-slate-200 hover:border-amber-300 transition-colors group">
                            <div class="flex items-center justify-between gap-3">
                                <div class="min-w-0">
                                    <p class="text-sm font-medium text-slate-700 group-hover:text-primary-600 transition-colors truncate">
                                        {{ item.request.title }}
                                    </p>
                                    <p class="text-xs text-slate-400 mt-0.5">{{ item.request.publicBody.name }}</p>
                                </div>
                                <span class="badge badge-warning flex-shrink-0">
                                    {{ item.notifications|length }}
                                </span>
                            </div>
                            <ul class="mt-2 space-y-1">
                                {% for n in item.notifications %}
                                    <li class="flex items-start gap-2 text-xs text-slate-600">
                                        <i data-lucide="{{ n.esComunicacion is defined and n.esComunicacion ? 'message-square' : 'file-text' }}" class="w-3.5 h-3.5 flex-shrink-0 mt-0.5 text-amber-400"></i>
                                        <span>
                                            <strong>{{ n.tipo }}</strong>
                                            {% if n.concepto is defined and n.concepto %} — {{ n.concepto }}{% endif %}
                                            {% if n.fechaEmision is defined %}
                                                <span class="text-slate-400">({{ n.fechaEmision }})</span>
                                            {% endif %}
                                            {% if n.fechaCaducidad is defined and n.fechaCaducidad %}
                                                <span class="text-red-500 font-medium">· caduca {{ n.fechaCaducidad }}</span>
                                            {% endif %}
                                        </span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </a>
                    {% endfor %}
                </div>

                {% set firstNotification = portalItems[0].notifications[0] %}
                {% if firstNotification.reportedAt is defined %}
                    <p class="text-xs text-slate-400 mt-3">
                        Última actualización: {{ firstNotification.reportedAt|date('d/m/Y H:i') }}
                    </p>
                {% endif %}
            </div>
        </div>
    </div>
    {% endif %}

    {% if consejoItems|length > 0 %}
    <div class="alert-banner alert-banner-purple mb-6 animate-fade-in">
        <div class="alert-banner-stripe"></div>
        <div class="flex items-start gap-4 p-5">
            <div class="alert-banner-icon bg-purple-100 text-purple-600">
                <i data-lucide="scale" class="w-5 h-5"></i>
            </div>
            <div class="flex-1 min-w-0">
                <h3 class="font-semibold text-slate-800">
                    {{ this.consejoCount }} notificación{{ this.consejoCount != 1 ? 'es' : '' }} pendiente{{ this.consejoCount != 1 ? 's' : '' }} en el Consejo de Transparencia
                </h3>
                <p class="text-sm text-slate-500 mt-1">
                    El agente ha detectado notificaciones sin aceptar en el CTBG.
                </p>

                <div class="mt-4 space-y-2">
                    {% for item in consejoItems %}
                        <a href="{{ path('app_solicitudes_show', {id: item.request.id}) }}"
                           class="block p-3 bg-white rounded-lg border border-slate-200 hover:border-purple-300 transition-colors group">
                            <div class="flex items-center justify-between gap-3">
                                <div class="min-w-0">
                                    <p class="text-sm font-medium text-slate-700 group-hover:text-primary-600 transition-colors truncate">
                                        {{ item.request.title }}
                                    </p>
                                    <p class="text-xs text-slate-400 mt-0.5">{{ item.request.publicBody.name }}</p>
                                </div>
                                <span class="badge" style="background: #f3e8ff; color: #7c3aed">
                                    {{ item.notifications|length }}
                                </span>
                            </div>
                            <ul class="mt-2 space-y-1">
                                {% for n in item.notifications %}
                                    <li class="flex items-start gap-2 text-xs text-slate-600">
                                        <i data-lucide="{{ n.esComunicacion is defined and n.esComunicacion ? 'message-square' : 'file-text' }}" class="w-3.5 h-3.5 flex-shrink-0 mt-0.5 text-purple-400"></i>
                                        <span>
                                            <strong>{{ n.tipo }}</strong>
                                            {% if n.concepto is defined and n.concepto %} — {{ n.concepto }}{% endif %}
                                            {% if n.fechaEmision is defined %}
                                                <span class="text-slate-400">({{ n.fechaEmision }})</span>
                                            {% endif %}
                                            {% if n.fechaCaducidad is defined and n.fechaCaducidad %}
                                                <span class="text-red-500 font-medium">· caduca {{ n.fechaCaducidad }}</span>
                                            {% endif %}
                                        </span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </a>
                    {% endfor %}
                </div>

                {% set firstConsejoNotif = consejoItems[0].notifications[0] %}
                {% if firstConsejoNotif.reportedAt is defined %}
                    <p class="text-xs text-slate-400 mt-3">
                        Última actualización: {{ firstConsejoNotif.reportedAt|date('d/m/Y H:i') }}
                    </p>
                {% endif %}
            </div>
        </div>
    </div>
    {% endif %}

    {% if dehuItems|length > 0 %}
    <div class="alert-banner alert-banner-teal mb-6 animate-fade-in">
        <div class="alert-banner-stripe"></div>
        <div class="flex items-start gap-4 p-5">
            <div class="alert-banner-icon bg-teal-100 text-teal-600">
                <i data-lucide="mail-open" class="w-5 h-5"></i>
            </div>
            <div class="flex-1 min-w-0">
                <h3 class="font-semibold text-slate-800">
                    {{ this.dehuCount }} posible{{ this.dehuCount != 1 ? 's' : '' }} notificación{{ this.dehuCount != 1 ? 'es' : '' }} de transparencia en DEHú
                </h3>
                <p class="text-sm text-slate-500 mt-1">
                    Notificaciones en DEHú / RedSARA que podrían estar relacionadas con solicitudes de transparencia.
                </p>

                <div class="mt-4 space-y-2">
                    {% for n in dehuItems %}
                        <div class="p-3 bg-white rounded-lg border border-slate-200">
                            <div class="flex items-center justify-between gap-3">
                                <div class="min-w-0">
                                    <p class="text-sm font-medium text-slate-700 truncate">
                                        {{ n.emisor ?? '—' }}
                                    </p>
                                    <p class="text-xs text-slate-400 mt-0.5 font-mono">
                                        {{ (n.notificationId ?? '')|slice(0, 16) }}…
                                    </p>
                                </div>
                                {% if n.fechaEmision is defined and n.fechaEmision %}
                                    <span class="text-xs text-slate-400 flex-shrink-0">{{ n.fechaEmision }}</span>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {% if dehuItems[0].reportedAt is defined %}
                    <p class="text-xs text-slate-400 mt-3">
                        Última actualización: {{ dehuItems[0].reportedAt|date('d/m/Y H:i') }}
                    </p>
                {% endif %}
            </div>
        </div>
    </div>
    {% endif %}
</div>
