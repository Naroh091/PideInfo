<div {{ attributes.defaults({class: 'recent-requests', 'data-action': 'documents:processed@window->live#$render'}) }}>
    {% set requests = this.requests %}

    <section class="dash-section" style="animation: fade-slide-up 0.5s ease-out both; animation-delay: 0.1s"
             data-controller="accordion" data-accordion-key-value="requests">
        <button type="button" class="dash-section-header cursor-pointer w-full" data-action="click->accordion#toggle">
            <h2 class="dash-section-title">
                <i data-lucide="folder" class="w-4 h-4 text-slate-400"></i>
                Solicitudes recientes
            </h2>
            <div class="flex items-center gap-3">
                <a href="{{ path('app_solicitudes_index') }}" class="text-xs text-slate-400 hover:text-primary-600 transition-colors" data-action="click->accordion#stopProp">
                    Ver todas <i data-lucide="arrow-right" class="w-3 h-3 inline"></i>
                </a>
                <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 transition-transform duration-200" data-accordion-target="icon"></i>
            </div>
        </button>

        <div data-accordion-target="body">
        {% if requests|length > 0 %}
            {% set statusColors = {
                sent: '#0ea5e9',
                processing: '#38bdf8',
                granted: '#34d399',
                granted_completed: '#059669',
                denied: '#f87171',
                delayed: '#a78bfa',
                pending: '#94a3b8',
            } %}
            <div class="space-y-1">
                {% for request in requests %}
                    <a href="{{ path('app_solicitudes_show', {id: request.id}) }}"
                       class="dash-item group">
                        <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: {{ statusColors[request.status]|default('#94a3b8') }}"></span>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-slate-700 group-hover:text-primary-600 transition-colors truncate">{{ request.title }}</p>
                            <p class="text-xs text-slate-400 truncate mt-0.5">{{ request.publicBody.name }}</p>
                        </div>
                        <span class="text-xs text-slate-400 flex-shrink-0">{{ request.statusLabel }}</span>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <div class="py-8 text-center">
                <p class="text-sm text-slate-400">Sin solicitudes aún</p>
            </div>
        {% endif %}
        </div>
    </section>
</div>
