<div {{ attributes.defaults({class: 'recent-requests', 'data-action': 'documents:processed@window->live#$render'}) }}>
    {% set requests = this.requests %}

    <section class="dash-section" style="animation: fade-slide-up 0.5s ease-out both; animation-delay: 0.1s"
             x-data="{ expanded: false }">
        <div class="dash-section-header">
            <h2 class="dash-section-title">
                <i data-lucide="folder" class="w-4 h-4 text-slate-400"></i>
                Solicitudes recientes
            </h2>
            <a href="{{ path('app_solicitudes_index') }}" class="text-xs text-slate-400 hover:text-primary-600 transition-colors">
                Ver todas <i data-lucide="arrow-right" class="w-3 h-3 inline"></i>
            </a>
        </div>

        {% if requests|length > 0 %}
            <div class="collapsible-body" :class="{ 'is-expanded': expanded }">
                <div class="space-y-1">
                    {% for request in requests %}
                        <a href="{{ path('app_solicitudes_show', {id: request.id}) }}"
                           class="dash-item group">
                            {# Color y etiqueta efectivos: la fuente única vive en la entidad #}
                            <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: {{ request.effectiveStatusColor }}"></span>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium text-slate-700 group-hover:text-primary-600 transition-colors truncate">{{ request.title }}</p>
                                <p class="text-xs text-slate-400 truncate mt-0.5">{{ request.publicBody.name }}</p>
                            </div>
                            <span class="text-xs text-slate-400 flex-shrink-0">{{ request.effectiveStatusLabel }}</span>
                        </a>
                    {% endfor %}
                </div>
                <div class="collapsible-fade" x-show="!expanded" x-cloak></div>
            </div>

            {% if requests|length > 4 %}
                <button type="button" class="collapsible-toggle" @click="expanded = !expanded">
                    <span x-show="!expanded" x-cloak>Mostrar todas ({{ requests|length }})</span>
                    <span x-show="expanded" x-cloak>Mostrar menos</span>
                    <i data-lucide="chevron-down" class="w-3.5 h-3.5 collapsible-chev" :class="{ 'is-up': expanded }"></i>
                </button>
            {% endif %}
        {% else %}
            <div class="py-8 text-center">
                <p class="text-sm text-slate-400">Sin solicitudes aún</p>
            </div>
        {% endif %}
    </section>
</div>
