<div {{ attributes.defaults({class: 'deadline-alerts', 'data-action': 'documents:processed@window->live#$render'}) }}>
    {% set alerts = this.alerts %}

    <div class="card animate-fade-in">
        <div class="card-header">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center">
                    <i data-lucide="alert-triangle" class="w-5 h-5 text-amber-600"></i>
                </div>
                <div>
                    <h2 class="font-semibold text-slate-800">Plazos proximos a vencer</h2>
                    <p class="text-sm text-slate-500">Solicitudes que requieren atencion</p>
                </div>
            </div>
        </div>
        <div class="card-body">
            {% if alerts|length > 0 %}
                <div class="space-y-3">
                    {% for alert in alerts %}
                        <a href="{{ path('app_solicitudes_show', {id: alert.id}) }}"
                           class="list-item list-item-clickable group">
                            <div class="flex-1 min-w-0">
                                <h3 class="font-medium text-slate-800 truncate group-hover:text-primary-600 transition-colors">
                                    {{ alert.title|u.truncate(45) }}
                                </h3>
                                <p class="text-sm text-slate-500 truncate mt-0.5">{{ alert.publicBody }}</p>
                            </div>
                            <span class="badge {{ alert.type == 'danger' ? 'badge-danger' : (alert.type == 'warning' ? 'badge-warning' : 'badge-info') }} flex-shrink-0">
                                {% if alert.isPassed %}
                                    <i data-lucide="alert-circle" class="w-3 h-3 mr-1"></i>
                                {% endif %}
                                {{ alert.message }}
                            </span>
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state py-8">
                    <div class="empty-state-icon">
                        <i data-lucide="check-circle" class="w-full h-full text-emerald-300"></i>
                    </div>
                    <p class="empty-state-title">Todo en orden</p>
                    <p class="empty-state-description">No hay plazos proximos a vencer</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
