{% set visible = this.isVisible %}
{% set html = this.cachedHtml %}
{% set stale = this.isStale %}
{% set ago = this.cachedAgo %}
{% set resolvedItems = this.resolvedItems %}

{# Iconos por categoría de item (kinds del ActivitySummarizer). #}
{% set kindIcons = {
    'estimacion': 'party-popper',
    'alegaciones': 'alarm-clock',
    'silencio': 'bell-off',
    'inadmision': 'file-x-2',
    'denegacion': 'file-x-2',
    'caducidad': 'hourglass',
    'otro': 'info',
} %}

<div {{ attributes.defaults({
    'data-action': 'notification_created@window->live#$render activity_summary_updated@window->live#$render',
}) }}{% if stale %} data-poll="delay(8000)|$render"{% endif %}>
    {% if visible %}
        {# El estado del dialog «Ver» vive AQUÍ, por encima de la sección
           animada: fade-slide-up (fill both) deja un transform residual y un
           ancestro con transform es containing block de los position:fixed —
           los dialogs deben quedar fuera para cubrir la página entera. #}
        <div x-data="{ verGrupo: null }" @keydown.escape.window="verGrupo = null">
        <section class="activity-summary {{ stale ? 'is-stale' : '' }}"
                 style="animation: fade-slide-up 0.5s ease-out both">
            <div class="activity-summary-hoja">
            <header class="activity-summary-head">
                <div class="activity-summary-eyebrow-wrap">
                    <span class="activity-summary-eyebrow">
                        <i data-lucide="sparkles" class="w-3 h-3"></i>
                        Resumen · últimas 24 h
                    </span>
                    {% if stale %}
                        <span class="activity-summary-pulse" title="Generando resumen actualizado…">
                            <span class="activity-summary-pulse-dot"></span>
                            actualizando
                        </span>
                    {% endif %}
                </div>
                {% if ago %}
                    <span class="activity-summary-meta" title="{{ this.cachedAt|date('d/m/Y H:i') }}">
                        Generado {{ ago }}
                    </span>
                {% endif %}
            </header>

            {# ── El lede: la voz del LLM, en la serif de la hoja ── #}
            {% if html %}
                <div class="panel-lede">
                    {{ html|raw }}
                </div>
            {% else %}
                <div class="activity-summary-loading">
                    <span class="activity-summary-loading-bar"></span>
                    <span class="activity-summary-loading-bar w-3/4"></span>
                    <span class="activity-summary-loading-bar w-2/3"></span>
                </div>
            {% endif %}
            </div>

            {# ── Necesita tu acción: el detalle accionable de los items.
                 Items de UNA solicitud enlazan directo; los agrupados abren
                 un dialog con sus solicitudes. ── #}
            {% if resolvedItems|length > 0 %}
                <div class="bg-white rounded-2xl border border-slate-200 p-5 mt-5">
                    <div class="flex items-center justify-between gap-3 mb-2">
                        <h2 class="flex items-center gap-2 text-[.9375rem] font-semibold text-slate-900">
                            <i data-lucide="list-todo" class="w-4 h-4 text-primary-500"></i>
                            Necesita tu acción
                        </h2>
                        <span class="text-xs font-medium px-2 py-0.5 rounded-full border bg-amber-50 text-amber-700 border-amber-200">
                            {{ resolvedItems|length }} pendiente{{ resolvedItems|length == 1 ? '' : 's' }}
                        </span>
                    </div>
                    {% for entry in resolvedItems %}
                        {% set item = entry.item %}
                        {% set requests = entry.requests %}
                        <div class="flex items-start gap-3 py-3 {{ not loop.first ? 'border-t border-slate-100' : '' }}">
                            <span class="panel-icono panel-icono--{{ item.severity }}">
                                <i data-lucide="{{ kindIcons[item.kind]|default('info') }}"></i>
                            </span>
                            <div class="min-w-0 flex-1">
                                <p class="text-sm font-medium text-slate-900">
                                    {% if requests|length == 1 %}
                                        <a href="{{ path('app_solicitudes_show', {id: requests[0].id}) }}" class="hover:text-primary-700">{{ item.title }}</a>
                                    {% elseif requests|length > 1 %}
                                        <button type="button" class="text-left hover:text-primary-700" @click="verGrupo = {{ loop.index0 }}">{{ item.title }}</button>
                                    {% else %}
                                        {{ item.title }}
                                    {% endif %}
                                </p>
                                {% if item.detail %}
                                    <p class="text-[.78rem] text-slate-500 mt-0.5 truncate">{{ item.detail }}</p>
                                {% endif %}
                            </div>
                            {% if requests|length == 1 %}
                                <a href="{{ path('app_solicitudes_show', {id: requests[0].id}) }}" class="btn btn-outline btn-sm self-center shrink-0">
                                    {{ item.action|default('Ver') }}
                                </a>
                            {% elseif requests|length > 1 %}
                                <button type="button" class="btn btn-outline btn-sm self-center shrink-0" @click="verGrupo = {{ loop.index0 }}">
                                    Ver ({{ requests|length }})
                                </button>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </section>

        {# Dialogs de los grupos, fuera de la sección animada (ver nota arriba).
           Reutilizan la papelería de la paleta ⌘K: cmdk-backdrop/shell/row. #}
        {% set severityTones = {
            exito: 'tone-emerald',
            aviso: 'tone-amber',
            fallo: 'tone-red',
            curso: 'tone-primary',
            neutro: 'tone-slate',
        } %}
        {% for entry in resolvedItems %}
            {% set item = entry.item %}
            {% set requests = entry.requests %}
            {% if requests|length > 1 %}
                <div class="cmdk-backdrop" x-show="verGrupo === {{ loop.index0 }}" x-cloak style="display: none;"
                     @click.self="verGrupo = null">
                    <div class="cmdk-shell" role="dialog" aria-modal="true" aria-label="{{ item.title }}">
                        <div class="cmdk-input-row">
                            <span class="cmdk-row-icon {{ severityTones[item.severity]|default('tone-slate') }}">
                                <i data-lucide="{{ kindIcons[item.kind]|default('info') }}" class="w-3.5 h-3.5"></i>
                            </span>
                            <span class="min-w-0 flex-1 text-sm font-semibold text-slate-900 truncate">{{ item.title }}</span>
                            <button type="button" class="cmdk-esc cursor-pointer" @click="verGrupo = null" aria-label="Cerrar">ESC</button>
                        </div>
                        <div class="cmdk-body">
                            <div class="cmdk-section">
                                <div class="cmdk-section-label">
                                    Solicitudes
                                    <span class="cmdk-count">{{ requests|length }}</span>
                                </div>
                                {% for request in requests %}
                                    <a href="{{ path('app_solicitudes_show', {id: request.id}) }}" class="cmdk-row">
                                        <span class="cmdk-row-icon {{ severityTones[item.severity]|default('tone-slate') }}">
                                            <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
                                        </span>
                                        <span class="cmdk-row-main">
                                            <span class="cmdk-row-title">{{ request.title }}</span>
                                            <span class="cmdk-row-sub">{{ request.publicBody.name }} · {{ request.effectiveStatusLabel }}</span>
                                        </span>
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
        </div>
    {% endif %}
</div>

<style>
    /* El parte del día sobre su hoja: en la columna de tarjetas el lede
       suelto flotaba, así que el resumen (cabecera + lede) vive en una carta
       blanca con la sombra suave de la hoja; «Necesita tu acción» sigue
       siendo su propia tarjeta debajo. */
    .activity-summary { position: relative; }
    .activity-summary-hoja {
        background: #fff;
        border: 1px solid rgb(226 232 240);
        border-radius: 1rem;
        padding: 1.1rem 1.4rem 1.25rem;
        box-shadow: 0 14px 40px -30px rgba(15, 23, 42, .25);
    }

    /* Los dialogs «Ver» reutilizan la papelería de la paleta ⌘K; la paleta
       marca la fila activa por teclado (.is-active), aquí navegamos con
       ratón — hover equivalente, acotado a los dialogs. */
    .cmdk-backdrop .cmdk-row:hover { background: rgb(241 245 249); }

    .activity-summary-head {
        display: flex; align-items: baseline; justify-content: space-between;
        gap: 1rem;
        margin-bottom: .65rem;
    }
    .activity-summary-eyebrow-wrap {
        display: inline-flex; align-items: center; gap: .55rem;
    }
    .activity-summary-eyebrow {
        font-family: 'DM Sans', sans-serif;
        font-size: .85rem;
        font-weight: 600;
        color: rgb(2 132 199);
        display: inline-flex;
        align-items: center;
        gap: .4rem;
    }
    .activity-summary-meta {
        font-family: 'Inter', sans-serif;
        font-size: .65rem;
        color: rgb(100 116 139);
        font-feature-settings: "tnum";
        letter-spacing: .04em;
    }
    .activity-summary-pulse {
        display: inline-flex; align-items: center; gap: .35rem;
        font-family: 'DM Sans', sans-serif;
        font-size: .75rem;
        font-weight: 500;
        color: rgb(180 83 9);
    }
    .activity-summary-pulse-dot {
        width: .4rem; height: .4rem;
        border-radius: 999px;
        background: rgb(245 158 11);
        animation: activitySummaryPulse 1.2s ease-in-out infinite;
    }
    @keyframes activitySummaryPulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%      { opacity: .35; transform: scale(.85); }
    }

    /* "Open in new tab" badge attached to each <b>solicitud</b> mention. */
    .panel-lede .ref-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1rem;
        height: 1rem;
        margin-left: .15rem;
        margin-right: .1rem;
        border-radius: .25rem;
        background: rgb(224 242 254);
        color: rgb(2 132 199);
        font-size: .7rem;
        font-weight: 700;
        line-height: 1;
        text-decoration: none;
        vertical-align: 1px;
        transition: background .12s ease, color .12s ease, transform .12s ease;
    }
    .panel-lede .ref-badge:hover {
        background: rgb(186 230 253);
        color: rgb(7 89 133);
        transform: translateY(-1px);
    }

    /* Fallback footer for references whose label didn't match any <b> in the text. */
    .panel-lede .ref-fallback {
        display: inline-flex;
        flex-wrap: wrap;
        gap: .15rem;
        margin-left: .25rem;
        padding-left: .5rem;
        border-left: 1px solid rgb(186 230 253);
    }

    /* Subtle loading skeleton when there's no cache yet but we know there's activity. */
    .activity-summary-loading {
        display: flex; flex-direction: column; gap: .55rem;
        font-family: 'DM Sans', sans-serif;
    }
    .activity-summary-loading-bar {
        display: block;
        height: .9rem;
        border-radius: 4px;
        background: linear-gradient(90deg, rgb(224 242 254) 0%, rgb(186 230 253) 50%, rgb(224 242 254) 100%);
        background-size: 200% 100%;
        animation: activitySummaryShimmer 1.5s ease-in-out infinite;
    }
    .activity-summary-loading-bar.w-3\/4 { width: 75%; }
    .activity-summary-loading-bar.w-2\/3 { width: 66%; }
    @keyframes activitySummaryShimmer {
        0%   { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }
</style>
