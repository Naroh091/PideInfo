<div {{ attributes.defaults({'data-action': 'documents:processed@window->live#$render'}) }}>
{# Granted pending reception #}
{% if request.status == 'granted' %}
    <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-5 mb-6" data-granted-banner>
        <div class="flex flex-col sm:flex-row items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center flex-shrink-0">
                <i data-lucide="package" class="w-5 h-5 text-emerald-600"></i>
            </div>
            <div class="flex-1">
                <h3 class="font-semibold text-emerald-800 text-lg">Solicitud concedida — pendiente de recepción</h3>
                <p class="text-sm text-emerald-700 mt-1">
                    La administración ha concedido tu solicitud. ¿Has recibido ya la información solicitada?
                </p>
                <div class="flex flex-wrap gap-3 mt-4">
                    <form action="{{ path('app_solicitudes_change_status', {id: request.id}) }}" method="post" class="inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('change-status-' ~ request.id) }}">
                        <input type="hidden" name="statusType" value="status">
                        <input type="hidden" name="newStatus" value="granted">
                        <button type="submit" class="btn btn-secondary">
                            <i data-lucide="clock" class="w-4 h-4 mr-2"></i>
                            Aún no la he recibido
                        </button>
                    </form>
                    <form action="{{ path('app_solicitudes_change_status', {id: request.id}) }}" method="post" class="inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('change-status-' ~ request.id) }}">
                        <input type="hidden" name="statusType" value="status">
                        <input type="hidden" name="newStatus" value="granted_completed">
                        <input type="hidden" name="notes" value="Información recibida correctamente">
                        <button type="submit" class="btn btn-primary bg-emerald-600 hover:bg-emerald-700 border-emerald-600">
                            <i data-lucide="check" class="w-4 h-4 mr-2"></i>
                            Completada — información recibida
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endif %}

{# Redirection notice #}
{% if request.wasRedirected %}
    <div class="alert alert-info mb-6">
        <i data-lucide="arrow-right-circle" class="w-5 h-5 flex-shrink-0"></i>
        <div class="flex-1">
            <p class="font-medium">Solicitud trasladada</p>
            <p class="text-sm mt-1">
                Esta solicitud fue trasladada de <strong>{{ request.originalPublicBody.name }}</strong>
                a <strong>{{ request.publicBody.name }}</strong>
                {% if request.redirectedAt %}el {{ request.redirectedAt|date('d/m/Y') }}{% endif %}
                (art. 19.1 Ley 19/2013).
            </p>
        </div>
    </div>
{% endif %}

{# Third party allegations suspension #}
{% if request.isDeadlineSuspended %}
    <div class="alert alert-warning mb-6">
        <i data-lucide="pause-circle" class="w-5 h-5 flex-shrink-0"></i>
        <div class="flex-1">
            <p class="font-medium">Plazo suspendido</p>
            <p class="text-sm mt-1">
                El plazo está suspendido por afectación a derechos de terceros.
                {% if request.thirdPartyAllegationsDeadlineAt %}
                    Plazo de alegaciones hasta el {{ request.thirdPartyAllegationsDeadlineAt|date('d/m/Y') }}.
                {% endif %}
                Quedan {{ request.suspendedDaysRemaining }} días hábiles cuando se reanude.
            </p>
        </div>
    </div>
{% endif %}
</div>
