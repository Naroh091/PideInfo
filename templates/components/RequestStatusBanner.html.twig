<div {{ attributes.defaults({'data-action': 'documents:processed@window->live#$render'}) }}>
{# Pending portal notifications (agent reported, auto-accept is off) #}
{% if request.hasPendingPortalNotifications %}
    {% set pending = request.pendingPortalNotifications %}
    <aside class="dossier-notice is-amber mb-6">
        <div class="dossier-notice-body">
            <div class="dossier-notice-icon">
                <i data-lucide="bell-ring" class="w-4 h-4"></i>
            </div>
            <div class="dossier-notice-content">
                <div class="dossier-notice-eyebrow">
                    <span class="dot"></span>
                    Notificaciones por aceptar
                    <span class="meta">· {{ pending|length }} pendiente{{ pending|length != 1 ? 's' : '' }}</span>
                </div>
                <h3 class="dossier-notice-headline">
                    {{ pending|length }} notificación{{ pending|length != 1 ? 'es' : '' }} pendiente{{ pending|length != 1 ? 's' : '' }} de aceptar
                </h3>
                <div class="dossier-notice-prose">
                    <p>Activa <strong>«Aceptar notificaciones electrónicas»</strong> en el agente, o accede manualmente al portal.</p>
                </div>
                <ul class="dossier-notice-list">
                    {% for n in pending %}
                        <li>
                            <i data-lucide="{{ n.esComunicacion ? 'message-square' : 'file-text' }}" class="w-3.5 h-3.5 mt-0.5 flex-shrink-0 text-amber-500"></i>
                            <span class="flex-1 min-w-0">
                                <strong>{{ n.tipo }}</strong>
                                {% if n.concepto %} — {{ n.concepto }}{% endif %}
                                <span class="text-slate-400 text-xs">({{ n.fechaEmision }})</span>
                                {% if n.fechaCaducidad %}
                                    <span class="text-red-600 font-medium text-xs">· caduca {{ n.fechaCaducidad }}</span>
                                {% endif %}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
                {% if pending[0].reportedAt is defined %}
                    <p class="text-xs text-slate-400 mt-3" style="font-family: 'JetBrains Mono', monospace;">
                        Última actualización: {{ pending[0].reportedAt|date('d/m/Y H:i') }}
                    </p>
                {% endif %}
            </div>
        </div>
    </aside>
{% endif %}

{# Pending — request created but not yet sent. Offer to complete the dispatch
   via the agent if the public body is reachable through the Portal de
   Transparencia (only routable channel in v1). #}
{% if request.status == 'pending' %}
    {% set canRouteViaAgent = request.publicBody.transparencyPortalUrl is not empty %}
    <aside class="dossier-notice is-sky mb-6">
        <div class="dossier-notice-body">
            <div class="dossier-notice-icon">
                <i data-lucide="send" class="w-4 h-4"></i>
            </div>
            <div class="dossier-notice-content">
                <div class="dossier-notice-eyebrow">
                    <span class="dot"></span>
                    Pendiente de envío
                    <span class="meta">· la solicitud aún no se ha presentado</span>
                </div>
                <h3 class="dossier-notice-headline">
                    {% if canRouteViaAgent %}
                        Completa el envío para que la administración la reciba.
                    {% else %}
                        Marca esta solicitud como enviada cuando la presentes.
                    {% endif %}
                </h3>
                <div class="dossier-notice-prose">
                    {% if canRouteViaAgent %}
                        <p>
                            <strong>{{ request.publicBody.name }}</strong> acepta solicitudes a través del Portal de Transparencia. PideInfo puede enviarla por ti con el agente local: revisa el borrador, ajusta lo que necesites y dale a "Enviar al organismo".
                        </p>
                    {% else %}
                        <p>
                            Este organismo no soporta envío automático todavía. Cuando lo presentes por tu cuenta, edita la solicitud para actualizar el estado a "Enviada" e introduce el número de expediente si lo tienes.
                        </p>
                    {% endif %}
                </div>
                {% if canRouteViaAgent %}
                    <div class="dossier-notice-actions" style="margin-top: 1rem; display: flex; gap: .55rem; flex-wrap: wrap;">
                        <a href="{{ path('app_solicitudes_realizar_draft', {id: request.id}) }}"
                           class="btn btn-primary btn-sm">
                            <i data-lucide="send" class="w-3.5 h-3.5 mr-1.5"></i>
                            Completar y enviar
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </aside>
{% endif %}

{# Granted pending reception #}
{% if request.status == 'granted' %}
    <aside class="dossier-notice is-emerald mb-6" data-granted-banner>
        <div class="dossier-notice-body">
            <div class="dossier-notice-icon">
                <i data-lucide="package" class="w-4 h-4"></i>
            </div>
            <div class="dossier-notice-content">
                <div class="dossier-notice-eyebrow">
                    <span class="dot"></span>
                    Resolución favorable
                    <span class="meta">· pendiente de recepción</span>
                </div>
                <h3 class="dossier-notice-headline">Solicitud concedida</h3>
                <div class="dossier-notice-prose">
                    <p>La administración ha concedido tu solicitud y está pendiente de que recibas la información.</p>
                </div>
            </div>
        </div>
    </aside>
{% endif %}

{# Redirection notice — only when the most recent timeline event is the redirection itself #}
{% set lastHistory = request.statusHistory|first %}
{% set redirectionIsLatest = lastHistory and 'trasladada' in (lastHistory.notes|default('')|lower) %}
{% if request.wasRedirected and redirectionIsLatest %}
    <aside class="dossier-notice is-sky mb-6">
        <div class="dossier-notice-body">
            <div class="dossier-notice-icon">
                <i data-lucide="arrow-right-circle" class="w-4 h-4"></i>
            </div>
            <div class="dossier-notice-content">
                <div class="dossier-notice-eyebrow">
                    <span class="dot"></span>
                    Traslado de competencia
                    <span class="meta">· art. 19.1 Ley 19/2013</span>
                </div>
                <div class="dossier-notice-prose">
                    <p>
                        Solicitud trasladada de <strong>{{ request.originalPublicBody.name }}</strong>
                        a <strong>{{ request.publicBody.name }}</strong>{% if request.redirectedAt %} el {{ request.redirectedAt|date('d/m/Y') }}{% endif %}.
                    </p>
                </div>
            </div>
        </div>
    </aside>
{% endif %}

{# Deadline expired — silencio administrativo (skip if a complaint already exists) #}
{% if request.isDeadlinePassed and not request.isDeadlineSuspended and request.complaint is null %}
    {% set council = this.transparencyCouncilName %}
    {% set silencePositive = this.isSilencePositive %}
    {% set lawName = this.applicableLawName %}
    {% set acName = this.autonomousCommunityName %}
    {% set pendingReminder = this.pendingReminder %}
    {% set complaintFormUrl = this.complaintFormUrl %}
    <aside class="dossier-notice {{ silencePositive ? 'is-emerald' : 'is-amber' }} mb-6">
        <div class="dossier-notice-body">
            <div class="dossier-notice-icon">
                <i data-lucide="{{ silencePositive ? 'check-circle-2' : 'clock-alert' }}" class="w-4 h-4"></i>
            </div>
            <div class="dossier-notice-content">
                <div class="dossier-notice-eyebrow">
                    <span class="dot"></span>
                    {% if silencePositive %}
                        Silencio positivo
                        <span class="meta">· acceso automático</span>
                    {% else %}
                        Plazo vencido
                        <span class="meta">· procede reclamación</span>
                    {% endif %}
                </div>
                {% if silencePositive %}
                    <h3 class="dossier-notice-headline">
                        Ha vencido el plazo de respuesta.
                        {% if acName %}En {{ acName }} esto te concede el acceso automáticamente.{% else %}Según la ley aplicable, esto te concede el acceso automáticamente.{% endif %}
                    </h3>
                    <div class="dossier-notice-prose">
                        <p>
                            Ten en cuenta que a veces la solicitud tarda unos días en llegar al órgano competente, por lo que puede ser razonable dar unos días de margen antes de dar por vencido el plazo.
                        </p>
                        <p>
                            La recomendación es ponerte en contacto con la administración mediante <strong>instancia general</strong> recordando que, de acuerdo con la <em>{{ lawName }}</em>, el silencio administrativo en este caso es <strong>positivo</strong>, y solicitar que te informen del modo de acceder a la información. Si no hay respuesta, puedes reclamar ante {{ council }}.
                        </p>
                    </div>
                {% else %}
                    <h3 class="dossier-notice-headline">
                        Ha vencido el plazo de respuesta. Ahora puedes reclamar a {{ council }}.
                    </h3>
                    <div class="dossier-notice-prose">
                        <p>
                            Ten en cuenta que a veces la solicitud tarda unos días en llegar al órgano que debe resolver, así que no es mala idea dar unos días de margen antes de presentar la reclamación.
                        </p>
                    </div>
                {% endif %}

                {% if pendingReminder %}
                    <span class="dossier-notice-meta-pill">
                        <i data-lucide="bell" class="w-3.5 h-3.5"></i>
                        Recordatorio programado para el <strong>{{ pendingReminder.remindAt|date('d/m/Y') }}</strong>
                    </span>
                {% endif %}
            </div>
        </div>
        {% set draftDocument = this.complaintDraftDocument %}
        <div class="dossier-notice-footer">
            <a href="{{ path('app_complaint_start', {id: request.id}) }}" class="btn btn-accent btn-sm">
                <i data-lucide="{{ draftDocument ? 'file-edit' : 'gavel' }}" class="w-4 h-4 mr-1.5"></i>
                {% if draftDocument %}
                    Continuar reclamación a {{ council|u.truncate(40, '…') }}
                {% else %}
                    Reclamar a {{ council|u.truncate(40, '…') }}
                {% endif %}
            </a>
        </div>
    </aside>
{% endif %}

{# Concesión parcial — la administración facilitó parte de lo solicitado.
   Invita a reclamar la parte no facilitada (skip if a complaint already exists). #}
{% if request.resolutionResult == 'partially_granted' and request.complaint is null %}
    {% set council = this.transparencyCouncilName %}
    <aside class="dossier-notice is-amber mb-6">
        <div class="dossier-notice-body">
            <div class="dossier-notice-icon">
                <i data-lucide="pie-chart" class="w-4 h-4"></i>
            </div>
            <div class="dossier-notice-content">
                <div class="dossier-notice-eyebrow">
                    <span class="dot"></span>
                    Concesión parcial
                    <span class="meta">· puedes reclamar lo no facilitado</span>
                </div>
                <h3 class="dossier-notice-headline">
                    La administración ha facilitado sólo parte de la información. Puedes reclamar a {{ council }} por lo restante.
                </h3>
                <div class="dossier-notice-prose">
                    <p>
                        Si parte de lo que pediste no se ha entregado o se ha entregado de forma incompleta, tienes derecho a presentar una reclamación gratuita ante {{ council }}, sin necesidad de abogado, para que ordene su entrega. Conviene hacerlo dentro del plazo de un mes desde la notificación.
                    </p>
                </div>
            </div>
        </div>
        {% set draftDocument = this.complaintDraftDocument %}
        <div class="dossier-notice-footer">
            <a href="{{ path('app_complaint_start', {id: request.id}) }}" class="btn btn-accent btn-sm">
                <i data-lucide="{{ draftDocument ? 'file-edit' : 'gavel' }}" class="w-4 h-4 mr-1.5"></i>
                {% if draftDocument %}
                    Continuar reclamación a {{ council|u.truncate(40, '…') }}
                {% else %}
                    Reclamar a {{ council|u.truncate(40, '…') }}
                {% endif %}
            </a>
        </div>
    </aside>
{% endif %}

{# Solicitud denegada — invita a reclamar (skip if a complaint already exists) #}
{% if request.status == 'denied' and request.complaint is null %}
    {% set council = this.transparencyCouncilName %}
    <aside class="dossier-notice is-red mb-6">
        <div class="dossier-notice-body">
            <div class="dossier-notice-icon">
                <i data-lucide="x-circle" class="w-4 h-4"></i>
            </div>
            <div class="dossier-notice-content">
                <div class="dossier-notice-eyebrow">
                    <span class="dot"></span>
                    Solicitud denegada
                    <span class="meta">· procede reclamación</span>
                </div>
                <h3 class="dossier-notice-headline">
                    La administración ha denegado tu solicitud. Ahora puedes reclamar a {{ council }}.
                </h3>
                <div class="dossier-notice-prose">
                    <p>
                        Tienes derecho a presentar una reclamación gratuita ante {{ council }}, sin necesidad de abogado, para que revise la denegación. Conviene hacerlo dentro del plazo de un mes desde la notificación.
                    </p>
                </div>
            </div>
        </div>
        {% set draftDocument = this.complaintDraftDocument %}
        <div class="dossier-notice-footer">
            <a href="{{ path('app_complaint_start', {id: request.id}) }}" class="btn btn-danger btn-sm">
                <i data-lucide="{{ draftDocument ? 'file-edit' : 'gavel' }}" class="w-4 h-4 mr-1.5"></i>
                {% if draftDocument %}
                    Continuar reclamación a {{ council|u.truncate(40, '…') }}
                {% else %}
                    Reclamar a {{ council|u.truncate(40, '…') }}
                {% endif %}
            </a>
        </div>
    </aside>
{% endif %}

{# Third party allegations suspension #}
{% if request.isDeadlineSuspended %}
    <aside class="dossier-notice is-amber mb-6">
        <div class="dossier-notice-body">
            <div class="dossier-notice-icon">
                <i data-lucide="pause-circle" class="w-4 h-4"></i>
            </div>
            <div class="dossier-notice-content">
                <div class="dossier-notice-eyebrow">
                    <span class="dot"></span>
                    Plazo suspendido
                    <span class="meta">· trámite de audiencia</span>
                </div>
                <h3 class="dossier-notice-headline">Plazo suspendido por afectación a terceros</h3>
                <div class="dossier-notice-prose">
                    <p>
                        {% if request.thirdPartyAllegationsDeadlineAt %}
                            Alegaciones hasta el <strong>{{ request.thirdPartyAllegationsDeadlineAt|date('d/m/Y') }}</strong>.
                        {% endif %}
                        Quedan <strong>{{ request.suspendedDaysRemaining }} días hábiles</strong> cuando se reanude.
                    </p>
                </div>
            </div>
        </div>
    </aside>
{% endif %}
</div>
