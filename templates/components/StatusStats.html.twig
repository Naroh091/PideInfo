<div {{ attributes.defaults({class: 'status-stats', 'data-action': 'documents:processed@window->live#$render'}) }}>
    {% set stats = this.stats %}

    {% set statItems = [
        { count: stats.draft, label: 'Borrador', color: '#94a3b8' },
        { count: stats.sent, label: 'Enviadas', color: '#7dd3fc' },
        { count: stats.processing, label: 'En trámite', color: '#38bdf8' },
        { count: stats.pending_reception, label: 'Pendientes de recepción', color: '#34d399' },
        { count: stats.finished, label: 'Finalizadas', color: '#10b981' },
        { count: stats.silence, label: 'Silencio', color: '#f59e0b' },
        { count: stats.in_complaint, label: 'En reclamación', color: '#fbbf24' },
        { count: stats.in_court, label: 'En vía judicial', color: '#8b5cf6' },
    ] %}

    {% if stats.total > 0 %}
    <div class="proportion-bar-container" style="animation: fade-slide-up 0.4s ease-out both">
        <div class="proportion-bar">
            {% for item in statItems %}
                {% if item.count > 0 %}
                    <div class="proportion-segment" style="width: {{ (item.count / stats.total * 100) }}%; background: {{ item.color }}"></div>
                {% endif %}
            {% endfor %}
        </div>
        <div class="flex flex-wrap gap-x-4 gap-y-1 mt-2">
            {% for item in statItems %}
                {% if item.count > 0 %}
                <div class="flex items-center gap-1.5 text-xs text-slate-500">
                    <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: {{ item.color }}"></span>
                    <span>{{ item.label }} <strong class="text-slate-700">{{ item.count }}</strong></span>
                </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
    {% endif %}
</div>
