<div {{ attributes.defaults({'data-action': 'documents:processed@window->live#$render'}) }}>
{# Plazos — marginalia: discreet, card-less, hairline-driven.
   Renders inside the parent .dossier-aside in show.html.twig. #}
    <div class="aside-block">
        <div class="aside-heading">
            <span class="aside-heading-name">Plazos</span>
            <span class="aside-heading-rule"></span>
        </div>

        <div class="aside-row">
            <span class="aside-key">Plazo de respuesta</span>
            {% if request.status in ['granted', 'granted_completed', 'denied'] %}
                <span class="aside-value">
                    <span class="meta">{{ request.deadlineAt|date('d/m/Y') }}</span>
                    <span class="aside-tag is-resolved">Resuelta</span>
                </span>
            {% elseif request.isDeadlineSuspended %}
                <span class="aside-value">
                    <span class="aside-tag is-suspended">Suspendido</span>
                </span>
                {% if request.thirdPartyAllegationsDeadlineAt %}
                    <p class="aside-note">
                        Alegaciones hasta el {{ request.thirdPartyAllegationsDeadlineAt|date('d/m/Y') }}.
                        Quedan {{ request.suspendedDaysRemaining }} días hábiles cuando se reanude.
                    </p>
                {% endif %}
            {% else %}
                <span class="aside-value">
                    <span class="{{ request.isDeadlinePassed ? 'text-red-600 font-semibold' : '' }}">
                        {{ request.deadlineAt|date('d/m/Y') }}
                    </span>
                    {% if request.isDeadlinePassed %}
                        <span class="aside-tag is-passed">Vencido</span>
                    {% else %}
                        <span class="meta">· {{ request.daysUntilDeadline }} día{{ request.daysUntilDeadline != 1 ? 's' : '' }}</span>
                    {% endif %}
                </span>
            {% endif %}
        </div>

        {% if request.extensionCount > 0 %}
            <div class="aside-row">
                <span class="aside-key">Prórroga</span>
                <span class="aside-value">
                    <span class="aside-tag is-info">{{ request.extensionCount }} aplicada{{ request.extensionCount != 1 ? 's' : '' }}</span>
                </span>
            </div>
        {% endif %}

        {% if request.complaint and request.complaint.deadlineAt %}
            {% set complaintPassed = date() > request.complaint.deadlineAt %}
            <div class="aside-row">
                <span class="aside-key">Plazo resolución reclamación</span>
                <span class="aside-value">
                    <span class="{{ complaintPassed ? 'text-red-600 font-semibold' : '' }}">
                        {{ request.complaint.deadlineAt|date('d/m/Y') }}
                    </span>
                    {% if complaintPassed %}
                        <span class="aside-tag is-passed">Vencido</span>
                    {% endif %}
                </span>
                {% if request.applicableLaw.complaintOrganism %}
                    <p class="aside-note">
                        {{ request.applicableLaw.complaintOrganism.shortName ?? request.applicableLaw.complaintOrganism.name }} tiene 3 meses para resolver.
                    </p>
                {% endif %}
            </div>
        {% endif %}

        {% if request.complaint and request.complaint.complianceDeadlineAt %}
            <div class="aside-row">
                <span class="aside-key">Plazo de cumplimiento</span>
                <span class="aside-value">{{ request.complaint.complianceDeadlineAt|date('d/m/Y') }}</span>
            </div>
        {% endif %}
    </div>
</div>
