<div {{ attributes.defaults({'data-action': 'documents:processed@window->live#$render'}) }}>
{# Plazos — marginalia: discreet, card-less, hairline-driven.
   Renders inside the parent .dossier-aside in show.html.twig. #}
    <div class="aside-block">
        <div class="aside-heading">
            <span class="aside-heading-name">Plazos</span>
            <span class="aside-heading-rule"></span>
        </div>

        <div class="aside-row">
            <span class="aside-key">Plazo de respuesta</span>
            {% if request.status in ['granted', 'granted_completed', 'denied'] %}
                <span class="aside-value">
                    <span class="meta">{{ request.deadlineAt|date('d/m/Y') }}</span>
                    <span class="aside-tag is-resolved">Resuelta</span>
                </span>
            {% elseif request.isDeadlineSuspended %}
                <span class="aside-value">
                    <span class="aside-tag is-suspended">Suspendido</span>
                </span>
                {% if request.thirdPartyAllegationsDeadlineAt %}
                    <p class="aside-note">
                        Alegaciones hasta el {{ request.thirdPartyAllegationsDeadlineAt|date('d/m/Y') }}.
                        Quedan {{ request.suspendedDaysRemaining }} días hábiles cuando se reanude.
                    </p>
                {% endif %}
            {% else %}
                <span class="aside-value">
                    <span class="{{ request.isDeadlinePassed ? 'text-red-600 font-semibold' : '' }}">
                        {{ request.deadlineAt|date('d/m/Y') }}
                    </span>
                    {% if request.isDeadlinePassed %}
                        <span class="aside-tag is-passed">Vencido</span>
                    {% else %}
                        <span class="meta">· {{ request.daysUntilDeadline }} día{{ request.daysUntilDeadline != 1 ? 's' : '' }}</span>
                    {% endif %}
                </span>
            {% endif %}
        </div>

        {% if request.extensionCount > 0 %}
            <div class="aside-row">
                <span class="aside-key">Prórroga</span>
                <span class="aside-value">
                    <span class="aside-tag is-info">{{ request.extensionCount }} aplicada{{ request.extensionCount != 1 ? 's' : '' }}</span>
                </span>
            </div>
        {% endif %}

        {% if request.complaint and request.complaint.deadlineAt %}
            {% set complaintPassed = date() > request.complaint.deadlineAt %}
            <div class="aside-row">
                <span class="aside-key">Plazo resolución reclamación</span>
                <span class="aside-value">
                    <span class="{{ complaintPassed ? 'text-red-600 font-semibold' : '' }}">
                        {{ request.complaint.deadlineAt|date('d/m/Y') }}
                    </span>
                    {% if complaintPassed %}
                        <span class="aside-tag is-passed">Vencido</span>
                    {% endif %}
                </span>
                {% if request.applicableLaw.complaintOrganism %}
                    <p class="aside-note">
                        {{ request.applicableLaw.complaintOrganism.shortName ?? request.applicableLaw.complaintOrganism.name }} tiene 3 meses para resolver.
                    </p>
                {% endif %}
            </div>
        {% endif %}

        {% if request.complaint and request.complaint.latestHearingProcess %}
            {% set hearing = request.complaint.latestHearingProcess %}
            {% set hearingPassed = not hearing.isActive %}
            <div class="aside-row">
                <span class="aside-key">Plazo de alegaciones</span>
                <span class="aside-value">
                    <span class="{{ hearingPassed ? 'text-red-600 font-semibold' : '' }}">
                        {{ hearing.endDate|date('d/m/Y') }}
                    </span>
                    {% if hearingPassed %}
                        <span class="aside-tag is-passed">Vencido</span>
                    {% else %}
                        <span class="meta">· {{ hearing.daysUntilEnd }} día{{ hearing.daysUntilEnd != 1 ? 's' : '' }}</span>
                    {% endif %}
                </span>
                <p class="aside-note">
                    Trámite de audiencia: {{ hearing.hearingDays }} {{ hearing.hearingDaysTypeLabel }} desde el {{ hearing.startDate|date('d/m/Y') }}.
                </p>
            </div>
        {% endif %}

        {% if request.complaint and request.complaint.complianceDeadlineAt %}
            <div class="aside-row">
                <span class="aside-key">Plazo de cumplimiento</span>
                <span class="aside-value">{{ request.complaint.complianceDeadlineAt|date('d/m/Y') }}</span>
            </div>
        {% endif %}
    </div>

    {# Recordatorios — deadlines propios (con fecha y descripción) y avisos ligeros
       "recuérdamelo". Las acciones de alta/edición/borrado usan las rutas existentes. #}
    {% set customDeadlines = this.customDeadlines %}
    {% set pendingReminders = this.pendingReminders %}
    <div class="aside-block">
        <div class="aside-heading">
            <span class="aside-heading-name">Recordatorios</span>
            <span class="aside-heading-rule"></span>
        </div>

        {% if customDeadlines is empty and pendingReminders is empty %}
            <p class="aside-note" style="margin-top: 0;">No tienes recordatorios para esta solicitud.</p>
        {% endif %}

        {% for deadline in customDeadlines %}
            <div class="aside-row">
                <span class="aside-key">{{ deadline.description }}</span>
                <span class="aside-value">
                    <span class="{{ deadline.daysUntil < 0 ? 'text-red-600 font-semibold' : '' }}">
                        {{ deadline.deadlineAt|date('d/m/Y') }}
                    </span>
                    {% if deadline.daysUntil < 0 %}
                        <span class="aside-tag is-passed">Vencido</span>
                    {% else %}
                        <span class="meta">· {{ deadline.daysUntil }} día{{ deadline.daysUntil != 1 ? 's' : '' }}</span>
                    {% endif %}
                </span>
                <span class="aside-value" style="gap: .9rem; margin-top: .1rem;">
                    <a href="{{ path('app_solicitudes_deadline_edit', {id: request.id, deadlineId: deadline.id}) }}"
                       class="aside-link" style="padding: 0; font-size: .78rem;">
                        <i data-lucide="pencil" class="w-3 h-3"></i>
                        Editar
                    </a>
                    <form action="{{ path('app_solicitudes_deadline_delete', {id: request.id, deadlineId: deadline.id}) }}"
                          method="post"
                          class="aside-action-form"
                          onsubmit="return confirm('¿Eliminar este recordatorio?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-deadline-' ~ deadline.id) }}">
                        <button type="submit" class="aside-link is-danger" style="padding: 0; font-size: .78rem;">
                            <i data-lucide="trash-2" class="w-3 h-3"></i>
                            Eliminar
                        </button>
                    </form>
                </span>
            </div>
        {% endfor %}

        {% for reminder in pendingReminders %}
            <div class="aside-row">
                <span class="aside-key">{{ reminder.note ?: 'Recuérdamelo' }}</span>
                <span class="aside-value">
                    <span class="meta">{{ reminder.remindAt|date('d/m/Y') }}</span>
                </span>
            </div>
        {% endfor %}

        <a href="{{ path('app_solicitudes_deadline_new', {id: request.id}) }}" class="aside-link" style="margin-top: .5rem;">
            <i data-lucide="plus" class="w-3.5 h-3.5"></i>
            Añadir recordatorio
        </a>
    </div>
</div>
