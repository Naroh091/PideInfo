<div {{ attributes.defaults({'data-action': 'documents:processed@window->live#$render'}) }}>
{# Plazos y recordatorios — bloques de la ficha registral (renderizan dentro
   de la hoja lateral de show.html.twig). Cada plazo vivo lleva su barra de
   consumo: cuánta parte del plazo se ha gastado ya. #}
    <div class="ficha-bloque">
        <p class="ficha-rotulo">Plazos</p>

        {# Plazo de respuesta de la administración #}
        <div class="ficha-fila">
            <span class="ficha-clave">Respuesta</span>
            {% if request.status in ['granted', 'granted_completed', 'denied'] %}
                <span class="ficha-valor">
                    {{ request.deadlineAt|date('d/m/Y') }}
                    <span class="ficha-tag is-resolved">Resuelta</span>
                </span>
            {% elseif request.isDeadlineSuspended %}
                <span class="ficha-valor">
                    <span class="ficha-tag is-suspended">Suspendido</span>
                </span>
            {% elseif request.isDeadlinePassed %}
                <span class="ficha-valor rojo">
                    {{ request.deadlineAt|date('d/m/Y') }}
                    <span class="ficha-tag is-passed">Vencido</span>
                </span>
            {% else %}
                <span class="ficha-valor {{ request.daysUntilDeadline <= 7 ? 'ambar' }}">
                    {{ request.deadlineAt|date('d/m/Y') }} · {{ request.daysUntilDeadline }} día{{ request.daysUntilDeadline != 1 ? 's' : '' }}
                </span>
            {% endif %}
        </div>
        {% if request.deadlineAt and request.sentAt
            and not request.isDeadlineSuspended
            and not request.isDeadlinePassed
            and request.status not in ['granted', 'granted_completed', 'denied'] %}
            {% set spanTotal = request.deadlineAt|date('U') - request.sentAt|date('U') %}
            {% if spanTotal > 0 %}
                {% set pct = min(100, max(0, (("now"|date('U') - request.sentAt|date('U')) / spanTotal * 100)|round)) %}
                <div class="ficha-barra"><i class="es-cielo" style="width: {{ pct }}%;"></i></div>
            {% endif %}
        {% endif %}
        {% if request.isDeadlineSuspended and request.thirdPartyAllegationsDeadlineAt %}
            <p class="ficha-nota">
                Alegaciones hasta el {{ request.thirdPartyAllegationsDeadlineAt|date('d/m/Y') }}.
                Quedan {{ request.suspendedDaysRemaining }} días hábiles cuando se reanude.
            </p>
        {% endif %}

        {% if request.extensionCount > 0 %}
            <div class="ficha-fila">
                <span class="ficha-clave">Prórroga</span>
                <span class="ficha-valor es-ui">{{ request.extensionCount }} aplicada{{ request.extensionCount != 1 ? 's' : '' }}</span>
            </div>
        {% endif %}

        {# Plazo de resolución de la reclamación #}
        {% if request.complaint and request.complaint.deadlineAt %}
            {% set complaintPassed = date() > request.complaint.deadlineAt %}
            <div class="ficha-fila">
                <span class="ficha-clave">Resolución reclamación</span>
                <span class="ficha-valor {{ complaintPassed ? 'rojo' }}">
                    {{ request.complaint.deadlineAt|date('d/m/Y') }}
                    {% if complaintPassed %}<span class="ficha-tag is-passed">Vencido</span>{% endif %}
                </span>
            </div>
            {% if not complaintPassed and request.complaint.filedAt %}
                {% set spanTotal = request.complaint.deadlineAt|date('U') - request.complaint.filedAt|date('U') %}
                {% if spanTotal > 0 %}
                    {% set pct = min(100, max(0, (("now"|date('U') - request.complaint.filedAt|date('U')) / spanTotal * 100)|round)) %}
                    <div class="ficha-barra"><i class="es-cielo" style="width: {{ pct }}%;"></i></div>
                {% endif %}
            {% endif %}
            {% if request.applicableLaw.complaintOrganism %}
                <p class="ficha-nota">
                    {{ request.applicableLaw.complaintOrganism.shortName ?? request.applicableLaw.complaintOrganism.name }} tiene 3 meses para resolver.
                </p>
            {% endif %}
        {% endif %}

        {# Plazo de alegaciones (trámite de audiencia) #}
        {% if request.complaint and request.complaint.latestHearingProcess %}
            {% set hearing = request.complaint.latestHearingProcess %}
            {% set hearingPassed = not hearing.isActive %}
            <div class="ficha-fila">
                <span class="ficha-clave">Alegaciones</span>
                <span class="ficha-valor {{ hearingPassed ? 'rojo' : 'ambar' }}">
                    {{ hearing.endDate|date('d/m/Y') }}
                    {% if hearingPassed %}
                        <span class="ficha-tag is-passed">Vencido</span>
                    {% else %}
                        · {{ hearing.daysUntilEnd }} día{{ hearing.daysUntilEnd != 1 ? 's' : '' }}
                    {% endif %}
                </span>
            </div>
            {% if not hearingPassed %}
                {% set spanTotal = hearing.endDate|date('U') - hearing.startDate|date('U') %}
                {% if spanTotal > 0 %}
                    {% set pct = min(100, max(0, (("now"|date('U') - hearing.startDate|date('U')) / spanTotal * 100)|round)) %}
                    <div class="ficha-barra"><i style="width: {{ pct }}%;"></i></div>
                {% endif %}
            {% endif %}
            <p class="ficha-nota">
                Trámite de audiencia: {{ hearing.hearingDays }} {{ hearing.hearingDaysTypeLabel }} desde el {{ hearing.startDate|date('d/m/Y') }}.
            </p>
        {% endif %}

        {% if request.complaint and request.complaint.complianceDeadlineAt %}
            <div class="ficha-fila">
                <span class="ficha-clave">Cumplimiento</span>
                <span class="ficha-valor">{{ request.complaint.complianceDeadlineAt|date('d/m/Y') }}</span>
            </div>
        {% endif %}
    </div>

    {# Recordatorios — deadlines propios (con fecha y descripción) y avisos ligeros
       "recuérdamelo". Las acciones de alta/edición/borrado usan las rutas existentes. #}
    {% set customDeadlines = this.customDeadlines %}
    {% set pendingReminders = this.pendingReminders %}
    <div class="ficha-bloque">
        <p class="ficha-rotulo">Recordatorios</p>

        {% if customDeadlines is empty and pendingReminders is empty %}
            <p class="ficha-nota" style="margin-top: 0;">No tienes recordatorios para esta solicitud.</p>
        {% endif %}

        {% for deadline in customDeadlines %}
            <div class="ficha-fila">
                <span class="ficha-clave">{{ deadline.description }}</span>
                <span class="ficha-valor {{ deadline.daysUntil < 0 ? 'rojo' : (deadline.daysUntil <= 3 ? 'ambar') }}">
                    {{ deadline.deadlineAt|date('d/m/Y') }}
                    {% if deadline.daysUntil < 0 %}
                        <span class="ficha-tag is-passed">Vencido</span>
                    {% else %}
                        · {{ deadline.daysUntil }} día{{ deadline.daysUntil != 1 ? 's' : '' }}
                    {% endif %}
                </span>
            </div>
            <div class="flex items-center gap-4" style="margin: -.1rem 0 .2rem;">
                <a href="{{ path('app_solicitudes_deadline_edit', {id: request.id, deadlineId: deadline.id}) }}"
                   class="ficha-enlace" style="padding: 0; font-size: .74rem;">
                    <i data-lucide="pencil" class="w-3 h-3"></i>
                    Editar
                </a>
                <form action="{{ path('app_solicitudes_deadline_delete', {id: request.id, deadlineId: deadline.id}) }}"
                      method="post"
                      class="ficha-accion-form"
                      onsubmit="return confirm('¿Eliminar este recordatorio?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-deadline-' ~ deadline.id) }}">
                    <button type="submit" class="ficha-enlace peligro" style="padding: 0; font-size: .74rem;">
                        <i data-lucide="trash-2" class="w-3 h-3"></i>
                        Eliminar
                    </button>
                </form>
            </div>
        {% endfor %}

        {% for reminder in pendingReminders %}
            <div class="ficha-fila">
                <span class="ficha-clave">{{ reminder.note ?: 'Recuérdamelo' }}</span>
                <span class="ficha-valor">{{ reminder.remindAt|date('d/m/Y') }}</span>
            </div>
        {% endfor %}

        <a href="{{ path('app_solicitudes_deadline_new', {id: request.id}) }}" class="ficha-enlace" style="margin-top: .35rem;">
            <i data-lucide="plus" class="w-3.5 h-3.5"></i>
            Añadir recordatorio
        </a>
    </div>
</div>
