<div {{ attributes.defaults({'data-action': 'notification_created@window->live#$render documents:processed@window->live#$render'}) }}>
    {% set unread = this.unreadCount %}
    {% set user = this.user %}

    <div class="relative" x-data="{ open: false }">
        <button @click="open = !open"
                class="flex items-center gap-2 px-2 py-1.5 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors cursor-pointer"
                :aria-expanded="open"
                aria-haspopup="true"
                title="{{ unread > 0 ? unread ~ ' notificación' ~ (unread == 1 ? '' : 'es') ~ ' sin leer' : 'Menú de usuario' }}">
            <span class="user-avatar">
                <i data-lucide="user" class="w-4 h-4"></i>
                {% if unread > 0 %}
                    <span class="user-avatar-dot" aria-hidden="true"></span>
                    <span class="sr-only">{{ unread }} sin leer</span>
                {% endif %}
            </span>
            <i data-lucide="chevron-down" class="w-4 h-4"></i>
        </button>

        <div x-show="open"
             @click.away="open = false"
             x-transition:enter="transition ease-out duration-100"
             x-transition:enter-start="transform opacity-0 scale-95"
             x-transition:enter-end="transform opacity-100 scale-100"
             x-transition:leave="transition ease-in duration-75"
             x-transition:leave-start="transform opacity-100 scale-100"
             x-transition:leave-end="transform opacity-0 scale-95"
             class="absolute right-0 mt-2 w-64 bg-white rounded-xl shadow-lg border border-slate-100 py-2 z-50"
             style="display: none;">

            {# User identity #}
            <div class="px-4 py-2 border-b border-slate-100">
                <p class="text-sm font-medium text-slate-900 truncate">{{ user.fullName }}</p>
                <p class="text-xs text-slate-500 truncate">{{ user.email }}</p>
            </div>

            {# Notifications entry — was the standalone bell #}
            <a href="{{ path('app_notificaciones_index') }}"
               class="user-menu-item">
                <i data-lucide="bell" class="w-4 h-4"></i>
                <span class="flex-1">Notificaciones</span>
                {% if unread > 0 %}
                    <span class="user-menu-badge">{{ unread > 99 ? '99+' : unread }}</span>
                {% endif %}
            </a>

            <div class="border-t border-slate-100 my-1"></div>

            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin') }}" class="user-menu-item">
                    <i data-lucide="settings" class="w-4 h-4"></i>
                    <span>Administración</span>
                </a>
            {% endif %}

            <button type="button"
                    @click="open = false; $dispatch('open-agent-token-modal')"
                    class="user-menu-item w-full text-left">
                <i data-lucide="link" class="w-4 h-4"></i>
                <span>Conectar agente</span>
            </button>
            <button type="button"
                    @click="open = false; $dispatch('open-mcp-info-modal')"
                    class="user-menu-item w-full text-left">
                <i data-lucide="cpu" class="w-4 h-4"></i>
                <span class="flex-1">Servidor MCP</span>
                <span class="user-menu-tag">IA</span>
            </button>
            <a href="{{ path('app_connected_apps') }}" class="user-menu-item">
                <i data-lucide="plug" class="w-4 h-4"></i>
                <span>Aplicaciones conectadas</span>
            </a>

            <div class="border-t border-slate-100 my-1"></div>

            <a href="{{ path('app_logout') }}" class="user-menu-item user-menu-item-danger">
                <i data-lucide="log-out" class="w-4 h-4"></i>
                <span>Cerrar sesión</span>
            </a>
        </div>
    </div>
</div>

<style>
    .user-avatar {
        position: relative;
        display: inline-flex;
        align-items: center; justify-content: center;
        width: 2rem; height: 2rem;
        border-radius: 999px;
        background: linear-gradient(135deg, var(--color-primary-400, #38bdf8), var(--color-primary-600, #0284c7));
        color: white;
    }
    .user-avatar-dot {
        position: absolute;
        top: -1px; right: -1px;
        width: .65rem; height: .65rem;
        border-radius: 999px;
        background: rgb(239 68 68);
        border: 2px solid white;
        box-shadow: 0 0 0 0 rgba(239, 68, 68, .55);
        animation: dotPulse 2s ease-in-out infinite;
    }
    @keyframes dotPulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, .55); }
        50%      { box-shadow: 0 0 0 4px rgba(239, 68, 68, 0); }
    }

    .user-menu-item {
        display: flex; align-items: center; gap: .55rem;
        padding: .5rem 1rem;
        font-family: 'DM Sans', sans-serif;
        font-size: .85rem;
        color: rgb(51 65 85);
        text-decoration: none;
        cursor: pointer;
        transition: background .12s ease, color .12s ease;
    }
    .user-menu-item:hover {
        background: rgb(248 250 252);
        color: rgb(15 23 42);
    }
    .user-menu-item-danger { color: rgb(220 38 38); }
    .user-menu-item-danger:hover {
        background: rgb(254 242 242);
        color: rgb(185 28 28);
    }
    .user-menu-badge {
        font-family: 'Inter', sans-serif;
        font-size: .65rem;
        font-weight: 700;
        color: white;
        background: rgb(239 68 68);
        border-radius: 999px;
        padding: .05rem .4rem;
        min-width: 1.25rem;
        text-align: center;
        font-feature-settings: "tnum";
        letter-spacing: 0;
    }
    .user-menu-tag {
        font-family: 'Inter', sans-serif;
        font-size: .58rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: rgb(2 132 199);
        background: rgb(224 242 254);
        padding: .05rem .4rem;
        border-radius: 999px;
    }
</style>
