{% extends 'layouts/app.html.twig' %}

{% block title %}{{ currentTitle }} - Guías - PideInfo{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* ── Guías layout ── */
        .guia-shell {
            display: flex;
            gap: 2.5rem;
        }
        @media (max-width: 1023px) {
            .guia-shell { flex-direction: column; gap: 1.5rem; }
        }

        /* ── Sidebar TOC: book contents ── */
        .guia-toc {
            width: 17rem;
            flex-shrink: 0;
        }
        @media (max-width: 1023px) {
            .guia-toc { width: 100%; }
        }
        .guia-toc-sticky {
            position: sticky;
            top: 5.5rem;
        }
        .guia-toc-heading {
            display: flex;
            align-items: baseline;
            gap: .65rem;
            margin-bottom: 1rem;
            padding-bottom: .5rem;
            border-bottom: 1px solid rgb(226 232 240);
        }
        .guia-toc-heading-name {
            font-family: 'DM Serif Display', Georgia, serif;
            font-style: italic;
            font-size: 1.1rem;
            font-weight: 400;
            color: rgb(30 41 59);
            letter-spacing: -.005em;
        }
        .guia-toc-heading-rule {
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, rgb(226 232 240), transparent);
            position: relative;
            top: -.4rem;
        }

        .guia-toc-list {
            display: flex;
            flex-direction: column;
            gap: .15rem;
        }
        .guia-toc-item {
            position: relative;
            display: grid;
            grid-template-columns: 1.65rem minmax(0, 1fr);
            gap: .65rem;
            align-items: center;
            padding: .55rem .65rem .55rem .75rem;
            border-radius: 4px;
            text-decoration: none;
            transition: background .12s ease, color .12s ease;
        }
        .guia-toc-item:hover {
            background: rgb(248 250 252);
        }
        .guia-toc-item.is-active {
            background: var(--color-primary-50);
        }
        .guia-toc-item.is-active::before {
            content: "";
            position: absolute;
            left: -.15rem; top: 24%; bottom: 24%;
            width: 2px;
            border-radius: 2px;
            background: var(--color-primary-600);
        }
        .guia-toc-item-num {
            font-family: 'DM Serif Display', Georgia, serif;
            font-style: italic;
            font-size: .9rem;
            color: rgb(148 163 184);
            text-align: center;
        }
        .guia-toc-item.is-active .guia-toc-item-num { color: var(--color-primary-700); }
        .guia-toc-item-title {
            font-family: 'DM Sans', sans-serif;
            font-size: .9rem;
            color: rgb(71 85 105);
            line-height: 1.3;
        }
        .guia-toc-item.is-active .guia-toc-item-title {
            color: var(--color-primary-800);
            font-weight: 500;
        }

        /* Mobile selector */
        .guia-mobile-select {
            display: none;
            margin-bottom: 1rem;
        }
        @media (max-width: 1023px) {
            .guia-mobile-select { display: block; }
            .guia-toc-sticky { display: none; }
        }

        /* ── Main content: editorial page ── */
        .guia-page {
            flex: 1;
            min-width: 0;
            position: relative;
        }
        .guia-page-eyebrow {
            font-family: 'DM Sans', sans-serif;
            font-size: .82rem;
            font-weight: 600;
            color: var(--color-primary-700);
            margin-bottom: .35rem;
        }
        .guia-page-title {
            font-family: 'DM Serif Display', Georgia, serif;
            font-weight: 400;
            font-size: clamp(1.85rem, 3.5vw, 2.5rem);
            line-height: 1.05;
            letter-spacing: -.015em;
            color: rgb(15 23 42);
            margin-bottom: 1.5rem;
            padding-bottom: 1.25rem;
            border-bottom: 1px solid rgb(226 232 240);
        }

        /* Markdown content typography */
        .guia-content {
            font-family: 'DM Sans', sans-serif;
            font-size: .98rem;
            line-height: 1.7;
            color: rgb(51 65 85);
            max-width: 42rem;
        }
        .guia-content h1,
        .guia-content h2 {
            font-family: 'DM Serif Display', Georgia, serif;
            font-weight: 400;
            color: rgb(15 23 42);
            line-height: 1.2;
            letter-spacing: -.01em;
            margin: 2.25rem 0 .85rem;
        }
        .guia-content h1:first-child,
        .guia-content h2:first-child { margin-top: 0; }
        .guia-content h1 { font-size: 1.65rem; }
        .guia-content h2 {
            font-size: 1.25rem;
            font-style: italic;
            color: rgb(30 41 59);
            padding-bottom: .35rem;
            border-bottom: 1px solid rgb(241 245 249);
        }
        .guia-content h3 {
            font-family: 'DM Sans', sans-serif;
            font-weight: 600;
            font-size: 1rem;
            color: rgb(15 23 42);
            margin: 1.6rem 0 .5rem;
        }
        .guia-content p {
            margin-bottom: 1rem;
        }
        .guia-content a {
            color: var(--color-primary-700);
            text-decoration: none;
            border-bottom: 1px solid var(--color-primary-200);
            transition: border-color .12s ease, color .12s ease;
        }
        .guia-content a:hover {
            color: var(--color-primary-800);
            border-bottom-color: var(--color-primary-500);
        }
        .guia-content strong {
            color: rgb(15 23 42);
            font-weight: 600;
        }
        .guia-content em {
            color: rgb(71 85 105);
            font-style: italic;
        }
        .guia-content ul,
        .guia-content ol {
            margin: 1rem 0 1rem 1.25rem;
            padding-left: .5rem;
        }
        .guia-content ul { list-style: none; padding-left: 0; }
        .guia-content ul li {
            position: relative;
            padding-left: 1.25rem;
            margin-bottom: .45rem;
        }
        .guia-content ul li::before {
            content: "";
            position: absolute;
            left: 0; top: .65rem;
            width: 4px; height: 4px;
            border-radius: 50%;
            background: var(--color-primary-500);
        }
        .guia-content ol li { margin-bottom: .45rem; }
        .guia-content blockquote {
            margin: 1.25rem 0;
            padding: .75rem 1.25rem;
            border-left: 3px solid var(--color-accent-400);
            background: var(--color-accent-50);
            color: rgb(120 53 15);
            font-style: italic;
            border-radius: 0 4px 4px 0;
        }
        .guia-content code {
            font-family: 'JetBrains Mono', 'SF Mono', monospace;
            font-size: .85em;
            padding: .1rem .4rem;
            background: rgb(241 245 249);
            border: 1px solid rgb(226 232 240);
            border-radius: 3px;
            color: rgb(15 23 42);
        }
        .guia-content pre {
            margin: 1rem 0;
            padding: 1rem;
            background: rgb(15 23 42);
            color: rgb(226 232 240);
            border-radius: 6px;
            overflow-x: auto;
            font-family: 'JetBrains Mono', 'SF Mono', monospace;
            font-size: .85rem;
            line-height: 1.55;
        }
        .guia-content pre code {
            padding: 0; background: transparent; border: 0; color: inherit;
        }
        .guia-content hr {
            border: 0;
            height: 1px;
            background: rgb(226 232 240);
            margin: 2rem 0;
        }
        .guia-content table {
            width: 100%;
            margin: 1.25rem 0;
            border-collapse: collapse;
            font-size: .92rem;
        }
        .guia-content th,
        .guia-content td {
            padding: .5rem .75rem;
            border-bottom: 1px solid rgb(226 232 240);
            text-align: left;
        }
        .guia-content th {
            font-weight: 600;
            color: rgb(15 23 42);
            background: rgb(248 250 252);
        }

        /* ── Prev / next nav ── */
        .guia-nav {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            margin-top: 3rem;
            padding-top: 1.5rem;
            border-top: 1px solid rgb(226 232 240);
        }
        .guia-nav-link {
            display: flex;
            flex-direction: column;
            gap: .25rem;
            padding: .85rem 1.25rem;
            background: white;
            border: 1px solid rgb(226 232 240);
            border-radius: 6px;
            text-decoration: none;
            transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
            max-width: 18rem;
        }
        .guia-nav-link:hover {
            border-color: var(--color-primary-300);
            box-shadow: 0 4px 12px -4px rgba(2, 132, 199, .15);
            transform: translateY(-1px);
        }
        .guia-nav-link-eyebrow {
            font-family: 'DM Sans', sans-serif;
            font-size: .72rem;
            color: rgb(148 163 184);
            display: inline-flex;
            align-items: center;
            gap: .35rem;
        }
        .guia-nav-link-title {
            font-family: 'DM Serif Display', Georgia, serif;
            font-style: italic;
            font-size: 1.05rem;
            color: rgb(15 23 42);
            line-height: 1.2;
        }
        .guia-nav-link.is-prev { text-align: left; }
        .guia-nav-link.is-next { text-align: right; }
        .guia-nav-link.is-next .guia-nav-link-eyebrow { justify-content: flex-end; }
    </style>
{% endblock %}

{% block content %}
{# Breadcrumb #}
<nav class="flex items-center gap-2 text-xs text-slate-500 mb-3" style="font-family:'Inter',sans-serif;letter-spacing:.04em;">
    <a href="{{ path('app_guias_index') }}" class="hover:text-slate-800 transition-colors">GUÍAS</a>
    <span class="text-slate-300">/</span>
    <span class="text-slate-800 font-medium truncate max-w-[24rem]">{{ currentTitle }}</span>
</nav>

{# Mobile guide selector #}
<div class="guia-mobile-select">
    <select onchange="window.location.href=this.value" class="input w-full">
        {% for slug, title in guides %}
            <option value="{{ path('app_guias_show', {slug: slug}) }}" {{ currentSlug == slug ? 'selected' : '' }}>
                {{ title }}
            </option>
        {% endfor %}
    </select>
</div>

{% set romans = ['', 'I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'] %}
{% set slugs = guides|keys %}
{% set currentIndex = null %}
{% for i, s in slugs %}
    {% if s == currentSlug %}
        {% set currentIndex = i %}
    {% endif %}
{% endfor %}

<div class="guia-shell">
    {# Sidebar TOC — book contents #}
    <aside class="guia-toc">
        <nav class="guia-toc-sticky">
            <div class="guia-toc-heading">
                <span class="guia-toc-heading-name">Contenido</span>
                <span class="guia-toc-heading-rule"></span>
            </div>
            <div class="guia-toc-list">
                {% for slug, title in guides %}
                    {% set i = loop.index %}
                    <a href="{{ path('app_guias_show', {slug: slug}) }}"
                       class="guia-toc-item {{ currentSlug == slug ? 'is-active' : '' }}">
                        <span class="guia-toc-item-num">{{ romans[i] ?? i }}</span>
                        <span class="guia-toc-item-title">{{ title }}</span>
                    </a>
                {% endfor %}
            </div>
        </nav>
    </aside>

    {# Main content — editorial page #}
    <main class="guia-page">
        <p class="guia-page-eyebrow">Capítulo {{ romans[currentIndex + 1] ?? (currentIndex + 1) }}</p>
        <h1 class="guia-page-title">{{ currentTitle }}</h1>

        <article class="guia-content">
            {{ markdown|markdown_to_html }}
        </article>

        {# Prev/Next navigation #}
        <nav class="guia-nav">
            {% if currentIndex > 0 %}
                {% set prevSlug = slugs[currentIndex - 1] %}
                <a href="{{ path('app_guias_show', {slug: prevSlug}) }}" class="guia-nav-link is-prev">
                    <span class="guia-nav-link-eyebrow">
                        <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
                        Anterior
                    </span>
                    <span class="guia-nav-link-title">{{ guides[prevSlug] }}</span>
                </a>
            {% else %}
                <span></span>
            {% endif %}

            {% if currentIndex < slugs|length - 1 %}
                {% set nextSlug = slugs[currentIndex + 1] %}
                <a href="{{ path('app_guias_show', {slug: nextSlug}) }}" class="guia-nav-link is-next">
                    <span class="guia-nav-link-eyebrow">
                        Siguiente
                        <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                    </span>
                    <span class="guia-nav-link-title">{{ guides[nextSlug] }}</span>
                </a>
            {% endif %}
        </nav>
    </main>
</div>
{% endblock %}
