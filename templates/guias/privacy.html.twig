{% extends 'base.html.twig' %}

{% block title %}Política de Privacidad - PideInfo{% endblock %}

{% block body_class %}min-h-screen flex flex-col{% endblock %}

{% block body %}
{# Simple nav for public page #}
<nav class="glass border-b border-slate-200/50 sticky top-0 z-30">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
            <a href="{{ app.user ? path('app_dashboard') : path('app_login') }}" class="flex items-center gap-2 text-primary-600 font-bold text-xl">
                <i data-lucide="search" class="w-6 h-6"></i>
                <span>PideInfo</span>
            </a>
            {% if app.user %}
                <a href="{{ path('app_dashboard') }}" class="flex items-center text-sm text-slate-600 hover:text-primary-600 transition-colors">
                    <i data-lucide="arrow-left" class="w-4 h-4 mr-1"></i>
                    Volver al panel
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" class="flex items-center text-sm text-slate-600 hover:text-primary-600 transition-colors">
                    Iniciar sesión
                </a>
            {% endif %}
        </div>
    </div>
</nav>

<main class="flex-1 py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="card">
            <div class="card-body">
                <article class="guide-content">
                    {{ markdown|markdown_to_html }}
                </article>
            </div>
        </div>
    </div>
</main>

<footer class="border-t border-slate-200/50 bg-white/50 py-6 mt-auto">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="flex items-center gap-2 text-slate-500 text-sm">
                <i data-lucide="search" class="w-4 h-4 text-primary-500"></i>
                <span>PideInfo - Sistema de seguimiento de solicitudes de acceso a información pública</span>
            </div>
            <div class="text-slate-400 text-xs">
                Ley 19/2013, de 9 de diciembre
            </div>
        </div>
    </div>
</footer>

<script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
{% endblock %}
