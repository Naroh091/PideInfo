{% extends 'layouts/public_page.html.twig' %}
{% block title %}Invitación no válida - PideInfo{% endblock %}
{% block content %}
    <header class="page-header">
        <div class="min-w-0">
            <h1 class="page-title">Invitación no válida</h1>
            <p class="page-sub">Este enlace no existe, ya se usó o caducó (las invitaciones duran 7 días).</p>
        </div>
    </header>
    <section class="bg-white rounded-2xl border border-slate-200 p-5 max-w-xl">
        <p class="text-sm text-slate-600 leading-relaxed">
            Pide a quien te invitó que te envíe una nueva invitación desde la página de su equipo.
        </p>
    </section>
{% endblock %}
