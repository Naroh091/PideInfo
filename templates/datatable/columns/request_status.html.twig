{% set statusClass = {
    'sent': 'status-sent',
    'processing': 'status-processing',
    'granted': 'status-granted',
    'granted_completed': 'status-granted-completed',
    'denied': 'status-denied',
    'delayed': 'status-delayed',
    'pending': 'status-pending'
} %}
{% set complaintClass = {
    'reclaimed': 'badge-warning',
    'complaint_granted': 'badge-success',
    'complaint_denied': 'badge-danger',
    'complaint_archived': 'badge-secondary'
} %}
<div class="inline-flex flex-col items-start gap-1">
    {# Show main status, but skip "delayed" if there's an active complaint #}
    {% if not (row.status == 'delayed' and row.complaint) %}
        <span class="badge {{ statusClass[row.status]|default('badge-secondary') }}">
            {{ row.statusLabel }}
        </span>
    {% endif %}
    {% if row.isDeadlineSuspended %}
        <span class="badge badge-warning">Plazo suspendido</span>
    {% endif %}
    {% if row.complaint %}
        <span class="badge {{ complaintClass[row.complaint.status]|default('badge-info') }}">{{ row.complaint.statusLabel }}</span>
    {% endif %}
</div>
