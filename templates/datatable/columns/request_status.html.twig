{# Estado INTERNO derivado (los 8) como badge principal; el detalle de la
   reclamación se mantiene como badge secundario cuando existe. #}
{% set internalStateBadge = {
    'draft': 'badge-secondary',
    'sent': 'status-sent',
    'processing': 'status-processing',
    'pending_reception': 'status-granted',
    'finished': 'status-granted-completed',
    'silence': 'status-delayed',
    'in_complaint': 'badge-warning',
    'in_court': 'badge-info',
} %}
{% set complaintClass = {
    'reclaimed': 'badge-warning',
    'complaint_granted': 'badge-success',
    'complaint_denied': 'badge-danger',
    'complaint_archived': 'badge-secondary'
} %}
<div class="inline-flex flex-col items-start gap-1">
    <span class="badge {{ internalStateBadge[row.internalState]|default('badge-secondary') }}">
        {{ row.internalStateLabel }}
    </span>
    {% if row.isDeadlineSuspended %}
        <span class="badge badge-warning">Plazo suspendido</span>
    {% endif %}
    {% if row.complaint %}
        <span class="badge {{ complaintClass[row.complaint.status]|default('badge-info') }}">{{ row.complaint.statusLabel }}</span>
    {% endif %}
</div>
