<div data-href="{{ path('app_solicitudes_show', {id: row.id}) }}">
    <span class="font-medium text-slate-800">{{ row.title }}</span>
    {% if row.externalId or (row.complaint and row.complaint.externalId) %}
        <div class="flex items-center gap-3 mt-0.5 text-xs">
            {% if row.externalId %}
                <span class="flex items-center gap-1 text-primary-600">
                    <i data-lucide="hash" class="w-3 h-3"></i>
                    {{ row.externalId }}
                </span>
            {% endif %}
            {% if row.complaint and row.complaint.externalId %}
                <span class="flex items-center gap-1 text-amber-600">
                    <i data-lucide="scale" class="w-3 h-3"></i>
                    Recl: {{ row.complaint.externalId }}
                </span>
            {% endif %}
        </div>
    {% endif %}
</div>
