{# Response deadline #}
{% if row.status in ['granted', 'denied'] %}
    <span class="text-slate-400">{{ row.deadlineAt|date('d/m/Y') }}</span>
    <p class="text-xs text-green-600 mt-0.5">Resuelta</p>
{% elseif row.isDeadlineSuspended %}
    <div class="flex items-center gap-1 text-amber-600">
        <i data-lucide="pause-circle" class="w-4 h-4"></i>
        <span class="text-sm font-medium">Suspendido</span>
    </div>
{% elseif row.isDeadlinePassed %}
    <div class="flex items-center gap-1 text-red-600">
        <i data-lucide="alert-circle" class="w-4 h-4"></i>
        <span class="text-sm font-medium">Vencido</span>
    </div>
{% else %}
    <span class="text-slate-700">{{ row.deadlineAt|date('d/m/Y') }}</span>
    <p class="text-xs {{ row.daysUntilDeadline <= 3 ? 'text-red-500' : (row.daysUntilDeadline <= 7 ? 'text-amber-500' : 'text-slate-400') }} mt-0.5">
        {{ row.daysUntilDeadline }} días
    </p>
{% endif %}

{# Complaint deadline (if applicable) #}
{% if row.complaint and row.complaint.deadlineAt %}
    {% set complaintPassed = date() > row.complaint.deadlineAt %}
    <div class="mt-2 pt-2 border-t border-slate-100">
        <p class="text-xs text-slate-500">Reclamación:</p>
        {% if complaintPassed %}
            <div class="flex items-center gap-1 text-red-600">
                <i data-lucide="alert-circle" class="w-3 h-3"></i>
                <span class="text-xs font-medium">Vencido</span>
            </div>
        {% else %}
            <span class="text-xs text-slate-700">{{ row.complaint.deadlineAt|date('d/m/Y') }}</span>
        {% endif %}
    </div>
{% endif %}
