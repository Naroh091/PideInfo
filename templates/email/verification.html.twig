{% extends 'email/base.html.twig' %}

{% block title %}Confirma tu correo electrónico - PideInfo{% endblock %}

{% block body %}
    <p class="greeting">Hola {{ user.firstName }},</p>

    <p class="message">
        Gracias por registrarte en PideInfo. Para completar tu registro y empezar a gestionar tus solicitudes de acceso a información pública, confirma tu correo electrónico.
    </p>

    <div class="button-container">
        <a href="{{ signedUrl }}" class="button" style="display:inline-block;padding:14px 32px;background-color:#0284c7;color:#ffffff;font-size:15px;font-weight:600;text-decoration:none;border-radius:12px;">Confirmar correo electrónico</a>
    </div>

    <div class="divider"></div>

    <p class="text-small text-muted text-center mb-16">
        Este enlace expirará {{ expiresAtMessageKey|trans(expiresAtMessageData) }}.
    </p>

    <p class="text-small text-muted text-center mb-0">
        Si no has creado una cuenta en PideInfo, puedes ignorar este correo de forma segura.
    </p>
{% endblock %}
