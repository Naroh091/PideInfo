{% extends 'base.html.twig' %}

{% block title %}Repositorio de resoluciones de transparencia - PideInfo{% endblock %}

{% block meta %}
    <meta name="description" content="Consulta las resoluciones de los consejos de transparencia españoles. Busca por organismo, resultado, fecha o texto libre.">
{% endblock %}

{% block og %}
    {% if activeOrganism is defined and activeOrganism %}
        <meta property="og:title" content="{{ activeOrganism.name }} - Resoluciones de Transparencia">
        <meta property="og:description" content="Resoluciones emitidas por {{ activeOrganism.shortName ?? activeOrganism.name }}. {{ cardStats.totalCount }} resoluciones, {{ cardStats.successRate }}% tasa de estimación.">
        <meta property="og:image" content="{{ url('og_image_organismo', { slug: activeOrganism.slug }) }}">
        <meta property="og:url" content="{{ url('app_resoluciones_organismo', { slug: activeOrganism.slug }) }}">
    {% else %}
        <meta property="og:title" content="Repositorio unificado de resoluciones de transparencia - PideInfo">
        <meta property="og:description" content="Consulta las resoluciones de los consejos de transparencia españoles. Busca por organismo, resultado, fecha o texto libre.">
        <meta property="og:image" content="{{ url('og_image_resoluciones') }}">
        <meta property="og:url" content="{{ url('app_resoluciones_index') }}">
    {% endif %}
    <meta property="og:site_name" content="PideInfo">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
{% endblock %}

{% block body_class %}min-h-screen flex flex-col{% endblock %}

{% block body %}
{% include '_partials/public_nav.html.twig' with { active_page: 'resoluciones' } %}

{% set hasFilters = filters.search or filters.organism or filters.outcome or filters.keyword or filters.publicBody or filters.dateFrom or filters.dateTo %}

{# Header #}
<header class="repo-header border-b border-slate-200/50 relative">
    <div class="repo-header-bg"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 relative z-10">
        {% if activeOrganism is defined and activeOrganism %}
            <nav class="flex items-center gap-2 text-sm text-slate-500 mb-3 animate-fade-in">
                <a href="{{ path('app_resoluciones_index') }}" class="hover:text-primary-600 transition-colors">Repositorio unificado de resoluciones</a>
                <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
                <span class="text-slate-700 font-medium">{{ activeOrganism.name }}</span>
            </nav>
            <div class="flex items-center justify-between gap-4">
                <div class="flex-1 min-w-0">
                    <div class="organism-title-select">
                        <select data-controller="organism-select" data-organism-select-style-value="title">
                            <option value="{{ path('app_resoluciones_index') }}">Visión global</option>
                            {% for organism in organisms %}
                                <option value="{{ organism.slug ? path('app_resoluciones_organismo', { slug: organism.slug }) : '' }}"
                                        data-shortname="{{ organism.shortName }}"
                                        data-ccaa="{{ organism.autonomousCommunity ? organism.autonomousCommunity.name : '' }}"
                                        {{ activeOrganism.id == organism.id ? 'selected' }}>
                                    {{ organism.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    {% if activeOrganism.autonomousCommunity %}
                        <p class="text-sm text-slate-400 italic mt-1">{{ activeOrganism.autonomousCommunity.name }}</p>
                    {% endif %}
                    <p class="text-sm text-slate-500 mt-1">Resoluciones emitidas por {{ activeOrganism.shortName ?? activeOrganism.name }}</p>
                </div>
                {% if activeOrganism.image %}
                    {% if activeOrganism.url %}
                        <a href="{{ activeOrganism.url }}" target="_blank" rel="noopener">
                    {% endif %}
                    <img src="{{ s3_image_url(activeOrganism.image) }}" alt="{{ activeOrganism.name }}"
                         class="w-60 rounded-xl object-contain bg-white border border-slate-200 p-2 hover:border-primary-300 transition-colors">
                    {% if activeOrganism.url %}
                        </a>
                    {% endif %}
                {% endif %}
            </div>
        {% elseif activePublicBody is defined and activePublicBody %}
            <nav class="flex items-center gap-2 text-sm text-slate-500 mb-3 animate-fade-in">
                <a href="{{ path('app_resoluciones_index') }}" class="hover:text-primary-600 transition-colors">Repositorio</a>
                <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
                <span class="text-slate-700 font-medium">{{ activePublicBody.name }}</span>
            </nav>
            <h1 class="repo-title text-2xl text-slate-800">{{ activePublicBody.name }}</h1>
            <p class="text-sm text-slate-500 mt-1">Resoluciones sobre reclamaciones contra {{ activePublicBody.name }}</p>
        {% else %}
            <div class="animate-fade-in">
                {% if globalStats.dateTo %}
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200 mb-3">
                        <i data-lucide="calendar-check" class="w-3 h-3"></i>
                        Actualizado {{ globalStats.dateTo|date('d/m/Y') }}
                    </span>
                {% endif %}
                <h1 class="repo-title text-4xl sm:text-5xl text-slate-800">Repositorio <span class="repo-title-accent">unificado</span><br>de resoluciones de transparencia</h1>
            </div>
            <p class="text-sm text-slate-500 mt-3 max-w-3xl leading-relaxed">Los consejos de transparencia están obligados a publicar sus resoluciones, pero no siempre es fácil realizar búsquedas en las resoluciones indexadas, reutilizar o navegar por las resoluciones. Este repositorio nace para hacer accesible ese conocimiento y para calcular en tiempo real estadísticas sobre el derecho de acceso.</p>
        {% endif %}

        {% set totalResolutions = outcomeStats|reduce((carry, v) => carry + v, 0) %}
        {% if totalResolutions > 0 %}
        {% set favorable = outcomeStats.favorable|default(0) %}
        {% set partial = outcomeStats.partial|default(0) %}
        {% set mediation = outcomeStats.acuerdo_mediacion|default(0) %}
        {% set unfavorable = outcomeStats.unfavorable|default(0) %}
        {% set inadmissible = outcomeStats.inadmissible|default(0) %}
        {% set archived = outcomeStats.archivo|default(0) %}
        {% set lossOfPurpose = outcomeStats.perdida_objeto|default(0) %}
        {% set withdrawal = outcomeStats.desistimiento|default(0) %}
        {% set referral = outcomeStats.derivacion|default(0) %}

        {# Stats — organism selector only on global view #}
        {% if not (activeOrganism is defined and activeOrganism) %}
        <div class="mt-6 mb-3">
            <div class="w-2/5">
                <select data-controller="organism-select">
                    <option value="{{ path('app_resoluciones_index') }}" selected>Visión global</option>
                    {% for organism in organisms %}
                        <option value="{{ organism.slug ? path('app_resoluciones_organismo', { slug: organism.slug }) : '' }}"
                                data-shortname="{{ organism.shortName }}"
                                data-ccaa="{{ organism.autonomousCommunity ? organism.autonomousCommunity.name : '' }}">
                            {{ organism.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>
        </div>
        {% endif %}
        {# Outcome proportion bar — grouped into 3 categories #}
        {% set positiveCount = favorable + partial + mediation %}
        {% set negativeCount = unfavorable + inadmissible %}
        {% set otherCount = archived + lossOfPurpose + withdrawal + referral %}

        {% set groups = [
            { count: positiveCount, label: 'Favorables', detail: [], color: '#34d399' },
            { count: negativeCount, label: 'Desfavorables', detail: [], color: '#f87171' },
            { count: otherCount, label: 'Otras', detail: [], color: '#cbd5e1' },
        ] %}

        <div class="mt-8 proportion-bar-container" style="animation-delay: 0.1s">
            <div class="proportion-bar">
                {% for g in groups %}
                    {% if g.count > 0 %}
                        <div class="proportion-segment" style="width: {{ (g.count / totalResolutions * 100) }}%; background: {{ g.color }}"></div>
                    {% endif %}
                {% endfor %}
            </div>

            {# Legend: 3 groups with detail breakdown inline #}
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-4">
                {# Favorables #}
                {% if positiveCount > 0 %}
                <div class="flex items-start gap-2.5">
                    <span class="w-3 h-3 rounded-full flex-shrink-0 mt-0.5" style="background: #34d399"></span>
                    <div class="text-sm">
                        <div class="font-semibold text-slate-700">Favorables <span class="text-emerald-600">{{ positiveCount }}</span> <span class="text-slate-400 font-normal text-xs">({{ (positiveCount / totalResolutions * 100)|round }}%)</span></div>
                        <div class="text-xs text-slate-400 mt-0.5">
                            {% if favorable > 0 %}Estimadas {{ favorable }}{% endif %}
                            {% if partial > 0 %}{{ favorable > 0 ? ' · ' }}Parciales {{ partial }}{% endif %}
                            {% if mediation > 0 %}{{ (favorable > 0 or partial > 0) ? ' · ' }}Mediación {{ mediation }}{% endif %}
                        </div>
                    </div>
                </div>
                {% endif %}

                {# Desfavorables #}
                {% if negativeCount > 0 %}
                <div class="flex items-start gap-2.5">
                    <span class="w-3 h-3 rounded-full flex-shrink-0 mt-0.5" style="background: #f87171"></span>
                    <div class="text-sm">
                        <div class="font-semibold text-slate-700">Desfavorables <span class="text-red-500">{{ negativeCount }}</span> <span class="text-slate-400 font-normal text-xs">({{ (negativeCount / totalResolutions * 100)|round }}%)</span></div>
                        <div class="text-xs text-slate-400 mt-0.5">
                            {% if unfavorable > 0 %}Desestimadas {{ unfavorable }}{% endif %}
                            {% if inadmissible > 0 %}{{ unfavorable > 0 ? ' · ' }}Inadmitidas {{ inadmissible }}{% endif %}
                        </div>
                    </div>
                </div>
                {% endif %}

                {# Otras #}
                {% if otherCount > 0 %}
                <div class="flex items-start gap-2.5">
                    <span class="w-3 h-3 rounded-full flex-shrink-0 mt-0.5" style="background: #cbd5e1"></span>
                    <div class="text-sm">
                        <div class="font-semibold text-slate-700">Otras <span class="text-slate-500">{{ otherCount }}</span> <span class="text-slate-400 font-normal text-xs">({{ (otherCount / totalResolutions * 100)|round }}%)</span></div>
                        <div class="text-xs text-slate-400 mt-0.5">
                            {% set otherParts = [] %}
                            {% if archived > 0 %}{% set otherParts = otherParts|merge(['Archivadas ' ~ archived]) %}{% endif %}
                            {% if lossOfPurpose > 0 %}{% set otherParts = otherParts|merge(['Pérdida obj. ' ~ lossOfPurpose]) %}{% endif %}
                            {% if withdrawal > 0 %}{% set otherParts = otherParts|merge(['Desistimiento ' ~ withdrawal]) %}{% endif %}
                            {% if referral > 0 %}{% set otherParts = otherParts|merge(['Derivadas ' ~ referral]) %}{% endif %}
                            {{ otherParts|join(' · ') }}
                        </div>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>

        {# Stat cards — fixed per context (global / organism / public body), not affected by search filters #}
        {% set isOrganismView = activeOrganism is defined and activeOrganism %}
        {% set isPublicBodyView = activePublicBody is defined and activePublicBody %}
        {% set isContextual = isOrganismView or isPublicBodyView %}

        <div class="grid grid-cols-2 sm:grid-cols-4 {{ not isContextual ? 'lg:grid-cols-5' }} gap-3 mt-6">
            <div class="stat-tile" style="animation-delay: 0.15s">
                <div class="stat-tile-value">{{ cardStats.totalCount }}</div>
                <div class="stat-tile-label">Resoluciones</div>
            </div>
            <div class="stat-tile stat-tile-accent" style="animation-delay: 0.2s">
                <div class="stat-tile-value">{{ cardStats.successRate }}%</div>
                <div class="stat-tile-label">Tasa de estimación</div>
                <div class="stat-tile-sub">Favorables / (favorables + desfavorables)</div>
            </div>
            {% if not isContextual %}
            <div class="stat-tile" style="animation-delay: 0.25s">
                <div class="stat-tile-value">{{ organisms|length }}</div>
                <div class="stat-tile-label">Consejos</div>
            </div>
            {% endif %}
            <a href="{{ path('app_resoluciones_reclamados') }}" class="stat-tile group" style="animation-delay: 0.3s">
                <div class="flex items-center justify-between">
                    <div class="stat-tile-value">{{ cardStats.distinctPublicBodies }}</div>
                    <i data-lucide="arrow-right" class="w-4 h-4 text-slate-300 group-hover:text-primary-400 transition-colors"></i>
                </div>
                <div class="stat-tile-label">Administraciones reclamadas</div>
            </a>
            {# Temporarily hidden
            {% if cardStats.meanDaysToResolve %}
            <div class="stat-tile stat-tile-warm" style="animation-delay: 0.35s">
                <div class="stat-tile-value">{{ cardStats.meanDaysToResolve }}</div>
                <div class="stat-tile-label">Días de media</div>
                <div class="stat-tile-sub">En resolver la reclamación</div>
            </div>
            {% endif %}
            #}
        </div>

        {% endif %}
    </div>
</header>

{# Main layout: sidebar filters + content #}
<div class="flex-1">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="flex flex-col lg:flex-row gap-6">

            {# Sidebar filters #}
            <aside class="lg:w-64 flex-shrink-0">
                <form method="GET" action="{{ path('app_resoluciones_index') }}" class="lg:sticky lg:top-20">
                    <div class="bg-white rounded-xl border border-slate-200 divide-y divide-slate-100">
                        {# Search #}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2 block">Buscar</label>
                            <div class="relative">
                                <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                                <input type="text" name="search" value="{{ filters.search }}"
                                       placeholder="Asunto, referencia..."
                                       class="input input-icon-left text-sm">
                            </div>
                        </div>

                        {# Organism #}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2 block">Organismo</label>
                            <select name="organism"
                                    data-controller="tom-select"
                                    data-tom-select-placeholder-value="Todos">
                                <option value="">Todos</option>
                                {% for organism in organisms %}
                                    <option value="{{ organism.id }}"
                                            data-ccaa="{{ organism.autonomousCommunity ? organism.autonomousCommunity.name : '' }}"
                                            {{ filters.organism == (organism.id ~ '') ? 'selected' }}>
                                        {{ organism.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        {# Outcome #}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2 block">Resultado</label>
                            <select name="outcome"
                                    data-controller="tom-select"
                                    data-tom-select-placeholder-value="Todos">
                                <option value="">Todos</option>
                                <option value="favorable" {{ filters.outcome == 'favorable' ? 'selected' }}>Estimada</option>
                                <option value="partial" {{ filters.outcome == 'partial' ? 'selected' }}>Estimación parcial</option>
                                <option value="acuerdo_mediacion" {{ filters.outcome == 'acuerdo_mediacion' ? 'selected' }}>Acuerdo de mediación</option>
                                <option value="unfavorable" {{ filters.outcome == 'unfavorable' ? 'selected' }}>Desestimada</option>
                                <option value="inadmissible" {{ filters.outcome == 'inadmissible' ? 'selected' }}>Inadmitida</option>
                                <option value="archivo" {{ filters.outcome == 'archivo' ? 'selected' }}>Archivada</option>
                                <option value="perdida_objeto" {{ filters.outcome == 'perdida_objeto' ? 'selected' }}>Pérdida de objeto</option>
                                <option value="desistimiento" {{ filters.outcome == 'desistimiento' ? 'selected' }}>Desistimiento</option>
                                <option value="derivacion" {{ filters.outcome == 'derivacion' ? 'selected' }}>Derivada</option>
                            </select>
                        </div>

                        {# Keyword #}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2 block">Palabra clave</label>
                            <select name="keyword"
                                    data-controller="tom-select"
                                    data-tom-select-placeholder-value="Todas"
                                    data-tom-select-remote-value="{{ path('app_resoluciones_keywords_api') }}">
                                <option value="">Todas</option>
                                {% if filters.keyword %}
                                    <option value="{{ filters.keyword }}" selected>{{ filters.keyword }}</option>
                                {% endif %}
                            </select>
                        </div>

                        {# Dates #}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2 block">Fecha</label>
                            <div class="space-y-2">
                                <input type="date" name="dateFrom" value="{{ filters.dateFrom }}"
                                       class="input text-sm">
                                <input type="date" name="dateTo" value="{{ filters.dateTo }}"
                                       class="input text-sm">
                            </div>
                        </div>

                        {# Actions #}
                        <div class="p-4 flex flex-col gap-2">
                            <button type="submit" class="btn btn-primary btn-sm w-full">
                                <i data-lucide="search" class="w-3.5 h-3.5 mr-1.5"></i>
                                Buscar
                            </button>
                            {% if hasFilters %}
                                <a href="{{ path('app_resoluciones_index') }}" class="btn btn-ghost btn-sm w-full">
                                    <i data-lucide="x" class="w-3.5 h-3.5 mr-1.5"></i>
                                    Limpiar filtros
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </form>
            </aside>

            {# Results #}
            <main class="flex-1 min-w-0">
                {% if hasFilters %}
                    <div class="flex items-center gap-2 mb-4 text-sm text-slate-500">
                        <i data-lucide="filter" class="w-4 h-4"></i>
                        <span>Filtros activos</span>
                        {% if filters.search %}
                            <span class="badge badge-secondary">&laquo;{{ filters.search }}&raquo;</span>
                        {% endif %}
                        {% if filters.organism %}
                            {% for organism in organisms %}
                                {% if organism.id ~ '' == filters.organism %}
                                    <span class="badge badge-secondary">{{ organism.name }}</span>
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                        {% if filters.outcome %}
                            <span class="badge badge-secondary">{{ filters.outcome }}</span>
                        {% endif %}
                        {% if filters.keyword %}
                            <span class="badge badge-secondary">{{ filters.keyword }}</span>
                        {% endif %}
                        {% if filters.publicBody %}
                            <span class="badge badge-secondary">{{ filters.publicBody }}</span>
                        {% endif %}
                        {% if filters.dateFrom or filters.dateTo %}
                            <span class="badge badge-secondary">{{ filters.dateFrom ?: '...' }} — {{ filters.dateTo ?: '...' }}</span>
                        {% endif %}
                    </div>
                {% endif %}

                {% if resolutions|length > 0 %}
                    <div class="space-y-2.5">
                        {% set outcomeAccent = {
                            favorable: '#34d399',
                            partial: '#fbbf24',
                            acuerdo_mediacion: '#818cf8',
                            unfavorable: '#f87171',
                            inadmissible: '#c084fc',
                            archivo: '#38bdf8',
                            perdida_objeto: '#94a3b8',
                            desistimiento: '#94a3b8',
                            derivacion: '#94a3b8',
                        } %}
                        {% set badgeClass = {
                            favorable: 'badge-success',
                            partial: 'badge-warning',
                            acuerdo_mediacion: 'badge-success',
                            unfavorable: 'badge-danger',
                            inadmissible: 'badge-secondary',
                            archivo: 'badge-info',
                            perdida_objeto: 'badge-secondary',
                            desistimiento: 'badge-secondary',
                            derivacion: 'badge-secondary',
                        } %}
                        {% for resolution in resolutions %}
                            <div class="resolution-card group" style="--accent: {{ outcomeAccent[resolution.outcome]|default('#94a3b8') }}">
                                <div class="p-4 sm:p-5">
                                    <div class="flex items-start justify-between gap-4">
                                        <div class="flex-1 min-w-0">
                                            <div class="flex flex-wrap items-center gap-2.5 mb-1.5">
                                                <span class="badge {{ badgeClass[resolution.outcome]|default('badge-secondary') }}">
                                                    {{ resolution.outcomeLabel }}
                                                </span>
                                                <span class="text-xs text-slate-400 font-mono tracking-tight">{{ resolution.referenceNumber }}</span>
                                                {% if resolution.complaintOrganism and resolution.complaintOrganism.slug %}
                                                    <a href="{{ path('app_resoluciones_organismo', { slug: resolution.complaintOrganism.slug }) }}"
                                                       class="relative z-10 text-xs text-slate-400 hover:text-primary-600 transition-colors">{{ resolution.complaintOrganism.shortName ?? resolution.complaintOrganism.name }}</a>
                                                {% elseif resolution.complaintOrganism %}
                                                    <span class="text-xs text-slate-400">{{ resolution.complaintOrganism.shortName ?? resolution.complaintOrganism.name }}</span>
                                                {% endif %}
                                            </div>

                                            <h3 class="text-lg font-semibold leading-snug mb-1">
                                                <a href="{{ path('app_resoluciones_show', { id: resolution.id }) }}"
                                                   class="text-slate-800 group-hover:text-primary-600 transition-colors after:absolute after:inset-0">
                                                    {{ resolution.subject|default(resolution.referenceNumber) }}
                                                </a>
                                            </h3>

                                            <p class="text-sm text-slate-500 leading-relaxed">
                                                {{ resolution.summary }}
                                            </p>

                                            {% if resolution.keywords is not empty %}
                                                <div class="flex flex-wrap gap-1.5 mt-2.5">
                                                    {% for kw in resolution.keywords|slice(0, 5) %}
                                                        <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-slate-50 text-xs text-slate-500 border border-slate-100">{{ kw }}</span>
                                                    {% endfor %}
                                                    {% if resolution.keywords|length > 5 %}
                                                        <span class="text-xs text-slate-400">+{{ resolution.keywords|length - 5 }}</span>
                                                    {% endif %}
                                                </div>
                                            {% endif %}
                                        </div>

                                        <div class="hidden sm:flex flex-col items-end gap-1 flex-shrink-0 text-right">
                                            <span class="text-sm text-slate-500 tabular-nums">{{ resolution.resolutionDate ? resolution.resolutionDate|date('d/m/Y') : '' }}</span>
                                            <i data-lucide="chevron-right" class="w-4 h-4 text-slate-300 group-hover:text-primary-400 transition-colors mt-1"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    {# Pagination #}
                    {% if totalPages > 1 %}
                        <div class="mt-6 flex items-center justify-between">
                            <p class="text-sm text-slate-500">
                                {{ ((page - 1) * 50) + 1 }}–{{ min(page * 50, total) }} de {{ total }}
                            </p>
                            <nav class="flex items-center gap-1" aria-label="Paginación">
                                {% if page > 3 %}
                                    <a href="{{ path('app_resoluciones_index', filters|merge({ page: 1 })) }}"
                                       class="btn btn-ghost btn-sm" title="Primera página">
                                        <i data-lucide="chevrons-left" class="w-4 h-4"></i>
                                    </a>
                                {% endif %}

                                {% if page > 1 %}
                                    <a href="{{ path('app_resoluciones_index', filters|merge({ page: page - 1 })) }}"
                                       class="btn btn-ghost btn-sm">
                                        <i data-lucide="chevron-left" class="w-4 h-4"></i>
                                    </a>
                                {% endif %}

                                {% for p in max(1, page - 2)..min(totalPages, page + 2) %}
                                    <a href="{{ path('app_resoluciones_index', filters|merge({ page: p })) }}"
                                       class="btn btn-sm {{ p == page ? 'btn-primary' : 'btn-ghost' }}">
                                        {{ p }}
                                    </a>
                                {% endfor %}

                                {% if page < totalPages %}
                                    <a href="{{ path('app_resoluciones_index', filters|merge({ page: page + 1 })) }}"
                                       class="btn btn-ghost btn-sm">
                                        <i data-lucide="chevron-right" class="w-4 h-4"></i>
                                    </a>
                                {% endif %}

                                {% if page < totalPages - 2 %}
                                    <a href="{{ path('app_resoluciones_index', filters|merge({ page: totalPages })) }}"
                                       class="btn btn-ghost btn-sm" title="Última página">
                                        <i data-lucide="chevrons-right" class="w-4 h-4"></i>
                                    </a>
                                {% endif %}
                            </nav>
                        </div>
                    {% endif %}

                {% else %}
                    <div class="empty-state py-16">
                        <i data-lucide="file-search" class="empty-state-icon"></i>
                        <h3 class="empty-state-title">No se encontraron resoluciones</h3>
                        <p class="empty-state-description">Prueba a cambiar los filtros de búsqueda</p>
                        {% if hasFilters %}
                            <a href="{{ path('app_resoluciones_index') }}" class="btn btn-secondary mt-4">
                                <i data-lucide="x" class="w-4 h-4 mr-2"></i>
                                Limpiar filtros
                            </a>
                        {% endif %}
                    </div>
                {% endif %}
            </main>

        </div>
    </div>
</div>

{% include '_partials/public_footer.html.twig' %}

{# JSON-LD Structured Data #}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "DataCatalog",
    "name": "Resoluciones de Transparencia",
    "description": "Catálogo de resoluciones de los consejos de transparencia españoles sobre solicitudes de acceso a información pública",
    "url": "{{ url('app_resoluciones_index') }}",
    "provider": {
        "@type": "Organization",
        "name": "PideInfo"
    }{% if resolutions|length > 0 %},
    "dataset": [
        {% for resolution in resolutions %}
        {
            "@type": "Dataset",
            "name": "Resolución {{ resolution.referenceNumber }}",
            "description": "{{ resolution.summary|u.truncate(200, '...')|e('js') }}",
            {% if resolution.resolutionDate %}"datePublished": "{{ resolution.resolutionDate|date('Y-m-d') }}",{% endif %}
            "url": "{{ url('app_resoluciones_show', { id: resolution.id }) }}"
        }{{ not loop.last ? ',' }}
        {% endfor %}
    ]{% endif %}
}
</script>

<script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
{% endblock %}
