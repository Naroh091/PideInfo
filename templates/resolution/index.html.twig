{% extends 'base.html.twig' %}

{% block title %}Repositorio de resoluciones de transparencia - PideInfo{% endblock %}

{% block meta %}
    <meta name="description" content="Consulta las resoluciones de los consejos de transparencia españoles. Busca por organismo, resultado, fecha o texto libre.">
{% endblock %}

{% block body_class %}min-h-screen flex flex-col{% endblock %}

{% block body %}
{% include '_partials/public_nav.html.twig' with { active_page: 'resoluciones' } %}

{% set hasFilters = filters.search or filters.organism or filters.outcome or filters.keyword or filters.publicBody or filters.dateFrom or filters.dateTo %}

{# Header #}
<header class="border-b border-slate-200/50 bg-white/60 backdrop-blur-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {% if activeOrganism is defined and activeOrganism %}
            <nav class="flex items-center gap-2 text-sm text-slate-500 mb-2">
                <a href="{{ path('app_resoluciones_index') }}" class="hover:text-primary-600 transition-colors">Repositorio</a>
                <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
                <span class="text-slate-700 font-medium">{{ activeOrganism.name }}</span>
            </nav>
            <div class="flex items-center justify-between gap-4">
                <div>
                    <h1 class="text-2xl font-bold text-slate-800">{{ activeOrganism.name }}</h1>
                    <p class="text-sm text-slate-500 mt-1">Resoluciones emitidas por {{ activeOrganism.shortName ?? activeOrganism.name }}</p>
                </div>
                {% if activeOrganism.image %}
                    {% if activeOrganism.url %}
                        <a href="{{ activeOrganism.url }}" target="_blank" rel="noopener">
                    {% endif %}
                    <img src="{{ s3_image_url(activeOrganism.image) }}" alt="{{ activeOrganism.name }}"
                         class="w-60 rounded-xl object-contain bg-white border border-slate-200 p-2 hover:border-primary-300 transition-colors">
                    {% if activeOrganism.url %}
                        </a>
                    {% endif %}
                {% endif %}
            </div>
        {% elseif activePublicBody is defined and activePublicBody %}
            <nav class="flex items-center gap-2 text-sm text-slate-500 mb-2">
                <a href="{{ path('app_resoluciones_index') }}" class="hover:text-primary-600 transition-colors">Repositorio</a>
                <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
                <span class="text-slate-700 font-medium">{{ activePublicBody.name }}</span>
            </nav>
            <h1 class="text-2xl font-bold text-slate-800">{{ activePublicBody.name }}</h1>
            <p class="text-sm text-slate-500 mt-1">Resoluciones sobre reclamaciones contra {{ activePublicBody.name }}</p>
        {% else %}
            <div class="flex items-center gap-3">
                <h1 class="text-3xl font-bold text-slate-800">Repositorio de resoluciones de transparencia</h1>
                {% if globalStats.dateTo %}
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
                        <i data-lucide="calendar-check" class="w-3 h-3"></i>
                        Actualizado {{ globalStats.dateTo|date('d/m/Y') }}
                    </span>
                {% endif %}
            </div>
            <p class="text-sm text-slate-500 mt-2 max-w-3xl">Los consejos de transparencia están obligados a publicar sus resoluciones, pero no siempre es fácil realizar búsquedas en las resoluciones indexadas, reutilizar o navegar por las resoluciones. Este repositorio nace para hacer accesible ese conocimiento y para calcular en tiempo real estadísticas sobre el derecho de acceso.</p>
        {% endif %}

        {% set totalResolutions = outcomeStats|reduce((carry, v) => carry + v, 0) %}
        {% if totalResolutions > 0 %}
        {% set favorable = outcomeStats.favorable|default(0) %}
        {% set partial = outcomeStats.partial|default(0) %}
        {% set mediation = outcomeStats.acuerdo_mediacion|default(0) %}
        {% set unfavorable = outcomeStats.unfavorable|default(0) %}
        {% set inadmissible = outcomeStats.inadmissible|default(0) %}
        {% set archived = outcomeStats.archivo|default(0) %}
        {% set lossOfPurpose = outcomeStats.perdida_objeto|default(0) %}
        {% set withdrawal = outcomeStats.desistimiento|default(0) %}
        {% set referral = outcomeStats.derivacion|default(0) %}

        {# Stats #}
        <h2 class="mt-6 text-sm font-semibold text-slate-500 uppercase tracking-wider mb-3">Estadísticas totales</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-5 gap-3">
            {# Row 1: global metrics #}
            <div class="bg-white rounded-xl border border-slate-200 p-4">
                <div class="text-3xl font-extrabold text-slate-800">{{ total }}</div>
                <div class="text-xs font-medium text-slate-400 uppercase tracking-wider mt-1">Resoluciones</div>
            </div>
            <div class="bg-white rounded-xl border border-slate-200 p-4">
                <div class="text-3xl font-extrabold text-primary-600">{{ globalStats.successRate }}%</div>
                <div class="text-xs font-medium text-slate-400 uppercase tracking-wider mt-1">Tasa de estimación</div>
                <div class="text-xs text-slate-400 mt-0.5">Estimadas + parciales + mediación</div>
            </div>
            <div class="bg-white rounded-xl border border-slate-200 p-4">
                <div class="text-3xl font-extrabold text-slate-800">{{ organisms|length }}</div>
                <div class="text-xs font-medium text-slate-400 uppercase tracking-wider mt-1">Consejos</div>
            </div>
            <div class="bg-white rounded-xl border border-slate-200 p-4">
                <div class="text-3xl font-extrabold text-slate-800">{{ globalStats.distinctPublicBodies }}</div>
                <div class="text-xs font-medium text-slate-400 uppercase tracking-wider mt-1">Organismos reclamados</div>
            </div>
            {% if globalStats.meanDaysToResolve %}
            <div class="bg-white rounded-xl border border-slate-200 p-4">
                <div class="text-3xl font-extrabold text-amber-600">{{ globalStats.meanDaysToResolve }}</div>
                <div class="text-xs font-medium text-slate-400 uppercase tracking-wider mt-1">Días de media</div>
                <div class="text-xs text-slate-400 mt-0.5">En resolver la reclamación</div>
            </div>
            {% endif %}
        </div>

        {# Outcome breakdown #}
        {% set outcomes = [
            { count: favorable, label: 'Estimadas', color: 'emerald', border: 'emerald-200', bg: 'emerald-100', text: 'emerald-600' },
            { count: partial, label: 'Parciales', color: 'amber', border: 'amber-200', bg: 'amber-100', text: 'amber-600' },
            { count: mediation, label: 'Mediación', color: 'teal', border: 'teal-200', bg: 'teal-100', text: 'teal-600' },
            { count: unfavorable, label: 'Desestimadas', color: 'red', border: 'red-200', bg: 'red-100', text: 'red-500' },
            { count: inadmissible, label: 'Inadmitidas', color: 'purple', border: 'purple-200', bg: 'purple-100', text: 'purple-500' },
            { count: archived, label: 'Archivadas', color: 'slate', border: 'slate-200', bg: 'slate-100', text: 'slate-500' },
            { count: lossOfPurpose, label: 'Pérdida de objeto', color: 'slate', border: 'slate-200', bg: 'slate-100', text: 'slate-400' },
            { count: withdrawal, label: 'Desistimiento', color: 'slate', border: 'slate-200', bg: 'slate-100', text: 'slate-400' },
            { count: referral, label: 'Derivadas', color: 'slate', border: 'slate-200', bg: 'slate-100', text: 'slate-400' },
        ] %}
        <div class="mt-3 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
            {% for o in outcomes %}
                {% if o.count > 0 %}
                <div class="bg-white rounded-xl border border-{{ o.border }} p-3 flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-{{ o.bg }} flex items-center justify-center">
                        <span class="text-lg font-extrabold text-{{ o.text }}">{{ o.count }}</span>
                    </div>
                    <div>
                        <div class="text-xs font-medium text-{{ o.text }} uppercase tracking-wider">{{ o.label }}</div>
                        <div class="text-xs text-slate-400">{{ (o.count / total * 100)|round }}%</div>
                    </div>
                </div>
                {% endif %}
            {% endfor %}
        </div>

        {# Organism navigator #}
        <div class="mt-4 bg-white rounded-xl border border-slate-200 p-4 flex flex-col sm:flex-row sm:items-center gap-3">
            <div class="flex items-center gap-2 text-sm text-slate-600 flex-shrink-0">
                <i data-lucide="building-2" class="w-4 h-4 text-slate-400"></i>
                <span class="font-medium">Ver estadísticas por consejo de transparencia</span>
            </div>
            <div class="flex-1 sm:max-w-md">
                <select data-controller="organism-select">
                    <option value=""></option>
                    {% for organism in organisms %}
                        <option value="{{ organism.slug ? path('app_resoluciones_organismo', { slug: organism.slug }) : '' }}"
                                data-shortname="{{ organism.shortName }}">
                            {{ organism.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>
        </div>
        {% endif %}
    </div>
</header>

{# Main layout: sidebar filters + content #}
<div class="flex-1">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="flex flex-col lg:flex-row gap-6">

            {# Sidebar filters #}
            <aside class="lg:w-64 flex-shrink-0">
                <form method="GET" action="{{ path('app_resoluciones_index') }}" class="lg:sticky lg:top-20">
                    <div class="bg-white rounded-xl border border-slate-200 divide-y divide-slate-100">
                        {# Search #}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2 block">Buscar</label>
                            <div class="relative">
                                <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                                <input type="text" name="search" value="{{ filters.search }}"
                                       placeholder="Asunto, referencia..."
                                       class="input input-icon-left text-sm">
                            </div>
                        </div>

                        {# Organism #}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2 block">Organismo</label>
                            <select name="organism"
                                    data-controller="tom-select"
                                    data-tom-select-placeholder-value="Todos">
                                <option value="">Todos</option>
                                {% for organism in organisms %}
                                    <option value="{{ organism.id }}" {{ filters.organism == (organism.id ~ '') ? 'selected' }}>
                                        {{ organism.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        {# Outcome #}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2 block">Resultado</label>
                            <select name="outcome"
                                    data-controller="tom-select"
                                    data-tom-select-placeholder-value="Todos">
                                <option value="">Todos</option>
                                <option value="favorable" {{ filters.outcome == 'favorable' ? 'selected' }}>Estimada</option>
                                <option value="partial" {{ filters.outcome == 'partial' ? 'selected' }}>Parcial</option>
                                <option value="acuerdo_mediacion" {{ filters.outcome == 'acuerdo_mediacion' ? 'selected' }}>Acuerdo de mediación</option>
                                <option value="unfavorable" {{ filters.outcome == 'unfavorable' ? 'selected' }}>Desestimada</option>
                                <option value="inadmissible" {{ filters.outcome == 'inadmissible' ? 'selected' }}>Inadmitida</option>
                                <option value="archivo" {{ filters.outcome == 'archivo' ? 'selected' }}>Archivada</option>
                                <option value="perdida_objeto" {{ filters.outcome == 'perdida_objeto' ? 'selected' }}>Pérdida de objeto</option>
                                <option value="desistimiento" {{ filters.outcome == 'desistimiento' ? 'selected' }}>Desistimiento</option>
                                <option value="derivacion" {{ filters.outcome == 'derivacion' ? 'selected' }}>Derivada</option>
                            </select>
                        </div>

                        {# Keyword #}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2 block">Palabra clave</label>
                            <select name="keyword"
                                    data-controller="tom-select"
                                    data-tom-select-placeholder-value="Todas"
                                    data-tom-select-remote-value="{{ path('app_resoluciones_keywords_api') }}">
                                <option value="">Todas</option>
                                {% if filters.keyword %}
                                    <option value="{{ filters.keyword }}" selected>{{ filters.keyword }}</option>
                                {% endif %}
                            </select>
                        </div>

                        {# Dates #}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2 block">Fecha</label>
                            <div class="space-y-2">
                                <input type="date" name="dateFrom" value="{{ filters.dateFrom }}"
                                       class="input text-sm">
                                <input type="date" name="dateTo" value="{{ filters.dateTo }}"
                                       class="input text-sm">
                            </div>
                        </div>

                        {# Actions #}
                        <div class="p-4 flex flex-col gap-2">
                            <button type="submit" class="btn btn-primary btn-sm w-full">
                                <i data-lucide="search" class="w-3.5 h-3.5 mr-1.5"></i>
                                Buscar
                            </button>
                            {% if hasFilters %}
                                <a href="{{ path('app_resoluciones_index') }}" class="btn btn-ghost btn-sm w-full">
                                    <i data-lucide="x" class="w-3.5 h-3.5 mr-1.5"></i>
                                    Limpiar filtros
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </form>
            </aside>

            {# Results #}
            <main class="flex-1 min-w-0">
                {% if hasFilters %}
                    <div class="flex items-center gap-2 mb-4 text-sm text-slate-500">
                        <i data-lucide="filter" class="w-4 h-4"></i>
                        <span>Filtros activos</span>
                        {% if filters.search %}
                            <span class="badge badge-secondary">&laquo;{{ filters.search }}&raquo;</span>
                        {% endif %}
                        {% if filters.outcome %}
                            <span class="badge badge-secondary">{{ filters.outcome }}</span>
                        {% endif %}
                        {% if filters.keyword %}
                            <span class="badge badge-secondary">{{ filters.keyword }}</span>
                        {% endif %}
                    </div>
                {% endif %}

                {% if resolutions|length > 0 %}
                    <div class="space-y-3">
                        {% for resolution in resolutions %}
                            <div class="relative bg-white rounded-xl border border-slate-200 hover:border-primary-300 hover:shadow-md transition-all duration-150 group">
                                <div class="p-4 sm:p-5">
                                    <div class="flex items-start justify-between gap-4">
                                        <div class="flex-1 min-w-0">
                                            <div class="flex flex-wrap items-center gap-2.5 mb-1.5">
                                                {% set badgeClass = {
                                                    favorable: 'badge-success',
                                                    partial: 'badge-warning',
                                                    acuerdo_mediacion: 'badge-success',
                                                    unfavorable: 'badge-danger',
                                                    inadmissible: 'badge-secondary',
                                                    archivo: 'badge-info',
                                                    perdida_objeto: 'badge-secondary',
                                                    desistimiento: 'badge-secondary',
                                                    derivacion: 'badge-secondary',
                                                } %}
                                                <span class="badge {{ badgeClass[resolution.outcome]|default('badge-secondary') }}">
                                                    {{ resolution.outcomeLabel }}
                                                </span>
                                                <span class="text-xs text-slate-400 font-mono">{{ resolution.referenceNumber }}</span>
                                                {% if resolution.complaintOrganism and resolution.complaintOrganism.slug %}
                                                    <a href="{{ path('app_resoluciones_organismo', { slug: resolution.complaintOrganism.slug }) }}"
                                                       class="relative z-10 text-xs text-slate-400 hover:text-primary-600 transition-colors">{{ resolution.complaintOrganism.shortName ?? resolution.complaintOrganism.name }}</a>
                                                {% elseif resolution.complaintOrganism %}
                                                    <span class="text-xs text-slate-400">{{ resolution.complaintOrganism.shortName ?? resolution.complaintOrganism.name }}</span>
                                                {% endif %}
                                            </div>

                                            <h3 class="font-semibold leading-snug mb-1">
                                                <a href="{{ path('app_resoluciones_show', { id: resolution.id }) }}"
                                                   class="text-slate-800 group-hover:text-primary-600 transition-colors after:absolute after:inset-0">
                                                    {{ resolution.subject|default(resolution.referenceNumber) }}
                                                </a>
                                            </h3>

                                            <p class="text-sm text-slate-500 leading-relaxed">
                                                {{ resolution.summary }}
                                            </p>

                                            {% if resolution.keywords is not empty %}
                                                <div class="flex flex-wrap gap-1.5 mt-2">
                                                    {% for kw in resolution.keywords|slice(0, 5) %}
                                                        <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-slate-100 text-xs text-slate-500">{{ kw }}</span>
                                                    {% endfor %}
                                                    {% if resolution.keywords|length > 5 %}
                                                        <span class="text-xs text-slate-400">+{{ resolution.keywords|length - 5 }}</span>
                                                    {% endif %}
                                                </div>
                                            {% endif %}
                                        </div>

                                        <div class="hidden sm:flex flex-col items-end gap-1 flex-shrink-0 text-right">
                                            <span class="text-sm text-slate-500">{{ resolution.resolutionDate ? resolution.resolutionDate|date('d/m/Y') : '' }}</span>
                                            <i data-lucide="chevron-right" class="w-4 h-4 text-slate-300 group-hover:text-primary-400 transition-colors"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    {# Pagination #}
                    {% if totalPages > 1 %}
                        <div class="mt-6 flex items-center justify-between">
                            <p class="text-sm text-slate-500">
                                {{ ((page - 1) * 12) + 1 }}–{{ min(page * 12, total) }} de {{ total }}
                            </p>
                            <nav class="flex items-center gap-1" aria-label="Paginación">
                                {% if page > 1 %}
                                    <a href="{{ path('app_resoluciones_index', filters|merge({ page: page - 1 })) }}"
                                       class="btn btn-ghost btn-sm">
                                        <i data-lucide="chevron-left" class="w-4 h-4"></i>
                                    </a>
                                {% endif %}

                                {% for p in max(1, page - 2)..min(totalPages, page + 2) %}
                                    <a href="{{ path('app_resoluciones_index', filters|merge({ page: p })) }}"
                                       class="btn btn-sm {{ p == page ? 'btn-primary' : 'btn-ghost' }}">
                                        {{ p }}
                                    </a>
                                {% endfor %}

                                {% if page < totalPages %}
                                    <a href="{{ path('app_resoluciones_index', filters|merge({ page: page + 1 })) }}"
                                       class="btn btn-ghost btn-sm">
                                        <i data-lucide="chevron-right" class="w-4 h-4"></i>
                                    </a>
                                {% endif %}
                            </nav>
                        </div>
                    {% endif %}

                {% else %}
                    <div class="empty-state py-16">
                        <i data-lucide="file-search" class="empty-state-icon"></i>
                        <h3 class="empty-state-title">No se encontraron resoluciones</h3>
                        <p class="empty-state-description">Prueba a cambiar los filtros de búsqueda</p>
                        {% if hasFilters %}
                            <a href="{{ path('app_resoluciones_index') }}" class="btn btn-secondary mt-4">
                                <i data-lucide="x" class="w-4 h-4 mr-2"></i>
                                Limpiar filtros
                            </a>
                        {% endif %}
                    </div>
                {% endif %}
            </main>

        </div>
    </div>
</div>

{% include '_partials/public_footer.html.twig' %}

{# JSON-LD Structured Data #}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "DataCatalog",
    "name": "Resoluciones de Transparencia",
    "description": "Catálogo de resoluciones de los consejos de transparencia españoles sobre solicitudes de acceso a información pública",
    "url": "{{ url('app_resoluciones_index') }}",
    "provider": {
        "@type": "Organization",
        "name": "PideInfo"
    }{% if resolutions|length > 0 %},
    "dataset": [
        {% for resolution in resolutions %}
        {
            "@type": "Dataset",
            "name": "Resolución {{ resolution.referenceNumber }}",
            "description": "{{ resolution.summary|u.truncate(200, '...')|e('js') }}",
            {% if resolution.resolutionDate %}"datePublished": "{{ resolution.resolutionDate|date('Y-m-d') }}",{% endif %}
            "url": "{{ url('app_resoluciones_show', { id: resolution.id }) }}"
        }{{ not loop.last ? ',' }}
        {% endfor %}
    ]{% endif %}
}
</script>

<script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
{% endblock %}
