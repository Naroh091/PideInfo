{% extends 'base.html.twig' %}

{% block title %}Administraciones reclamadas - Resoluciones de Transparencia - PideInfo{% endblock %}

{% block meta %}
    <meta name="description" content="Listado de administraciones públicas reclamadas ante los consejos de transparencia españoles. Consulta las estadísticas de cada organismo.">
{% endblock %}

{% block body_class %}min-h-screen flex flex-col{% endblock %}

{% block body %}
{% include '_partials/public_nav.html.twig' with { active_page: 'resoluciones' } %}

{# ── Ranking item macro ── #}
{% macro ranking_item(pb, position, stat, statLabel, statSuffix) %}
    {% set medals = { 1: '🥇', 2: '🥈', 3: '🥉' } %}
    <a href="{{ pb.slug ? path('app_resoluciones_reclamado', { slug: pb.slug }) : '#' }}"
       class="flex items-center gap-3 py-3 px-3 -mx-3 rounded-lg hover:bg-slate-50 transition-colors group {{ not pb.slug ? 'pointer-events-none' }}">
        <span class="w-7 text-center flex-shrink-0 {{ position <= 3 ? 'text-lg' : 'text-sm font-bold text-slate-300' }}">
            {{ medals[position]|default(position) }}
        </span>
        <div class="flex-1 min-w-0">
            <div class="text-sm font-medium text-slate-700 group-hover:text-primary-600 transition-colors truncate">{{ pb.name }}</div>
            <div class="text-xs text-slate-400">{{ pb.count }} reclamaciones</div>
        </div>
        <div class="flex-shrink-0 text-right">
            <div class="text-sm font-bold tabular-nums {{ stat > 70 ? 'text-red-500' : (stat > 40 ? 'text-amber-500' : 'text-emerald-500') }}">{{ stat }}{{ statSuffix|default('') }}</div>
            <div class="text-xs text-slate-400">{{ statLabel }}</div>
        </div>
    </a>
{% endmacro %}

{# Neutral color variant (no red/green judgment) #}
{% macro ranking_item_neutral(pb, position, stat, statLabel, statSuffix) %}
    {% set medals = { 1: '🥇', 2: '🥈', 3: '🥉' } %}
    <a href="{{ pb.slug ? path('app_resoluciones_reclamado', { slug: pb.slug }) : '#' }}"
       class="flex items-center gap-3 py-3 px-3 -mx-3 rounded-lg hover:bg-slate-50 transition-colors group {{ not pb.slug ? 'pointer-events-none' }}">
        <span class="w-7 text-center flex-shrink-0 {{ position <= 3 ? 'text-lg' : 'text-sm font-bold text-slate-300' }}">
            {{ medals[position]|default(position) }}
        </span>
        <div class="flex-1 min-w-0">
            <div class="text-sm font-medium text-slate-700 group-hover:text-primary-600 transition-colors truncate">{{ pb.name }}</div>
            <div class="text-xs text-slate-400">{{ pb.count }} reclamaciones</div>
        </div>
        <div class="flex-shrink-0 text-right">
            <div class="text-sm font-bold tabular-nums text-slate-700">{{ stat }}{{ statSuffix|default('') }}</div>
            <div class="text-xs text-slate-400">{{ statLabel }}</div>
        </div>
    </a>
{% endmacro %}

<header class="repo-header border-b border-slate-200/50 relative overflow-hidden">
    <div class="repo-header-bg"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 relative z-10">
        <nav class="flex items-center gap-2 text-sm text-slate-500 mb-3 animate-fade-in">
            <a href="{{ path('app_resoluciones_index') }}" class="hover:text-primary-600 transition-colors">Repositorio</a>
            <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
            <span class="text-slate-700 font-medium">Administraciones reclamadas</span>
        </nav>
        <h1 class="repo-title text-3xl sm:text-4xl text-slate-800">Administraciones reclamadas</h1>
        <p class="text-sm text-slate-500 mt-2 max-w-2xl">Administraciones públicas contra las que se han presentado reclamaciones ante los consejos de transparencia. Selecciona una para ver su historial completo.</p>
    </div>
</header>

<div class="flex-1">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-10">

        {# ── Rankings ── #}
        {% if rankings is not empty %}
        <section>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

                {# Los que más pierden — por porcentaje #}
                {% if rankings.topLosersByPct|length > 0 %}
                <div class="profile-section" style="animation: fade-slide-up 0.5s ease-out both; animation-delay: 0.05s">
                    <h2 class="profile-section-title">
                        <i data-lucide="trending-down" class="w-4 h-4 text-red-400"></i>
                        Los que más pierden (%)
                    </h2>
                    <p class="text-xs text-slate-400 -mt-2 mb-3">Mayor tasa de reclamaciones estimadas contra ellos (mín. {{ minCases }} casos resueltos)</p>
                    <div class="divide-y divide-slate-100">
                        {% for pb in rankings.topLosersByPct %}
                            {{ _self.ranking_item(pb, loop.index, pb.lossRate, 'estimadas', '%') }}
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                {# Los que más pierden — en absoluto #}
                {% if rankings.topLosersByAbs|length > 0 %}
                <div class="profile-section" style="animation: fade-slide-up 0.5s ease-out both; animation-delay: 0.1s">
                    <h2 class="profile-section-title">
                        <i data-lucide="bar-chart-horizontal" class="w-4 h-4 text-red-400"></i>
                        Los que más pierden (total)
                    </h2>
                    <p class="text-xs text-slate-400 -mt-2 mb-3">Mayor número absoluto de reclamaciones donde ganó el ciudadano</p>
                    <div class="divide-y divide-slate-100">
                        {% for pb in rankings.topLosersByAbs %}
                            {{ _self.ranking_item_neutral(pb, loop.index, pb.favorable, 'estimadas', '') }}
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                {# Los más reclamados #}
                {% if rankings.mostComplained|length > 0 %}
                <div class="profile-section" style="animation: fade-slide-up 0.5s ease-out both; animation-delay: 0.15s">
                    <h2 class="profile-section-title">
                        <i data-lucide="megaphone" class="w-4 h-4 text-primary-500"></i>
                        Los más reclamados
                    </h2>
                    <p class="text-xs text-slate-400 -mt-2 mb-3">Administraciones que acumulan más reclamaciones ante los consejos</p>
                    <div class="divide-y divide-slate-100">
                        {% for pb in rankings.mostComplained %}
                            {{ _self.ranking_item_neutral(pb, loop.index, pb.count, 'reclamaciones', '') }}
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                {# Nunca pierden #}
                {% if rankings.neverLose|length > 0 %}
                <div class="profile-section" style="animation: fade-slide-up 0.5s ease-out both; animation-delay: 0.3s">
                    <h2 class="profile-section-title">
                        <i data-lucide="shield-check" class="w-4 h-4 text-emerald-500"></i>
                        Nunca pierden
                    </h2>
                    <p class="text-xs text-slate-400 -mt-2 mb-3">0% de estimación: el consejo no les ha dado la razón al ciudadano en ningún caso (mín. {{ minCases }} resueltos)</p>
                    <div class="divide-y divide-slate-100">
                        {% for pb in rankings.neverLose %}
                            <a href="{{ pb.slug ? path('app_resoluciones_reclamado', { slug: pb.slug }) : '#' }}"
                               class="flex items-center gap-3 py-3 px-3 -mx-3 rounded-lg hover:bg-slate-50 transition-colors group {{ not pb.slug ? 'pointer-events-none' }}">
                                <span class="w-7 text-center flex-shrink-0 {{ loop.index <= 3 ? 'text-lg' : 'text-sm font-bold text-slate-300' }}">
                                    {{ { 1: '🛡️', 2: '🛡️', 3: '🛡️' }[loop.index]|default(loop.index) }}
                                </span>
                                <div class="flex-1 min-w-0">
                                    <div class="text-sm font-medium text-slate-700 group-hover:text-primary-600 transition-colors truncate">{{ pb.name }}</div>
                                    <div class="text-xs text-slate-400">{{ pb.decisive }} casos resueltos, 0 estimados</div>
                                </div>
                                <div class="flex-shrink-0">
                                    <span class="badge badge-success text-xs">0%</span>
                                </div>
                            </a>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

            </div>
        </section>
        {% endif %}

        {# ── Full listing ── #}
        <section>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
                <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wider">
                    {% if search %}Resultados para &laquo;{{ search }}&raquo; ({{ total }}){% else %}Todas las administraciones ({{ total }}){% endif %}
                </h2>
                <form method="GET" action="{{ path('app_resoluciones_reclamados') }}" class="relative sm:w-72 flex gap-2">
                    <div class="relative flex-1">
                        <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                        <input type="text" name="search" value="{{ search }}" placeholder="Buscar administración..."
                               class="input input-icon-left text-sm">
                    </div>
                    {% if search %}
                        <a href="{{ path('app_resoluciones_reclamados') }}" class="btn btn-ghost btn-sm flex-shrink-0">
                            <i data-lucide="x" class="w-4 h-4"></i>
                        </a>
                    {% endif %}
                </form>
            </div>
            {% set levelLabels = { state: 'Estatal', autonomous: 'Autonómico', local: 'Local' } %}

            {% if publicBodies|length > 0 %}
            <div class="space-y-2">
                {% for pb in publicBodies %}
                    <a href="{{ pb.slug ? path('app_resoluciones_reclamado', { slug: pb.slug }) : '#' }}"
                       class="resolution-card group block {{ not pb.slug ? 'pointer-events-none' }}"
                       style="--accent: {{ pb.lossRate > 60 ? '#f87171' : (pb.lossRate > 40 ? '#fbbf24' : '#34d399') }}">
                        <div class="p-4 sm:p-5">
                            <div class="flex items-center justify-between gap-4">
                                <div class="flex-1 min-w-0">
                                    <div class="flex flex-wrap items-center gap-2.5 mb-1">
                                        <h3 class="text-base font-semibold text-slate-800 group-hover:text-primary-600 transition-colors" style="font-family: 'DM Sans', sans-serif">
                                            {{ pb.name }}
                                        </h3>
                                        <span class="badge badge-secondary text-xs">{{ levelLabels[pb.level]|default(pb.level) }}</span>
                                    </div>
                                    <div class="flex flex-wrap items-center gap-3 text-sm text-slate-500">
                                        <span>{{ pb.count }} {{ pb.count == 1 ? 'reclamación' : 'reclamaciones' }}</span>
                                        <span class="text-slate-300">&middot;</span>
                                        <span>En el {{ pb.lossRate }}% ganó el ciudadano</span>
                                        {% if pb.avg_days %}
                                            <span class="text-slate-300">&middot;</span>
                                            <span>{{ pb.avg_days }} días de media</span>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="hidden sm:flex items-center gap-3 flex-shrink-0">
                                    {% if pb.decisive > 0 %}
                                    <div class="w-24 flex h-2 rounded-full overflow-hidden gap-px bg-slate-100">
                                        {% if pb.favorable > 0 %}
                                            <div class="h-full rounded-full" style="flex: {{ pb.favorable }}; background: #f87171;" title="Estimadas: {{ pb.favorable }}"></div>
                                        {% endif %}
                                        {% if pb.unfavorable > 0 %}
                                            <div class="h-full rounded-full" style="flex: {{ pb.unfavorable }}; background: #34d399;" title="Desestimadas: {{ pb.unfavorable }}"></div>
                                        {% endif %}
                                    </div>
                                    {% endif %}
                                    <i data-lucide="chevron-right" class="w-4 h-4 text-slate-300 group-hover:text-primary-400 transition-colors"></i>
                                </div>
                            </div>
                        </div>
                    </a>
                {% endfor %}
            </div>

            {# Pagination #}
            {% if totalPages > 1 %}
                {% set paginationParams = search ? { search: search } : {} %}
                <div class="mt-6 flex items-center justify-between">
                    <p class="text-sm text-slate-500">
                        {{ ((page - 1) * 30) + 1 }}–{{ min(page * 30, total) }} de {{ total }}
                    </p>
                    <nav class="flex items-center gap-1" aria-label="Paginación">
                        {% if page > 3 %}
                            <a href="{{ path('app_resoluciones_reclamados', paginationParams|merge({ page: 1 })) }}"
                               class="btn btn-ghost btn-sm" title="Primera página">
                                <i data-lucide="chevrons-left" class="w-4 h-4"></i>
                            </a>
                        {% endif %}
                        {% if page > 1 %}
                            <a href="{{ path('app_resoluciones_reclamados', paginationParams|merge({ page: page - 1 })) }}"
                               class="btn btn-ghost btn-sm">
                                <i data-lucide="chevron-left" class="w-4 h-4"></i>
                            </a>
                        {% endif %}
                        {% for p in max(1, page - 2)..min(totalPages, page + 2) %}
                            <a href="{{ path('app_resoluciones_reclamados', paginationParams|merge({ page: p })) }}"
                               class="btn btn-sm {{ p == page ? 'btn-primary' : 'btn-ghost' }}">
                                {{ p }}
                            </a>
                        {% endfor %}
                        {% if page < totalPages %}
                            <a href="{{ path('app_resoluciones_reclamados', paginationParams|merge({ page: page + 1 })) }}"
                               class="btn btn-ghost btn-sm">
                                <i data-lucide="chevron-right" class="w-4 h-4"></i>
                            </a>
                        {% endif %}
                        {% if page < totalPages - 2 %}
                            <a href="{{ path('app_resoluciones_reclamados', paginationParams|merge({ page: totalPages })) }}"
                               class="btn btn-ghost btn-sm" title="Última página">
                                <i data-lucide="chevrons-right" class="w-4 h-4"></i>
                            </a>
                        {% endif %}
                    </nav>
                </div>
            {% endif %}

            {% else %}
                <div class="empty-state py-16">
                    <i data-lucide="building-2" class="empty-state-icon"></i>
                    <h3 class="empty-state-title">No se encontraron administraciones</h3>
                    <p class="empty-state-description">Prueba con otro término de búsqueda</p>
                    {% if search %}
                        <a href="{{ path('app_resoluciones_reclamados') }}" class="btn btn-secondary mt-4">
                            <i data-lucide="x" class="w-4 h-4 mr-2"></i>
                            Limpiar búsqueda
                        </a>
                    {% endif %}
                </div>
            {% endif %}
        </section>

    </div>
</div>

{% include '_partials/public_footer.html.twig' %}
{% endblock %}
