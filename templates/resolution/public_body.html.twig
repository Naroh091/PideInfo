{% extends 'base.html.twig' %}

{% block title %}{{ publicBody.name }} - Resoluciones de Transparencia - PideInfo{% endblock %}

{% block meta %}
    <meta name="description" content="{{ publicBody.name }}: {{ cardStats.totalWithOutcome }} reclamaciones resueltas por los consejos de transparencia. En el {{ cardStats.successRate }}% de los casos, el consejo dio la razón al ciudadano.">
{% endblock %}

{% block body_class %}min-h-screen flex flex-col{% endblock %}

{% block body %}
{% include '_partials/public_nav.html.twig' with { active_page: 'resoluciones' } %}

{% set hasFilters = filters.search or filters.organism or filters.outcome or filters.keyword or filters.dateFrom or filters.dateTo %}
{% set baseRoute = path('app_resoluciones_reclamado', { slug: publicBody.slug }) %}
{% set urlFilters = filters|filter((v, k) => v is not empty and k != 'publicBody' and k != 'publicBodyExact') %}

{# ── Header ── #}
<header class="repo-header border-b border-slate-200/50 relative overflow-hidden">
    <div class="repo-header-bg"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 relative z-10">
        <nav class="flex items-center gap-2 text-sm text-slate-500 mb-3 animate-fade-in">
            <a href="{{ path('app_resoluciones_index') }}" class="hover:text-primary-600 transition-colors">Repositorio</a>
            <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
            <a href="{{ path('app_resoluciones_reclamados') }}" class="hover:text-primary-600 transition-colors">Administraciones reclamadas</a>
            <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
            <span class="text-slate-700 font-medium">{{ publicBody.name }}</span>
        </nav>

        <h1 class="repo-title text-3xl sm:text-4xl text-slate-800">{{ publicBody.name }}</h1>

        <div class="flex flex-wrap items-center gap-3 mt-2">
            <span class="badge badge-secondary">
                <i data-lucide="building-2" class="w-3 h-3 mr-1"></i>
                {{ publicBody.levelLabel }}
            </span>
            {% if publicBody.autonomousCommunity %}
                <span class="text-sm text-slate-400">{{ publicBody.autonomousCommunity.name }}</span>
            {% endif %}
            {% if publicBody.transparencyPortalUrl %}
                <a href="{{ publicBody.transparencyPortalUrl }}" target="_blank" rel="noopener"
                   class="inline-flex items-center gap-1 text-sm text-primary-600 hover:text-primary-700 transition-colors">
                    <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                    Portal de transparencia
                </a>
            {% endif %}
            {% if publicBody.email %}
                <a href="mailto:{{ publicBody.email }}"
                   class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-primary-600 transition-colors">
                    <i data-lucide="mail" class="w-3.5 h-3.5"></i>
                    {{ publicBody.email }}
                </a>
            {% endif %}
        </div>

        <p class="text-sm text-slate-500 mt-2">Reclamaciones de transparencia presentadas contra esta administración ante los consejos de transparencia</p>

        {# ── Proportion bar (colores invertidos: perspectiva del reclamado) ── #}
        {# Estimada = el consejo dio la razón al ciudadano = la administración perdió → rojo #}
        {# Desestimada = el consejo rechazó la reclamación = la administración ganó → verde #}
        {% set totalResolutions = outcomeStats|reduce((carry, v) => carry + v, 0) %}
        {% if totalResolutions > 0 %}
            {% set favorable = outcomeStats.favorable|default(0) %}
            {% set partial = outcomeStats.partial|default(0) %}
            {% set mediation = outcomeStats.acuerdo_mediacion|default(0) %}
            {% set unfavorable = outcomeStats.unfavorable|default(0) %}
            {% set inadmissible = outcomeStats.inadmissible|default(0) %}
            {% set archived = outcomeStats.archivo|default(0) %}
            {% set lossOfPurpose = outcomeStats.perdida_objeto|default(0) %}
            {% set withdrawal = outcomeStats.desistimiento|default(0) %}
            {% set referral = outcomeStats.derivacion|default(0) %}

            {% set estimadasCount = favorable + partial + mediation %}
            {% set desestimadaCount = unfavorable + inadmissible %}
            {% set otherCount = archived + lossOfPurpose + withdrawal + referral %}

            {% set groups = [
                { count: estimadasCount, label: 'Estimadas', color: '#f87171' },
                { count: desestimadaCount, label: 'Desestimadas', color: '#34d399' },
                { count: otherCount, label: 'Otras', color: '#cbd5e1' },
            ] %}

            <div class="mt-8 proportion-bar-container" style="animation-delay: 0.1s">
                <div class="proportion-bar">
                    {% for g in groups %}
                        {% if g.count > 0 %}
                            <div class="proportion-segment" style="width: {{ (g.count / totalResolutions * 100) }}%; background: {{ g.color }}"></div>
                        {% endif %}
                    {% endfor %}
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-4">
                    {% if estimadasCount > 0 %}
                    <div class="flex items-start gap-2.5">
                        <span class="w-3 h-3 rounded-full flex-shrink-0 mt-0.5" style="background: #f87171"></span>
                        <div class="text-sm">
                            <div class="font-semibold text-slate-700">Estimadas contra la administración <span class="text-red-500">{{ estimadasCount }}</span> <span class="text-slate-400 font-normal text-xs">({{ (estimadasCount / totalResolutions * 100)|round }}%)</span></div>
                            <div class="text-xs text-slate-400 mt-0.5">
                                El consejo dio la razón al ciudadano.
                                {% if favorable > 0 %}Totales {{ favorable }}{% endif %}
                                {% if partial > 0 %}{{ favorable > 0 ? ' · ' }}Parciales {{ partial }}{% endif %}
                                {% if mediation > 0 %}{{ (favorable > 0 or partial > 0) ? ' · ' }}Mediación {{ mediation }}{% endif %}
                            </div>
                        </div>
                    </div>
                    {% endif %}

                    {% if desestimadaCount > 0 %}
                    <div class="flex items-start gap-2.5">
                        <span class="w-3 h-3 rounded-full flex-shrink-0 mt-0.5" style="background: #34d399"></span>
                        <div class="text-sm">
                            <div class="font-semibold text-slate-700">Desestimadas <span class="text-emerald-600">{{ desestimadaCount }}</span> <span class="text-slate-400 font-normal text-xs">({{ (desestimadaCount / totalResolutions * 100)|round }}%)</span></div>
                            <div class="text-xs text-slate-400 mt-0.5">
                                El consejo rechazó la reclamación.
                                {% if unfavorable > 0 %}Desestimadas {{ unfavorable }}{% endif %}
                                {% if inadmissible > 0 %}{{ unfavorable > 0 ? ' · ' }}Inadmitidas {{ inadmissible }}{% endif %}
                            </div>
                        </div>
                    </div>
                    {% endif %}

                    {% if otherCount > 0 %}
                    <div class="flex items-start gap-2.5">
                        <span class="w-3 h-3 rounded-full flex-shrink-0 mt-0.5" style="background: #cbd5e1"></span>
                        <div class="text-sm">
                            <div class="font-semibold text-slate-700">Otras <span class="text-slate-500">{{ otherCount }}</span> <span class="text-slate-400 font-normal text-xs">({{ (otherCount / totalResolutions * 100)|round }}%)</span></div>
                            <div class="text-xs text-slate-400 mt-0.5">
                                {% set otherParts = [] %}
                                {% if archived > 0 %}{% set otherParts = otherParts|merge(['Archivadas ' ~ archived]) %}{% endif %}
                                {% if lossOfPurpose > 0 %}{% set otherParts = otherParts|merge(['Pérdida obj. ' ~ lossOfPurpose]) %}{% endif %}
                                {% if withdrawal > 0 %}{% set otherParts = otherParts|merge(['Desistimiento ' ~ withdrawal]) %}{% endif %}
                                {% if referral > 0 %}{% set otherParts = otherParts|merge(['Derivadas ' ~ referral]) %}{% endif %}
                                {{ otherParts|join(' · ') }}
                            </div>
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>

            {# ── Stat tiles ── #}
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6">
                <div class="stat-tile" style="animation-delay: 0.15s">
                    <div class="stat-tile-value">{{ cardStats.totalWithOutcome }}</div>
                    <div class="stat-tile-label">Reclamaciones resueltas contra {{ publicBody.name }}</div>
                </div>
                <div class="stat-tile stat-tile-warm" style="animation-delay: 0.2s">
                    <div class="stat-tile-value">{{ cardStats.successRate }}%</div>
                    <div class="stat-tile-label">Tasa de pérdida en las reclamaciones</div>
                    <div class="stat-tile-sub">% de veces que el ciudadano ganó con su reclamación</div>
                </div>
                {% if distinctOrganisms|length > 1 %}
                <div class="stat-tile" style="animation-delay: 0.25s">
                    <div class="stat-tile-value">{{ distinctOrganisms|length }}</div>
                    <div class="stat-tile-label">Consejos implicados</div>
                </div>
                {% endif %}
            </div>
        {% endif %}
    </div>
</header>

{# ── Profile dashboard sections ── #}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    {# Councils section #}
    {% if distinctOrganisms|length > 1 %}
    <section class="profile-section" style="animation: fade-slide-up 0.5s ease-out both; animation-delay: 0.15s">
        <h2 class="profile-section-title">
            <i data-lucide="landmark" class="w-4 h-4 text-primary-500"></i>
            Consejos que han tramitado reclamaciones
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {% for org in distinctOrganisms %}
                <a href="{{ org.slug ? path('app_resoluciones_organismo', { slug: org.slug }) : '#' }}"
                   class="organism-chip {{ not org.slug ? 'pointer-events-none' }}">
                    {% if org.image %}
                        <img src="{{ s3_image_url(org.image) }}" alt="{{ org.name }}" class="organism-chip-img">
                    {% else %}
                        <div class="organism-chip-img flex items-center justify-center">
                            <i data-lucide="building" class="w-5 h-5 text-slate-300"></i>
                        </div>
                    {% endif %}
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2">
                            {% if org.shortName %}
                                <span class="badge badge-primary text-xs">{{ org.shortName }}</span>
                            {% endif %}
                            <span class="organism-chip-count">{{ org.resolutionCount }}</span>
                        </div>
                        <div class="text-sm text-slate-600 truncate mt-0.5">{{ org.name }}</div>
                    </div>
                </a>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {# Yearly evolution #}
        {% if yearlyBreakdown|length > 0 %}
        <section class="profile-section" style="animation: fade-slide-up 0.5s ease-out both; animation-delay: 0.2s">
            <h2 class="profile-section-title">
                <i data-lucide="bar-chart-3" class="w-4 h-4 text-primary-500"></i>
                Evolución anual
            </h2>
            {% set maxTotal = 0 %}
                {% for row in yearlyBreakdown %}{% if row.total > maxTotal %}{% set maxTotal = row.total %}{% endif %}{% endfor %}
            <div class="space-y-0.5">
                {% for row in yearlyBreakdown %}
                    <div class="year-row">
                        <span class="year-label">{{ row.year }}</span>
                        <div class="year-bar-container">
                            {% if row.favorable > 0 %}
                                <div class="year-bar-segment" style="flex: {{ row.favorable }}; background: #f87171;" title="Estimadas: {{ row.favorable }}"></div>
                            {% endif %}
                            {% if row.unfavorable > 0 %}
                                <div class="year-bar-segment" style="flex: {{ row.unfavorable }}; background: #34d399;" title="Desestimadas: {{ row.unfavorable }}"></div>
                            {% endif %}
                            {% if row.other > 0 %}
                                <div class="year-bar-segment" style="flex: {{ row.other }}; background: #cbd5e1;" title="Otras: {{ row.other }}"></div>
                            {% endif %}
                            {# Fill remaining space to scale bars relative to max year #}
                            {% if row.total < maxTotal %}
                                <div style="flex: {{ maxTotal - row.total }}; background: transparent;"></div>
                            {% endif %}
                        </div>
                        <span class="year-bar-count">{{ row.total }}</span>
                    </div>
                {% endfor %}
            </div>
            <div class="flex items-center gap-4 mt-4 pt-3 border-t border-slate-100">
                <div class="flex items-center gap-1.5 text-xs text-slate-400">
                    <span class="w-2.5 h-2.5 rounded-sm" style="background: #f87171"></span> Estimadas (ciudadano ganó)
                </div>
                <div class="flex items-center gap-1.5 text-xs text-slate-400">
                    <span class="w-2.5 h-2.5 rounded-sm" style="background: #34d399"></span> Desestimadas
                </div>
                <div class="flex items-center gap-1.5 text-xs text-slate-400">
                    <span class="w-2.5 h-2.5 rounded-sm" style="background: #cbd5e1"></span> Otras
                </div>
            </div>
        </section>
        {% endif %}

        {# Keywords / Denial reasons #}
        <section class="profile-section" style="animation: fade-slide-up 0.5s ease-out both; animation-delay: 0.25s">
            <h2 class="profile-section-title">
                <i data-lucide="tag" class="w-4 h-4 text-primary-500"></i>
                Temas más frecuentes
            </h2>
            {% if topKeywords|length > 0 %}
                <div class="flex flex-wrap gap-2">
                    {% for kw in topKeywords %}
                        <a href="{{ path('app_resoluciones_reclamado', { slug: publicBody.slug, keyword: kw.keyword }) }}"
                           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-50 border border-slate-200 text-sm text-slate-600 hover:border-primary-200 hover:text-primary-600 transition-all">
                            {{ kw.keyword }}
                            <span class="text-xs text-slate-400">({{ kw.count }})</span>
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                <div class="relative bg-amber-50/50 rounded-xl border border-amber-200 p-5 pl-8">
                    <div class="absolute left-0 top-0 bottom-0 w-1 rounded-l-xl bg-amber-400"></div>
                    <div class="flex items-start gap-3">
                        <div class="w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center flex-shrink-0">
                            <i data-lucide="construction" class="w-4 h-4 text-amber-600"></i>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-amber-800">En construcción</p>
                            <p class="text-xs text-amber-600 mt-0.5">Estamos procesando las resoluciones para extraer los temas más habituales.</p>
                        </div>
                    </div>
                </div>
            {% endif %}
        </section>
    </div>

    {# Contact info #}
    {% if publicBody.address or publicBody.registryCode %}
    <section class="profile-section" style="animation: fade-slide-up 0.5s ease-out both; animation-delay: 0.3s">
        <h2 class="profile-section-title">
            <i data-lucide="info" class="w-4 h-4 text-primary-500"></i>
            Información del organismo
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            {% if publicBody.address %}
            <div>
                <span class="text-xs text-slate-400 uppercase tracking-wider">Dirección</span>
                <p class="text-slate-600 mt-0.5">{{ publicBody.address }}</p>
            </div>
            {% endif %}
            {% if publicBody.registryCode %}
            <div>
                <span class="text-xs text-slate-400 uppercase tracking-wider">Código de registro</span>
                <p class="text-slate-600 mt-0.5 font-mono">{{ publicBody.registryCode }}</p>
            </div>
            {% endif %}
        </div>
    </section>
    {% endif %}
</div>

{# ── Resolution list with filters ── #}
<div class="flex-1 border-t border-slate-200/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="flex flex-col lg:flex-row gap-6">

            {# Sidebar filters #}
            <aside class="lg:w-64 flex-shrink-0">
                <form method="GET" action="{{ baseRoute }}" class="lg:sticky lg:top-20">
                    <div class="bg-white rounded-xl border border-slate-200 divide-y divide-slate-100">
                        {# Search #}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2 block">Buscar</label>
                            <div class="relative">
                                <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                                <input type="text" name="search" value="{{ filters.search }}"
                                       placeholder="Asunto, referencia..."
                                       class="input input-icon-left text-sm">
                            </div>
                        </div>

                        {# Organism #}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2 block">Organismo</label>
                            <select name="organism"
                                    data-controller="tom-select"
                                    data-tom-select-placeholder-value="Todos">
                                <option value="">Todos</option>
                                {% for organism in organisms %}
                                    <option value="{{ organism.id }}"
                                            data-ccaa="{{ organism.autonomousCommunity ? organism.autonomousCommunity.name : '' }}"
                                            {{ filters.organism == (organism.id ~ '') ? 'selected' }}>
                                        {{ organism.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        {# Outcome #}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2 block">Resultado</label>
                            <select name="outcome"
                                    data-controller="tom-select"
                                    data-tom-select-placeholder-value="Todos">
                                <option value="">Todos</option>
                                <option value="favorable" {{ filters.outcome == 'favorable' ? 'selected' }}>Estimada</option>
                                <option value="partial" {{ filters.outcome == 'partial' ? 'selected' }}>Parcial</option>
                                <option value="acuerdo_mediacion" {{ filters.outcome == 'acuerdo_mediacion' ? 'selected' }}>Acuerdo de mediación</option>
                                <option value="unfavorable" {{ filters.outcome == 'unfavorable' ? 'selected' }}>Desestimada</option>
                                <option value="inadmissible" {{ filters.outcome == 'inadmissible' ? 'selected' }}>Inadmitida</option>
                                <option value="archivo" {{ filters.outcome == 'archivo' ? 'selected' }}>Archivada</option>
                                <option value="perdida_objeto" {{ filters.outcome == 'perdida_objeto' ? 'selected' }}>Pérdida de objeto</option>
                                <option value="desistimiento" {{ filters.outcome == 'desistimiento' ? 'selected' }}>Desistimiento</option>
                                <option value="derivacion" {{ filters.outcome == 'derivacion' ? 'selected' }}>Derivada</option>
                            </select>
                        </div>

                        {# Keyword #}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2 block">Palabra clave</label>
                            <select name="keyword"
                                    data-controller="tom-select"
                                    data-tom-select-placeholder-value="Todas"
                                    data-tom-select-remote-value="{{ path('app_resoluciones_keywords_api') }}">
                                <option value="">Todas</option>
                                {% if filters.keyword %}
                                    <option value="{{ filters.keyword }}" selected>{{ filters.keyword }}</option>
                                {% endif %}
                            </select>
                        </div>

                        {# Dates #}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2 block">Fecha</label>
                            <div class="space-y-2">
                                <input type="date" name="dateFrom" value="{{ filters.dateFrom }}"
                                       class="input text-sm">
                                <input type="date" name="dateTo" value="{{ filters.dateTo }}"
                                       class="input text-sm">
                            </div>
                        </div>

                        {# Actions #}
                        <div class="p-4 flex flex-col gap-2">
                            <button type="submit" class="btn btn-primary btn-sm w-full">
                                <i data-lucide="search" class="w-3.5 h-3.5 mr-1.5"></i>
                                Buscar
                            </button>
                            {% if hasFilters %}
                                <a href="{{ baseRoute }}" class="btn btn-ghost btn-sm w-full">
                                    <i data-lucide="x" class="w-3.5 h-3.5 mr-1.5"></i>
                                    Limpiar filtros
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </form>
            </aside>

            {# Results #}
            <main class="flex-1 min-w-0">
                {% if hasFilters %}
                    <div class="flex items-center gap-2 mb-4 text-sm text-slate-500">
                        <i data-lucide="filter" class="w-4 h-4"></i>
                        <span>Filtros activos</span>
                        {% if filters.search %}
                            <span class="badge badge-secondary">&laquo;{{ filters.search }}&raquo;</span>
                        {% endif %}
                        {% if filters.organism %}
                            {% for organism in organisms %}
                                {% if organism.id ~ '' == filters.organism %}
                                    <span class="badge badge-secondary">{{ organism.name }}</span>
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                        {% if filters.outcome %}
                            <span class="badge badge-secondary">{{ filters.outcome }}</span>
                        {% endif %}
                        {% if filters.keyword %}
                            <span class="badge badge-secondary">{{ filters.keyword }}</span>
                        {% endif %}
                        {% if filters.dateFrom or filters.dateTo %}
                            <span class="badge badge-secondary">{{ filters.dateFrom ?: '...' }} — {{ filters.dateTo ?: '...' }}</span>
                        {% endif %}
                    </div>
                {% endif %}

                {% if resolutions|length > 0 %}
                    <div class="space-y-2.5">
                        {% set outcomeAccent = {
                            favorable: '#34d399',
                            partial: '#fbbf24',
                            acuerdo_mediacion: '#818cf8',
                            unfavorable: '#f87171',
                            inadmissible: '#c084fc',
                            archivo: '#38bdf8',
                            perdida_objeto: '#94a3b8',
                            desistimiento: '#94a3b8',
                            derivacion: '#94a3b8',
                        } %}
                        {% set badgeClass = {
                            favorable: 'badge-success',
                            partial: 'badge-warning',
                            acuerdo_mediacion: 'badge-success',
                            unfavorable: 'badge-danger',
                            inadmissible: 'badge-secondary',
                            archivo: 'badge-info',
                            perdida_objeto: 'badge-secondary',
                            desistimiento: 'badge-secondary',
                            derivacion: 'badge-secondary',
                        } %}
                        {% for resolution in resolutions %}
                            <div class="resolution-card group" style="--accent: {{ outcomeAccent[resolution.outcome]|default('#94a3b8') }}">
                                <div class="p-4 sm:p-5">
                                    <div class="flex items-start justify-between gap-4">
                                        <div class="flex-1 min-w-0">
                                            <div class="flex flex-wrap items-center gap-2.5 mb-1.5">
                                                <span class="badge {{ badgeClass[resolution.outcome]|default('badge-secondary') }}">
                                                    {{ resolution.outcomeLabel }}
                                                </span>
                                                <span class="text-xs text-slate-400 font-mono tracking-tight">{{ resolution.referenceNumber }}</span>
                                                {% if resolution.complaintOrganism and resolution.complaintOrganism.slug %}
                                                    <a href="{{ path('app_resoluciones_organismo', { slug: resolution.complaintOrganism.slug }) }}"
                                                       class="relative z-10 text-xs text-slate-400 hover:text-primary-600 transition-colors">{{ resolution.complaintOrganism.shortName ?? resolution.complaintOrganism.name }}</a>
                                                {% elseif resolution.complaintOrganism %}
                                                    <span class="text-xs text-slate-400">{{ resolution.complaintOrganism.shortName ?? resolution.complaintOrganism.name }}</span>
                                                {% endif %}
                                            </div>

                                            <h3 class="text-lg font-semibold leading-snug mb-1">
                                                <a href="{{ path('app_resoluciones_show', { id: resolution.id }) }}"
                                                   class="text-slate-800 group-hover:text-primary-600 transition-colors after:absolute after:inset-0">
                                                    {{ resolution.subject|default(resolution.referenceNumber) }}
                                                </a>
                                            </h3>

                                            <p class="text-sm text-slate-500 leading-relaxed">
                                                {{ resolution.summary }}
                                            </p>

                                            {% if resolution.keywords is not empty %}
                                                <div class="flex flex-wrap gap-1.5 mt-2.5">
                                                    {% for kw in resolution.keywords|slice(0, 5) %}
                                                        <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-slate-50 text-xs text-slate-500 border border-slate-100">{{ kw }}</span>
                                                    {% endfor %}
                                                    {% if resolution.keywords|length > 5 %}
                                                        <span class="text-xs text-slate-400">+{{ resolution.keywords|length - 5 }}</span>
                                                    {% endif %}
                                                </div>
                                            {% endif %}
                                        </div>

                                        <div class="hidden sm:flex flex-col items-end gap-1 flex-shrink-0 text-right">
                                            <span class="text-sm text-slate-500 tabular-nums">{{ resolution.resolutionDate ? resolution.resolutionDate|date('d/m/Y') : '' }}</span>
                                            <i data-lucide="chevron-right" class="w-4 h-4 text-slate-300 group-hover:text-primary-400 transition-colors mt-1"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    {# Pagination #}
                    {% if totalPages > 1 %}
                        <div class="mt-6 flex items-center justify-between">
                            <p class="text-sm text-slate-500">
                                {{ ((page - 1) * 50) + 1 }}–{{ min(page * 50, total) }} de {{ total }}
                            </p>
                            <nav class="flex items-center gap-1" aria-label="Paginación">
                                {% if page > 3 %}
                                    <a href="{{ path('app_resoluciones_reclamado', { slug: publicBody.slug }|merge(urlFilters|merge({ page: 1 }))) }}"
                                       class="btn btn-ghost btn-sm" title="Primera página">
                                        <i data-lucide="chevrons-left" class="w-4 h-4"></i>
                                    </a>
                                {% endif %}

                                {% if page > 1 %}
                                    <a href="{{ path('app_resoluciones_reclamado', { slug: publicBody.slug }|merge(urlFilters|merge({ page: page - 1 }))) }}"
                                       class="btn btn-ghost btn-sm">
                                        <i data-lucide="chevron-left" class="w-4 h-4"></i>
                                    </a>
                                {% endif %}

                                {% for p in max(1, page - 2)..min(totalPages, page + 2) %}
                                    <a href="{{ path('app_resoluciones_reclamado', { slug: publicBody.slug }|merge(urlFilters|merge({ page: p }))) }}"
                                       class="btn btn-sm {{ p == page ? 'btn-primary' : 'btn-ghost' }}">
                                        {{ p }}
                                    </a>
                                {% endfor %}

                                {% if page < totalPages %}
                                    <a href="{{ path('app_resoluciones_reclamado', { slug: publicBody.slug }|merge(urlFilters|merge({ page: page + 1 }))) }}"
                                       class="btn btn-ghost btn-sm">
                                        <i data-lucide="chevron-right" class="w-4 h-4"></i>
                                    </a>
                                {% endif %}

                                {% if page < totalPages - 2 %}
                                    <a href="{{ path('app_resoluciones_reclamado', { slug: publicBody.slug }|merge(urlFilters|merge({ page: totalPages }))) }}"
                                       class="btn btn-ghost btn-sm" title="Última página">
                                        <i data-lucide="chevrons-right" class="w-4 h-4"></i>
                                    </a>
                                {% endif %}
                            </nav>
                        </div>
                    {% endif %}

                {% else %}
                    <div class="empty-state py-16">
                        <i data-lucide="file-search" class="empty-state-icon"></i>
                        <h3 class="empty-state-title">No se encontraron resoluciones</h3>
                        <p class="empty-state-description">Prueba a cambiar los filtros de búsqueda</p>
                        {% if hasFilters %}
                            <a href="{{ baseRoute }}" class="btn btn-secondary mt-4">
                                <i data-lucide="x" class="w-4 h-4 mr-2"></i>
                                Limpiar filtros
                            </a>
                        {% endif %}
                    </div>
                {% endif %}
            </main>

        </div>
    </div>
</div>

{% include '_partials/public_footer.html.twig' %}

{# JSON-LD Structured Data #}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "GovernmentOrganization",
    "name": "{{ publicBody.name|e('js') }}",
    {% if publicBody.transparencyPortalUrl %}"url": "{{ publicBody.transparencyPortalUrl|e('js') }}",{% endif %}
    {% if publicBody.address %}"address": "{{ publicBody.address|e('js') }}",{% endif %}
    {% if publicBody.email %}"email": "{{ publicBody.email|e('js') }}",{% endif %}
    "description": "{{ cardStats.totalWithOutcome }} reclamaciones resueltas. En el {{ cardStats.successRate }}% el consejo dio la razón al ciudadano."
}
</script>
{% endblock %}
