{% extends 'base.html.twig' %}

{% block title %}{{ resolution.subject|default(resolution.referenceNumber) }} - Resoluciones de Transparencia - PideInfo{% endblock %}

{% block meta %}
    <meta name="description" content="{{ resolution.summary|u.truncate(160, '...') }}">
{% endblock %}

{% block og %}
    <meta property="og:title" content="{{ resolution.subject|default(resolution.referenceNumber) }} - PideInfo">
    <meta property="og:description" content="{{ resolution.summary|u.truncate(200, '...') }}">
    <meta property="og:image" content="{{ url('og_image_resolucion', { id: resolution.id }) }}">
    <meta property="og:url" content="{{ url('app_resoluciones_show', { id: resolution.id }) }}">
    <meta property="og:site_name" content="PideInfo">
    <meta property="og:type" content="article">
    <meta name="twitter:card" content="summary_large_image">
{% endblock %}

{% block body_class %}min-h-screen flex flex-col{% endblock %}

{% block body %}
{% if is_granted('ROLE_ADMIN') %}
<div class="bg-slate-800 text-white text-xs py-1.5 px-4 flex items-center justify-between">
    <span class="font-medium">Admin</span>
    <a href="{{ ea_admin_url('App\\Controller\\Admin\\ResolutionCrudController', 'detail', resolution.id) }}"
       class="inline-flex items-center gap-1 text-sky-300 hover:text-sky-100 transition-colors">
        <i data-lucide="external-link" class="w-3 h-3"></i>
        Ver en panel de administración
    </a>
</div>
{% endif %}

{% include '_partials/public_nav.html.twig' with { active_page: 'resoluciones' } %}

{% set outcomeAccent = {
    favorable: '#34d399',
    partial: '#fbbf24',
    acuerdo_mediacion: '#818cf8',
    unfavorable: '#f87171',
    inadmissible: '#c084fc',
    archivo: '#38bdf8',
    perdida_objeto: '#94a3b8',
    desistimiento: '#94a3b8',
    derivacion: '#94a3b8',
} %}
{% set accent = outcomeAccent[resolution.outcome]|default('#94a3b8') %}

{# Hero header #}
<header class="repo-header border-b border-slate-200/50 relative">
    <div class="repo-header-bg"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 relative z-10">
        <nav class="flex items-center gap-2 text-sm text-slate-500 mb-5 animate-fade-in">
            <a href="{{ path('app_resoluciones_index') }}" class="hover:text-primary-600 transition-colors">Repositorio</a>
            <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
            {% if resolution.complaintOrganism and resolution.complaintOrganism.slug %}
                <a href="{{ path('app_resoluciones_organismo', { slug: resolution.complaintOrganism.slug }) }}" class="hover:text-primary-600 transition-colors">{{ resolution.complaintOrganism.name }}</a>
                <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
            {% endif %}
            <span class="text-slate-700 font-medium font-mono text-xs">{{ resolution.referenceNumber }}</span>
        </nav>

        <div class="flex flex-wrap items-center gap-3 mb-3" style="animation: fade-slide-up 0.4s ease-out both">
            {% set badgeClass = {
                favorable: 'badge-success',
                partial: 'badge-warning',
                acuerdo_mediacion: 'badge-success',
                unfavorable: 'badge-danger',
                inadmissible: 'badge-secondary',
                archivo: 'badge-info',
                perdida_objeto: 'badge-secondary',
                desistimiento: 'badge-secondary',
                derivacion: 'badge-secondary',
            } %}
            <span class="badge {{ badgeClass[resolution.outcome]|default('badge-secondary') }}">
                {{ resolution.outcomeLabel }}
            </span>
            {% if resolution.resolutionDate %}
                <span class="text-sm text-slate-500">{{ resolution.resolutionDate|date('d/m/Y') }}</span>
            {% endif %}
            {% if resolution.daysToResolve %}
                <span class="text-xs text-slate-400">&middot; {{ resolution.daysToResolve }} días en resolverse</span>
            {% endif %}
        </div>

        <h1 class="repo-title text-2xl sm:text-3xl text-slate-800 max-w-4xl" style="animation: fade-slide-up 0.5s ease-out both; animation-delay: 0.05s">
            {{ resolution.subject|default(resolution.referenceNumber) }}
        </h1>

        {# Historial judicial: la misma regla que aplica el agente, mostrada a humanos. Una
           resolución anulada por sentencia firme no puede leerse como doctrina viva sin saberlo.
           La clasificación (incluida la DIRECCIÓN de la anulación) la decide JudicialStatus, no
           esta plantilla: es una regla jurídica, y no puede tener dos versiones. #}
        {% if judicial.challenged %}
            <div id="historial-judicial" class="mt-5 w-full scroll-mt-24 rounded-xl border px-4 py-3.5 {{ judicial.bannerClass }}"
                 style="animation: fade-slide-up 0.5s ease-out both; animation-delay: 0.1s">
                <div class="flex items-start gap-3">
                    <i data-lucide="{{ judicial.icon }}" class="w-5 h-5 mt-0.5 shrink-0"></i>
                    <div class="min-w-0 flex-1">
                        <div class="text-sm font-semibold">{{ judicial.title }}</div>

                        {# Qué significa el fallo EN LA PRÁCTICA: sin esto, la etiqueta procesal
                           no dice qué consiguió realmente quien pedía la información. #}
                        {% if judicial.effectiveOutcome %}
                            <p class="text-sm mt-1.5 font-medium border-l-2 border-current/30 pl-2.5">
                                {{ judicial.effectiveOutcome }}
                            </p>
                        {% endif %}

                        <p class="text-sm mt-1.5 opacity-90">{{ judicial.detail }}</p>

                        {# Recorrido judicial, en orden procesal. Un caso como BOSCO pierde en
                           instancia, pierde en apelación y GANA en casación: contar solo el final
                           esconde la historia, y contar solo las referencias no dice qué pasó. #}
                        <ol class="mt-4 space-y-0">
                            {% for j in judicial.judgments %}
                                {% set last = loop.last %}
                                {% set stance = {
                                    pro_acceso:    { dot: 'bg-emerald-500', label: 'Amplía el acceso',  chip: 'bg-emerald-100 text-emerald-800' },
                                    contra_acceso: { dot: 'bg-red-500',     label: 'Restringe el acceso', chip: 'bg-red-100 text-red-800' },
                                    neutro:        { dot: 'bg-slate-400',   label: 'No entra al fondo', chip: 'bg-slate-100 text-slate-700' },
                                }[j.transparencyStance]|default({ dot: 'bg-slate-300', label: 'Sin analizar', chip: 'bg-slate-100 text-slate-600' }) %}
                                <li class="relative pl-6 {{ last ? '' : 'pb-4' }}">
                                    {% if not last %}
                                        <span class="absolute left-[5px] top-3 bottom-0 w-px bg-current opacity-20"></span>
                                    {% endif %}
                                    <span class="absolute left-0 top-1.5 w-[11px] h-[11px] rounded-full ring-2 ring-white {{ stance.dot }}"></span>

                                    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                                        <span class="text-xs uppercase tracking-wide opacity-70">{{ j.instanceLabel }}</span>
                                        {% if j.sourceUrl %}
                                            <a href="{{ j.sourceUrl }}" target="_blank" rel="noopener"
                                               class="inline-flex items-center gap-1 text-sm font-mono font-medium underline decoration-current/30 hover:decoration-current">
                                                {{ j.citationLabel }}
                                                <i data-lucide="external-link" class="w-3 h-3 opacity-60"></i>
                                            </a>
                                        {% else %}
                                            <span class="text-sm font-mono font-medium">{{ j.citationLabel }}</span>
                                        {% endif %}
                                        <span class="text-[11px] font-medium px-1.5 py-0.5 rounded-full {{ stance.chip }}">{{ stance.label }}</span>
                                        {% if j.isFinal %}
                                            <span class="text-[11px] font-semibold px-1.5 py-0.5 rounded-full bg-slate-800 text-white">FIRME</span>
                                        {% endif %}
                                    </div>

                                    {% if j.effectiveOutcome %}
                                        <p class="text-sm mt-1 opacity-90">{{ j.effectiveOutcome }}</p>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ol>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</header>

<div class="flex-1">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex flex-col lg:flex-row gap-8">

            {# Sidebar — metadata #}
            <aside class="lg:w-72 flex-shrink-0 order-2 lg:order-1">
                <div class="space-y-4">
                    <div class="bg-white rounded-xl border border-slate-200 divide-y divide-slate-100" style="animation: fade-slide-up 0.5s ease-out both; animation-delay: 0.15s">
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-400">Resultado</label>
                            <div class="mt-1.5">
                                <span class="badge {{ badgeClass[resolution.outcome]|default('badge-secondary') }}">
                                    {{ resolution.outcomeLabel }}
                                </span>
                            </div>
                        </div>
                        {# El resultado de arriba es lo que decidió el Consejo; esto es lo que
                           hicieron después los tribunales con esa decisión. Cuando difieren, lo
                           que vale es esto. #}
                        {% if judicial.challenged %}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-400">Situación judicial</label>
                            <div class="mt-1.5">
                                <span class="badge {{ judicial.badgeClass }}">{{ judicial.badgeLabel }}</span>
                            </div>
                            {% if judicial.hint %}
                                <p class="mt-1.5 text-xs text-slate-500">{{ judicial.hint }}</p>
                            {% endif %}
                            <a href="#historial-judicial" class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-primary-600 hover:text-primary-700 transition-colors">
                                <i data-lucide="scale" class="w-3 h-3"></i>
                                {{ judicial.judgments|length }} sentencia{{ judicial.judgments|length == 1 ? '' : 's' }}
                            </a>
                        </div>
                        {% endif %}
                        {% if resolution.complaintOrganism %}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-400">Organismo</label>
                            <div class="mt-1.5 text-sm">
                                {% if resolution.complaintOrganism.slug %}
                                    <a href="{{ path('app_resoluciones_organismo', { slug: resolution.complaintOrganism.slug }) }}"
                                       class="text-primary-600 hover:text-primary-700 font-medium transition-colors">
                                        {{ resolution.complaintOrganism.name }}
                                    </a>
                                {% else %}
                                    <span class="text-slate-700 font-medium">{{ resolution.complaintOrganism.name }}</span>
                                {% endif %}
                                {% if resolution.complaintOrganism.autonomousCommunity %}
                                    <div class="text-xs text-slate-400 italic mt-0.5">{{ resolution.complaintOrganism.autonomousCommunity.name }}</div>
                                {% endif %}
                            </div>
                        </div>
                        {% endif %}
                        {% if resolution.publicBodyName %}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-400">Organismo reclamado</label>
                            <div class="mt-1.5 text-sm">
                                {% if publicBody is defined and publicBody and publicBody.slug %}
                                    <a href="{{ path('app_resoluciones_reclamado', { slug: publicBody.slug }) }}"
                                       class="text-primary-600 hover:text-primary-700 font-medium transition-colors">
                                        {{ resolution.publicBodyName }}
                                    </a>
                                {% else %}
                                    <span class="text-slate-700">{{ resolution.publicBodyName }}</span>
                                {% endif %}
                            </div>
                        </div>
                        {% endif %}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-400">Referencia</label>
                            <div class="mt-1 text-sm font-mono text-slate-600 tracking-tight">{{ resolution.referenceNumber }}</div>
                        </div>
                        {% if resolution.infoRequestDate or resolution.claimDate or resolution.resolutionDate %}
                        {% set milestones = [] %}
                        {% if resolution.infoRequestDate %}
                            {% set milestones = milestones|merge([{
                                date: resolution.infoRequestDate,
                                label: 'Solicitud de información',
                                color: 'bg-primary-500',
                                warning: false
                            }]) %}
                        {% endif %}
                        {% if resolution.claimDate %}
                            {% set milestones = milestones|merge([{
                                date: resolution.claimDate,
                                label: 'Reclamación presentada',
                                color: 'bg-amber-500',
                                warning: false
                            }]) %}
                        {% endif %}
                        {% if resolution.resolutionDate %}
                            {% set milestones = milestones|merge([{
                                date: resolution.resolutionDate,
                                label: 'Resolución emitida / publicada',
                                color: 'bg-emerald-500',
                                warning: true
                            }]) %}
                        {% endif %}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-400">Cronología</label>
                            <ol class="relative mt-3 space-y-4">
                                {% if milestones|length > 1 %}
                                <span class="absolute left-[7px] top-2 bottom-2 w-px bg-gradient-to-b from-primary-200 via-amber-200 to-emerald-200" aria-hidden="true"></span>
                                {% endif %}
                                {% for m in milestones %}
                                <li class="relative pl-6">
                                    <span class="absolute left-0 top-1 w-3.5 h-3.5 rounded-full {{ m.color }} ring-2 ring-white shadow-sm"></span>
                                    <div class="flex items-center gap-1 text-[11px] font-medium text-slate-400">
                                        {{ m.label }}
                                        {% if m.warning %}
                                        <span class="relative group inline-flex">
                                            <i data-lucide="info" class="w-3 h-3 text-slate-400 hover:text-slate-600 cursor-help"></i>
                                            <span role="tooltip" class="pointer-events-none absolute left-1/2 bottom-full z-10 mb-2 w-64 -translate-x-1/2 rounded-md bg-slate-800 px-3 py-2 text-[11px] font-normal normal-case leading-snug text-white shadow-lg opacity-0 group-hover:opacity-100 transition-opacity">
                                                Puede ser la fecha de firma, de aprobación de la resolución o incluso de subida a la web. No siempre se indica explícitamente; en algunos casos se extrae automáticamente del contenido y puede contener errores. Algunos organismos no facilitan la fecha de resolución, como la Comisión Vasca, y se usa la fecha de subida a la web. 
                                                <span class="absolute left-1/2 top-full -translate-x-1/2 border-4 border-transparent border-t-slate-800"></span>
                                            </span>
                                        </span>
                                        {% endif %}
                                    </div>
                                    <div class="text-sm font-semibold text-slate-700">{{ m.date|date('d/m/Y') }}</div>
                                    {% if not loop.last %}
                                        {% set gap = m.date.diff(milestones[loop.index0 + 1].date).days %}
                                        {% if gap > 0 %}
                                            <div class="text-[10px] text-slate-400 italic mt-1 pl-0">+{{ gap }} {{ gap == 1 ? 'día' : 'días' }}</div>
                                        {% endif %}
                                    {% endif %}
                                </li>
                                {% endfor %}
                            </ol>
                        </div>
                        {% endif %}
                        {% if resolution.claimReason %}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-400">Motivo de reclamación</label>
                            <div class="mt-1 text-sm text-slate-600 leading-relaxed">{{ resolution.claimReason }}</div>
                        </div>
                        {% endif %}
                        {% if resolution.limits is not empty %}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-400">Límites invocados <span class="text-slate-300 font-normal normal-case">· art. 14</span></label>
                            <div class="mt-2 flex flex-wrap gap-1.5">
                                {% for key in resolution.limits %}
                                    {% set label = limitLabels[key]|default(key) %}
                                    <a href="{{ path('app_inadmisiones_limites_limit', { value: key }) }}"
                                       title="{{ label }}"
                                       class="inline-flex items-center px-2 py-0.5 rounded-md bg-rose-50 text-xs text-rose-600 border border-rose-100 hover:border-rose-300 hover:bg-rose-100 transition-colors">{{ label }}</a>
                                {% endfor %}
                            </div>
                        </div>
                        {% endif %}
                        {% if resolution.inadmissionCauses is not empty %}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-400">Causas de inadmisión <span class="text-slate-300 font-normal normal-case">· art. 18</span></label>
                            <div class="mt-2 flex flex-wrap gap-1.5">
                                {% for key in resolution.inadmissionCauses %}
                                    {% set label = inadmissionCauseLabels[key]|default(key) %}
                                    <a href="{{ path('app_inadmisiones_limites_cause', { value: key }) }}"
                                       title="{{ label }}"
                                       class="inline-flex items-center px-2 py-0.5 rounded-md bg-amber-50 text-xs text-amber-700 border border-amber-100 hover:border-amber-300 hover:bg-amber-100 transition-colors">{{ label }}</a>
                                {% endfor %}
                            </div>
                        </div>
                        {% endif %}
                        {% if resolution.keywords is not empty %}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-400">Palabras clave</label>
                            <div class="mt-2 flex flex-wrap gap-1.5">
                                {% for kw in resolution.keywords %}
                                    <a href="{{ path('app_resoluciones_index', { keyword: kw }) }}"
                                       class="inline-flex items-center px-2 py-0.5 rounded-md bg-slate-50 text-xs text-slate-500 border border-slate-100 hover:border-primary-200 hover:text-primary-600 transition-colors">{{ kw }}</a>
                                {% endfor %}
                            </div>
                        </div>
                        {% endif %}
                        {% if resolution.sourceUrl %}
                        <div class="p-4">
                            <label class="text-xs font-semibold text-slate-400">Documento original</label>
                            <div class="mt-1.5">
                                <a href="{{ resolution.sourceUrl }}" target="_blank" rel="noopener"
                                   class="inline-flex items-center gap-1.5 text-sm text-primary-600 hover:text-primary-700 transition-colors">
                                    <i data-lucide="file-text" class="w-4 h-4"></i>
                                    Ver archivo
                                    <i data-lucide="external-link" class="w-3 h-3 text-slate-400"></i>
                                </a>
                            </div>
                        </div>
                        {% endif %}
                    </div>

                    {# Back link #}
                    <div style="animation: fade-slide-up 0.5s ease-out both; animation-delay: 0.2s">
                        <a href="{{ path('app_resoluciones_index') }}" class="btn btn-ghost btn-sm w-full">
                            <i data-lucide="arrow-left" class="w-4 h-4 mr-2"></i>
                            Volver al listado
                        </a>
                    </div>
                </div>
            </aside>

            {# Main content #}
            <main class="flex-1 min-w-0 order-1 lg:order-2 space-y-8">
                {# Summary #}
                {% if resolution.summary %}
                <section style="animation: fade-slide-up 0.5s ease-out both; animation-delay: 0.1s">
                    <div class="resolution-summary" style="--accent: {{ accent }}">
                        <div class="resolution-summary-accent"></div>
                        <p class="text-slate-700 leading-relaxed">{{ resolution.summary }}</p>
                    </div>
                </section>
                {% endif %}

                {# Keypoints #}
                {% if resolution.keypoints is not empty %}
                <section style="animation: fade-slide-up 0.5s ease-out both; animation-delay: 0.15s">
                    <h2 class="text-xs font-semibold text-slate-400 mb-3">
                        Puntos clave de la argumentación
                    </h2>
                    <div class="space-y-2.5">
                        {% for keypoint in resolution.keypoints %}
                            <div class="resolution-keypoint">
                                <span class="resolution-keypoint-num">{{ loop.index }}</span>
                                <span class="text-sm text-slate-700 leading-relaxed">{{ keypoint }}</span>
                            </div>
                        {% endfor %}
                    </div>
                </section>
                {% endif %}

                {# Full text #}
                {% if resolution.fullText %}
                <section style="animation: fade-slide-up 0.5s ease-out both; animation-delay: 0.2s">
                    <h2 class="text-xs font-semibold text-slate-400 mb-3">
                        Texto completo
                    </h2>
                    {% if '<h2' in resolution.fullText or '<p>' in resolution.fullText %}
                        <div class="bg-white rounded-xl border border-slate-200 p-6 sm:p-8 guide-content">
                            {{ resolution.fullText|raw }}
                        </div>
                    {% else %}
                        <div class="bg-white rounded-xl border border-slate-200 p-6 sm:p-8 text-sm text-slate-700 leading-relaxed whitespace-pre-wrap">{{ resolution.fullText }}</div>
                    {% endif %}
                </section>
                {% endif %}
            </main>

        </div>
    </div>
</div>

{% include '_partials/public_footer.html.twig' %}

{# JSON-LD Structured Data #}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Dataset",
    "name": "Resolución {{ resolution.referenceNumber }} - {{ resolution.subject|default('')|e('js') }}",
    "description": "{{ resolution.summary|u.truncate(300, '...')|e('js') }}",
    {% if resolution.resolutionDate %}"datePublished": "{{ resolution.resolutionDate|date('Y-m-d') }}",{% endif %}
    "url": "{{ url('app_resoluciones_show', { id: resolution.id }) }}",
    {% if resolution.complaintOrganism %}
    "creator": {
        "@type": "Organization",
        "name": "{{ resolution.complaintOrganism.name|e('js') }}"
    },
    {% endif %}
    {% if resolution.sourceUrl %}
    "distribution": {
        "@type": "DataDownload",
        "contentUrl": "{{ resolution.sourceUrl }}",
        "encodingFormat": "application/pdf"
    },
    {% endif %}
    "keywords": ["transparencia", "derecho de acceso", "información pública"{% if resolution.keywords %}{% for kw in resolution.keywords %}, "{{ kw|e('js') }}"{% endfor %}{% endif %}],
    "isPartOf": {
        "@type": "DataCatalog",
        "name": "Resoluciones de Transparencia",
        "url": "{{ url('app_resoluciones_index') }}"
    }
}
</script>

<script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
{% endblock %}
