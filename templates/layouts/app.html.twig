{% extends 'base.html.twig' %}

{% block body_class %}min-h-screen flex flex-col{% endblock %}

{% block body %}
{# Navigation #}
<nav class="glass border-b border-slate-200/50 sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
            {# Logo and main nav #}
            <div class="flex items-center">
                <a href="{{ path('app_dashboard') }}" class="flex items-center gap-2 text-primary-600 font-bold text-xl">
                    <i data-lucide="search" class="w-6 h-6"></i>
                    <span>PideInfo</span>
                </a>

                <div class="hidden md:flex items-center ml-10 space-x-1">
                    <a href="{{ path('app_dashboard') }}"
                       class="nav-link {{ app.request.attributes.get('_route') == 'app_dashboard' ? 'active' : '' }}">
                        <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                        <span>Panel principal</span>
                    </a>
                    <a href="{{ path('app_solicitudes_index') }}"
                       class="nav-link {{ 'solicitud' in app.request.attributes.get('_route')|default('') ? 'active' : '' }}">
                        <i data-lucide="folder-open" class="w-4 h-4"></i>
                        <span>Solicitudes</span>
                    </a>
                    <a href="{{ path('app_listas_index') }}"
                       class="nav-link {{ 'lista' in app.request.attributes.get('_route')|default('') ? 'active' : '' }}">
                        <i data-lucide="list" class="w-4 h-4"></i>
                        <span>Listas</span>
                    </a>
                    <a href="{{ path('app_guias_index') }}"
                       class="nav-link {{ 'guia' in app.request.attributes.get('_route')|default('') ? 'active' : '' }}">
                        <i data-lucide="book-open" class="w-4 h-4"></i>
                        <span>Guías</span>
                    </a>
                    <a href="{{ path('app_resoluciones_index') }}"
                       class="nav-link {{ 'resoluciones' in app.request.attributes.get('_route')|default('') ? 'active' : '' }}">
                        <i data-lucide="scale" class="w-4 h-4"></i>
                        <span>Resoluciones</span>
                    </a>
                </div>
            </div>

            {# User menu #}
            <div class="flex items-center gap-4">
                {# Notification bell #}
                {{ component('NotificationBell') }}

                {# User dropdown #}
                <div class="relative" x-data="{ open: false }">
                    <button @click="open = !open"
                            class="flex items-center gap-2 px-3 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors">
                        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center text-white font-medium text-sm">
                            {{ app.user.fullName|slice(0, 1)|upper }}
                        </div>
                        <span class="hidden sm:block text-sm font-medium">{{ app.user.fullName }}</span>
                        <i data-lucide="chevron-down" class="w-4 h-4"></i>
                    </button>

                    <div x-show="open"
                         @click.away="open = false"
                         x-transition:enter="transition ease-out duration-100"
                         x-transition:enter-start="transform opacity-0 scale-95"
                         x-transition:enter-end="transform opacity-100 scale-100"
                         x-transition:leave="transition ease-in duration-75"
                         x-transition:leave-start="transform opacity-100 scale-100"
                         x-transition:leave-end="transform opacity-0 scale-95"
                         class="absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-lg border border-slate-100 py-2 z-50"
                         style="display: none;">
                        <div class="px-4 py-2 border-b border-slate-100">
                            <p class="text-sm font-medium text-slate-900">{{ app.user.fullName }}</p>
                            <p class="text-xs text-slate-500">{{ app.user.email }}</p>
                        </div>
                        {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('admin') }}" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50">
                            <i data-lucide="settings" class="w-4 h-4"></i>
                            Administración
                        </a>
                        {% endif %}
                        <button type="button"
                                @click="open = false; $dispatch('open-agent-token-modal')"
                                class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 w-full text-left">
                            <i data-lucide="link" class="w-4 h-4"></i>
                            Conectar agente
                        </button>
                        <div class="border-t border-slate-100 my-1"></div>
                        <a href="{{ path('app_logout') }}" class="flex items-center gap-2 px-4 py-2 text-sm text-red-600 hover:bg-red-50">
                            <i data-lucide="log-out" class="w-4 h-4"></i>
                            Cerrar sesión
                        </a>
                    </div>
                </div>

                {# Mobile menu button #}
                <button class="md:hidden p-2 rounded-lg text-slate-600 hover:bg-slate-100"
                        x-data
                        @click="$dispatch('toggle-mobile-menu')">
                    <i data-lucide="menu" class="w-5 h-5"></i>
                </button>
            </div>
        </div>
    </div>

    {# Mobile menu #}
    <div class="md:hidden border-t border-slate-200"
         x-data="{ open: false }"
         @toggle-mobile-menu.window="open = !open"
         x-show="open"
         x-transition>
        <div class="px-4 py-3 space-y-1">
            <a href="{{ path('app_dashboard') }}"
               class="nav-link w-full {{ app.request.attributes.get('_route') == 'app_dashboard' ? 'active' : '' }}">
                <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                <span>Panel principal</span>
            </a>
            <a href="{{ path('app_solicitudes_index') }}"
               class="nav-link w-full {{ 'solicitud' in app.request.attributes.get('_route')|default('') ? 'active' : '' }}">
                <i data-lucide="folder-open" class="w-4 h-4"></i>
                <span>Solicitudes</span>
            </a>
            <a href="{{ path('app_listas_index') }}"
               class="nav-link w-full {{ 'lista' in app.request.attributes.get('_route')|default('') ? 'active' : '' }}">
                <i data-lucide="list" class="w-4 h-4"></i>
                <span>Listas</span>
            </a>
            <a href="{{ path('app_resoluciones_index') }}"
               class="nav-link w-full {{ 'resoluciones' in app.request.attributes.get('_route')|default('') ? 'active' : '' }}">
                <i data-lucide="scale" class="w-4 h-4"></i>
                <span>Resoluciones</span>
            </a>
        </div>
    </div>
</nav>

{# Flash messages #}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} animate-fade-in mb-4" role="alert">
                <i data-lucide="{{ label == 'success' ? 'check-circle' : (label == 'error' ? 'alert-circle' : (label == 'warning' ? 'alert-triangle' : 'info')) }}" class="w-5 h-5 flex-shrink-0"></i>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
    {% endfor %}
</div>

{# Main content #}
<main class="flex-1 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {% block content %}{% endblock %}
    </div>
</main>

{# Footer #}
<footer class="border-t border-slate-200/50 bg-white/50 py-6 mt-auto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="flex items-center gap-2 text-slate-500 text-sm">
                <i data-lucide="search" class="w-4 h-4 text-primary-500"></i>
                <span>PideInfo - Sistema de seguimiento de solicitudes de acceso a información pública</span>
            </div>
            <div class="flex items-center gap-4 text-slate-400 text-xs">
                <a href="{{ path('app_privacidad') }}" class="hover:text-primary-600 transition-colors">Política de privacidad</a>
            </div>
        </div>
    </div>
</footer>

{% include '_partials/agent_token_modal.html.twig' %}

{# Alpine.js for interactivity #}
<script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
{% endblock %}
