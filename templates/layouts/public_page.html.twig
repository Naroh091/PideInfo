{% extends 'base.html.twig' %}

{# Layout for app pages usable without an account (e.g. anonymous
   drafting at /redactar): same content container as layouts/app.html.twig
   but with the public nav instead of the authenticated navbar. #}

{% block body_class %}min-h-screen flex flex-col{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>[x-cloak] { display: none !important; }</style>
{% endblock %}

{% block body %}
{% include '_partials/public_nav.html.twig' %}

{# Flash messages (same markup as layouts/app.html.twig) #}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} animate-fade-in mb-4" role="alert">
                <span>{{ message }}</span>
            </div>
        {% endfor %}
    {% endfor %}
</div>

<main class="flex-1 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {% block content %}{% endblock %}
    </div>
</main>

{% include '_partials/public_footer.html.twig' %}

{# Alpine.js — same version and loading as layouts/app.html.twig #}
<script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
{% endblock %}
