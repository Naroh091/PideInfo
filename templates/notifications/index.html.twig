{% import 'components/_notification_macros.html.twig' as macros %}
{% extends 'layouts/app.html.twig' %}

{% block title %}Notificaciones - PideInfo{% endblock %}

{% block content %}
<div>
    {# Page Header #}
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
        <div>
            <h1 class="repo-title text-3xl text-slate-800">Notificaciones</h1>
            <p class="text-slate-500 mt-1">{{ total }} en total</p>
        </div>
        {% if total > 0 %}
            <form action="{{ path('app_notificaciones_read_all') }}" method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('read_all_notifications') }}">
                <button type="submit" class="btn btn-ghost btn-sm">
                    <i data-lucide="check-check" class="w-4 h-4 mr-1"></i>
                    Marcar todas como leídas
                </button>
            </form>
        {% endif %}
    </div>

    {# Filters as pills #}
    <div class="flex flex-wrap gap-1.5 mb-6">
        <a href="{{ path('app_notificaciones_index') }}"
           class="notif-filter {{ currentType is null ? 'notif-filter-active' : '' }}">
            Todas
        </a>
        {% for typeValue, typeLabel in types %}
            <a href="{{ path('app_notificaciones_index', {type: typeValue}) }}"
               class="notif-filter {{ currentType == typeValue ? 'notif-filter-active' : '' }}">
                {{ typeLabel }}
            </a>
        {% endfor %}
    </div>

    {# Notification list #}
    {% if notifications|length > 0 %}
        <div class="dash-section">
            <div class="dash-timeline">
                {% for notification in notifications %}
                    <a href="{{ path('app_notificaciones_read', {id: notification.id}) }}"
                       class="dash-timeline-item group {{ not notification.read ? 'dash-timeline-unread' : '' }}">
                        <div class="dash-timeline-dot {{ notification.alertLevel == 'warning' ? 'dash-dot-warn' : '' }}">
                            <i data-lucide="{{ notification.icon }}" class="w-3.5 h-3.5"></i>
                        </div>
                        <div class="flex-1 min-w-0 py-4">
                            {% if notification.accessRequest %}
                                <p class="text-xs font-medium text-primary-600 truncate mb-0.5">{{ notification.accessRequest.title }}</p>
                            {% endif %}
                            <p class="text-sm text-slate-700 leading-relaxed {{ not notification.read ? 'font-medium' : '' }}">
                                {{ notification.message }}
                            </p>
                            {{ macros.status_transition(notification) }}
                            <div class="flex items-center gap-2 mt-1.5">
                                <span class="text-xs text-slate-400">{{ notification.createdAt|date('d/m/Y H:i') }}</span>
                                <span class="text-xs px-1.5 py-0.5 rounded bg-slate-50 text-slate-400">{{ notification.typeLabel }}</span>
                            </div>
                        </div>
                        {% if not notification.read %}
                            <span class="w-2 h-2 rounded-full bg-primary-500 flex-shrink-0 mt-5"></span>
                        {% endif %}
                    </a>
                {% endfor %}
            </div>
        </div>

        {# Pagination #}
        {% if totalPages > 1 %}
            <div class="flex items-center justify-center gap-1 mt-6">
                {% if page > 1 %}
                    <a href="{{ path('app_notificaciones_index', {page: page - 1, type: currentType}) }}" class="btn btn-ghost btn-sm">
                        <i data-lucide="chevron-left" class="w-4 h-4"></i>
                    </a>
                {% endif %}

                {% for p in max(1, page - 2)..min(totalPages, page + 2) %}
                    <a href="{{ path('app_notificaciones_index', {page: p, type: currentType}) }}"
                       class="btn btn-sm {{ p == page ? 'btn-primary' : 'btn-ghost' }}">
                        {{ p }}
                    </a>
                {% endfor %}

                {% if page < totalPages %}
                    <a href="{{ path('app_notificaciones_index', {page: page + 1, type: currentType}) }}" class="btn btn-ghost btn-sm">
                        <i data-lucide="chevron-right" class="w-4 h-4"></i>
                    </a>
                {% endif %}
            </div>
        {% endif %}
    {% else %}
        <div class="dash-section">
            <div class="py-16 text-center">
                <i data-lucide="bell-off" class="w-12 h-12 mx-auto text-slate-200 mb-3"></i>
                <p class="text-sm font-medium text-slate-500">Sin notificaciones</p>
                <p class="text-xs text-slate-400 mt-1">
                    {% if currentType %}
                        No hay notificaciones de este tipo
                    {% else %}
                        Las acciones automáticas del agente aparecerán aquí
                    {% endif %}
                </p>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
