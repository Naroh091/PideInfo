{# Estilos comunes de los PDF generados (solicitud, reclamación, alegaciones).
   Se incluye DENTRO de un <style> — dompdf no comparte hojas externas.
   Tipografía según la maqueta de David: Playfair Display para títulos,
   Gelasio (métrica-compatible libre de Georgia) para el cuerpo.
   Paleta solo tinta: la única marca visible es el pie de página. #}
@font-face {
    font-family: 'Playfair Display';
    font-style: normal;
    font-weight: 400;
    src: url('file://{{ pdf_font_dir }}/PlayfairDisplay-Regular.ttf') format('truetype');
}
@font-face {
    font-family: 'Playfair Display';
    font-style: normal;
    font-weight: 700;
    src: url('file://{{ pdf_font_dir }}/PlayfairDisplay-Bold.ttf') format('truetype');
}
@font-face {
    font-family: 'Playfair Display';
    font-style: italic;
    font-weight: 400;
    src: url('file://{{ pdf_font_dir }}/PlayfairDisplay-Italic.ttf') format('truetype');
}
@font-face {
    font-family: 'Playfair Display';
    font-style: italic;
    font-weight: 700;
    src: url('file://{{ pdf_font_dir }}/PlayfairDisplay-BoldItalic.ttf') format('truetype');
}
@font-face {
    font-family: 'Gelasio';
    font-style: normal;
    font-weight: 400;
    src: url('file://{{ pdf_font_dir }}/Gelasio-Regular.ttf') format('truetype');
}
@font-face {
    font-family: 'Gelasio';
    font-style: normal;
    font-weight: 700;
    src: url('file://{{ pdf_font_dir }}/Gelasio-Bold.ttf') format('truetype');
}
@font-face {
    font-family: 'Gelasio';
    font-style: italic;
    font-weight: 400;
    src: url('file://{{ pdf_font_dir }}/Gelasio-Italic.ttf') format('truetype');
}
@font-face {
    font-family: 'Gelasio';
    font-style: italic;
    font-weight: 700;
    src: url('file://{{ pdf_font_dir }}/Gelasio-BoldItalic.ttf') format('truetype');
}
@font-face {
    font-family: 'DM Sans';
    font-style: normal;
    font-weight: 400;
    src: url('file://{{ pdf_font_dir }}/DMSans-Variable.ttf') format('truetype');
}

@page { margin: 0; }

html { margin: 0; padding: 0; }

body {
    margin: 0;
    padding: 2.4cm 2.6cm 3cm 2.6cm;
    font-family: 'Gelasio', Georgia, 'Times New Roman', serif;
    font-size: 10.5pt;
    line-height: 1.5;
    color: #0f172a;
}

/* Cabecera de documento según la maqueta: título centrado en Playfair
   bold italic, subtítulo («al amparo de la…») en Playfair italic. */
.doc-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 19pt;
    font-weight: 700;
    font-style: italic;
    line-height: 1;
    color: #0f172a;
    text-align: center;
    margin: 0 0 0.15em 0;
}

/* Título sin subtítulo debajo (reclamaciones): respira antes del cuerpo. */
.doc-heading--standalone {
    margin-bottom: 1.6em;
}

.doc-subheading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 11pt;
    font-weight: 400;
    font-style: italic;
    color: #0f172a;
    text-align: center;
    margin: 0 0 2.2em 0;
}

/* Líneas «A/A:» y «ASUNTO:» de la maqueta. */
.doc-addressee {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 12pt;
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 0.3em 0;
}

.content { text-align: justify; }

.content h1 {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: 13.5pt;
    line-height: 1.3;
    color: #0f172a;
    text-align: left;
    margin: 1.9em 0 0.65em 0;
    page-break-after: avoid;
}

.content h1:first-child { margin-top: 0; }

.content h2 {
    font-size: 11pt;
    font-weight: 700;
    color: #0f172a;
    text-align: left;
    margin: 1.4em 0 0.5em 0;
    page-break-after: avoid;
}

.content h3 {
    font-size: 10.5pt;
    font-weight: 700;
    color: #475569;
    text-align: left;
    margin: 1.1em 0 0.4em 0;
    page-break-after: avoid;
}

.content p {
    margin: 0 0 0.8em 0;
    orphans: 3;
    widows: 3;
}

.content ul, .content ol {
    margin: 0.25em 0 0.9em 0;
    padding-left: 1.4em;
}

.content li {
    margin-bottom: 0.3em;
    text-align: justify;
}

.content strong { font-weight: 700; }
.content em { font-style: italic; }

.content blockquote {
    border-left: 2pt solid #cbd5e1;
    margin: 1em 0;
    padding: 0.1em 0 0.1em 1em;
    color: #475569;
    font-style: italic;
}

/* Los enlaces suelen ser citas (BOE, resoluciones): tinta subrayada,
   que imprime igual de bien en blanco y negro. */
.content a {
    color: #0f172a;
    text-decoration: underline;
}

/* Marcador de cita en el cuerpo (¹, ²…) y bloque «Fuentes citadas». dompdf no
   ancla notas al pie a su página, así que el bloque cierra el flujo de conte-
   nido; en una solicitud de una página se lee como notas al pie. */
sup.fn-ref {
    font-size: 0.62em;
    vertical-align: super;
    line-height: 0;
    font-weight: 700;
    color: #0f172a;
}

.footnotes {
    margin-top: 1.8em;
    padding-top: 0.7em;
    border-top: 0.5pt solid #cbd5e1;
    page-break-inside: avoid;
}

.footnotes-title {
    font-family: 'DM Sans', sans-serif;
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #64748b;
    margin: 0 0 0.5em 0;
}

.footnote {
    font-size: 8.5pt;
    line-height: 1.4;
    color: #475569;
    margin: 0 0 0.3em 0;
    text-align: left;
}

.footnote sup {
    font-size: 0.7em;
    vertical-align: super;
    line-height: 0;
    font-weight: 700;
    color: #0f172a;
    margin-right: 0.15em;
}

.footnote a {
    color: #475569;
    text-decoration: underline;
    word-break: break-all;
}

/* Pie discreto: la única parte con marca de todo el documento. */
.footer {
    position: fixed;
    left: 2.6cm;
    right: 2.6cm;
    bottom: 1.1cm;
    font-family: 'DM Sans', sans-serif;
    font-size: 7.5pt;
    color: #94a3b8;
    text-align: center;
    line-height: 1.35;
}

.pagenum {
    position: fixed;
    right: 2.6cm;
    bottom: 1.1cm;
    font-family: 'DM Sans', sans-serif;
    font-size: 7.5pt;
    color: #94a3b8;
}

.pagenum:after { content: counter(page); }
