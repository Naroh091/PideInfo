{% extends 'layouts/app.html.twig' %}

{% block title %}{{ list ? 'Editar lista' : 'Nueva lista' }} - PideInfo{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .lista-form-card {
            position: relative;
            background: white;
            border: 1px solid rgb(226 232 240);
            border-radius: 6px;
            overflow: hidden;
            box-shadow:
                0 1px 2px rgba(15, 23, 42, .04),
                0 12px 32px -20px rgba(15, 23, 42, .12);
        }
        .lista-form-card::before {
            content: "";
            position: absolute;
            top: 0; bottom: 0; left: 0;
            width: 3px;
            background: linear-gradient(180deg, var(--color-accent-500) 0%, #075985 100%);
            z-index: 1;
        }
        .lista-form-strip {
            padding: .85rem 1.25rem .85rem 1.5rem;
            border-bottom: 1px solid rgb(226 232 240);
            background: #f8fafc;
            font-family: 'DM Sans', sans-serif;
            font-size: .82rem;
            font-weight: 500;
            color: rgb(148 163 184);
            display: inline-flex;
            align-items: center;
            gap: .55rem;
            width: 100%;
        }
        .lista-form-strip i { color: rgb(100 116 139); }
        .lista-form-body {
            padding: 1.5rem 1.5rem 1.4rem 1.75rem;
        }
        .lista-form-headline {
            font-family: 'DM Serif Display', Georgia, serif;
            font-weight: 400;
            font-size: clamp(1.5rem, 3vw, 1.85rem);
            line-height: 1.1;
            letter-spacing: -.005em;
            color: rgb(15 23 42);
            margin-bottom: .35rem;
        }
        .lista-form-sub {
            font-family: 'DM Sans', sans-serif;
            font-size: .92rem;
            color: rgb(100 116 139);
            margin-bottom: 1.5rem;
        }
        .lista-form-field-label {
            display: block;
            font-family: 'DM Sans', sans-serif;
            font-size: .85rem;
            font-weight: 500;
            color: rgb(51 65 85);
            margin-bottom: .4rem;
        }
        .lista-form-help {
            font-family: 'DM Sans', sans-serif;
            font-size: .78rem;
            color: rgb(148 163 184);
            margin-top: .4rem;
        }
        .lista-form-actions {
            border-top: 1px solid rgb(241 245 249);
            margin-top: 1.5rem;
            padding-top: 1.25rem;
            display: flex;
            justify-content: space-between;
            gap: .75rem;
            flex-wrap: wrap;
        }
    </style>
{% endblock %}

{% block content %}
{# Breadcrumb #}
<nav class="flex items-center gap-2 text-xs text-slate-500 mb-3" style="font-family:'Inter',sans-serif;letter-spacing:.04em;">
    <a href="{{ path('app_listas_index') }}" class="hover:text-slate-800 transition-colors">LISTAS</a>
    <span class="text-slate-300">/</span>
    {% if list %}
        <a href="{{ path('app_listas_show', {id: list.id}) }}" class="hover:text-slate-800 transition-colors truncate max-w-[14rem]">
            {{ list.name|u.truncate(30) }}
        </a>
        <span class="text-slate-300">/</span>
        <span class="text-slate-800 font-medium">EDITAR</span>
    {% else %}
        <span class="text-slate-800 font-medium">NUEVA LISTA</span>
    {% endif %}
</nav>

<div class="max-w-2xl">
    <div class="lista-form-card">
        <div class="lista-form-strip">
            <i data-lucide="{{ list ? 'pencil' : 'list-plus' }}" class="w-4 h-4"></i>
            {{ list ? 'Editar carpeta' : 'Nueva carpeta de organización' }}
        </div>
        <div class="lista-form-body">
            <h1 class="lista-form-headline">{{ list ? 'Editar lista' : 'Nueva lista' }}</h1>
            <p class="lista-form-sub">
                {{ list ? 'Modifica los datos de la lista.' : 'Crea una carpeta para agrupar solicitudes por tema, proyecto u organismo.' }}
            </p>

            {{ form_start(form, {'attr': {'class': 'space-y-5', 'onsubmit': "if(typeof gtag==='function'){gtag('event','" ~ (list ? 'edit_list' : 'create_list') ~ "')}"}}) }}
                <div>
                    <label for="{{ form.name.vars.id }}" class="lista-form-field-label">
                        {{ form_label(form.name) }}
                    </label>
                    {{ form_widget(form.name, {'attr': {'class': 'input'}}) }}
                    {{ form_errors(form.name) }}
                </div>

                <div>
                    <label for="{{ form.description.vars.id }}" class="lista-form-field-label">
                        {{ form_label(form.description) }}
                    </label>
                    {{ form_widget(form.description, {'attr': {'class': 'input min-h-[80px]'}}) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="grid md:grid-cols-2 gap-5">
                    <div>
                        <label for="{{ form.color.vars.id }}" class="lista-form-field-label">
                            {{ form_label(form.color) }}
                        </label>
                        {{ form_widget(form.color, {'attr': {'class': 'input'}}) }}
                        {{ form_errors(form.color) }}
                    </div>

                    {% if form.visibility is defined %}
                        <div>
                            <label for="{{ form.visibility.vars.id }}" class="lista-form-field-label">
                                {{ form_label(form.visibility) }}
                            </label>
                            {{ form_widget(form.visibility, {'attr': {'class': 'input'}}) }}
                            {{ form_errors(form.visibility) }}
                            <p class="lista-form-help">Las listas compartidas son visibles para todos los miembros de tu organización.</p>
                        </div>
                    {% endif %}
                </div>

                <div class="lista-form-actions">
                    <a href="{{ list ? path('app_listas_show', {id: list.id}) : path('app_listas_index') }}" class="btn btn-secondary">
                        <i data-lucide="arrow-left" class="w-4 h-4"></i>
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i data-lucide="check" class="w-4 h-4"></i>
                        {{ list ? 'Guardar cambios' : 'Crear lista' }}
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
