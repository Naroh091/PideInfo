{% extends 'layouts/app.html.twig' %}

{% block title %}{{ list.name }} - PideInfo{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* ── Lista detail ── */
        .lista-card-show {
            position: relative;
            background: white;
            border: 1px solid rgb(226 232 240);
            border-radius: 6px;
            overflow: hidden;
            box-shadow:
                0 1px 2px rgba(15, 23, 42, .04),
                0 12px 32px -20px rgba(15, 23, 42, .12);
            margin-bottom: 1.5rem;
        }
        .lista-card-show::before {
            content: "";
            position: absolute;
            top: 0; bottom: 0; left: 0;
            width: 3px;
            background: var(--lista-color, rgb(148 163 184));
            z-index: 1;
        }

        .lista-card-show-strip {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
            padding: .7rem 1.25rem .7rem 1.5rem;
            border-bottom: 1px solid rgb(226 232 240);
            background: #f8fafc;
        }
        .lista-card-show-strip-label {
            display: inline-flex;
            align-items: center;
            gap: .55rem;
            font-family: 'DM Sans', sans-serif;
            font-size: .82rem;
            font-weight: 500;
            color: rgb(148 163 184);
        }
        .lista-card-show-strip-label .icon {
            color: var(--lista-color, rgb(100 116 139));
        }
        .lista-card-show-strip-meta {
            font-family: 'DM Sans', sans-serif;
            font-size: .78rem;
            color: rgb(148 163 184);
            display: inline-flex;
            align-items: center;
            gap: .65rem;
        }
        .lista-card-show-strip-meta .visibility {
            display: inline-flex; align-items: center; gap: .3rem;
            font-weight: 500;
            color: rgb(71 85 105);
        }
        .lista-card-show-strip-meta .visibility .dot {
            width: 5px; height: 5px; border-radius: 50%;
            background: currentColor;
        }
        .lista-card-show-strip-meta .visibility.is-shared { color: var(--color-primary-700); }

        .lista-card-show-body {
            padding: 1.25rem 1.5rem 1.4rem 1.75rem;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1.5rem;
            flex-wrap: wrap;
        }
        .lista-card-show-name {
            font-family: 'DM Serif Display', Georgia, serif;
            font-weight: 400;
            font-size: clamp(1.6rem, 3vw, 2.1rem);
            line-height: 1.1;
            letter-spacing: -.01em;
            color: rgb(15 23 42);
            margin-bottom: .25rem;
        }
        .lista-card-show-desc {
            font-family: 'DM Sans', sans-serif;
            font-size: .95rem;
            color: rgb(71 85 105);
            line-height: 1.55;
            max-width: 42rem;
            margin-top: .5rem;
        }
        .lista-card-show-actions {
            display: flex;
            gap: .5rem;
            flex-shrink: 0;
        }

        /* ── Add request inline panel ── */
        .add-panel {
            position: relative;
            background: white;
            border: 1px solid rgb(226 232 240);
            border-radius: 6px;
            padding: .85rem 1rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: .75rem;
        }
        .add-panel-icon {
            color: var(--color-primary-600);
            flex-shrink: 0;
        }
        .add-panel-input {
            flex: 1;
            border: 0;
            outline: 0;
            background: transparent;
            font-family: 'DM Sans', sans-serif;
            font-size: .95rem;
            color: rgb(15 23 42);
        }
        .add-panel-input::placeholder { color: rgb(148 163 184); }
        .add-panel-results {
            position: absolute;
            top: calc(100% + .35rem);
            left: 0; right: 0;
            background: white;
            border: 1px solid rgb(226 232 240);
            border-radius: 6px;
            box-shadow: 0 12px 28px -10px rgba(15, 23, 42, .18);
            padding: .35rem;
            z-index: 30;
            max-height: 22rem;
            overflow-y: auto;
        }
        .add-panel-result {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .85rem;
            padding: .55rem .65rem;
            border-radius: 4px;
            transition: background .12s ease;
        }
        .add-panel-result:hover { background: rgb(248 250 252); }
        .add-panel-result-main { flex: 1; min-width: 0; }
        .add-panel-result-title {
            font-family: 'DM Sans', sans-serif;
            font-size: .9rem;
            color: rgb(15 23 42);
            font-weight: 500;
            line-height: 1.3;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .add-panel-result-meta {
            font-size: .75rem;
            color: rgb(148 163 184);
            margin-top: .15rem;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .add-panel-empty {
            padding: 1.25rem;
            text-align: center;
            font-size: .85rem;
            color: rgb(148 163 184);
        }
        .add-panel-success {
            margin-top: .65rem;
            padding: .5rem .75rem;
            background: rgb(236 253 245);
            border: 1px solid #a7f3d0;
            color: #047857;
            border-radius: 4px;
            font-size: .85rem;
            display: inline-flex;
            align-items: center;
            gap: .4rem;
        }

        /* ── Items list ── */
        .lista-items {
            background: white;
            border: 1px solid rgb(226 232 240);
            border-radius: 6px;
            overflow: hidden;
        }
        .lista-item {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 1rem;
            align-items: center;
            padding: .85rem 1.25rem;
            border-bottom: 1px solid rgb(241 245 249);
            transition: background .12s ease;
        }
        .lista-item:last-child { border-bottom: none; }
        .lista-item:hover { background: rgb(248 250 252); }
        .lista-item:hover .lista-item-remove { opacity: 1; }
        .lista-item-main { min-width: 0; }
        .lista-item-title {
            font-family: 'DM Sans', sans-serif;
            font-size: .95rem;
            font-weight: 500;
            color: rgb(15 23 42);
            text-decoration: none;
            line-height: 1.3;
            display: block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            transition: color .12s ease;
        }
        .lista-item-title:hover { color: var(--color-primary-700); }
        .lista-item-meta {
            margin-top: .25rem;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: .55rem;
            font-family: 'DM Sans', sans-serif;
            font-size: .78rem;
            color: rgb(100 116 139);
        }
        .lista-item-meta .organism {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            max-width: 24rem;
        }
        .lista-item-meta .ext-id {
            font-family: 'JetBrains Mono', monospace;
            font-size: .72rem;
            color: var(--color-primary-700);
        }
        .lista-item-meta .sep { color: rgb(203 213 225); }
        .lista-item-meta .status {
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            font-size: .72rem;
            padding: .05rem .5rem;
            border-radius: 999px;
            background: rgb(241 245 249);
            color: rgb(71 85 105);
            font-weight: 500;
        }
        .lista-item-meta .status .pulse {
            width: 5px; height: 5px; border-radius: 50%;
            background: currentColor;
        }
        .lista-item-meta .status.is-emerald { background: rgb(236 253 245); color: #047857; }
        .lista-item-meta .status.is-red     { background: rgb(254 242 242); color: rgb(185 28 28); }
        .lista-item-meta .status.is-amber   { background: var(--color-accent-50); color: var(--color-accent-700); }
        .lista-item-meta .status.is-sky     { background: var(--color-primary-50); color: var(--color-primary-700); }
        .lista-item-remove {
            display: inline-flex; align-items: center; justify-content: center;
            width: 28px; height: 28px;
            border-radius: 4px;
            background: transparent;
            border: 0;
            color: rgb(148 163 184);
            cursor: pointer;
            opacity: .35;
            transition: opacity .12s ease, background .12s ease, color .12s ease;
        }
        .lista-item-remove:hover {
            background: rgb(254 242 242);
            color: rgb(185 28 28);
        }

        /* ── Empty state ── */
        .lista-empty {
            background: white;
            border: 1px dashed rgb(203 213 225);
            border-radius: 6px;
            padding: 3rem 1.5rem;
            text-align: center;
        }
        .lista-empty-title {
            font-family: 'DM Serif Display', Georgia, serif;
            font-style: italic;
            font-size: 1.4rem;
            color: rgb(30 41 59);
            margin-bottom: .35rem;
        }
        .lista-empty-sub {
            font-family: 'DM Sans', sans-serif;
            font-size: .92rem;
            color: rgb(100 116 139);
            max-width: 28rem;
            margin: 0 auto 1.5rem;
        }

        .lista-footer-link {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            margin-top: 1rem;
            font-family: 'DM Sans', sans-serif;
            font-size: .85rem;
            color: rgb(100 116 139);
            transition: color .12s ease;
        }
        .lista-footer-link:hover { color: var(--color-primary-700); }
    </style>
{% endblock %}

{% block content %}
{# Breadcrumb #}
<nav class="flex items-center gap-2 text-xs text-slate-500 mb-3" style="font-family:'Inter',sans-serif;letter-spacing:.04em;">
    <a href="{{ path('app_listas_index') }}" class="hover:text-slate-800 transition-colors">LISTAS</a>
    <span class="text-slate-300">/</span>
    <span class="text-slate-800 font-medium truncate max-w-[14rem]">{{ list.name|u.truncate(30) }}</span>
</nav>

{# List header card #}
{% set listColor = list.color ?: '#94a3b8' %}
<section class="lista-card-show" style="--lista-color: {{ listColor }}">
    <header class="lista-card-show-strip">
        <div class="lista-card-show-strip-label">
            <span class="icon">
                <i data-lucide="{{ list.icon ?: 'list' }}" class="w-4 h-4"></i>
            </span>
            Carpeta de organización
        </div>
        <div class="lista-card-show-strip-meta">
            <span>{{ list.itemCount }} solicitud{{ list.itemCount != 1 ? 'es' : '' }}</span>
            <span class="text-slate-300">·</span>
            <span class="visibility {{ list.visibility == 'shared' ? 'is-shared' : '' }}">
                <span class="dot"></span>
                {{ list.visibilityLabel|lower }}
            </span>
        </div>
    </header>
    <div class="lista-card-show-body">
        <div class="min-w-0">
            <h1 class="lista-card-show-name">{{ list.name }}</h1>
            {% if list.description %}
                <p class="lista-card-show-desc">{{ list.description }}</p>
            {% endif %}
        </div>
        {% if is_granted('edit', list) %}
            <div class="lista-card-show-actions">
                <a href="{{ path('app_listas_edit', {id: list.id}) }}" class="btn btn-secondary btn-sm">
                    <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                    Editar
                </a>
                <form action="{{ path('app_listas_delete', {id: list.id}) }}"
                      method="post"
                      class="inline"
                      onsubmit="return confirm('¿Eliminar esta lista? Las solicitudes no se eliminarán.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-list-' ~ list.id) }}">
                    <button type="submit" class="btn btn-danger btn-sm">
                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                        Eliminar
                    </button>
                </form>
            </div>
        {% endif %}
    </div>
</section>

{% if is_granted('edit', list) %}
{# Add request to list — slim inline bar #}
<div class="add-panel" x-data="addRequestToList()">
    <i data-lucide="search" class="w-4 h-4 add-panel-icon"></i>
    <input type="text"
           x-model="query"
           @input.debounce.300ms="search()"
           @focus="if (results.length) showResults = true"
           class="add-panel-input"
           placeholder="Añadir solicitudes a esta lista — busca por título u organismo">

    <div x-show="showResults && results.length > 0"
         @click.away="showResults = false"
         x-transition
         class="add-panel-results"
         style="display: none;">
        <template x-for="req in results" :key="req.id">
            <div class="add-panel-result">
                <div class="add-panel-result-main">
                    <p class="add-panel-result-title" x-text="req.title"></p>
                    <p class="add-panel-result-meta">
                        <span x-text="req.publicBody.name"></span>
                        <span class="text-slate-300"> · </span>
                        <span x-text="req.statusLabel"></span>
                    </p>
                </div>
                <button @click="addToList(req)"
                        class="btn btn-primary btn-sm flex-shrink-0"
                        :disabled="adding === req.id">
                    <template x-if="adding !== req.id">
                        <span class="flex items-center gap-1">
                            <i data-lucide="plus" class="w-3 h-3"></i>
                            Añadir
                        </span>
                    </template>
                    <template x-if="adding === req.id">
                        <i data-lucide="loader-2" class="w-3 h-3 animate-spin"></i>
                    </template>
                </button>
            </div>
        </template>
    </div>

    <div x-show="showResults && results.length === 0 && query.length >= 2 && !searching"
         @click.away="showResults = false"
         class="add-panel-results add-panel-empty"
         style="display: none;">
        Sin resultados para «<span x-text="query"></span>»
    </div>

    <template x-if="successMessage">
        <div class="add-panel-success" x-transition>
            <i data-lucide="check-circle" class="w-3.5 h-3.5"></i>
            <span x-text="successMessage"></span>
        </div>
    </template>
</div>
{% endif %}

{# List items #}
{% if list.items|length > 0 %}
    {% set statusTone = {
        'granted': 'is-emerald', 'granted_completed': 'is-emerald',
        'denied': 'is-red',
        'delayed': 'is-amber',
        'processing': 'is-sky', 'sent': 'is-sky',
        'pending': ''
    } %}
    <div class="lista-items">
        {% for item in list.items %}
            {% set ar = item.accessRequest %}
            <div class="lista-item" data-request-id="{{ ar.id }}">
                <div class="lista-item-main">
                    <a href="{{ path('app_solicitudes_show', {id: ar.id}) }}" class="lista-item-title">{{ ar.title }}</a>
                    <div class="lista-item-meta">
                        <span class="organism" title="{{ ar.publicBody.name }}">{{ ar.publicBody.name }}</span>
                        {% if ar.externalId %}
                            <span class="sep">·</span>
                            <span class="ext-id">#{{ ar.externalId }}</span>
                        {% endif %}
                        <span class="sep">·</span>
                        <span class="status {{ statusTone[ar.status] ?? '' }}">
                            <span class="pulse"></span>
                            {{ ar.statusLabel }}
                        </span>
                    </div>
                </div>
                {% if is_granted('edit', list) %}
                    <button type="button"
                            class="lista-item-remove"
                            title="Quitar de la lista"
                            onclick="removeFromList('{{ ar.id }}', this)">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                {% endif %}
            </div>
        {% endfor %}
    </div>

    <a href="{{ path('app_solicitudes_index', {list: list.id}) }}" class="lista-footer-link">
        <i data-lucide="filter" class="w-3.5 h-3.5"></i>
        Ver en solicitudes con filtros
    </a>
{% else %}
    <div class="lista-empty">
        <h2 class="lista-empty-title">Carpeta vacía</h2>
        <p class="lista-empty-sub">
            Añade solicitudes a esta carpeta desde la búsqueda de arriba o desde la página de detalle de cada solicitud.
        </p>
        <a href="{{ path('app_solicitudes_index') }}" class="btn btn-secondary btn-sm">
            <i data-lucide="folder-open" class="w-3.5 h-3.5"></i>
            Ir a solicitudes
        </a>
    </div>
{% endif %}

{% if is_granted('edit', list) %}
<script>
function addRequestToList() {
    return {
        query: '',
        results: [],
        showResults: false,
        searching: false,
        adding: null,
        successMessage: '',

        async search() {
            if (this.query.length < 2) {
                this.results = [];
                this.showResults = false;
                return;
            }
            this.searching = true;
            try {
                const resp = await fetch('/solicitudes/buscar?q=' + encodeURIComponent(this.query), {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (resp.ok) {
                    const data = await resp.json();
                    const existingIds = new Set(
                        [...document.querySelectorAll('[data-request-id]')].map(el => el.dataset.requestId)
                    );
                    this.results = data.requests.filter(r => !existingIds.has(r.id));
                    this.showResults = true;
                    this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
                }
            } catch (e) {
                console.error('Error searching:', e);
            } finally {
                this.searching = false;
            }
        },

        async addToList(req) {
            this.adding = req.id;
            try {
                const resp = await fetch('{{ path('app_listas_add_request', {id: list.id}) }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({
                        requestId: req.id,
                        _token: '{{ csrf_token('list-manage-' ~ list.id) }}'
                    })
                });

                if (resp.ok) {
                    this.results = this.results.filter(r => r.id !== req.id);
                    this.successMessage = '«' + req.title + '» añadida a la lista';
                    setTimeout(() => { this.successMessage = ''; }, 3000);
                    setTimeout(() => { window.location.reload(); }, 1000);
                } else {
                    const data = await resp.json();
                    alert(data.error || 'Error al añadir la solicitud');
                }
            } catch (e) {
                alert('Error de conexión');
            } finally {
                this.adding = null;
            }
        }
    };
}

async function removeFromList(requestId, btn) {
    if (!confirm('¿Quitar esta solicitud de la lista?')) return;

    btn.disabled = true;
    try {
        const resp = await fetch('{{ path('app_listas_remove_request', {id: list.id}) }}', {
            method: 'POST',
            headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
            body: JSON.stringify({
                requestId: requestId,
                _token: '{{ csrf_token('list-manage-' ~ list.id) }}'
            })
        });
        if (resp.ok) {
            btn.closest('.lista-item').remove();
        } else {
            const data = await resp.json();
            alert(data.error || 'Error al quitar la solicitud');
            btn.disabled = false;
        }
    } catch (e) {
        alert('Error de conexión');
        btn.disabled = false;
    }
}
</script>
{% endif %}
{% endblock %}
