{% extends 'layouts/app.html.twig' %}

{% block title %}Listas - PideInfo{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* ── Listas index ── */
        .listas-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 2rem;
            padding-bottom: 1.25rem;
            border-bottom: 1px solid rgb(226 232 240);
        }
        .listas-eyebrow {
            font-family: 'DM Sans', sans-serif;
            font-size: .82rem;
            font-weight: 600;
            color: var(--color-primary-700);
            margin-bottom: .35rem;
        }
        .listas-title {
            font-family: 'DM Serif Display', Georgia, serif;
            font-weight: 400;
            font-size: clamp(1.75rem, 3.5vw, 2.4rem);
            line-height: 1.05;
            letter-spacing: -.015em;
            color: rgb(15 23 42);
        }
        .listas-sub {
            font-family: 'DM Sans', sans-serif;
            font-size: .92rem;
            color: rgb(100 116 139);
            margin-top: .35rem;
        }

        /* ── Carpeta cards ── */
        .listas-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
            gap: 1rem;
        }
        .lista-card {
            position: relative;
            background: white;
            border: 1px solid rgb(226 232 240);
            border-radius: 6px;
            overflow: hidden;
            transition: transform .15s ease, box-shadow .2s ease, border-color .15s ease;
            display: block;
            text-decoration: none;
            box-shadow:
                0 1px 2px rgba(15, 23, 42, .03);
        }
        .lista-card::before {
            content: "";
            position: absolute;
            top: 0; bottom: 0; left: 0;
            width: 3px;
            background: var(--lista-color, rgb(148 163 184));
            transition: width .15s ease;
            z-index: 1;
        }
        .lista-card:hover {
            transform: translateY(-2px);
            border-color: rgb(203 213 225);
            box-shadow:
                0 1px 2px rgba(15, 23, 42, .04),
                0 12px 28px -16px rgba(15, 23, 42, .15);
        }
        .lista-card:hover::before { width: 5px; }

        .lista-card-strip {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: .55rem 1rem .5rem 1.25rem;
            border-bottom: 1px solid rgb(241 245 249);
            background: #fafbfc;
        }
        .lista-card-strip .icon-wrap {
            display: inline-flex; align-items: center; justify-content: center;
            width: 22px; height: 22px;
            color: var(--lista-color, rgb(100 116 139));
        }
        .lista-card-visibility {
            font-family: 'DM Sans', sans-serif;
            font-size: .72rem;
            font-weight: 500;
            color: rgb(148 163 184);
            display: inline-flex; align-items: center; gap: .3rem;
        }
        .lista-card-visibility.is-shared { color: var(--color-primary-700); }
        .lista-card-visibility .dot {
            width: 5px; height: 5px; border-radius: 50%;
            background: currentColor;
        }

        .lista-card-body {
            padding: 1rem 1.25rem 1.1rem;
        }
        .lista-card-name {
            font-family: 'DM Serif Display', Georgia, serif;
            font-style: italic;
            font-size: 1.25rem;
            font-weight: 400;
            line-height: 1.2;
            letter-spacing: -.005em;
            color: rgb(15 23 42);
            transition: color .12s ease;
        }
        .lista-card:hover .lista-card-name { color: var(--color-primary-800); }
        .lista-card-desc {
            font-family: 'DM Sans', sans-serif;
            font-size: .85rem;
            color: rgb(100 116 139);
            margin-top: .35rem;
            line-height: 1.45;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .lista-card-meta {
            margin-top: .85rem;
            padding-top: .65rem;
            border-top: 1px dashed rgb(241 245 249);
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-family: 'DM Sans', sans-serif;
            font-size: .75rem;
            color: rgb(148 163 184);
        }
        .lista-card-meta .count {
            font-feature-settings: "tnum";
            color: rgb(71 85 105);
            font-weight: 500;
        }
        .lista-card-meta .arrow {
            color: rgb(148 163 184);
            transition: transform .15s ease, color .12s ease;
        }
        .lista-card:hover .arrow {
            color: var(--color-primary-600);
            transform: translateX(3px);
        }

        /* ── Empty state ── */
        .listas-empty {
            position: relative;
            background: white;
            border: 1px dashed rgb(203 213 225);
            border-radius: 6px;
            padding: 3rem 1.5rem;
            text-align: center;
            background-image:
                radial-gradient(ellipse at top, rgba(14, 165, 233, .03), transparent 60%);
        }
        .listas-empty-icon {
            display: inline-flex; align-items: center; justify-content: center;
            width: 56px; height: 56px;
            border-radius: 999px;
            background: var(--color-primary-50);
            color: var(--color-primary-600);
            margin-bottom: 1rem;
        }
        .listas-empty-title {
            font-family: 'DM Serif Display', Georgia, serif;
            font-style: italic;
            font-size: 1.5rem;
            color: rgb(30 41 59);
            margin-bottom: .35rem;
        }
        .listas-empty-sub {
            font-family: 'DM Sans', sans-serif;
            font-size: .92rem;
            color: rgb(100 116 139);
            max-width: 28rem;
            margin: 0 auto 1.5rem;
            line-height: 1.55;
        }
    </style>
{% endblock %}

{% block content %}
<header class="listas-header">
    <div class="min-w-0">
        <h1 class="listas-title">Mis listas</h1>
        <p class="listas-sub">
            {% if lists|length > 0 %}
                {{ lists|length }} carpeta{{ lists|length != 1 ? 's' : '' }} para agrupar solicitudes por tema, proyecto u organismo.
            {% else %}
                Agrupa solicitudes por tema, proyecto u organismo.
            {% endif %}
        </p>
    </div>
    <a href="{{ path('app_listas_new') }}" class="btn btn-primary">
        <i data-lucide="plus" class="w-4 h-4"></i>
        Nueva lista
    </a>
</header>

{% if lists|length > 0 %}
    <div class="listas-grid">
        {% for list in lists %}
            <a href="{{ path('app_listas_show', {id: list.id}) }}"
               class="lista-card"
               style="--lista-color: {{ list.color ?: '#94a3b8' }}">
                <div class="lista-card-strip">
                    <span class="icon-wrap">
                        <i data-lucide="{{ list.icon ?: 'list' }}" class="w-[18px] h-[18px]"></i>
                    </span>
                    <span class="lista-card-visibility {{ list.visibility == 'shared' ? 'is-shared' : '' }}">
                        <span class="dot"></span>
                        {{ list.visibilityLabel|lower }}
                    </span>
                </div>
                <div class="lista-card-body">
                    <h3 class="lista-card-name">{{ list.name }}</h3>
                    {% if list.description %}
                        <p class="lista-card-desc">{{ list.description }}</p>
                    {% endif %}
                    <div class="lista-card-meta">
                        <span class="count">
                            {{ list.itemCount }} solicitud{{ list.itemCount != 1 ? 'es' : '' }}
                        </span>
                        <i data-lucide="arrow-right" class="w-4 h-4 arrow"></i>
                    </div>
                </div>
            </a>
        {% endfor %}
    </div>
{% else %}
    <div class="listas-empty">
        <div class="listas-empty-icon">
            <i data-lucide="folder-plus" class="w-7 h-7"></i>
        </div>
        <h2 class="listas-empty-title">Aún no hay carpetas</h2>
        <p class="listas-empty-sub">
            Crea listas para organizar tus solicitudes por tema, proyecto u organismo y encuéntralas más rápido cuando las necesites.
        </p>
        <a href="{{ path('app_listas_new') }}" class="btn btn-primary">
            <i data-lucide="plus" class="w-4 h-4"></i>
            Crear primera lista
        </a>
    </div>
{% endif %}
{% endblock %}
