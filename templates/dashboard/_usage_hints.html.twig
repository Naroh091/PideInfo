{# Dismissable "Novedades" block: pending UsageHints for the current user.
   Each hint can be closed individually; the dismissal is persisted on the
   user (User.dismissedHints) via POST app_usage_hint_dismiss. #}
{% if usageHints|length > 0 %}
<div id="usage-hints-block" class="mb-6">
    <div class="card border-primary-200 bg-gradient-to-br from-primary-50 via-white to-white shadow-sm">
        <div class="card-body">
            <div class="flex items-center gap-2 mb-4">
                <div class="w-8 h-8 rounded-lg bg-primary-100 flex items-center justify-center flex-shrink-0">
                    <i data-lucide="sparkles" class="w-4 h-4 text-primary-600"></i>
                </div>
                <h2 class="text-base font-bold text-slate-800">Novedades</h2>
            </div>

            <div class="space-y-4">
                {% for hint in usageHints %}
                    <div class="usage-hint flex items-start justify-between gap-4 {{ not loop.last ? 'pb-4 border-b border-slate-100' : '' }}"
                         data-hint-id="{{ hint.id }}">
                        <div class="min-w-0">
                            <p class="font-semibold text-slate-800 text-sm">{{ hint.title }}</p>
                            <div class="text-sm text-slate-600 mt-1 leading-relaxed [&_p]:m-0 [&_strong]:text-slate-700">
                                {{ hint.content|markdown_to_html }}
                            </div>
                            {% if hint.linkUrl %}
                                <a href="{{ hint.linkUrl }}"
                                   class="inline-flex items-center gap-1 mt-2 text-sm text-primary-600 font-medium hover:underline">
                                    {{ hint.linkLabel ?: 'Saber más' }}
                                    <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                                </a>
                            {% endif %}
                        </div>
                        <button type="button"
                                class="usage-hint-dismiss btn btn-ghost btn-sm flex-shrink-0 text-slate-400 hover:text-slate-600 cursor-pointer"
                                title="No volver a mostrar"
                                data-dismiss-url="{{ path('app_usage_hint_dismiss', {id: hint.id}) }}">
                            <i data-lucide="x" class="w-4 h-4"></i>
                        </button>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const block = document.getElementById('usage-hints-block');
        if (!block) return;

        block.querySelectorAll('.usage-hint-dismiss').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                btn.disabled = true;
                try {
                    const resp = await fetch(btn.dataset.dismissUrl, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    if (!resp.ok) throw new Error('dismiss failed');

                    const hint = btn.closest('.usage-hint');
                    hint.remove();

                    // Hide the whole block when the last hint is dismissed,
                    // and tidy the divider of the (new) last hint.
                    const remaining = block.querySelectorAll('.usage-hint');
                    if (remaining.length === 0) {
                        block.remove();
                    } else {
                        const last = remaining[remaining.length - 1];
                        last.classList.remove('pb-4', 'border-b', 'border-slate-100');
                    }
                } catch (e) {
                    btn.disabled = false;
                }
            });
        });
    });
</script>
{% endif %}
