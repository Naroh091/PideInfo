{% extends 'layouts/app.html.twig' %}

{% block title %}Inicio - PideInfo{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* ── Hero: lo que no cubren las clases panel-* de app.css ── */
        .hero-band {
            position: relative;
            margin-bottom: .25rem;
        }
        .hero-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }
        .org-pill {
            display: inline-flex; align-items: center; gap: .35rem;
            padding: .1rem .55rem;
            border-radius: 999px;
            background: rgb(224 242 254);
            color: rgb(2 132 199);
            font-weight: 600;
            font-size: .72rem;
            font-family: 'Inter', sans-serif;
            letter-spacing: .02em;
            vertical-align: 1px;
        }

        /* ── Body grid ── */
        .home-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            gap: 1.25rem;
            align-items: start;
        }
        @media (min-width: 1024px) {
            .home-grid {
                grid-template-columns: minmax(0, 1fr) 22rem;
                gap: 1.75rem;
            }
        }
        .home-main { display: flex; flex-direction: column; gap: 1.25rem; min-width: 0; }
        .home-side { display: flex; flex-direction: column; gap: 1rem; }

        /* ── Side card: dropzone + email virtual ── */
        .side-card {
            background: white;
            border: 1px solid rgb(226 232 240);
            border-radius: 1rem;
            overflow: hidden;
        }
        .side-card-head {
            padding: .85rem 1.1rem;
            border-bottom: 1px solid rgb(241 245 249);
            background: rgb(248 250 252);
            display: flex; align-items: center; justify-content: space-between;
        }
        .side-card-eyebrow {
            font-family: 'DM Sans', sans-serif;
            font-size: .82rem;
            font-weight: 600;
            color: rgb(100 116 139);
            display: inline-flex; align-items: center; gap: .4rem;
        }
        .side-card-body { padding: 1rem 1.1rem 1.1rem; }

        .virtual-email {
            display: flex; align-items: center; gap: .5rem;
            padding: .55rem .65rem;
            background: rgb(248 250 252);
            border: 1px solid rgb(226 232 240);
            border-radius: .55rem;
        }
        .virtual-email code {
            flex: 1;
            min-width: 0;
            font-family: 'JetBrains Mono', 'SF Mono', monospace;
            font-size: .72rem;
            color: rgb(15 23 42);
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        }

        /* ── Collapsible body pattern (used by Agenda / Actividad / Recientes) ── */
        .collapsible-body {
            position: relative;
            max-height: 22rem;
            overflow: hidden;
            transition: max-height .35s cubic-bezier(.25,.8,.25,1);
        }
        .collapsible-body.is-expanded {
            max-height: 200rem; /* generous ceiling so transition still animates */
        }
        .collapsible-fade {
            position: absolute;
            left: 0; right: 0; bottom: 0;
            height: 4rem;
            pointer-events: none;
            background: linear-gradient(180deg, transparent 0%, white 90%);
        }
        .collapsible-toggle {
            display: inline-flex; align-items: center; justify-content: center;
            gap: .35rem;
            width: 100%;
            padding: .65rem 1rem;
            border-top: 1px solid rgb(241 245 249);
            background: rgb(248 250 252);
            font-family: 'Inter', sans-serif;
            font-size: .72rem;
            font-weight: 600;
            letter-spacing: .04em;
            color: rgb(71 85 105);
            cursor: pointer;
            transition: background .12s ease, color .12s ease;
        }
        .collapsible-toggle:hover {
            background: rgb(241 245 249);
            color: rgb(2 132 199);
        }
        .collapsible-chev {
            transition: transform .2s ease;
        }
        .collapsible-chev.is-up {
            transform: rotate(180deg);
        }
    </style>
{% endblock %}

{% block content %}

<div>
    {# Toast container for live alerts (kept for the file uploader controller) #}
    <div id="global-alerts-container" class="space-y-3 empty:hidden mb-4"></div>

    {# Pending portal/CTBG/DEHU notifications (banners) #}
    {{ component('PendingNotifications') }}

    {# Onboarding banner for new users #}
    {% include 'dashboard/_onboarding_banner.html.twig' %}

    {# ─────────────────── HERO ─────────────────── #}
    {% set h = 'now'|date('H')|number_format(0) %}
    {% set salutation = h < 6 ? 'Buenas noches' : (h < 13 ? 'Buenos días' : (h < 21 ? 'Buenas tardes' : 'Buenas noches')) %}
    {% set firstName = app.user.firstName|default(app.user.email|split('@')[0]) %}
    {% set spanishDays = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'] %}
    {% set spanishMonths = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'] %}
    {% set today = 'now'|date('U')|number_format(0) %}
    {% set dayName = spanishDays[('now'|date('w'))] %}
    {% set monthName = spanishMonths[('now'|date('n')) - 1] %}

    <header class="hero-band">
        <p class="panel-eyebrow"><span>{{ dayName }}, {{ 'now'|date('j') }} de {{ monthName }} de {{ 'now'|date('Y') }}</span></p>
        <div class="hero-row">
            <h1 class="panel-saludo">
                {{ salutation }}, <em>{{ firstName }}</em>.
            </h1>
            <a href="{{ path('app_solicitudes_new') }}" class="btn btn-primary panel-cta">
                <i data-lucide="pen-line" class="w-4 h-4"></i>
                Nueva solicitud
            </a>
        </div>

        {# Contadores: datos en línea de base, sin tarjetas #}
        {% if totalRequests > 0 %}
            <div class="panel-franja">
                <span class="panel-dato"><b>{{ activeCount }}</b><span>en curso</span></span>
                <span class="panel-dato"><b>{{ resolvedCount }}</b><span>resueltas</span></span>
                {% if app.user.organization %}
                    <span class="panel-dato">
                        <span class="org-pill">
                            <i data-lucide="building-2" class="w-3 h-3"></i>
                            {{ app.user.organization.name }}
                        </span>
                    </span>
                {% endif %}
            </div>
        {% endif %}
    </header>

    <hr class="panel-sep">

    {# Novedades (dismissable usage hints) #}
    {% include 'dashboard/_usage_hints.html.twig' %}

    {# ─────────────────── BODY ─────────────────── #}
    <div class="home-grid">

        {# ── Main column: resumen + agenda + actividad + recientes ── #}
        <div class="home-main">
            {# 0. Resumen IA — últimas 24 h: lede narrativo + «Necesita tu
               acción», dentro del LiveComponent para que el poll/Mercure lo
               refresque de una pieza. En la columna principal a propósito:
               la sidebar (bandeja, estados, email) arranca a su altura. #}
            {{ component('ActivitySummary') }}

            {# 1. Plazos (lo más urgente) #}
            {{ component('DeadlineAlerts') }}

            {# 2. Actividad reciente #}
            {{ component('RecentNotifications') }}

            {# 3. Solicitudes recientes #}
            {{ component('RecentRequests') }}
        </div>

        {# ── Side column: bandeja de entrada (dropzone + email virtual) ── #}
        <aside class="home-side">
            <div class="side-card" id="bandeja"
                 data-controller="file-uploader"
                 data-file-uploader-url-value="{{ path('app_document_upload') }}">
                <div class="side-card-head">
                    <span class="side-card-eyebrow">
                        <i data-lucide="inbox" class="w-3.5 h-3.5"></i>
                        Bandeja de entrada
                    </span>
                </div>
                <div class="side-card-body">
                    <div data-file-uploader-target="status" class="mb-3"></div>

                    {# Dropzone #}
                    <div class="dropzone-area py-7"
                         data-file-uploader-target="dropzone"
                         data-action="dragover->file-uploader#dragOver dragenter->file-uploader#dragOver dragleave->file-uploader#dragLeave drop->file-uploader#drop click->file-uploader#clickToUpload">
                        <div class="flex flex-col items-center">
                            <div class="w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center mb-3">
                                <i data-lucide="upload-cloud" class="w-6 h-6 text-primary-500"></i>
                            </div>
                            <p class="text-slate-700 font-medium text-sm mb-1">Arrastra documentos</p>
                            <p class="text-slate-500 text-xs mb-3">PDF, Word, imágenes</p>
                            <span class="btn btn-outline btn-sm">
                                <i data-lucide="folder-open" class="w-4 h-4 mr-1"></i>
                                Seleccionar
                            </span>
                            <input type="file"
                                   class="hidden"
                                   multiple
                                   accept=".pdf,.doc,.docx,.txt,.jpg,.jpeg,.png,.gif"
                                   data-file-uploader-target="input"
                                   data-action="change->file-uploader#selectFiles">
                        </div>
                    </div>

                    <div data-file-uploader-target="preview" class="mt-3 space-y-2"></div>

                    <p class="mt-3 text-xs text-slate-500 leading-relaxed">
                        <i data-lucide="sparkles" class="w-3 h-3 inline text-primary-500 mr-1"></i>
                        Se analizan con IA y se asocian automáticamente a la solicitud correspondiente.
                    </p>
                </div>

                {# Modals (necesarios para el file-uploader controller) #}
                {% include 'dashboard/_uploader_modals.html.twig' ignore missing %}

                {# Inline modals (kept here because file-uploader controller binds to them) #}
                <div id="relatedDocsModal"
                     class="modal-backdrop hidden"
                     data-file-uploader-target="modal">
                    <div class="modal-content max-w-md">
                        <div class="modal-header">
                            <h3 class="text-lg font-semibold text-slate-800">Documentos relacionados</h3>
                        </div>
                        <div class="modal-body">
                            <p class="text-slate-600 mb-4">Has subido varios documentos. Selecciona como quieres procesarlos:</p>
                            <div class="space-y-3">
                                <button type="button"
                                        class="w-full p-4 rounded-xl border-2 border-slate-200 hover:border-primary-500 hover:bg-primary-50 transition-all text-left group"
                                        data-action="click->file-uploader#processAsRelated">
                                    <div class="flex items-start gap-3">
                                        <div class="w-10 h-10 rounded-lg bg-primary-100 flex items-center justify-center flex-shrink-0 group-hover:bg-primary-200 transition-colors">
                                            <i data-lucide="link" class="w-5 h-5 text-primary-600"></i>
                                        </div>
                                        <div>
                                            <p class="font-medium text-slate-800">Son documentos relacionados</p>
                                            <p class="text-sm text-slate-500 mt-1">Pertenecen a la misma solicitud</p>
                                        </div>
                                    </div>
                                </button>
                                <button type="button"
                                        class="w-full p-4 rounded-xl border-2 border-slate-200 hover:border-slate-400 hover:bg-slate-50 transition-all text-left group"
                                        data-action="click->file-uploader#processAsSeparate">
                                    <div class="flex items-start gap-3">
                                        <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center flex-shrink-0 group-hover:bg-slate-200 transition-colors">
                                            <i data-lucide="files" class="w-5 h-5 text-slate-600"></i>
                                        </div>
                                        <div>
                                            <p class="font-medium text-slate-800">Son documentos separados</p>
                                            <p class="text-sm text-slate-500 mt-1">Se analizarán de forma independiente</p>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-action="click->file-uploader#closeModal">
                                Cancelar
                            </button>
                        </div>
                    </div>
                </div>

                <div id="orphanLinkModal"
                     class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center"
                     data-file-uploader-target="orphanLinkModal">
                    <div class="h-[80vh] w-[90vw] max-w-7xl mx-auto my-auto bg-white rounded-2xl shadow-2xl flex flex-col overflow-hidden">
                        <div class="flex items-center justify-between px-8 py-5 border-b border-slate-200">
                            <div class="flex items-center gap-4">
                                <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center">
                                    <i data-lucide="file-question" class="w-5 h-5 text-amber-600"></i>
                                </div>
                                <div>
                                    <h2 class="text-lg font-semibold text-slate-800">Documento sin solicitud asociada</h2>
                                    <p class="text-sm text-slate-500">
                                        <span id="orphanDocTitle"></span>
                                        <span id="orphanDocType" class="ml-2 text-xs badge badge-secondary"></span>
                                    </p>
                                </div>
                            </div>
                            <button type="button"
                                    class="btn btn-ghost btn-sm"
                                    data-action="click->file-uploader#closeOrphanModal">
                                <i data-lucide="x" class="w-5 h-5"></i>
                            </button>
                        </div>
                        <div class="flex-1 flex overflow-hidden">
                            <div class="w-1/2 border-r border-slate-200 bg-slate-50">
                                <iframe id="orphanDocViewer" src="" class="w-full h-full border-0"></iframe>
                            </div>
                            <div class="w-1/2 flex flex-col overflow-hidden">
                                <div class="px-6 py-5 border-b border-slate-200">
                                    <div class="relative flex items-center">
                                        <i data-lucide="search" class="w-4 h-4 absolute left-3 text-slate-400 pointer-events-none" style="z-index:1"></i>
                                        <input type="text"
                                               placeholder="Buscar solicitud..."
                                               id="orphanSearchInput"
                                               class="input input-icon-left w-full"
                                               data-action="input->file-uploader#searchOrphanRequests">
                                    </div>
                                </div>
                                <div class="flex-1 overflow-y-auto px-6 py-5 space-y-8">
                                    <div id="suggestedRequests"></div>
                                    <div id="allRequests">
                                        <div class="text-center py-8">
                                            <div class="w-8 h-8 rounded-full bg-primary-100 flex items-center justify-center mx-auto mb-3">
                                                <i data-lucide="loader-2" class="w-4 h-4 text-primary-600 animate-spin"></i>
                                            </div>
                                            <p class="text-sm text-slate-500">Cargando solicitudes...</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="px-6 py-4 border-t border-slate-200 flex items-center justify-between gap-3 bg-slate-50">
                                    <button type="button"
                                            class="btn btn-secondary"
                                            data-action="click->file-uploader#skipOrphanLink">
                                        Omitir
                                    </button>
                                    <button type="button"
                                            class="btn btn-primary"
                                            data-action="click->file-uploader#createRequestFromOrphan">
                                        <i data-lucide="plus" class="w-4 h-4 mr-2"></i>
                                        Añadir solicitud
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="keywordMatchModal"
                     class="modal-backdrop hidden"
                     data-file-uploader-target="keywordMatchModal">
                    <div class="modal-content max-w-lg">
                        <div class="modal-header">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center">
                                    <i data-lucide="alert-triangle" class="w-5 h-5 text-amber-600"></i>
                                </div>
                                <div>
                                    <h3 class="text-lg font-semibold text-slate-800">Verificar asociaciones</h3>
                                    <p class="text-sm text-slate-500">Documentos asociados automáticamente por palabras clave</p>
                                </div>
                            </div>
                        </div>
                        <div class="modal-body">
                            <p class="text-slate-600 mb-4">
                                Los siguientes documentos han sido asociados automáticamente a solicitudes existentes
                                basándose en palabras clave encontradas en el contenido. Por favor, verifica si las asociaciones son correctas.
                            </p>
                            <div id="keywordMatchList"
                                 data-file-uploader-target="keywordMatchList"
                                 class="space-y-3 max-h-80 overflow-y-auto">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-action="click->file-uploader#closeKeywordMatchModal">
                                Cerrar
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            {# Estados de las solicitudes: barras horizontales (ApexCharts,
               mismo controlador que /estadisticas). Solo estados con datos. #}
            {% if chartStatuses|length > 0 %}
                {% set chartConfig = {
                    series: [{name: 'Solicitudes', data: chartStatuses|column('count')}],
                    chart: {type: 'bar', height: chartStatuses|length * 36 + 40, fontFamily: 'DM Sans, sans-serif', toolbar: {show: false}, sparkline: {enabled: false}},
                    plotOptions: {bar: {horizontal: true, distributed: true, borderRadius: 4, barHeight: '58%'}},
                    colors: chartStatuses|column('color'),
                    xaxis: {categories: chartStatuses|column('label'), labels: {style: {colors: '#94a3b8', fontSize: '11px'}}},
                    yaxis: {labels: {style: {colors: '#475569', fontSize: '12px'}}},
                    dataLabels: {enabled: false},
                    legend: {show: false},
                    grid: {borderColor: '#f1f5f9'},
                    tooltip: {theme: 'light'},
                } %}
                <div class="side-card">
                    <div class="side-card-head">
                        <span class="side-card-eyebrow">
                            <i data-lucide="bar-chart-3" class="w-3.5 h-3.5"></i>
                            Estados de tus solicitudes
                        </span>
                        <a href="{{ path('app_stats') }}" class="text-xs text-slate-400 hover:text-primary-600 transition-colors" title="Ver estadísticas completas">
                            <i data-lucide="arrow-up-right" class="w-3.5 h-3.5"></i>
                        </a>
                    </div>
                    <div class="side-card-body !pt-2">
                        <div data-controller="apex-chart"
                             data-apex-chart-config-value="{{ chartConfig|json_encode|e('html_attr') }}"></div>
                    </div>
                </div>
            {% endif %}

            {# Email virtual #}
            <div class="side-card"
                 data-controller="clipboard"
                 {% if not app.user.virtualEmail %}data-clipboard-url-value="{{ path('app_virtual_email_generate') }}"{% endif %}>
                <div class="side-card-head">
                    <span class="side-card-eyebrow">
                        <i data-lucide="mail" class="w-3.5 h-3.5"></i>
                        Email virtual
                    </span>
                    <a href="{{ path('app_guias_show', {slug: 'buzon-virtual'}) }}" class="text-xs text-slate-400 hover:text-primary-600 transition-colors" title="Cómo configurar">
                        <i data-lucide="help-circle" class="w-3.5 h-3.5"></i>
                    </a>
                </div>
                <div class="side-card-body">
                    {% if app.user.virtualEmail %}
                        <div class="virtual-email">
                            <code data-clipboard-target="source">{{ app.user.virtualEmail }}</code>
                            <button type="button"
                                    class="btn btn-ghost btn-sm flex-shrink-0"
                                    data-action="click->clipboard#copy"
                                    data-clipboard-target="button"
                                    title="Copiar">
                                <i data-lucide="copy" class="w-4 h-4"></i>
                            </button>
                        </div>
                        <p class="mt-2 text-xs text-slate-500 leading-relaxed">
                            Reenvía aquí los correos de las administraciones para que se procesen automáticamente.
                        </p>
                        <a href="{{ path('app_comunicaciones_index') }}"
                           class="mt-3 flex items-center justify-between gap-2 px-2.5 py-2 rounded-lg bg-slate-50 border border-slate-200 hover:border-primary-200 hover:bg-primary-50/50 transition-colors group">
                            <span class="flex items-center gap-2 text-xs text-slate-600 group-hover:text-primary-700">
                                <i data-lucide="inbox" class="w-3.5 h-3.5"></i>
                                Emails recibidos (últimos 7 días)
                            </span>
                            <span class="flex items-center gap-1">
                                <span class="badge badge-primary">{{ recentEmailCount }}</span>
                                <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-slate-400 group-hover:text-primary-600"></i>
                            </span>
                        </a>
                    {% else %}
                        <p class="text-xs text-slate-500 mb-3 leading-relaxed">
                            Genera un email para recibir documentos directamente desde las administraciones.
                        </p>
                        <button type="button"
                                class="btn btn-secondary btn-sm w-full"
                                data-action="click->clipboard#generate">
                            <i data-lucide="wand-2" class="w-4 h-4 mr-2"></i>
                            Generar email virtual
                        </button>
                    {% endif %}
                </div>
            </div>
        </aside>
    </div>


</div>

<script>
    // Re-render Lucide icons after dynamic content updates
    document.addEventListener('DOMContentLoaded', function() {
        if (window.lucide) window.lucide.createIcons();
    });
</script>
{% endblock %}
