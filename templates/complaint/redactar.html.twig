{% extends 'layouts/app.html.twig' %}

{% set isAlegation = mode == 'alegation_response' %}
{% set pageTitle = mode is null
    ? 'Redactar escrito'
    : (isAlegation ? 'Respuesta a Alegaciones' : 'Reclamación') %}

{% block title %}{{ pageTitle }} - {{ request.title }} - PideInfo{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="https://unpkg.com/trix@2.1.15/dist/trix.css">
    <style>
        /* Cabecera local heredada — no migrar a app.css: .page-title ya existe
           allí como clase canónica con otra definición. */
        .page-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
        .page-head .page-title { font-family: 'DM Serif Display', serif; font-size: clamp(1.6rem, 3vw, 2.1rem); line-height: 1.15; color: rgb(15 23 42); }
    </style>
{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto">

    {% include '_partials/agent_required_banner.html.twig' %}

    {# ── Breadcrumb ─────────────────────────────────────────── #}
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-3" style="font-family:'Inter',sans-serif;letter-spacing:.04em;">
        <a href="{{ path('app_solicitudes_index') }}" class="hover:text-slate-800 transition-colors">SOLICITUDES</a>
        <span class="text-slate-300">/</span>
        <a href="{{ path('app_solicitudes_show', {id: request.id}) }}" class="hover:text-slate-800 transition-colors truncate max-w-[14rem]">
            {{ request.title|u.truncate(28) }}
        </a>
        <span class="text-slate-300">/</span>
        <span class="text-slate-800 font-medium">{{ pageTitle|upper }}</span>
    </nav>

    {% if mode is null %}
        {# ── Mode selector ─────────────────────────────────────── #}
        <header class="page-head">
            <div>
                <h1 class="page-title">¿Qué quieres redactar?</h1>
                <p class="text-slate-500 mt-2" style="font-family:'DM Sans',sans-serif;font-size:.95rem;">Elige el tipo de escrito para empezar.</p>
            </div>
            <a href="{{ path('app_solicitudes_show', {id: request.id}) }}" class="ghost-link"><i data-lucide="arrow-left" class="w-4 h-4"></i> Volver al expediente</a>
        </header>

        <div class="mode-grid">
            <a href="{{ canComplaint ? path('app_complaint_redactar', {id: request.id, mode: 'complaint'}) : '#' }}"
               class="mode-card {{ canComplaint ? '' : 'is-disabled' }}"
               {% if not canComplaint %}aria-disabled="true" onclick="event.preventDefault()"{% endif %}>
                <span class="mode-icon"><i data-lucide="gavel" class="w-5 h-5"></i></span>
                <h2 class="mode-title">Reclamación</h2>
                <p class="mode-desc">Reclama ante el Consejo de Transparencia cuando la administración deniegue o no responda dentro de plazo.</p>
                {% if canComplaint %}
                    <span class="mode-cta">Empezar →</span>
                {% else %}
                    <span class="text-xs" style="color:#64748b;font-family:'DM Sans',sans-serif;">No disponible: la solicitud aún no admite reclamación.</span>
                {% endif %}
            </a>
            <a href="{{ canAlegation ? path('app_complaint_redactar', {id: request.id, mode: 'alegation_response'}) : '#' }}"
               class="mode-card {{ canAlegation ? '' : 'is-disabled' }}"
               {% if not canAlegation %}aria-disabled="true" onclick="event.preventDefault()"{% endif %}>
                <span class="mode-icon"><i data-lucide="message-square-reply" class="w-5 h-5"></i></span>
                <h2 class="mode-title">Respuesta a alegaciones</h2>
                <p class="mode-desc">Rebate punto por punto las alegaciones que la administración haya presentado en el procedimiento de reclamación.</p>
                {% if canAlegation %}
                    <span class="mode-cta">Empezar →</span>
                {% else %}
                    <span class="text-xs" style="color:#64748b;font-family:'DM Sans',sans-serif;">No disponible: aún no hay reclamación con alegaciones.</span>
                {% endif %}
            </a>
        </div>

        <script>
            window.addEventListener('DOMContentLoaded', () => { if (window.lucide) window.lucide.createIcons(); });
        </script>
    {% else %}
        {# ── Canvas + chat ─────────────────────────────────────── #}
        <header class="draft-band">
            <div class="draft-eyebrow">
                <span class="dot"></span>
                {% if isAlegation %}Respuesta a alegaciones{% else %}Reclamación{% endif %}
            </div>
            <div class="draft-band-row">
                <h1 class="draft-band-title">
                    {% if isAlegation %}
                        Responde a las alegaciones de
                    {% else %}
                        Reclama frente a
                    {% endif %}
                    <em>{{ request.publicBody.name|u.truncate(60, '…') }}</em>
                </h1>
                <span class="draft-status"
                      :class="{
                          'is-streaming': loading,
                          'is-saved': !loading && editorReady && !documentEdited && draftSavedAt,
                          'is-edited': !loading && editorReady && documentEdited,
                      }"
                      x-text="docStatusLabel()"></span>
            </div>
        </header>

        {% if isAlegation and existingDrafts|length > 0 %}
            <nav class="draft-tabs" aria-label="Borradores de respuesta a alegaciones">
                {% for draft in existingDrafts %}
                    <a href="{{ path('app_complaint_redactar', {id: request.id, mode: 'alegation_response', draft: draft.id}) }}"
                       class="draft-tab{% if currentDraft and currentDraft.id == draft.id %} is-current{% endif %}">
                        <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
                        {{ draft.originalFilename|default('Borrador')|u.truncate(30) }}
                    </a>
                {% endfor %}
                <a href="{{ path('app_complaint_redactar', {id: request.id, mode: 'alegation_response'}) }}"
                   class="draft-tab">
                    <i data-lucide="plus" class="w-3.5 h-3.5"></i> Nuevo borrador
                </a>
            </nav>
        {% endif %}

        <div x-data="redactarApp()">
        <div class="draft-grid">

            <article class="draft-card">
                <div class="draft-meta-row">
                    <span class="meta-pill meta-pill-portal">
                        {% if isAlegation %}Consejo de Transparencia{% else %}Reclamación{% endif %}
                    </span>
                    <span class="meta-pill">{{ request.publicBody.getLevelLabel() }}</span>
                    {% if request.applicableLaw %}
                        <span class="meta-pill meta-pill-law">{{ request.applicableLaw.shortCode ?? request.applicableLaw.name }}</span>
                    {% endif %}
                </div>

                {% if not isAlegation %}
                    {% include '_partials/_agent_present_modal.html.twig' %}
                {% endif %}

                <div class="draft-body draft-body-stack">
                    {# Trix editor — always mounted so the previous draft remains visible while
                       the model streams a new version on top. The complaint-canvas Stimulus
                       controller exposes `replaceContent({bodyHtml})` to the assistant-chat
                       outlet so the chat can push generated HTML into Trix. #}
                    <div id="complaint-canvas" data-controller="complaint-canvas" class="draft-editor-wrap">
                        <input id="redactar-html-input" type="hidden" value="">
                        <trix-editor input="redactar-html-input"
                                     data-complaint-canvas-target="editor"
                                     placeholder="{% if isAlegation %}Escribe la respuesta a las alegaciones, o abre el asistente en la zona inferior derecha para comenzar a redactar la respuesta utilizando inteligencia artificial y resoluciones históricas de los Consejos…{% else %}Escribe la reclamación, o abre el asistente en la zona inferior derecha para comenzar a redactar la reclamación utilizando inteligencia artificial y resoluciones históricas de los Consejos…{% endif %}"
                                     @trix-change="documentEdited = true; persistedAt = null; charCount = ($event.target.editor.getDocument().toString() || '').length"></trix-editor>
                    </div>

                </div>

                <div class="draft-counters" x-show="editorReady" x-cloak>
                    <span x-text="`${charCount.toLocaleString('es-ES')} caracteres`">0 caracteres</span>
                    <span>{% if isAlegation %}Respuesta a alegaciones · escrito estructurado{% else %}Reclamación · escrito estructurado{% endif %}</span>
                </div>

                <div class="draft-cta-row">
                    <div class="draft-cta-group">
                        <a href="{{ path('app_solicitudes_show', {id: request.id}) }}" class="btn btn-secondary">
                            <i data-lucide="arrow-left" class="w-4 h-4 mr-2"></i> Volver al expediente
                        </a>
                        <button type="button" x-show="editorReady" x-cloak
                                @click="saveDraft()" :disabled="savingDraft"
                                class="btn btn-secondary">
                            <i data-lucide="save" class="w-4 h-4 mr-2"></i>
                            <span x-text="savingDraft ? 'Guardando…' : (draftSavedAt ? 'Borrador guardado' : 'Guardar borrador')">Guardar borrador</span>
                        </button>
                        <button type="button" x-show="editorReady" x-cloak
                                @click="downloadPdf()" :disabled="downloadingPdf"
                                class="btn btn-secondary">
                            <i data-lucide="file-down" class="w-4 h-4 mr-2"></i>
                            <span x-text="downloadingPdf ? 'Generando…' : 'Descargar PDF'">Descargar PDF</span>
                        </button>
                    </div>
                    {% if not isAlegation %}
                        <div class="draft-cta-group">
                            <button type="button" x-show="editorReady" x-cloak
                                    @click="presentViaAgent('supervised')" :disabled="$store.agentPresent.busy"
                                    class="btn btn-secondary"
                                    title="El agente abre la sede con el formulario rellenado y tú revisas + envías">
                                <i data-lucide="eye" class="w-4 h-4 mr-2"></i>
                                <span x-text="$store.agentPresent.busy ? 'Encolando…' : 'Presentar (supervisado)'">Presentar (supervisado)</span>
                            </button>
                            <button type="button" x-show="editorReady" x-cloak
                                    @click="presentViaAgent('auto')" :disabled="$store.agentPresent.busy"
                                    class="btn btn-primary"
                                    title="El agente rellena y envía sin intervención">
                                <i data-lucide="zap" class="w-4 h-4 mr-2"></i>
                                <span x-text="$store.agentPresent.busy ? 'Encolando…' : 'Presentar (auto)'">Presentar (auto)</span>
                            </button>
                        </div>
                    {% endif %}
                </div>
            </article>

            {# ── Sidebar ─────────────────────────────────────── #}
            <aside class="brief">
                <section class="panel">
                    <div class="panel-label"><i data-lucide="gavel" class="w-3.5 h-3.5"></i> Informe preliminar</div>
                    <template x-if="analysisLoading && !analysis">
                        <div>
                            <div class="brief-skel-num" style="display:inline-block;width:5rem;height:4rem;border-radius:4px;background:linear-gradient(90deg,#f1f5f9 0%,#e2e8f0 50%,#f1f5f9 100%);background-size:200% 100%;animation:shimmer 1.4s infinite;"></div>
                        </div>
                    </template>
                    <template x-if="analysis">
                        <div>
                            <div class="verdict">
                                <span class="verdict-num" x-text="displayPercentage"></span>
                                <span class="verdict-frac">/100</span>
                            </div>
                            <div class="verdict-label">
                                Probabilidad de estimación
                                <span class="verdict-zone" :class="zoneClass(analysis.percentage)" x-text="zoneLabel(analysis.percentage)"></span>
                            </div>
                            <div class="gauge">
                                <div class="gauge-track"></div>
                                <div class="gauge-marker" :style="`left: ${analysis.percentage}%`"></div>
                            </div>
                            <div class="gauge-scale"><span>0</span><span>25</span><span>50</span><span>75</span><span>100</span></div>
                            <div class="brief-section" x-show="analysis.summary">
                                <p class="brief-summary brief-html" x-html="analysis.summary"></p>
                            </div>
                            <div class="brief-section" x-show="analysis.strengths">
                                <h3 class="brief-html" style="color:#047857;font-weight:600;margin-bottom:.4rem;">A favor</h3>
                                <div class="brief-html" x-html="analysis.strengths"></div>
                            </div>
                            <div class="brief-section" x-show="analysis.weaknesses">
                                <h3 class="brief-html" style="color:#b91c1c;font-weight:600;margin-bottom:.4rem;">En contra</h3>
                                <div class="brief-html" x-html="analysis.weaknesses"></div>
                            </div>
                        </div>
                    </template>
                </section>

                {% if isAlegation and alegacionesDoc and alegacionesDoc.aiMetadata.alegationPoints is defined and alegacionesDoc.aiMetadata.alegationPoints %}
                    <section class="panel">
                        <div class="panel-label"><i data-lucide="shield-alert" class="w-3.5 h-3.5"></i> Alegaciones de la administración</div>
                        <div class="alegation-stack">
                            {% for point in alegacionesDoc.aiMetadata.alegationPoints %}
                                <div class="alegation-pt"><span class="num">{{ loop.index }}</span><span>{{ point }}</span></div>
                            {% endfor %}
                        </div>
                    </section>
                {% endif %}

                {% if availableDocuments|length > 0 %}
                    <section class="panel">
                        <div class="panel-label"><i data-lucide="files" class="w-3.5 h-3.5"></i> Documentos como contexto</div>
                        <p class="text-xs mb-2" style="color:#64748b;font-family:'DM Sans',sans-serif;">Los documentos marcados se enviarán al modelo como evidencia primaria.</p>
                        {% for doc in availableDocuments %}
                            <label class="file-row cursor-pointer">
                                <input type="checkbox" value="{{ doc.id }}" x-model="selectedDocIds"
                                       {% if doc.type.value == 'response' or doc.type.value == 'alegaciones' %}checked{% endif %}>
                                <div class="min-w-0">
                                    <p class="file-name truncate">{{ doc.originalFilename }}</p>
                                    <p class="file-meta">{{ doc.typeLabel }} · {{ doc.fileSizeFormatted }}</p>
                                </div>
                            </label>
                        {% endfor %}
                    </section>
                {% endif %}
            </aside>
        </div>

        {# ── Floating chatbot (bottom-right) — unified assistant-chat controller ── #}
        <div data-controller="assistant-chat"
             data-assistant-chat-endpoint-url-value="{{ path('app_assistant_chat_complaint', {id: request.id}) }}"
             data-assistant-chat-canvas-outlet-selector-value="#complaint-canvas"
             @assistant-chat:before-send.window="$refs.assistantCurrentBodyHtml.value = (editorInstance ? editorInstance.innerHTML : ''); $refs.assistantDocumentIds.value = selectedDocIds.join(',')">

            {# Hidden fields the assistant-chat controller appends to every turn's FormData.
               The :before-send event handler above refreshes them with current Trix HTML
               and selected document IDs right before serialization. #}
            <input type="hidden" name="mode" value="{{ mode }}"
                   data-assistant-chat-target="extra">
            <input type="hidden" name="currentBodyHtml" value=""
                   data-assistant-chat-target="extra"
                   x-ref="assistantCurrentBodyHtml">
            <input type="hidden" name="documentIds" value=""
                   data-assistant-chat-target="extra"
                   x-ref="assistantDocumentIds">

            <button type="button"
                    class="chatbot-fab"
                    data-assistant-chat-target="fab"
                    data-action="assistant-chat#open"
                    aria-label="Abrir asistente">
                <i data-lucide="sparkles" class="w-5 h-5"></i>
                <span class="chatbot-fab-dot"></span>
            </button>

            <div class="chatbot-panel"
                 data-assistant-chat-target="panel"
                 role="dialog"
                 aria-label="Asistente de redacción">
                <header class="chatbot-head">
                    <div class="chatbot-head-title">
                        <i data-lucide="sparkles" class="w-4 h-4"></i>
                        <div>
                            Asistente de redacción
                            <small>{% if isAlegation %}Pídeme redactar la respuesta o adjunta archivos{% else %}Pídeme redactar la reclamación o adjunta archivos{% endif %}</small>
                        </div>
                    </div>
                    <button type="button"
                            class="chatbot-close"
                            data-action="assistant-chat#close"
                            aria-label="Cerrar asistente">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                </header>

                <div class="chatbot-history" data-assistant-chat-target="history">
                    {% for msg in chatHistory|default([]) %}
                        {% if msg.role == 'user' %}
                            <div class="chat-turn chat-turn-user">
                                <div class="chat-bubble-text">{{ msg.content|default('')|nl2br }}</div>
                            </div>
                        {% elseif msg.role != 'user' and msg.kind != 'suggestions' and msg.kind != 'system' %}
                            <div class="chat-turn chat-turn-assistant">
                                <div class="chat-bubble-text">
                                    {% if msg.allowsHtml|default(false) %}{{ msg.content|raw }}{% else %}{{ msg.content|default('')|nl2br }}{% endif %}
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>

                <div data-assistant-chat-target="attachChips" class="composer-chips"></div>

                <form class="chatbot-input-row" data-action="submit->assistant-chat#sendMessage">
                    <label class="composer-attach" title="Adjuntar archivo (no se guarda)">
                        <input type="file"
                               class="hidden"
                               multiple
                               accept=".pdf,.csv,.txt,.md,.png,.jpg,.jpeg"
                               data-assistant-chat-target="attachInput"
                               data-action="change->assistant-chat#onAttach">
                        <i data-lucide="paperclip" class="w-3.5 h-3.5"></i>
                    </label>
                    <textarea rows="1"
                              class="composer-input composer-input-multiline"
                              placeholder="Escribe un mensaje, pega texto o adjunta archivos…"
                              data-assistant-chat-target="input"
                              data-action="keydown->assistant-chat#onKeydown input->assistant-chat#onInput"></textarea>
                    <button type="submit"
                            class="composer-send"
                            data-assistant-chat-target="sendButton"
                            aria-label="Enviar">
                        <i data-lucide="send" class="w-3 h-3"></i>
                    </button>
                </form>
                <p class="composer-disclaimer">Los archivos se usan solo en esta conversación y no se guardan.</p>
            </div>
        </div>

        </div>
    {% endif %}
</div>

{% if mode is not null %}
<script type="text/javascript" src="https://unpkg.com/trix@2.1.15/dist/trix.umd.min.js"></script>
<script>
function redactarApp() {
    return {
        mode: '{{ mode }}',
        draftId: {{ currentDraft ? "'#{currentDraft.id}'"|raw : 'null' }},
        currentBodyHtml: {{ currentBodyHtml|json_encode|raw }},
        messages: {{ chatHistory|json_encode|raw }},
        userInput: '',
        loading: false,
        loadingLabel: 'Pensando…',
        editorReady: false,
        editorInstance: null,
        documentEdited: false,
        savingDraft: false,
        draftSavedAt: null,
        downloadingPdf: false,
        analysis: null,
        analysisLoading: false,
        streamingHtml: '',
        chatOpen: false,
        charCount: 0,
        displayPercentage: 0,
        selectedDocIds: [{% for doc in availableDocuments %}{% if doc.type.value in ['response', 'alegaciones'] %}'{{ doc.id }}',{% endif %}{% endfor %}],

        init() {
            // Always init Trix — empty if no draft yet — so the user can write
            // directly without having to call the AI first.
            this.$nextTick(() => this.initEditor(this.currentBodyHtml || ''));
            this.runAnalysis();
            this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
        },

        escapeHtml(s) {
            return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
        },

        docStatusLabel() {
            if (this.loading && !this.streamingHtml) return 'Preparando contexto…';
            if (this.loading && this.streamingHtml) return 'Redactando…';
            if (this.charCount === 0) return 'Borrador en blanco';
            if (this.documentEdited) return 'Borrador con cambios sin guardar';
            if (this.draftSavedAt) return 'Borrador guardado';
            return 'Borrador listo';
        },

        zoneClass(p) {
            if (p < 30) return 'zone-low';
            if (p < 50) return 'zone-mid-low';
            if (p < 65) return 'zone-mid';
            if (p < 80) return 'zone-mid-high';
            return 'zone-high';
        },
        zoneLabel(p) {
            if (p < 30) return 'Muy baja';
            if (p < 50) return 'Baja';
            if (p < 65) return 'Media';
            if (p < 80) return 'Alta';
            return 'Muy alta';
        },
        animatePercentage(target) {
            const start = this.displayPercentage;
            const delta = target - start;
            if (delta === 0) return;
            const duration = 900;
            const t0 = performance.now();
            const tick = (now) => {
                const t = Math.min(1, (now - t0) / duration);
                const eased = 1 - Math.pow(1 - t, 3);
                this.displayPercentage = Math.round(start + delta * eased);
                if (t < 1) requestAnimationFrame(tick); else this.displayPercentage = target;
            };
            requestAnimationFrame(tick);
        },

        initEditor(html) {
            const trixEditor = document.querySelector('trix-editor');
            if (!trixEditor) return;
            const apply = () => {
                trixEditor.editor.loadHTML(html || '');
                this.editorInstance = trixEditor;
                this.editorReady = true;
                this.documentEdited = false;
                this.charCount = (trixEditor.editor.getDocument().toString() || '').length;
                this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
            };
            if (trixEditor.editor) apply();
            else trixEditor.addEventListener('trix-initialize', apply, { once: true });
        },

        getCanvasHtml() {
            if (this.editorReady) {
                return document.getElementById('redactar-html-input').value || '';
            }
            return this.currentBodyHtml || '';
        },

        async saveDraft() {
            if (!this.editorReady) return;
            const html = this.getCanvasHtml();
            if (!html.trim()) { alert('No hay contenido para guardar.'); return; }
            this.savingDraft = true;
            try {
                const res = await fetch('{{ path('app_complaint_redactar_save', {id: request.id}) }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mode: this.mode, html, draftId: this.draftId }),
                });
                const data = await res.json();
                if (!res.ok || !data.success) {
                    alert(data.error || 'No se pudo guardar el borrador.');
                    return;
                }
                this.draftSavedAt = Date.now();
                this.documentEdited = false;
                if (data.documentId) this.draftId = data.documentId;
                if (data.redirectUrl && this.draftId !== data.documentId) {
                    // First save: navigate so the URL reflects the saved draft id.
                    window.history.replaceState(null, '', data.redirectUrl);
                }
                setTimeout(() => { this.draftSavedAt = null; }, 4000);
            } catch (e) {
                alert('Error de red al guardar el borrador.');
            } finally {
                this.savingDraft = false;
            }
        },

        async downloadPdf() {
            if (!this.editorReady) return;
            this.downloadingPdf = true;
            const html = this.getCanvasHtml();
            try {
                const res = await fetch('{{ path('app_complaint_download_pdf', {id: request.id}) }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ html }),
                });
                if (!res.ok) {
                    const j = await res.json().catch(() => ({}));
                    alert(j.error || 'Error al generar PDF');
                    return;
                }
                const blob = await res.blob();
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = res.headers.get('content-disposition')?.match(/filename="(.+)"/)?.[1] || 'documento.pdf';
                document.body.appendChild(a);
                a.click();
                a.remove();
                URL.revokeObjectURL(url);
            } catch (e) {
                alert('Error de conexión.');
            } finally {
                this.downloadingPdf = false;
            }
        },

        async presentViaAgent(mode) {
            const store = this.$store.agentPresent;
            if (store.busy) return;
            if (!this.draftSavedAt) {
                await this.saveDraft();
                if (!this.draftSavedAt) return;
            }
            store.open('reclamación');
            try {
                const res = await fetch('{{ path('app_complaint_present_via_agent', {id: request.id}) }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mode }),
                });
                const data = await res.json();
                if (!res.ok) { store.fail(data.error || 'No se pudo encolar la tarea.'); return; }
                store.track(
                    [{ id: data.taskId, statusUrl: data.statusUrl, schemeUrl: data.schemeUrl }],
                    { entityLabel: 'reclamación' },
                );
            } catch (e) {
                store.fail('Error de red.');
            }
        },

        async runAnalysis() {
            this.analysisLoading = true;
            try {
                const url = '{{ path('app_complaint_analyze', {id: request.id}) }}';
                const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
                const data = await res.json();
                if (data.success) {
                    this.analysis = data.analysis;
                    this.animatePercentage(this.analysis.percentage || 0);
                }
            } catch (_) {
                // silently ignore
            } finally {
                this.analysisLoading = false;
                this.$nextTick(() => { if (window.lucide) window.lucide.createIcons(); });
            }
        },

        scrollHistoryEnd() {
            this.$nextTick(() => {
                const el = this.$refs.historyEl;
                if (el) el.scrollTop = el.scrollHeight;
            });
        },

        openChat() {
            this.chatOpen = true;
            this.$nextTick(() => {
                if (window.lucide) window.lucide.createIcons();
                this.scrollHistoryEnd();
                const inp = this.$refs.chatInput;
                if (inp) inp.focus();
            });
        },
        closeChat() {
            this.chatOpen = false;
        },
    };
}
</script>
{% endif %}
{% endblock %}
