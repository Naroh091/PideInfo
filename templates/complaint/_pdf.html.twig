<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Reclamación - {{ accessRequest.publicBody.name }}</title>
    <style>
        {% include 'pdf/_styles.css.twig' %}
    </style>
</head>
<body>
    {% set parts = draft.content|pdf_complaint_parts %}
    {% if parts.heading %}
        <div class="doc-heading doc-heading--standalone">Reclamación en materia de acceso <br>a información pública</div>
    {% endif %}
    <div class="content">{{ parts.html|raw }}</div>

    {% include 'pdf/_footer.html.twig' %}
</body>
</html>
