<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>{{ accessRequest.publicBody.name }}</title>
    <style>
        @page {
            margin: 2.5cm;
        }

        body {
            font-family: 'DejaVu Sans', sans-serif;
            font-size: 11pt;
            line-height: 1.5;
            color: #1a1a1a;
        }

        h1 {
            font-size: 14pt;
            font-weight: bold;
            text-align: center;
            margin-bottom: 1.5em;
            text-transform: uppercase;
        }

        h2 {
            font-size: 12pt;
            font-weight: bold;
            margin-top: 1.5em;
            margin-bottom: 0.5em;
            text-transform: uppercase;
        }

        h3 {
            font-size: 11pt;
            font-weight: bold;
            margin-top: 1em;
            margin-bottom: 0.5em;
        }

        p {
            text-align: justify;
            margin-bottom: 0.8em;
        }

        ul, ol {
            margin-bottom: 0.8em;
            padding-left: 1.5em;
        }

        li {
            margin-bottom: 0.3em;
        }

        blockquote {
            border-left: 3px solid #ccc;
            margin: 1em 0;
            padding: 0.5em 1em;
            color: #555;
        }

        strong {
            font-weight: bold;
        }

        em {
            font-style: italic;
        }

        .footer {
            position: fixed;
            bottom: 0;
            width: 100%;
            text-align: center;
            font-size: 8pt;
            color: #999;
            padding-top: 0.5em;
            border-top: 1px solid #eee;
        }
    </style>
</head>
<body>
    <div class="content">{{ markdown|markdown_to_html }}</div>

    <div class="footer">
        Documento generado con PideInfo - {{ "now"|date("d/m/Y H:i") }}
    </div>
</body>
</html>
