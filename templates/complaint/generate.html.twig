{% extends 'layouts/app.html.twig' %}

{% block title %}Generar Reclamación - {{ request.title }} - PideInfo{% endblock %}

{% block content %}
{# Breadcrumb #}
<nav class="flex items-center gap-2 text-sm mb-6">
    <a href="{{ path('app_solicitudes_index') }}" class="text-slate-500 hover:text-primary-600 transition-colors">
        Solicitudes
    </a>
    <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
    <a href="{{ path('app_solicitudes_show', {id: request.id}) }}" class="text-slate-500 hover:text-primary-600 transition-colors truncate max-w-xs">
        {{ request.title|u.truncate(30) }}
    </a>
    <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
    <span class="text-slate-800 font-medium">Reclamación</span>
</nav>

{# Header #}
<div class="flex flex-col sm:flex-row justify-between items-start gap-4 mb-8">
    <div class="min-w-0">
        <h1 class="text-2xl font-bold text-slate-800">Generar reclamación</h1>
        <div class="flex flex-wrap items-center gap-3 mt-2 text-sm text-slate-500">
            <span class="flex items-center gap-1">
                <i data-lucide="building" class="w-4 h-4"></i>
                {{ request.publicBody.name }}
            </span>
            <span class="badge {{ request.status == 'denied' ? 'status-denied' : 'status-delayed' }}">
                {{ request.statusLabel }}
            </span>
        </div>
    </div>
    <a href="{{ path('app_solicitudes_show', {id: request.id}) }}" class="btn btn-secondary flex-shrink-0">
        <i data-lucide="arrow-left" class="w-4 h-4 mr-2"></i>
        Volver
    </a>
</div>

<div class="grid lg:grid-cols-3 gap-6" x-data="complaintGenerator()" x-init="init()">
    <div class="lg:col-span-2 space-y-6">
        {# Analysis Card #}
        <div class="card">
            <div class="card-header">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center">
                        <i data-lucide="bar-chart-2" class="w-5 h-5 text-amber-600"></i>
                    </div>
                    <h2 class="font-semibold text-slate-800">Análisis de probabilidad</h2>
                </div>
            </div>
            <div class="card-body">
                <template x-if="!analysis && !analysisLoading">
                    <div class="text-center py-6">
                        <p class="text-slate-500 mb-4">
                            Analiza la probabilidad de éxito de tu reclamación antes de generarla.
                        </p>
                        <button @click="runAnalysis()" class="btn btn-secondary">
                            <i data-lucide="sparkles" class="w-4 h-4 mr-2"></i>
                            Analizar probabilidad
                        </button>
                    </div>
                </template>

                <template x-if="analysisLoading">
                    <div class="flex items-center justify-center py-8">
                        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary-600"></div>
                        <span class="ml-3 text-slate-600">Analizando...</span>
                    </div>
                </template>

                <template x-if="analysis && !analysisLoading">
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <div>
                                <span class="text-4xl font-bold" :class="getProbabilityClass(analysis.probability)" x-text="analysis.probability + '%'"></span>
                                <span class="text-sm text-slate-500 ml-2" x-text="getProbabilityLabel(analysis.probability)"></span>
                            </div>
                        </div>

                        <div class="w-full bg-slate-200 rounded-full h-3 mb-4">
                            <div class="h-3 rounded-full transition-all duration-500"
                                 :class="getProbabilityBarClass(analysis.probability)"
                                 :style="'width: ' + analysis.probability + '%'"></div>
                        </div>

                        <p class="text-slate-600 mb-4" x-text="analysis.reasoning"></p>

                        <div class="grid sm:grid-cols-2 gap-4">
                            <div x-show="analysis.strengths && analysis.strengths.length > 0">
                                <h4 class="text-sm font-medium text-green-700 mb-2 flex items-center gap-1">
                                    <i data-lucide="check-circle" class="w-4 h-4"></i>
                                    Puntos fuertes
                                </h4>
                                <ul class="text-sm text-slate-600 space-y-1">
                                    <template x-for="strength in analysis.strengths">
                                        <li class="flex items-start gap-2">
                                            <i data-lucide="plus" class="w-3 h-3 text-green-500 mt-1 flex-shrink-0"></i>
                                            <span x-text="strength"></span>
                                        </li>
                                    </template>
                                </ul>
                            </div>
                            <div x-show="analysis.weaknesses && analysis.weaknesses.length > 0">
                                <h4 class="text-sm font-medium text-red-700 mb-2 flex items-center gap-1">
                                    <i data-lucide="alert-circle" class="w-4 h-4"></i>
                                    Puntos débiles
                                </h4>
                                <ul class="text-sm text-slate-600 space-y-1">
                                    <template x-for="weakness in analysis.weaknesses">
                                        <li class="flex items-start gap-2">
                                            <i data-lucide="minus" class="w-3 h-3 text-red-500 mt-1 flex-shrink-0"></i>
                                            <span x-text="weakness"></span>
                                        </li>
                                    </template>
                                </ul>
                            </div>
                        </div>
                    </div>
                </template>
            </div>
        </div>

        {# Preview Card #}
        <div class="card" x-show="preview">
            <div class="card-header">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-primary-100 flex items-center justify-center">
                            <i data-lucide="file-text" class="w-5 h-5 text-primary-600"></i>
                        </div>
                        <h2 class="font-semibold text-slate-800">Vista previa de la reclamación</h2>
                    </div>
                    <div class="flex gap-2">
                        <a :href="'{{ path('app_complaint_pdf', {id: request.id}) }}'" class="btn btn-secondary btn-sm">
                            <i data-lucide="file-text" class="w-4 h-4 mr-1"></i>
                            PDF
                        </a>
                        <a :href="'{{ path('app_complaint_word', {id: request.id}) }}'" class="btn btn-secondary btn-sm">
                            <i data-lucide="file" class="w-4 h-4 mr-1"></i>
                            Word
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="prose prose-slate max-w-none" x-html="preview"></div>
            </div>
        </div>

        {# Empty state when no preview #}
        <div class="card" x-show="!preview && !loading">
            <div class="card-body">
                <div class="empty-state py-12">
                    <div class="empty-state-icon">
                        <i data-lucide="file-plus" class="w-full h-full"></i>
                    </div>
                    <p class="empty-state-title">Genera tu reclamación</p>
                    <p class="empty-state-description">
                        Haz clic en el botón "Generar reclamación" para crear un borrador basado en tu solicitud y los criterios del CTBG.
                    </p>
                </div>
            </div>
        </div>

        {# Loading state #}
        <div class="card" x-show="loading">
            <div class="card-body">
                <div class="flex flex-col items-center justify-center py-12">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary-600 mb-4"></div>
                    <p class="text-slate-600 font-medium">Generando reclamación...</p>
                    <p class="text-sm text-slate-500 mt-2">Esto puede tardar unos segundos</p>
                </div>
            </div>
        </div>
    </div>

    <div class="lg:col-span-1 space-y-6">
        {# Request Summary Card #}
        <div class="card">
            <div class="card-header">
                <h2 class="font-semibold text-slate-800">Datos de la solicitud</h2>
            </div>
            <div class="card-body space-y-4">
                <div>
                    <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">Título</h4>
                    <p class="text-slate-800">{{ request.title }}</p>
                </div>
                <div>
                    <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">Organismo</h4>
                    <p class="text-slate-800">{{ request.publicBody.name }}</p>
                </div>
                <div>
                    <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">Ley aplicable</h4>
                    <p class="text-slate-800">{{ request.applicableLaw.name }}</p>
                </div>
                <div>
                    <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">Fecha de envío</h4>
                    <p class="text-slate-800">{{ request.sentAt|date('d/m/Y') }}</p>
                </div>
                {% if request.resolutionNotes %}
                <div>
                    <h4 class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">Motivo de denegación</h4>
                    <p class="text-slate-800">{{ request.resolutionNotes }}</p>
                </div>
                {% endif %}
            </div>
        </div>

        {# Actions Card #}
        <div class="card">
            <div class="card-header">
                <h2 class="font-semibold text-slate-800">Acciones</h2>
            </div>
            <div class="card-body space-y-3">
                {% if existingComplaint %}
                    <div class="p-3 bg-amber-50 rounded-lg text-sm text-amber-700 mb-3">
                        <i data-lucide="alert-triangle" class="w-4 h-4 inline mr-1"></i>
                        Ya existe una reclamación generada. Puedes descargarla o generar una nueva.
                    </div>
                {% endif %}

                <button @click="generateComplaint()"
                        :disabled="loading"
                        class="btn btn-accent w-full">
                    <i data-lucide="sparkles" class="w-4 h-4 mr-2"></i>
                    <span x-text="loading ? 'Generando...' : '{{ existingComplaint ? 'Regenerar reclamación' : 'Generar reclamación' }}'"></span>
                </button>

                {% if existingComplaint %}
                    <a href="{{ path('app_complaint_pdf', {id: request.id}) }}" class="btn btn-secondary w-full">
                        <i data-lucide="download" class="w-4 h-4 mr-2"></i>
                        Descargar PDF
                    </a>
                    <a href="{{ path('app_complaint_word', {id: request.id}) }}" class="btn btn-secondary w-full">
                        <i data-lucide="download" class="w-4 h-4 mr-2"></i>
                        Descargar Word
                    </a>
                {% endif %}
            </div>
        </div>

        {# Info Card #}
        <div class="card bg-slate-50">
            <div class="card-body">
                <h3 class="font-medium text-slate-800 mb-2 flex items-center gap-2">
                    <i data-lucide="info" class="w-4 h-4 text-primary-600"></i>
                    Información importante
                </h3>
                <ul class="text-sm text-slate-600 space-y-2">
                    <li class="flex items-start gap-2">
                        <i data-lucide="check" class="w-4 h-4 text-primary-500 mt-0.5 flex-shrink-0"></i>
                        <span>La reclamación se genera automáticamente usando IA y criterios del CTBG.</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <i data-lucide="check" class="w-4 h-4 text-primary-500 mt-0.5 flex-shrink-0"></i>
                        <span>Revisa el documento antes de presentarlo.</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <i data-lucide="check" class="w-4 h-4 text-primary-500 mt-0.5 flex-shrink-0"></i>
                        <span>Completa tus datos personales en el documento final.</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script>
function complaintGenerator() {
    return {
        loading: false,
        analysisLoading: false,
        preview: null,
        analysis: null,
        error: null,

        init() {
            // Auto-run analysis on page load
            this.runAnalysis();
        },

        async runAnalysis() {
            this.analysisLoading = true;
            this.error = null;

            try {
                const response = await fetch('{{ path('app_complaint_analyze', {id: request.id}) }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                });

                const data = await response.json();

                if (data.success) {
                    this.analysis = data.analysis;
                } else {
                    this.error = data.error;
                }
            } catch (e) {
                this.error = 'Error al analizar la probabilidad';
            } finally {
                this.analysisLoading = false;
            }
        },

        async generateComplaint() {
            this.loading = true;
            this.error = null;

            try {
                const response = await fetch('{{ path('app_complaint_create', {id: request.id}) }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                });

                const data = await response.json();

                if (data.success) {
                    this.preview = data.preview;
                    if (data.successAnalysis) {
                        this.analysis = data.successAnalysis;
                    }
                } else {
                    this.error = data.error;
                    alert(data.error);
                }
            } catch (e) {
                this.error = 'Error al generar la reclamación';
                alert('Error al generar la reclamación');
            } finally {
                this.loading = false;
            }
        },

        getProbabilityClass(probability) {
            if (probability >= 80) return 'text-green-600';
            if (probability >= 60) return 'text-lime-600';
            if (probability >= 40) return 'text-yellow-600';
            if (probability >= 20) return 'text-orange-600';
            return 'text-red-600';
        },

        getProbabilityBarClass(probability) {
            if (probability >= 80) return 'bg-green-500';
            if (probability >= 60) return 'bg-lime-500';
            if (probability >= 40) return 'bg-yellow-500';
            if (probability >= 20) return 'bg-orange-500';
            return 'bg-red-500';
        },

        getProbabilityLabel(probability) {
            if (probability >= 80) return 'Muy alta';
            if (probability >= 60) return 'Alta';
            if (probability >= 40) return 'Media';
            if (probability >= 20) return 'Baja';
            return 'Muy baja';
        }
    };
}
</script>
{% endblock %}
