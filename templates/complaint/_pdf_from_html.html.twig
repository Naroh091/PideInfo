<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>{{ accessRequest.publicBody.name }}</title>
    <style>
        @font-face {
            font-family: 'DM Sans';
            font-style: normal;
            font-weight: 400;
            src: url('file://{{ pdf_font_dir }}/DMSans-Variable.ttf') format('truetype');
        }
        @font-face {
            font-family: 'DM Sans';
            font-style: normal;
            font-weight: 700;
            src: url('file://{{ pdf_font_dir }}/DMSans-Variable.ttf') format('truetype');
        }
        @font-face {
            font-family: 'DM Serif Display';
            font-style: normal;
            font-weight: 400;
            src: url('file://{{ pdf_font_dir }}/DMSerifDisplay-Regular.ttf') format('truetype');
        }

        @page {
            margin: 0;
        }

        html {
            margin: 0;
            padding: 0;
        }

        body {
            margin: 0;
            padding: 2.8cm 2.6cm 3.2cm 2.6cm;
            font-family: 'DM Sans', 'DejaVu Sans', sans-serif;
            font-size: 10.5pt;
            line-height: 1.55;
            color: #1e293b;
        }

        .masthead {
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 0.6em;
            margin-bottom: 1.6em;
        }

        .masthead .wordmark {
            font-family: 'DM Serif Display', Georgia, serif;
            font-size: 16pt;
            color: #0369a1;
            letter-spacing: -0.01em;
        }

        .masthead .tagline {
            font-size: 8.5pt;
            color: #64748b;
            margin-top: 0.15em;
        }

        .content h1 {
            font-family: 'DM Serif Display', Georgia, serif;
            font-size: 13pt;
            font-weight: 400;
            color: #0c4a6e;
            text-transform: none;
            letter-spacing: 0.005em;
            margin-top: 1.6em;
            margin-bottom: 0.6em;
            padding-bottom: 0.25em;
            border-bottom: 1px solid #bae6fd;
        }

        .content h1:first-child {
            margin-top: 0;
        }

        .content h2 {
            font-family: 'DM Sans', sans-serif;
            font-size: 11.5pt;
            font-weight: 700;
            color: #0369a1;
            margin-top: 1.3em;
            margin-bottom: 0.5em;
        }

        .content h3 {
            font-family: 'DM Sans', sans-serif;
            font-size: 10.5pt;
            font-weight: 700;
            color: #334155;
            margin-top: 1em;
            margin-bottom: 0.4em;
        }

        .content p {
            text-align: justify;
            margin: 0 0 0.75em 0;
            orphans: 3;
            widows: 3;
        }

        .content ul, .content ol {
            margin: 0.25em 0 0.85em 0;
            padding-left: 1.4em;
        }

        .content li {
            margin-bottom: 0.3em;
            text-align: justify;
        }

        .content strong {
            font-weight: 700;
            color: #0f172a;
        }

        .content em {
            font-style: italic;
        }

        .content blockquote {
            border-left: 3px solid #7dd3fc;
            background: #f0f9ff;
            margin: 0.8em 0;
            padding: 0.4em 0.9em;
            color: #334155;
            font-style: italic;
        }

        .content a {
            color: #0284c7;
            text-decoration: underline;
        }

        .footer {
            position: fixed;
            left: 2.6cm;
            right: 2.6cm;
            bottom: 1.2cm;
            height: 1cm;
            padding-top: 0.25cm;
            border-top: 1px solid #e2e8f0;
            font-size: 7.5pt;
            color: #64748b;
            text-align: center;
            line-height: 1.35;
        }

        .footer .brand {
            color: #0369a1;
            font-weight: 700;
        }
    </style>
</head>
<body>
    <div class="masthead">
        <div class="wordmark">Pideinfo</div>
        <div class="tagline">Plataforma de simplificación para el ejercicio del derecho de acceso a información pública</div>
    </div>

    <div class="content">{{ html|raw }}</div>

    <div class="footer">
        Documento generado con <span class="brand">Pideinfo.es</span> — Plataforma de simplificación para el ejercicio del derecho de acceso a información pública
    </div>
</body>
</html>
