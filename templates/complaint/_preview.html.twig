<div class="complaint-preview">
    <div class="mb-6 p-4 bg-primary-50 rounded-lg border border-primary-100">
        <div class="flex items-center gap-2 text-primary-700 font-medium mb-2">
            <i data-lucide="building-2" class="w-5 h-5"></i>
            {{ draft.transparencyCouncil }}
        </div>
        <p class="text-sm text-primary-600">
            Ley aplicable: {{ draft.applicableLaw }}
        </p>
    </div>

    <div class="prose prose-slate max-w-none">
        {{ draft.content|markdown_to_html }}
    </div>

    {% if draft.hasCitedCriteria or draft.hasCitedResolutions %}
        <div class="mt-8 pt-6 border-t border-slate-200">
            <h3 class="font-semibold text-slate-800 mb-4">Referencias utilizadas</h3>

            {% if draft.hasCitedCriteria %}
                <div class="mb-4">
                    <h4 class="text-sm font-medium text-slate-600 mb-2">Criterios interpretativos citados:</h4>
                    <ul class="text-sm text-slate-500 space-y-1">
                        {% for criterion in draft.citedCriteria %}
                            <li class="flex items-center gap-2">
                                <i data-lucide="book-open" class="w-4 h-4 text-primary-500"></i>
                                {{ criterion }}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {% if draft.hasCitedResolutions %}
                <div>
                    <h4 class="text-sm font-medium text-slate-600 mb-2">Resoluciones citadas:</h4>
                    <ul class="text-sm text-slate-500 space-y-1">
                        {% for resolution in draft.citedResolutions %}
                            <li class="flex items-center gap-2">
                                <i data-lucide="file-check" class="w-4 h-4 text-green-500"></i>
                                {{ resolution.reference }}
                                {% if resolution.date %}<span class="text-slate-400">({{ resolution.date }})</span>{% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>
    {% endif %}

    <div class="mt-6 p-4 bg-amber-50 rounded-lg border border-amber-100">
        <div class="flex items-start gap-2">
            <i data-lucide="alert-triangle" class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5"></i>
            <div>
                <p class="text-sm text-amber-800 font-medium">Importante</p>
                <p class="text-sm text-amber-700 mt-1">
                    Revisa el contenido y completa tus datos personales antes de presentar la reclamacion.
                    Descarga el documento en PDF o Word para editarlo.
                </p>
            </div>
        </div>
    </div>
</div>
