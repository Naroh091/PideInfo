{% extends 'layouts/auth.html.twig' %}

{% block title %}Registro - PideInfo{% endblock %}

{% block auth_content %}
    <h2 class="text-xl font-semibold text-slate-800 text-center mb-4">Crear cuenta</h2>

    <div class="flex items-start gap-3 p-4 rounded-xl bg-emerald-50 border border-emerald-200 mb-6">
        <i data-lucide="sparkles" class="w-5 h-5 text-emerald-600 flex-shrink-0 mt-0.5"></i>
        <div class="text-sm text-emerald-800">
            <p class="font-medium">PideInfo está en beta abierta</p>
            <p class="mt-1 text-emerald-700">Crea tu cuenta gratis y empieza a gestionar tus solicitudes de acceso a información pública. Si tienes dudas o sugerencias, escríbenos por DM en Twitter a <a href="https://twitter.com/naroh" target="_blank" rel="noopener" class="font-medium underline">@naroh</a> o a <a href="mailto:info@iniciativafaro.es" class="font-medium underline">info@iniciativafaro.es</a>.</p>
        </div>
    </div>

    {{ form_start(registrationForm, {'attr': {'class': 'space-y-5'}}) }}
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label for="{{ registrationForm.firstName.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1.5">
                    Nombre
                </label>
                {{ form_widget(registrationForm.firstName, {'attr': {'class': 'input', 'placeholder': 'Juan'}}) }}
                {{ form_errors(registrationForm.firstName) }}
            </div>
            <div>
                <label for="{{ registrationForm.lastName.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1.5">
                    Apellidos
                </label>
                {{ form_widget(registrationForm.lastName, {'attr': {'class': 'input', 'placeholder': 'García'}}) }}
                {{ form_errors(registrationForm.lastName) }}
            </div>
        </div>

        <div>
            <label for="{{ registrationForm.email.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1.5">
                Correo electrónico
            </label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i data-lucide="mail" class="w-5 h-5 text-slate-400"></i>
                </div>
                {{ form_widget(registrationForm.email, {'attr': {'class': 'input input-icon-left', 'placeholder': 'tu@email.com'}}) }}
            </div>
            {{ form_errors(registrationForm.email) }}
        </div>

        <div>
            <label for="{{ registrationForm.plainPassword.first.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1.5">
                Contraseña
            </label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i data-lucide="lock" class="w-5 h-5 text-slate-400"></i>
                </div>
                {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'input input-icon-left', 'placeholder': 'Mínimo 8 caracteres'}}) }}
            </div>
        </div>

        <div>
            <label for="{{ registrationForm.plainPassword.second.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1.5">
                Confirmar contraseña
            </label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i data-lucide="lock" class="w-5 h-5 text-slate-400"></i>
                </div>
                {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'input input-icon-left', 'placeholder': 'Repite tu contraseña'}}) }}
            </div>
            {{ form_errors(registrationForm.plainPassword) }}
        </div>

        <div class="flex items-start gap-2">
            {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'w-4 h-4 rounded border-slate-300 text-primary-600 focus:ring-primary-500 mt-0.5'}}) }}
            <label for="{{ registrationForm.agreeTerms.vars.id }}" class="text-sm text-slate-600">
                He leído y acepto la
                <a href="{{ path('app_privacidad') }}" class="text-primary-600 hover:underline" target="_blank">política de privacidad</a>
            </label>
        </div>
        {{ form_errors(registrationForm.agreeTerms) }}

        <button type="submit" class="btn btn-primary w-full">
            <i data-lucide="user-plus" class="w-4 h-4 mr-2"></i>
            Crear cuenta
        </button>
    {{ form_end(registrationForm) }}
{% endblock %}

{% block auth_footer %}
    <p class="text-slate-500">
        ¿Ya tienes cuenta?
        <a href="{{ path('app_login') }}" class="text-primary-600 font-medium hover:text-primary-700">
            Inicia sesión
        </a>
    </p>
{% endblock %}
