# Portal de Transparencia AGE
PORTAL_URL=https://transparencia.sede.gob.es
PORTAL_CTBG=https://sede.consejodetransparencia.gob.es/info.0

# PideInfo
PIDEINFO_BASE_URL=http://localhost:8000

# Agent settings
AUTH_TIMEOUT_SECONDS=120
SYNC_INTERVAL_MINUTES=30
DATA_DIR=~/.pideinfo-agent

# Sentry (telemetría de errores). Vacío = desactivado.
# DSN del proyecto Sentry del agente, distinto del DSN del backend PHP.
SENTRY_DSN_AGENT=
SENTRY_ENVIRONMENT=production
