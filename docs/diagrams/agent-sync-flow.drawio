<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Agent Sync Flow">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Agent -->
        <mxCell id="agent" value="PideInfo Agent (Python, local)" style="swimlane;startSize=35;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="460" height="320" as="geometry" />
        </mxCell>

        <!-- Playwright -->
        <mxCell id="2" value="Playwright (headed)&#xa;Cl@ve + certificado digital&#xa;→ session cookies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="agent">
          <mxGeometry x="30" y="60" width="190" height="70" as="geometry" />
        </mxCell>

        <!-- httpx -->
        <mxCell id="3" value="httpx → Portal de Transparencia AGE&#xa;GET /privada/expedientes&#xa;GET /privada/notificaciones&#xa;GET /.rest/download/v1/descargaDocumento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="agent">
          <mxGeometry x="240" y="60" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Webhook POST -->
        <mxCell id="4" value="POST /api/agent/webhook&#xa;Authorization: Bearer &lt;JWT&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="agent">
          <mxGeometry x="130" y="220" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Edges inside agent -->
        <mxCell id="ea1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="agent" source="2" target="4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="125" y="180" />
              <mxPoint x="230" y="180" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ea2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="agent" source="3" target="4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="340" y="180" />
              <mxPoint x="230" y="180" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Controller -->
        <mxCell id="ctrl" value="AgentApiController" style="swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="20" width="360" height="320" as="geometry" />
        </mxCell>

        <mxCell id="5" value="JWT authentication&#xa;(lexik/jwt-authentication-bundle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="ctrl">
          <mxGeometry x="80" y="50" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="proc" value="AgentWebhookProcessor" style="swimlane;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="ctrl">
          <mxGeometry x="30" y="130" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="6" value="Deduplicates by contentHash (SHA-256)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="proc">
          <mxGeometry x="20" y="35" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="7" value="Stores documents in S3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="proc">
          <mxGeometry x="20" y="75" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="8" value="Dispatches ProcessDocumentBatchMessage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="proc">
          <mxGeometry x="20" y="110" width="260" height="30" as="geometry" />
        </mxCell>

        <!-- Pipeline -->
        <mxCell id="9" value="Same processing pipeline as manual uploads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="560" y="380" width="360" height="60" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="emain" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontStyle=1;" edge="1" parent="1" source="agent" target="ctrl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="epipe" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="ctrl" target="9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
