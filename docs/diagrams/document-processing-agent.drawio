        <mxCell id="3" value="AccessRequestRepository::find(uuid)&#xa;+ assertOwnership(user)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="110" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- Loop container -->
        <mxCell id="loop" value="Por cada documento (hasta limit)" style="swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="220" width="500" height="290" as="geometry" />
        </mxCell>

        <mxCell id="4" value="AgentProgress::step(&quot;Leyendo {filename}…&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="loop">
          <mxGeometry x="30" y="50" width="440" height="40" as="geometry" />
