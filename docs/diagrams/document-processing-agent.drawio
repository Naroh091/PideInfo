        <mxCell id="8" value="formatExtractions()&#xa;→ Markdown estructurado con hechos, fechas y motivos de denegación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="550" width="400" height="60" as="geometry" />
