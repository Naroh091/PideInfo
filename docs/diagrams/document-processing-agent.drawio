        <mxCell id="7" value="LlmClient::chatJson(pideinfo-document-extract-for-drafting)&#xa;→ {document_type, key_facts[], denial_reasons[],&#xa;    relevant_dates{}, useful_for_drafting}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="loop">
          <mxGeometry x="30" y="210" width="440" height="60" as="geometry" />
